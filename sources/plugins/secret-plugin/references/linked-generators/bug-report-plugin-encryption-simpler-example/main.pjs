commentsPlugin = {import:comments-plugin}
bugReport = {import:bug-report-plugin}

bugReportPublicKey = PUBLIC_1__PUBLIC_END

options
  channel = feedback
  commentPlaceholderText = Submit a bug report here
  hideSettingsButton = true
  hideFullscreenButton = true
  
  async beforeSubmit(e) =>
    let url = await bugReport.createTemporaryDebugInfoUrl({ // this URL is not permanent - i.e. debug data is deleted after a few months. See   perchance.org/bug-report-plugin   for more info.
      customData: {
        foo: 123, // by default browser version and a bunch of other commonly used stuff is collected, but you can add extra debug info here if needed
      },
      // Debug info is encrypted with this public key to increase user privacy.
      // You can generate your own public/private key pairs here:  https://perchance.org/public-key-encryption-tool
      publicKey: bugReportPublicKey,
    });
    // Note that the feedback itself (inputText) is not encrypted. Only the debug data is encrypted (and it's uploaded as an expiring/temporary file using the upload-plugin) You could easily encrypt the feedback text too by just importing `secret-plugin` and then writing `secret.encrypt(e.inputText, bugReportPublicKey)` instead of just `e.inputText` in the line below.
    return `${e.inputText}\n\nBrowser Debug Info:\n${url}`;