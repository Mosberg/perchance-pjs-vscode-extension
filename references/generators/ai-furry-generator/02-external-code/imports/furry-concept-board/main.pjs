// G2G (Generator-to-Generator) friendly: Open to networking and partnerships. Got ideas or feedback? Leave a comment in this generator's comment section, or drop a note here: https://tally.so/r/mY2kKz

kv = {import:kv-plugin}
superFetch = {import:super-fetch-plugin} // for URL-based media imports (see gallery menu)
upload = {import:upload-plugin} // direct ZIP backup links (permanent or 24-hour)
favicon = {import:favicon-plugin}
createMediaGallery = [$output] // just for the demo in the HTML panel

$output(name) =>
  if(!name) name = "";
  if(!/^[a-zA-Z0-9_]*$/.test(name)) throw new Error("Gallery name must be alphanumeric (underscores are also allowed)");
   
  /* ── prefix to avoid collisions ── */
  const pre = `localMediaGallery_${name}.`;
  const galleriesKey = pre + "names";
  const broadcastKey = "localMediaGallery_globalCatalogUpdate";
  const defaultGallery = "Default";
  let activeGalleryName = localStorage[pre + "activeGalleryName"] || defaultGallery;
  let internalRefreshUI = () => {};

  /* helper to coerce any info object into { [k:string]:string } */
  const cleanInfo = i => {
    if (!i || typeof i !== "object") i = {};
    const o = {};
    for (const [k, v] of Object.entries(i)) o[k] = String(v);
    return o;
  };

  /* global dark-mode + btn-visibility vars (once) */
  if (!document.getElementById("localMediaGalleryGlobalStyles")) {
    const s = document.createElement("style");
    s.id = "localMediaGalleryGlobalStyles";
    s.textContent = `
      html{color-scheme:light dark;}
      :root  {
        /* --- ADD THIS BLOCK --- */
        /* Default Fallback Colors (Master site will override these) */
        --background-color: light-dark(#fff, #222);
        --text-color: light-dark(#000, #eee);
        --box-color: light-dark(#f0f0f0, #333);
        --warning-color: light-dark(#d93025, #e57373);
        --alert-color: var(--warning-color, light-dark(#d93025, #e57373)); /* Enslaved Red */
        /* --- END ADD --- */

        --localMediaGalleryBtnsDisplay:flex;
      }

      body {
        /* Master --special-color → master --primary-color → built-in teal */
        --localMediaGallerySpecialColor: var(
          --special-color,
          var(--primary-color, light-dark(#00796B, #4DB6AC))
        );
      }
      #localMediaGallery_root [data-local-media-gallery-bar]{
        display:var(--localMediaGalleryBtnsDisplay, flex) !important;
      }
      @media (hover:hover) and (pointer:fine) {
        [data-local-media-gallery-item] [data-local-media-gallery-bar]{opacity:0;pointer-events:none;transition:opacity .15s,transform .15s;}
        [data-local-media-gallery-item]:hover [data-local-media-gallery-bar],
        [data-local-media-gallery-item]:focus-within [data-local-media-gallery-bar]{opacity:1;pointer-events:auto;}
      }
      @keyframes localMediaGalleryTaskSpin{to{transform:rotate(360deg);}}
      .localMediaGallery-task-spinner{
        width:18px;
        height:18px;
        flex:0 0 18px;
        border:2px solid rgba(128,128,128,.35);
        border-top-color:var(--localMediaGallerySpecialColor);
        border-radius:50%;
        animation:localMediaGalleryTaskSpin .72s linear infinite;
        box-sizing:border-box;
      }
      .localMediaGallery-task-progress-track{
        width:100%;
        height:5px;
        overflow:hidden;
        border-radius:999px;
        background:rgba(128,128,128,.24);
      }
      .localMediaGallery-task-progress-fill{
        width:0%;
        height:100%;
        border-radius:inherit;
        background:var(--localMediaGallerySpecialColor);
        transition:width .12s linear;
      }

      /* Shared Concept Board visual system. Uses existing host color variables only. */
      #localMediaGallery_root.localMediaGallery-root{
        font:14px/1.4 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      }
      #localMediaGallery_root button,
      .localMediaGallery-modal-shell button{
        font-weight:500;
      }
      #localMediaGallery_root button strong,
      .localMediaGallery-modal-shell button strong{
        font-weight:600;
      }
      #localMediaGallery_root .localMediaGallery-page-icon{
        width:16px;
        height:16px;
        line-height:16px;
        flex:0 0 16px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font-size:15.5px !important;
        vertical-align:middle;
      }
      .localMediaGallery-leading-icon{
        width:24px;
        min-width:24px;
        margin-top:2px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        color:inherit;
        font-size:14px;
        line-height:1;
      }
      #localMediaGallery_root .localMediaGallery-toolbar{
        min-height:52px;
        padding:8px 10px;
        display:flex;
        flex-wrap:wrap;
        align-items:center;
        gap:8px;
        border-bottom:1px solid light-dark(#ccc,#333);
        background:var(--background-color);
        box-shadow:0 1px 0 rgba(128,128,128,.08);
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-toolbar-control{
        min-height:36px !important;
        padding:0 11px !important;
        border:1px solid #444;
        border-radius:9px !important;
        background:var(--background-color);
        color:var(--text-color);
        cursor:pointer;
        display:inline-flex;
        align-items:center !important;
        justify-content:center;
        gap:7px !important;
        font:500 13px/1.25 system-ui,sans-serif !important;
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-toolbar-control:hover,
      #localMediaGallery_root .localMediaGallery-toolbar-control:focus-visible{
        background:var(--box-color);
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list{
        margin-top:6px !important;
        padding:6px !important;
        border:1px solid #555 !important;
        border-radius:10px !important;
        background:var(--background-color);
        box-shadow:0 12px 32px rgba(0,0,0,.26) !important;
        overflow:hidden;
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list button,
      #localMediaGallery_root .localMediaGallery-dropdown-list [role="menuitem"]{
        min-height:36px;
        padding:8px 10px !important;
        border-radius:8px;
        gap:9px !important;
        font-size:13px !important;
        line-height:1.25;
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list > div{
        min-height:36px;
        border-radius:7px;
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list{
        scrollbar-width:thin;
        scrollbar-color:rgba(128,128,128,.55) transparent;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list::-webkit-scrollbar{
        width:6px;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list::-webkit-scrollbar-track{
        background:transparent;
      }
      #localMediaGallery_root .localMediaGallery-dropdown-list::-webkit-scrollbar-thumb{
        background:rgba(128,128,128,.55);
        border-radius:6px;
      }
      #localMediaGallery_root .localMediaGallery-folder-row{
        min-height:30px !important;
        border-radius:6px !important;
      }
      #localMediaGallery_root .localMediaGallery-folder-row > button:first-child{
        min-height:26px !important;
        padding:2px 5px !important;
        line-height:1.25 !important;
      }
      #localMediaGallery_root .localMediaGallery-menu-group-gap{
        min-height:4px !important;
        height:4px;
        padding:0 !important;
        pointer-events:none;
      }
      #localMediaGallery_root .localMediaGallery-grid{
        gap:8px !important;
        padding:10px !important;
      }
      #localMediaGallery_root .localMediaGallery-card{
        border-radius:4px;
        overflow:hidden;
        outline:1px solid rgba(128,128,128,.22);
        outline-offset:-1px;
        transition:transform .14s ease,box-shadow .14s ease;
      }
      #localMediaGallery_root .localMediaGallery-card:hover{
        box-shadow:0 5px 16px rgba(0,0,0,.20);
      }
      #localMediaGallery_root .localMediaGallery-add-card{
        background:transparent !important;
        color:light-dark(#777,#aaa);
        outline:1px dashed rgba(128,128,128,.42);
        outline-offset:-1px;
        box-shadow:none !important;
        transition:background .14s ease,color .14s ease,outline-color .14s ease;
      }
      #localMediaGallery_root .localMediaGallery-add-card:hover,
      #localMediaGallery_root .localMediaGallery-add-card:focus-visible{
        background:var(--box-color) !important;
        color:var(--text-color);
        outline-color:rgba(128,128,128,.68);
        box-shadow:none !important;
      }
      #localMediaGallery_root .localMediaGallery-card-action{
        border:none;
        background:rgba(0,0,0,.78);
        color:#fff;
        cursor:pointer;
        display:flex;
        align-items:center;
        justify-content:center;
        box-shadow:0 2px 8px rgba(0,0,0,.24);
      }
      #localMediaGallery_root .localMediaGallery-item-menu{
        width:max-content;
        min-width:176px;
        max-width:calc(100vw - 20px);
        padding:6px;
        position:fixed;
        z-index:10051000;
        border:1px solid #555;
        border-radius:10px;
        background:var(--background-color);
        color:var(--text-color);
        box-shadow:0 16px 42px rgba(0,0,0,.34);
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-item-menu-header{
        padding:7px 10px 8px;
        font-size:11px;
        font-weight:600;
        opacity:.62;
        white-space:nowrap;
        overflow:hidden;
        text-overflow:ellipsis;
      }
      #localMediaGallery_root .localMediaGallery-item-menu button{
        width:100%;
        min-height:38px;
        padding:9px 10px;
        border:0;
        border-radius:8px;
        background:transparent;
        color:var(--text-color);
        cursor:pointer;
        display:flex;
        align-items:center;
        gap:10px;
        text-align:left;
        font:500 13px/1.25 system-ui,sans-serif;
        box-sizing:border-box;
      }
      #localMediaGallery_root .localMediaGallery-item-menu button:hover,
      #localMediaGallery_root .localMediaGallery-item-menu button:focus-visible{
        background:var(--box-color);
      }
      #localMediaGallery_root .localMediaGallery-item-menu button[data-danger="1"]{
        color:var(--alert-color);
      }
      #localMediaGallery_root .localMediaGallery-item-menu-group-gap{
        height:4px;
        margin:1px 0;
        pointer-events:none;
      }
      .localMediaGallery-modal-overlay{
        padding:16px;
        box-sizing:border-box;
      }
      .localMediaGallery-modal-shell{
        border:1px solid rgba(128,128,128,.38);
        border-radius:12px !important;
        box-shadow:0 22px 64px rgba(0,0,0,.38);
        overflow:hidden;
        box-sizing:border-box;
      }
      .localMediaGallery-modal-header{
        min-height:54px;
        padding:12px 16px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        border-bottom:1px solid rgba(128,128,128,.28);
        background:var(--box-color);
        box-sizing:border-box;
        text-align:left;
      }
      .localMediaGallery-modal-header > :first-child{
        min-width:0;
        flex:1;
        text-align:left;
      }
      .localMediaGallery-modal-header > :first-child > *{
        text-align:left;
      }
      .localMediaGallery-modal-footer{
        padding:12px 16px;
        display:flex;
        justify-content:flex-end;
        gap:9px;
        border-top:1px solid rgba(128,128,128,.28);
        background:var(--box-color);
        box-sizing:border-box;
      }
      .localMediaGallery-field-card{
        padding:10px;
        border:1px solid rgba(128,128,128,.28);
        border-radius:8px;
        background:var(--box-color);
      }
      .localMediaGallery-flat-field{
        border:1px solid rgba(128,128,128,.38) !important;
        background:var(--background-color) !important;
        color:var(--text-color) !important;
        box-shadow:none !important;
        outline:none;
        appearance:none;
      }
      .localMediaGallery-flat-field:focus{
        border-color:var(--localMediaGallerySpecialColor) !important;
      }
      .localMediaGallery-flat-panel{
        border:1px solid rgba(128,128,128,.28) !important;
        background:transparent !important;
        box-shadow:none !important;
      }
      .localMediaGallery-flat-button{
        border:1px solid rgba(128,128,128,.42) !important;
        background:transparent !important;
        color:inherit !important;
        box-shadow:none !important;
      }
      .localMediaGallery-flat-button:hover,
      .localMediaGallery-flat-button:focus-visible{
        background:var(--box-color) !important;
      }
      @media (max-width:560px){
        #localMediaGallery_root .localMediaGallery-toolbar{padding:7px 8px;gap:6px;}
        #localMediaGallery_root .localMediaGallery-toolbar-control{min-height:34px !important;padding:0 9px !important;border-radius:8px !important;}
        #localMediaGallery_root .localMediaGallery-grid{gap:6px !important;padding:7px !important;}
        #localMediaGallery_root .localMediaGallery-item-menu{min-width:176px;max-width:calc(100vw - 20px);}
        .localMediaGallery-modal-overlay{padding:10px;}
      }
    `;
    document.head.appendChild(s);
  }

  const getGalleryNames  = () => JSON.parse(localStorage.getItem(galleriesKey) || `["${defaultGallery}"]`);
  const saveGalleryNames = a => localStorage.setItem(galleriesKey, JSON.stringify([...new Set(a)]));
  // Helper to atomically add a page name
  const addPageName = (name) => {
    const currentNames = getGalleryNames(); // Always read the LATEST list
    if (!currentNames.includes(name)) {
      saveGalleryNames([...currentNames, name]); // Save it
      return true; // Return true to show we added it
    }
    return false; // Return false, it already existed
  };
  
  const $ = (t,p={},...k)=>{
    const el=document.createElement(t);
    for(const [k2,v] of Object.entries(p)){
      if(k2==="style")el.style.cssText=v;
      else if(k2==="dataset")Object.assign(el.dataset,v);
      else el[k2]=v;
    }
    k.forEach(c => c && el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c));
    return el;
  };

  // Shared non-native dialog for every Concept Board confirmation, notice, and text entry.
  // Generic plugin rule: no host-generator dependency and no alert/confirm/prompt fallback.
  let conceptBoardDialogDepth = 0;
  const conceptBoardDialogStack = [];
  const openConceptBoardDialog = ({
    title = "Concept Board",
    message = "",
    detail = "",
    input = null,
    actions = [{ label: "OK", value: true, primary: true }],
    dismissValue = null,
    closeOnBackdrop = true
  } = {}) => new Promise(resolve => {
    const dialogToken = {};
    conceptBoardDialogStack.push(dialogToken);
    conceptBoardDialogDepth = conceptBoardDialogStack.length;
    const overlay = $("div", {
      className: "localMediaGallery-modal-overlay",
      style: `display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:${10090000 + conceptBoardDialogDepth};background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;`
    });
    const modal = $("div", {
      className: "localMediaGallery-modal-shell",
      role: "dialog",
      ariaModal: "true",
      style: "width:min(440px,96vw);background:var(--background-color);color:var(--text-color);"
    });
    const header = $("div", { className: "localMediaGallery-modal-header" });
    const heading = $("div", { textContent: String(title), style: "font-size:16px;font-weight:600;line-height:1.25;" });
    const closeButton = $("button", {
      type: "button",
      title: "Close",
      ariaLabel: "Close",
      innerHTML: "×",
      style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;line-height:1;"
    });
    header.append(heading, closeButton);

    const body = $("div", { style: "padding:16px;display:flex;flex-direction:column;gap:10px;" });
    if (message) body.appendChild($("div", { textContent: String(message), style: "font-size:14px;line-height:1.5;white-space:pre-wrap;" }));
    if (detail) body.appendChild($("div", { textContent: String(detail), style: "font-size:12px;line-height:1.45;opacity:.7;white-space:pre-wrap;" }));

    let inputEl = null;
    if (input) {
      inputEl = $(input.multiline ? "textarea" : "input", {
        value: String(input.value ?? ""),
        placeholder: String(input.placeholder || ""),
        autocomplete: "off",
        rows: input.multiline ? Number(input.rows || 4) : undefined,
        style: "width:100%;min-height:40px;padding:9px 10px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);box-sizing:border-box;font:14px/1.4 system-ui,sans-serif;resize:vertical;"
      });
      body.appendChild(inputEl);
    }

    const errorEl = $("div", {
      style: "display:none;padding:8px 10px;border-radius:7px;background:var(--box-color);color:var(--alert-color);font-size:12px;line-height:1.4;"
    });
    body.appendChild(errorEl);

    const footer = $("div", { className: "localMediaGallery-modal-footer" });
    let closed = false;
    const cleanup = value => {
      if (closed) return;
      closed = true;
      document.removeEventListener("keydown", onKey);
      overlay.remove();
      const stackIndex = conceptBoardDialogStack.indexOf(dialogToken);
      if (stackIndex !== -1) conceptBoardDialogStack.splice(stackIndex, 1);
      conceptBoardDialogDepth = conceptBoardDialogStack.length;
      resolve(value);
    };
    const onKey = event => {
      if (conceptBoardDialogStack.at(-1) !== dialogToken) return;
      if (event.key !== "Escape" && event.key !== "Enter") return;
      event.stopImmediatePropagation();
      if (event.key === "Escape") cleanup(dismissValue);
      if (event.key === "Enter" && !input?.multiline) {
        const primaryButton = footer.querySelector('[data-primary="1"]');
        primaryButton?.click();
      }
    };

    for (const action of actions) {
      const button = $("button", {
        type: "button",
        textContent: String(action.label || "OK"),
        dataset: action.primary ? { primary: "1" } : {},
        style: `${action.primary ? "border:0;background:var(--localMediaGallerySpecialColor);color:#fff;font-weight:600;" : action.danger ? "border:1px solid var(--alert-color);background:transparent;color:var(--alert-color);font-weight:600;" : "border:1px solid rgba(128,128,128,.45);background:var(--background-color);color:var(--text-color);"}min-height:38px;padding:0 14px;border-radius:8px;cursor:pointer;`
      });
      button.onclick = () => {
        const value = inputEl ? inputEl.value : action.value;
        if (typeof action.validate === "function") {
          const validation = action.validate(value);
          if (validation !== true) {
            errorEl.textContent = String(validation || "Check this value and try again.");
            errorEl.style.display = "block";
            inputEl?.focus();
            return;
          }
        }
        cleanup(inputEl ? { action: action.value, value } : action.value);
      };
      footer.appendChild(button);
    }

    closeButton.onclick = () => cleanup(dismissValue);
    overlay.onclick = event => { if (closeOnBackdrop && event.target === overlay) cleanup(dismissValue); };
    document.addEventListener("keydown", onKey);
    modal.append(header, body, footer);
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    setTimeout(() => (inputEl || footer.querySelector('[data-primary="1"]') || closeButton).focus(), 0);
  });

  const showConceptBoardNotice = (message, options = {}) => openConceptBoardDialog({
    title: options.title || "Concept Board",
    message,
    detail: options.detail || "",
    actions: [{ label: options.label || "OK", value: true, primary: true }]
  });

  const askConceptBoardConfirm = async (message, options = {}) => (await openConceptBoardDialog({
    title: options.title || "Confirm",
    message,
    detail: options.detail || "",
    actions: [
      { label: options.cancelLabel || "Cancel", value: false },
      { label: options.confirmLabel || "Continue", value: true, primary: !options.danger, danger: !!options.danger }
    ],
    dismissValue: false
  })) === true;

  const askConceptBoardText = async (message, options = {}) => {
    const result = await openConceptBoardDialog({
      title: options.title || "Enter text",
      message,
      detail: options.detail || "",
      input: { value: options.value ?? "", placeholder: options.placeholder || "" },
      actions: [
        { label: options.cancelLabel || "Cancel", value: "cancel" },
        { label: options.confirmLabel || "Save", value: "confirm", primary: true, validate: options.validate }
      ],
      dismissValue: null
    });
    return result?.action === "confirm" ? String(result.value) : null;
  };

  const nextConceptBoardPaint = () => new Promise(resolve => {
    const schedule = callback => typeof requestAnimationFrame === "function"
      ? requestAnimationFrame(callback)
      : setTimeout(callback, 0);
    schedule(() => schedule(resolve));
  });

  const setConceptBoardInlineProgress = (container, options = {}) => {
    if (!container) return;
    const state = options.state || "working";
    const percent = options.percent == null ? Number.NaN : Number(options.percent);
    const hasPercent = Number.isFinite(percent);

    if (!container._conceptBoardProgressParts) {
      const row = $("div", { style: "display:flex;align-items:center;gap:9px;min-width:0;" });
      const icon = $("span", { ariaHidden: "true" });
      const message = $("span", { style: "min-width:0;flex:1;white-space:pre-wrap;" });
      const percentText = $("span", { style: "display:none;flex:0 0 auto;font-variant-numeric:tabular-nums;opacity:.7;" });
      const track = $("div", { className: "localMediaGallery-task-progress-track", style: "display:none;margin-top:8px;" });
      const fill = $("div", { className: "localMediaGallery-task-progress-fill" });
      track.appendChild(fill);
      row.append(icon, message, percentText);
      container.replaceChildren(row, track);
      container._conceptBoardProgressParts = { icon, message, percentText, track, fill };
    }

    const parts = container._conceptBoardProgressParts;
    parts.message.textContent = String(options.message || "Working...");
    if (state === "working") {
      parts.icon.className = "localMediaGallery-task-spinner";
    } else {
      parts.icon.className = state === "error"
        ? "fa-solid fa-triangle-exclamation fa-fw"
        : "fa-solid fa-circle-check fa-fw";
    }

    parts.track.style.display = hasPercent ? "block" : "none";
    parts.percentText.style.display = hasPercent ? "inline" : "none";
    if (hasPercent) {
      const clamped = Math.max(0, Math.min(100, percent));
      parts.fill.style.width = `${clamped}%`;
      parts.percentText.textContent = `${Math.round(clamped)}%`;
    }
  };

  const createConceptBoardTaskProgress = ({
    title = "Concept Board",
    message = "Working...",
    delay = 220
  } = {}) => {
    let overlay = null;
    let status = null;
    let closed = false;
    let latest = { message, state: "working" };

    const mount = () => {
      if (closed || overlay) return;
      overlay = $("div", {
        className: "localMediaGallery-modal-overlay",
        style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10085000;background:rgba(0,0,0,.62);padding:14px;box-sizing:border-box;"
      });
      const shell = $("div", {
        className: "localMediaGallery-modal-shell",
        role: "status",
        ariaLive: "polite",
        ariaBusy: "true",
        style: "width:min(390px,94vw);padding:16px;background:var(--background-color);color:var(--text-color);"
      });
      shell.appendChild($("div", { textContent: String(title), style: "font-size:15px;font-weight:600;margin-bottom:10px;" }));
      status = $("div", { style: "font-size:12px;line-height:1.45;padding:10px;border-radius:8px;background:var(--box-color);" });
      shell.appendChild(status);
      overlay.appendChild(shell);
      document.body.appendChild(overlay);
      setConceptBoardInlineProgress(status, latest);
    };

    const timer = setTimeout(mount, Math.max(0, Number(delay) || 0));
    return {
      show: mount,
      update(options = {}) {
        latest = typeof options === "string"
          ? { message: options, state: "working" }
          : { ...latest, ...options };
        if (overlay && status) setConceptBoardInlineProgress(status, latest);
      },
      close() {
        if (closed) return;
        closed = true;
        clearTimeout(timer);
        overlay?.remove();
        overlay = null;
        status = null;
      }
    };
  };

  const formatConceptBoardTaskError = (error, actionLabel = "finish this operation") => {
    const message = String(error?.message || error || "Unknown error");
    if (/memory|allocation|array buffer|out of memory|invalid array length|too large/i.test(message)) {
      return `The browser could not ${actionLabel} in one pass. Close other heavy tabs and try again. The backup file itself remains unchanged.`;
    }
    return message;
  };

  const dims = b => new Promise(r => {
    const url = URL.createObjectURL(b);
    if (b.type.startsWith("image/")) {
      const i = new Image();
      i.onload = () => { r({w:i.width, h:i.height}); URL.revokeObjectURL(url); };
      i.src = url;
    } else if (b.type.startsWith("video/")) {
      const v = document.createElement("video");
      v.onloadedmetadata = () => { r({w:v.videoWidth||300, h:v.videoHeight||300}); URL.revokeObjectURL(url); };
      v.src = url;
    } else {
      URL.revokeObjectURL(url);
      r({w:300, h:300});
    }
  });

    // Helper to check if a blob ID is referenced by ANY page
    // except for the pages listed in 'ignorePages'
    const isBlobReferenced = async (id, ignorePages = []) => {
      const allPages = getGalleryNames();
      for (const pageName of allPages) {
        if (ignorePages.includes(pageName)) continue; // Skip pages we're deleting
        
        // Check if the page's KV store has a reference to this ID
        if (await kv[pre + pageName].get(id)) {
          return true; // Found it! It's still in use.
        }
      }
      return false; // No other page references this blob
    };
  
  const blobs = kv[pre+"blobs"]; // blob store

  // Backwards-compatibly store Blobs as ArrayBuffers due to long-standing Safari bug #74827837
  // Fix taken from old new code.txt 
  const originalBlobsSet = blobs.set.bind(blobs);
  blobs.set = async (id, data) => {
    // data is either {blob, info} or just a raw blob
    const blob = data?.blob ?? data;
    const info = data?.info ?? null;
    // If it's a file, convert to ArrayBuffer before storing
    if (blob instanceof Blob) {
      const arrayBuffer = await blob.arrayBuffer();
      return originalBlobsSet(id, { buffer: arrayBuffer, type: blob.type, info });
    }
    return originalBlobsSet(id, data);
  };

  const originalBlobsGet = blobs.get.bind(blobs);
  blobs.get = async (id) => {
    const rec = await originalBlobsGet(id);
    if (!rec) return null;
    // Backwards compat: if it's already a Blob, return as-is
    if (rec instanceof Blob) return { blob: rec, info: null };
    if (rec.blob instanceof Blob) return rec;
    
    // New format: reconstruct from ArrayBuffer
    if (rec.buffer) {
      const blob = new Blob([rec.buffer], { type: rec.type || 'application/octet-stream' });
      return { blob, info: rec.info ?? null };
    }
    return rec;
  };

  // Return only a real media Blob. Note-only records deliberately resolve to null.
  const getMediaBlob = rec => {
    if (rec instanceof Blob) return rec;
    return rec?.blob instanceof Blob ? rec.blob : null;
  };

  // Resolve an already-stored hosted image link without changing the item record.
  // Exact image-specific keys are trusted. Generic "url" remains conservative so
  // ordinary web, Spotify, YouTube, audio, and video links keep existing behavior.
  const getLinkedImageUrl = info => {
    if (!info || typeof info !== "object") return "";

    for (const raw of [info["Image URL"], info.imageUrl]) {
      const value = String(raw || "").trim();
      if (/^https?:\/\//i.test(value)) return value;
    }

    const genericUrl = String(info.url || "").trim();
    if (
      /^https?:\/\//i.test(genericUrl) &&
      (
        /\.(?:avif|bmp|gif|jpe?g|png|svg|webp)(?:[?#].*)?$/i.test(genericUrl) ||
        /(?:aigc|user)\.uploads\.dev\/(?:image|file)\//i.test(genericUrl)
      )
    ) {
      return genericUrl;
    }

    return "";
  };

  // FurAI artifact viewers are opt-in through metadata. Existing gallery items keep
  // their original image/video/link/note behavior unchanged.
  const furaiArtifactViewers = new Set([
    "furai-chat",
    "furai-backup",
    "furai-character",
    "furai-lorebook",
    "furai-glossary"
  ]);

  const isFuraiArtifactInfo = info =>
    !!info && furaiArtifactViewers.has(String(info.viewer || "").trim());

  const isFuraiArtifactExportGateRequired = info => {
    const viewer = String(info?.viewer || "").trim();
    if (!["furai-character", "furai-chat", "furai-backup"].includes(viewer)) {
      return false;
    }

    return !(
      String(info?.furaiProtectionMeta ?? "") === "1" &&
      String(info?.furaiHiddenInstructions ?? "") === "0"
    );
  };

  const isFuraiArtifactPg13GateRequired = info => {
    const viewer = String(info?.viewer || "").trim();
    if (!["furai-character", "furai-chat", "furai-backup"].includes(viewer)) {
      return false;
    }

    return !(
      String(info?.furaiPg13Meta ?? "") === "1" &&
      String(info?.furaiAdultTags ?? "") === "0"
    );
  };

  const isFuraiArtifactSafetyBridgeRequired = info =>
    isFuraiArtifactExportGateRequired(info) || isFuraiArtifactPg13GateRequired(info);


  const getFuraiArtifactBridge = viewer => {
    try {
      const bridge = window.FuraiConceptBoardBridge;
      if (!bridge || typeof bridge.importArtifact !== "function") return null;
      if (typeof bridge.supports === "function" && !bridge.supports(viewer)) return null;
      return bridge;
    } catch (error) {
      console.warn("FurAI bridge check failed.", error);
      return null;
    }
  };

  const getFuraiArtifactReturnAction = (bridge, viewer) => {
    try {
      const supplied = typeof bridge?.getAction === "function" ? bridge.getAction(viewer) : null;
      if (supplied?.label) {
        return {
          label: String(supplied.label),
          icon: String(supplied.icon || "fa-solid fa-arrow-up-right-from-square")
        };
      }
    } catch (error) {
      console.warn("Could not read FurAI bridge action.", error);
    }

    return ({
      "furai-chat": { label: "Import Chat", icon: "fa-solid fa-file-import" },
      "furai-backup": { label: "Restore Backup", icon: "fa-solid fa-rotate-left" },
      "furai-character": { label: "Add Character", icon: "fa-solid fa-user-plus" },
      "furai-lorebook": { label: "Add to Bookshelf", icon: "fa-solid fa-book-medical" },
      "furai-glossary": { label: "Add to Bookshelf", icon: "fa-solid fa-book-medical" }
    })[viewer] || null;
  };

  const formatArtifactBytes = value => {
    const bytes = Number(value);
    if (!Number.isFinite(bytes) || bytes < 0) return "Unknown size";
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
    if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(2)} MB`;
    return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
  };

  const getArtifactDownloadName = (item, blob, info = {}) => {
    const providedName = String(info.fileName || "").trim();
    if (providedName) return providedName;

    // Preserve the legacy filename fallback exactly for pre-viewer items.
    const subtype = blob?.type?.split("/")[1] || "bin";
    return `${item?.id || "concept-board-item"}.${subtype}`;
  };

  const downloadBoardItemBlob = (item, blob, info = {}) => {
    const fileName = getArtifactDownloadName(item, blob, info);

    if (String(info.fileName || "").trim()) {
      // FurAI provides its original export filename. Use the mobile-safe path.
      triggerDownload(blob, fileName);
      return;
    }

    // Keep the original download behavior for all existing Concept Board items.
    const url = URL.createObjectURL(blob);
    const anchor = $("a", { href: url, download: fileName });
    anchor.click();
    URL.revokeObjectURL(url);
  };


  const FURAI_BOARD_MAX_ARTIFACT_BYTES = 128 * 1024 * 1024;
  const FURAI_BOARD_MAX_CHARACTER_BYTES = 32 * 1024 * 1024;
  const FURAI_BOARD_MAX_LIBRARY_BYTES = 32 * 1024 * 1024;
  const FURAI_BOARD_MAX_PREVIEW_BYTES = 16 * 1024 * 1024;

  const getBoardArtifactMaxBytes = viewer => {
    if (viewer === "furai-character") return FURAI_BOARD_MAX_CHARACTER_BYTES;
    if (viewer === "furai-lorebook" || viewer === "furai-glossary") return FURAI_BOARD_MAX_LIBRARY_BYTES;
    return FURAI_BOARD_MAX_ARTIFACT_BYTES;
  };

  // @FURAI_BOARD_ARTIFACT_FORMAT — CONTRACT FOR HUMAN AND AI EDITORS:
  // FurAI artifact preview/import/download must accept both readable JSON and gzip.
  // Detect gzip by its 1F 8B signature; never trust only the filename or MIME type.
  // These helpers stay dormant for every normal gallery item. FurAI behavior is
  // entered only after isFuraiArtifactInfo(info) explicitly opts an item in.
  const canCreateBoardGzip = () => typeof CompressionStream === "function";

  const isBoardGzipBlob = async blob => {
    if (!(blob instanceof Blob) || blob.size < 2) return false;
    const signature = new Uint8Array(await blob.slice(0, 2).arrayBuffer());
    return signature[0] === 0x1f && signature[1] === 0x8b;
  };

  const readBoardArtifactText = async (blob, maxBytes = FURAI_BOARD_MAX_ARTIFACT_BYTES) => {
    if (!(blob instanceof Blob)) throw new Error("Artifact file is unavailable.");
    const limit = Math.max(1, Number(maxBytes) || FURAI_BOARD_MAX_ARTIFACT_BYTES);
    if (blob.size > limit) throw new Error("Artifact file is too large.");

    const isGzip = await isBoardGzipBlob(blob);
    if (!isGzip) return blob.text();

    if (typeof DecompressionStream !== "function" || typeof TransformStream !== "function") {
      throw new Error("This browser cannot preview gzip files.");
    }

    let decodedBytes = 0;
    let exceededLimit = false;
    try {
      const stream = blob.stream()
        .pipeThrough(new DecompressionStream("gzip"))
        .pipeThrough(new TransformStream({
          transform(chunk, controller) {
            decodedBytes += chunk.byteLength;
            if (decodedBytes > limit) {
              exceededLimit = true;
              throw new Error("FURAI_BOARD_ARTIFACT_TOO_LARGE");
            }
            controller.enqueue(chunk);
          }
        }));
      return await new Response(stream).text();
    } catch (error) {
      if (exceededLimit || error?.message === "FURAI_BOARD_ARTIFACT_TOO_LARGE") {
        throw new Error("Artifact is too large after decompression.");
      }
      throw new Error("Invalid or corrupted gzip artifact.");
    }
  };

  const createBoardGzipBlob = async (text, fileName) => {
    if (!canCreateBoardGzip()) {
      throw new Error("This browser cannot create gzip files. Download JSON instead.");
    }
    const source = new Blob([String(text || "")], { type: "application/json;charset=utf-8" });
    const compressed = await new Response(
      source.stream().pipeThrough(new CompressionStream("gzip"))
    ).blob();
    const gzipBlob = new Blob([compressed], { type: "application/gzip" });
    return typeof File === "function"
      ? new File([gzipBlob], fileName, { type: "application/gzip" })
      : gzipBlob;
  };

  const getBoardArtifactJsonObject = async (blob, info = {}) => {
    const viewer = String(info.viewer || "");
    const rawText = await readBoardArtifactText(blob, getBoardArtifactMaxBytes(viewer));

    if (viewer === "furai-lorebook" || viewer === "furai-glossary") {
      try {
        const parsed = JSON.parse(rawText);
        if (parsed && typeof parsed === "object" && typeof parsed.content === "string") return parsed;
      } catch (error) {}

      const type = viewer === "furai-glossary" ? "glossary" : "lorebook";
      return {
        furaiArtifactVersion: 2,
        furaiArtifactType: type,
        type,
        title: String(info.title || info.type || (type === "glossary" ? "Glossary" : "Lorebook")),
        hashTag: String(info.hashTag || ""),
        cover: String(info.cover || ""),
        content: rawText
      };
    }

    try {
      return JSON.parse(rawText);
    } catch (error) {
      throw new Error("This FurAI artifact is not valid JSON.");
    }
  };

  const getBoardArtifactBaseName = (item, info = {}) => {
    const preferred = String(info.readableFileName || info.fileName || "").trim();
    const raw = preferred || String(info.title || item?.id || "FurAI-artifact");
    return raw
      .replace(/\.(?:json\.gz|json|txt\.gz|txt|gz)$/i, "")
      .replace(/[\\/:*?"<>|]+/g, "")
      .replace(/\s+/g, "_")
      .slice(0, 100) || "FurAI-artifact";
  };

  const downloadBoardArtifactFormat = async (item, blob, info = {}, format = "json") => {
    const baseName = getBoardArtifactBaseName(item, info);
    const useGzip = String(format).toLowerCase() === "gz";
    const fileName = `${baseName}.json${useGzip ? ".gz" : ""}`;
    const viewer = String(info.viewer || "");
    const protectionHint = String(info.furaiHiddenInstructions ?? "");
    const originalIsGzip = useGzip ? await isBoardGzipBlob(blob) : false;

    // New Safe/Plain items explicitly store 0 and may keep the original gzip bytes.
    // Older or Full items are decoded so FurAI can apply the same Safe/Full gate.
    if (
      useGzip &&
      String(info.furaiProtectionMeta ?? "") === "1" &&
      protectionHint === "0" &&
      String(info.furaiPg13Meta ?? "") === "1" &&
      String(info.furaiAdultTags ?? "") === "0" &&
      originalIsGzip
    ) {
      triggerDownload(blob, fileName);
      return { mode: "plain", protectedCount: 0 };
    }

    let data = await getBoardArtifactJsonObject(blob, info);
    let result = { data, mode: "plain", protectedCount: 0 };
    const requiresGate = isFuraiArtifactSafetyBridgeRequired(info);
    const bridge = requiresGate ? getFuraiArtifactBridge(viewer) : null;

    if (requiresGate && (!bridge || typeof bridge.prepareArtifactExport !== "function")) {
      throw new Error("Open this protected or adult-tagged FurAI artifact inside FurAI to create the allowed version.");
    }

    if (bridge && typeof bridge.prepareArtifactExport === "function") {
      const prepared = await bridge.prepareArtifactExport(data, {
        viewer,
        title: getFuraiArtifactTitle(info),
        actionLabel: "download this Concept Board item"
      });

      if (!prepared) return { cancelled: true };

      const preparedMode = String(prepared.mode || "");
      const preparedCount = Number(prepared.protectedCount || 0);
      const preparedAdultMode = String(prepared.adultTagMode || "unchanged");
      const preparedAdultCount = Number(prepared.adultTagCount || 0);
      const validHiddenDecision =
        (preparedMode === "safe" && preparedCount > 0) ||
        (preparedMode === "full" && preparedCount > 0) ||
        (preparedMode === "unchanged" && preparedCount === 0);
      const validAdultDecision =
        (preparedAdultMode === "pg13" && preparedAdultCount > 0) ||
        (preparedAdultMode === "full" && preparedAdultCount > 0) ||
        (preparedAdultMode === "unchanged" && preparedAdultCount === 0);

      if (!validHiddenDecision || !validAdultDecision || !prepared.data || typeof prepared.data !== "object") {
        throw new Error("FurAI returned an invalid export decision for this item.");
      }

      result = prepared;
      data = prepared.data;
    }

    // A verified Full GZ download can use the exact stored bytes. Safe Copy must
    // be rebuilt because its hidden fields were removed from the temporary data.
    if (
      useGzip &&
      originalIsGzip &&
      (result.mode === "full" || result.mode === "unchanged") &&
      result.adultTagMode !== "pg13"
    ) {
      triggerDownload(blob, fileName);
      return result;
    }

    const outputBlob = useGzip
      ? await createBoardGzipBlob(JSON.stringify(data), fileName)
      : new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    triggerDownload(outputBlob, fileName);
    return result;
  };

  const decodeArtifactText = value => {
    const raw = value == null
      ? ""
      : typeof value === "string"
        ? value
        : JSON.stringify(value, null, 2);

    const namedEntities = {
      amp: "&",
      lt: "<",
      gt: ">",
      quot: '"',
      apos: "'",
      nbsp: " "
    };

    return raw
      .replace(/<br\s*\/?\s*>/gi, "\n")
      .replace(/<\/(?:p|div|li|blockquote|h[1-6])>/gi, "\n")
      .replace(/<[^>]*>/g, "")
      .replace(/&(#x[0-9a-f]+|#\d+|amp|lt|gt|quot|apos|nbsp);/gi, (match, entity) => {
        const normalized = String(entity).toLowerCase();
        if (normalized[0] !== "#") return namedEntities[normalized] ?? match;

        const isHex = normalized.startsWith("#x");
        const codePoint = Number.parseInt(normalized.slice(isHex ? 2 : 1), isHex ? 16 : 10);
        try {
          return Number.isFinite(codePoint) ? String.fromCodePoint(codePoint) : match;
        } catch {
          return match;
        }
      })
      .replace(/\u00a0/g, " ")
      .replace(/[ \t]+\n/g, "\n")
      .replace(/\n{3,}/g, "\n\n")
      .trim();
  };

  // Character artifacts may contain ordinary [SECRET] blocks plus the newer
  // protected fields. Concept Board never exposes either through its normal UI.
  // The full stored/downloaded character artifact remains unchanged for round-trip import.
  const getFuraiPublicCharacterInstruction = character => decodeArtifactText(
    character?.instruction || ""
  )
    .replace(/\[SECRET\][\s\S]*?\[\/SECRET\]/gi, "")
    .replace(/\n{3,}/g, "\n\n")
    .trim();

  const getBoardFuraiJsonValueEnd = (text, startIndex) => {
    let index = Math.max(0, Number(startIndex) || 0);
    while (index < text.length && /\s/.test(text[index])) index++;

    const first = text[index];
    if (first !== "{" && first !== "[") return -1;

    const stack = [first];
    let inString = false;
    let escaped = false;

    for (index += 1; index < text.length; index++) {
      const char = text[index];

      if (inString) {
        if (escaped) escaped = false;
        else if (char === "\\") escaped = true;
        else if (char === "\"") inString = false;
        continue;
      }

      if (char === "\"") {
        inString = true;
        continue;
      }

      if (char === "{" || char === "[") {
        stack.push(char);
        continue;
      }

      if (char === "}" || char === "]") {
        const expected = char === "}" ? "{" : "[";
        if (stack.pop() !== expected) return -1;
        if (!stack.length) return index + 1;
      }
    }

    return -1;
  };

  const removeBoardFuraiProtectedMetadataNotes = value => {
    const original = String(value || "");
    let text = original;
    let changed = false;
    let searchFrom = 0;
    const headingPattern = /\[FurAI Export Metadata\]\s*(?:\r?\n)?/ig;
    const protectedPattern = /(?:protectedInstruction|protectedSecret|protectedHiddenSecrets|protectedEditCodeHash)/i;

    while (searchFrom < text.length) {
      headingPattern.lastIndex = searchFrom;
      const match = headingPattern.exec(text);
      if (!match) break;

      const contentStart = headingPattern.lastIndex;
      const jsonEnd = getBoardFuraiJsonValueEnd(text, contentStart);
      const blockEnd = jsonEnd > contentStart ? jsonEnd : text.length;
      const metadataBlock = text.slice(contentStart, blockEnd);

      if (!protectedPattern.test(metadataBlock)) {
        searchFrom = Math.max(blockEnd, headingPattern.lastIndex);
        continue;
      }

      const before = text.slice(0, match.index).trimEnd();
      const after = text.slice(blockEnd).trimStart();
      text = [before, after].filter(Boolean).join("\n\n");
      changed = true;
      searchFrom = Math.max(0, before.length - 1);
    }

    return changed ? text.trim() : original.trim();
  };

  const getFuraiPublicCreatorNotes = character => removeBoardFuraiProtectedMetadataNotes(
    character?.creatorNotes ?? character?.creator_notes ?? ""
  );

  const getFuraiCharacterProtectionStats = character => {
    const nested = character?.protectedInstructions && typeof character.protectedInstructions === "object"
      ? character.protectedInstructions
      : {};
    const protectedInstruction = String(
      character?.protectedInstruction ?? nested.instruction ?? ""
    ).trim();
    const protectedSecret = String(
      character?.protectedSecret ??
      character?.protectedHiddenSecrets ??
      nested.secret ??
      nested.hiddenSecrets ??
      ""
    ).trim();
    const text = [protectedInstruction, protectedSecret].filter(Boolean).join("\n\n");
    const words = text ? text.split(/\s+/).filter(Boolean).length : 0;

    return {
      words,
      label: words ? `${words} hidden word${words === 1 ? "" : "s"}` : ""
    };
  };

  const getFuraiArtifactTitle = info => {
    const explicitTitle = String(info?.title || "").trim();
    if (explicitTitle) return explicitTitle;

    const firstCustomEntry = Object.entries(info || {}).find(([key]) =>
      !["viewer", "category", "fileName", "contentType", "size", "date", "artifactVersion", "type"].includes(key)
    );

    return firstCustomEntry?.[0] || String(info?.type || info?.category || "FurAI Artifact");
  };

  const getFuraiArtifactIcon = viewer => ({
    "furai-chat": "fa-solid fa-comments",
    "furai-backup": "fa-solid fa-database",
    "furai-character": "fa-regular fa-id-card",
    "furai-lorebook": "fa-solid fa-book-open",
    "furai-glossary": "fa-solid fa-book-bookmark"
  }[viewer] || "fa-regular fa-file-lines");

  const getFuraiChatMessageText = message => decodeArtifactText(
    message?.content ??
    message?.text ??
    message?.message ??
    message?.body ??
    message?.value ??
    ""
  );

  const getFuraiChatMessageName = (message, artifact) => {
    const role = String(message?.role || "").toLowerCase();
    const profile = artifact?.profile || {};

    if (role === "user") {
      return String(
        message?.userNameSnapshot ||
        message?.name ||
        profile?.user?.name ||
        "User"
      );
    }

    if (role === "system") return String(message?.name || "System");
    if (role === "cutscene") return String(message?.name || "Cutscene");

    const bots = Array.isArray(profile?.bots) ? profile.bots : [];
    const numericIndex = Number(message?.botIndex);
    const indexedBot = Number.isInteger(numericIndex) && numericIndex >= 0
      ? bots[numericIndex]
      : null;
    const uidBot = message?.botUid
      ? bots.find(bot => bot && String(bot.uid || "") === String(message.botUid))
      : null;

    return String(
      message?.botNameSnapshot ||
      message?.speaker ||
      message?.name ||
      indexedBot?.name ||
      uidBot?.name ||
      (role === "ai" ? "AI" : role || "Message")
    );
  };

  const buildReadableFuraiChat = artifact => {
    const chat = artifact?.chat || artifact || {};
    const messages = Array.isArray(chat?.messages) ? chat.messages : [];

    if (!messages.length) return "This exported chat contains no messages.";

    return messages.map((message, index) => {
      const speaker = getFuraiChatMessageName(message, artifact);
      const content = getFuraiChatMessageText(message) || "[Empty message]";
      const rawTime = Number(message?.timestamp);
      const time = Number.isFinite(rawTime) && rawTime > 0
        ? ` · ${new Date(rawTime).toLocaleString()}`
        : "";
      return `${index + 1}. ${speaker}${time}\n${content}`;
    }).join("\n\n");
  };

  const getFuraiArtifactCardPreview = async (blob, info) => {
    const viewer = String(info?.viewer || "");
    const title = getFuraiArtifactTitle(info);
    const sizeLabel = formatArtifactBytes(blob?.size ?? info?.size);

    try {
      if (viewer === "furai-chat") {
        const count = Number(info?.messageCount);
        const mode = String(info?.mode || "").trim();
        const summary = [
          Number.isFinite(count) ? `${count} message${count === 1 ? "" : "s"}` : "Chat export",
          mode && mode !== "unknown" ? mode : "",
          sizeLabel
        ].filter(Boolean).join(" · ");

        // Chat/backup items saved by FurAI are gzip. Keep gallery scrolling light:
        // use their metadata card and defer decompression until the user opens them.
        if (await isBoardGzipBlob(blob)) return { title, description: summary };

        if (blob?.size <= 6 * 1024 * 1024) {
          const parsed = JSON.parse(await readBoardArtifactText(blob, 6 * 1024 * 1024));
          const messages = Array.isArray(parsed?.chat?.messages) ? parsed.chat.messages : [];
          const latest = [...messages].reverse().find(msg => getFuraiChatMessageText(msg));
          if (latest) {
            const speaker = getFuraiChatMessageName(latest, parsed);
            const snippet = getFuraiChatMessageText(latest).replace(/\s+/g, " ").slice(0, 150);
            return { title, description: `${summary}\n${speaker}: ${snippet}` };
          }
        }

        return { title, description: summary };
      }

      if (viewer === "furai-character" && blob?.size <= 2 * 1024 * 1024) {
        let parsed = JSON.parse(await readBoardArtifactText(blob, 2 * 1024 * 1024));
        if (isFuraiArtifactSafetyBridgeRequired(info)) {
          const bridge = getFuraiArtifactBridge(viewer);
          if (!bridge || typeof bridge.sanitizeArtifactView !== "function") {
            return { title, description: `Character artifact · ${sizeLabel}` };
          }
          const safeView = bridge.sanitizeArtifactView(parsed);
          if (!safeView?.data || typeof safeView.data !== "object") {
            return { title, description: `Character artifact · ${sizeLabel}` };
          }
          parsed = safeView.data;
        }
        const instruction = getFuraiPublicCharacterInstruction(parsed)
          .replace(/\s+/g, " ")
          .slice(0, 170);
        const protection = getFuraiCharacterProtectionStats(parsed);
        return {
          title: String(parsed?.name || title),
          description: [
            String(parsed?.hashTag || "").trim(),
            instruction || "Character profile",
            protection.label ? `🔒 ${protection.label}` : "",
            sizeLabel
          ]
            .filter(Boolean)
            .join(" · ")
        };
      }

      if ((viewer === "furai-lorebook" || viewer === "furai-glossary") && blob) {
        const rawText = await readBoardArtifactText(blob, 2 * 1024 * 1024);
        let contentText = rawText;
        try {
          const parsed = JSON.parse(rawText);
          if (parsed && typeof parsed.content === "string") contentText = parsed.content;
        } catch (error) {}
        const previewText = decodeArtifactText(contentText)
          .replace(/\s+/g, " ")
          .slice(0, 190);
        return { title, description: previewText || `${info?.type || "Text artifact"} · ${sizeLabel}` };
      }
    } catch (error) {
      console.warn("Could not build FurAI artifact card preview.", error);
    }

    const typeLabel = String(info?.type || info?.category || "FurAI artifact");
    return { title, description: `${typeLabel} · ${sizeLabel}` };
  };

  /* ───────────────────────────── JSZip loader */
  let jszipPromise = null;
  
  const getJSZip = () => {
    // 1. If loaded already, return it immediately
    if (window.JSZip) return Promise.resolve(window.JSZip);
    
    // 2. If currently loading, return the pending promise to avoid duplicates
    if (jszipPromise) return jszipPromise;
  
    // 3. Start the loading process
    jszipPromise = new Promise((resolve, reject) => {
      // We use the "Universal" (.min.js) builds, not the Module (+esm) builds
      const sources = [
        "https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js",
        "https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js",
        "https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"
      ];
  
      let i = 0;
  
      const tryNext = () => {
        if (i >= sources.length) {
          jszipPromise = null;
          return reject(new Error("ZIP tools could not load. Check your internet connection and try again."));
        }
  
        const script = document.createElement("script");
        script.src = sources[i];
        
        script.onload = () => {
          if (window.JSZip) {
            resolve(window.JSZip);
            return;
          }
          script.remove();
          i++;
          tryNext();
        };
  
        script.onerror = () => {
          // Failed, try the next mirror
          script.remove();
          i++;
          tryNext();
        };
  
        document.head.appendChild(script);
      };
  
      tryNext();
    });
  
    return jszipPromise;
  };
  
  /* ───────────────────────────── Concept Board ZIP backup / restore / links */
  const CONCEPT_BOARD_BACKUP_MANIFEST = "concept-board.manifest.json";
  const CONCEPT_BOARD_BACKUP_FORMAT = "concept-board-zip";
  const CONCEPT_BOARD_BACKUP_VERSION = 1;
  const CONCEPT_BOARD_LINK_EXPIRY_MS = 24 * 60 * 60 * 1000;
  const CONCEPT_BOARD_MIB = 1024 * 1024;
  // Large backups are warned about, not rejected by arbitrary browser-size guesses.
  // These values are recommendation thresholds only; invalid paths/metadata still fail normally.
  const CONCEPT_BOARD_LOCAL_MAX_ENTRY_COUNT = 200000;
  const CONCEPT_BOARD_LOCAL_MAX_DECLARED_UNPACKED_BYTES = 32768 * CONCEPT_BOARD_MIB;
  const CONCEPT_BOARD_LINK_MAX_ENTRY_COUNT = 100000;
  const CONCEPT_BOARD_MANIFEST_MAX_BYTES = 64 * 1024;
  const CONCEPT_BOARD_INFO_MAX_BYTES = 16 * CONCEPT_BOARD_MIB;
  const CONCEPT_BOARD_PAGE_NAME_RE = /^[a-zA-Z0-9_]+$/;
  // Archive paths must stay flat and path-safe, while stored IDs remain compatible
  // with older rescue records and generic host integrations.
  const CONCEPT_BOARD_ARCHIVE_ITEM_ID_RE = /^[^\/\\\u0000-\u001f\u007f]{1,768}$/u;
  const CONCEPT_BOARD_STORAGE_ITEM_ID_MAX_LENGTH = 1024;

  const getConceptBoardLinkMaxZipBytes = () => {
    const memoryGb = Number(globalThis.navigator?.deviceMemory);
    if (Number.isFinite(memoryGb) && memoryGb <= 2) return 512 * CONCEPT_BOARD_MIB;
    if (Number.isFinite(memoryGb) && memoryGb <= 4) return 1024 * CONCEPT_BOARD_MIB;
    if (Number.isFinite(memoryGb) && memoryGb <= 8) return 2048 * CONCEPT_BOARD_MIB;
    if (Number.isFinite(memoryGb) && memoryGb > 8) return 4096 * CONCEPT_BOARD_MIB;
    return 1024 * CONCEPT_BOARD_MIB;
  };

  const getConceptBoardLinkWarningBytes = () => 256 * CONCEPT_BOARD_MIB;

  const getConceptBoardLinkImportLimits = () => {
    const recommendedCompressedBytes = getConceptBoardLinkMaxZipBytes();
    return {
      maxCompressedBytes: recommendedCompressedBytes,
      warningCompressedBytes: getConceptBoardLinkWarningBytes(),
      maxEntries: CONCEPT_BOARD_LINK_MAX_ENTRY_COUNT,
      maxDeclaredUnpackedBytes: Math.min(32768 * CONCEPT_BOARD_MIB, recommendedCompressedBytes * 8),
      requireDeclaredSizes: false
    };
  };

  const getConceptBoardLocalImportLimits = () => ({
    maxCompressedBytes: Number.POSITIVE_INFINITY,
    warningCompressedBytes: 512 * CONCEPT_BOARD_MIB,
    maxEntries: CONCEPT_BOARD_LOCAL_MAX_ENTRY_COUNT,
    maxDeclaredUnpackedBytes: CONCEPT_BOARD_LOCAL_MAX_DECLARED_UNPACKED_BYTES,
    requireDeclaredSizes: false
  });

  const assertConceptBoardPageName = (value, label = "page name") => {
    const name = String(value || "").trim();
    if (!CONCEPT_BOARD_PAGE_NAME_RE.test(name)) {
      throw new Error(`Invalid Concept Board ${label}. Page names may contain only letters, numbers, and underscores.`);
    }
    return name;
  };

  const assertConceptBoardStorageItemId = value => {
    const id = String(value ?? "");
    if (
      !id ||
      id.length > CONCEPT_BOARD_STORAGE_ITEM_ID_MAX_LENGTH ||
      /[\u0000-\u001f\u007f]/u.test(id)
    ) {
      throw new Error("This ZIP contains an invalid Concept Board item ID.");
    }
    return id;
  };

  const assertConceptBoardArchiveItemId = value => {
    const id = String(value ?? "");
    if (!CONCEPT_BOARD_ARCHIVE_ITEM_ID_RE.test(id) || id === "." || id === "..") {
      throw new Error("This ZIP contains an invalid Concept Board archive item ID.");
    }
    return id;
  };

  const getConceptBoardStableIdHash = async value => {
    const bytes = new TextEncoder().encode(String(value));
    try {
      if (globalThis.crypto?.subtle) {
        const digest = new Uint8Array(await globalThis.crypto.subtle.digest("SHA-256", bytes));
        return Array.from(digest, byte => byte.toString(16).padStart(2, "0")).join("").slice(0, 32);
      }
    } catch {}

    // Deterministic fallback for older browser contexts. Archive-local collision
    // handling below still guarantees unique names inside one backup.
    let h1 = 0x811c9dc5;
    let h2 = 0x9e3779b9;
    for (const byte of bytes) {
      h1 = Math.imul(h1 ^ byte, 0x01000193) >>> 0;
      h2 = Math.imul(h2 ^ (byte + 0x9d), 0x85ebca6b) >>> 0;
    }
    return `${h1.toString(16).padStart(8, "0")}${h2.toString(16).padStart(8, "0")}${bytes.length.toString(16)}`;
  };

  const createConceptBoardArchiveIdMapper = () => {
    const archiveByStorage = new Map();
    const storageByArchive = new Map();

    return async value => {
      const storageId = assertConceptBoardStorageItemId(value);
      if (archiveByStorage.has(storageId)) return archiveByStorage.get(storageId);

      let archiveId = (
        CONCEPT_BOARD_ARCHIVE_ITEM_ID_RE.test(storageId) &&
        storageId !== "." &&
        storageId !== ".."
      ) ? storageId : `cbid_${await getConceptBoardStableIdHash(storageId)}`;

      const base = archiveId;
      let suffix = 2;
      while (storageByArchive.has(archiveId) && storageByArchive.get(archiveId) !== storageId) {
        archiveId = `${base}_${suffix++}`;
      }

      archiveByStorage.set(storageId, archiveId);
      storageByArchive.set(archiveId, storageId);
      return archiveId;
    };
  };

  const getZipEntryDeclaredSize = entry => {
    const size = Number(entry?._data?.uncompressedSize);
    return Number.isFinite(size) && size >= 0 ? size : null;
  };

  // @CONCEPT_BOARD_ZIP_BACKUP_POLICY — CONTRACT FOR HUMAN AND AI EDITORS:
  // - Current-page and whole-board backups use ZIP only. Do not gzip a ZIP backup.
  // - Local files and uploaded backup links use the same ZIP structure and offer Smart Merge or Replace.
  // - Link lifetime choices are Permanent or 24 Hours only. Do not restore a 7-day option.
  // - The 24-hour option exists mainly for its much higher upload-size and daily allowance.
  // - Other apps keep the exact original one-record-at-a-time path and data shape.
  // - Only FurAI's namespaced artifact metadata opts into its Safe/Full export gate.

  const getConceptBoardBackupTimestamp = () =>
    new Date().toISOString().replace(/[:]/g, "-").slice(0, 19);

  const getConceptBoardBackupManifest = (scope, pageName = "") => {
    const normalizedScope = scope === "full" ? "full" : "page";
    return {
      format: CONCEPT_BOARD_BACKUP_FORMAT,
      version: CONCEPT_BOARD_BACKUP_VERSION,
      scope: normalizedScope,
      pageName: normalizedScope === "full" ? "" : assertConceptBoardPageName(pageName || activeGalleryName),
      createdAt: Date.now()
    };
  };

  const getConceptBoardBackupFileName = (scope, pageName = activeGalleryName) => {
    const stamp = getConceptBoardBackupTimestamp();
    return scope === "full"
      ? `concept_board_backup_ALL_${stamp}.zip`
      : `concept_board_backup_PAGE-${assertConceptBoardPageName(pageName)}_${stamp}.zip`;
  };

  const addConceptBoardItemToZip = async (
    zip,
    item,
    basePath = "",
    getArchiveId,
    options = {}
  ) => {
    const storageId = assertConceptBoardStorageItemId(item?.id);
    const archiveId = await getArchiveId(storageId);
    const rec = options.record || await blobs.get(storageId);
    const blob = rec?.blob;
    const info = rec?.info || {};

    if (typeof options.beforeAdd === "function") {
      const defer = await options.beforeAdd({
        storageId,
        archiveId,
        item,
        basePath,
        rec,
        blob,
        info
      });
      if (defer === true) return { deferred: true, storageId, rec };
    }

    const ext = (blob?.type?.split("/")[1] || "bin").replace(/[^\w.-]/g, "");

    if (blob instanceof Blob) {
      zip.file(`${basePath}${archiveId}.${ext}`, blob);
    } else if (Object.keys(info).length) {
      let text = "";
      for (const [key, value] of Object.entries(info)) {
        text += `# ${key}\n${value}\n\n`;
      }
      zip.file(
        `${basePath}${archiveId}.note.txt`,
        new Blob([text.trim()], { type: "text/plain" })
      );
    }

    zip.file(
      `${basePath}${archiveId}.info.json`,
      new Blob(
        [JSON.stringify({ meta: { ...item, id: storageId }, info, mime: blob?.type || null }, null, 2)],
        { type: "application/json" }
      )
    );

    return { deferred: false, storageId, rec };
  };

  const prepareDeferredFuraiBackupRecords = async (
    protectedArtifacts,
    scope,
    report,
    bridge
  ) => {
    if (!protectedArtifacts.size) return null;

    const artifacts = Array.from(protectedArtifacts.values());
    report({
      message: `Checking ${artifacts.length} FurAI item${artifacts.length === 1 ? "" : "s"} for hidden instructions...`,
      percent: null
    });

    const parsedArtifacts = [];
    for (let index = 0; index < artifacts.length; index++) {
      const artifact = artifacts[index];
      const data = await getBoardArtifactJsonObject(artifact.rec.blob, artifact.info);
      parsedArtifacts.push({ ...artifact, data });

      if ((index + 1) % 4 === 0) {
        report({
          message: `Checking hidden instructions · ${index + 1} of ${artifacts.length} items`,
          percent: null
        });
        await nextConceptBoardPaint();
      }
    }

    const prepared = await bridge.prepareArtifactExport(
      { artifacts: parsedArtifacts.map(artifact => artifact.data) },
      {
        viewer: "furai-backup",
        title: scope === "full" ? "Concept Board Backup" : "Concept Board Page",
        actionLabel: scope === "full"
          ? "create this whole Concept Board backup"
          : "create this Concept Board page backup"
      }
    );

    if (!prepared) {
      const error = new Error("Backup cancelled.");
      error.code = "CONCEPT_BOARD_BACKUP_CANCELLED";
      throw error;
    }

    const preparedMode = String(prepared.mode || "");
    const preparedCount = Number(prepared.protectedCount || 0);
    const preparedAdultMode = String(prepared.adultTagMode || "unchanged");
    const preparedAdultCount = Number(prepared.adultTagCount || 0);
    const hiddenChanged = preparedMode === "safe" && preparedCount > 0;
    const adultChanged = preparedAdultMode === "pg13" && preparedAdultCount > 0;
    const hiddenUnchanged =
      (preparedMode === "full" && preparedCount > 0) ||
      (preparedMode === "unchanged" && preparedCount === 0);
    const adultUnchanged =
      (preparedAdultMode === "full" && preparedAdultCount > 0) ||
      (preparedAdultMode === "unchanged" && preparedAdultCount === 0);

    if (hiddenUnchanged && adultUnchanged) return null;
    if ((!hiddenChanged && !hiddenUnchanged) || (!adultChanged && !adultUnchanged)) {
      throw new Error("FurAI returned an invalid export decision for this backup.");
    }

    const safeArtifacts = prepared?.data?.artifacts;
    if (!Array.isArray(safeArtifacts) || safeArtifacts.length !== parsedArtifacts.length) {
      throw new Error("FurAI returned an invalid Safe Copy batch.");
    }
    if (safeArtifacts.some(artifact => !artifact || typeof artifact !== "object")) {
      throw new Error("FurAI returned an invalid Safe Copy artifact.");
    }

    const protectedIndexes = new Set();
    const collectIndexes = (rawIndexes, label) => {
      if (!Array.isArray(rawIndexes)) {
        throw new Error(`FurAI did not identify the ${label} records in this copy.`);
      }
      rawIndexes.forEach(index => {
        if (!Number.isInteger(index) || index < 0 || index >= parsedArtifacts.length) {
          throw new Error(`FurAI returned an invalid ${label}-record index.`);
        }
        protectedIndexes.add(index);
      });
    };

    if (hiddenChanged) collectIndexes(prepared?.protectedArtifactIndexes, "protected");
    if (adultChanged) collectIndexes(prepared?.adultArtifactIndexes, "PG-13-trimmed");

    if (!protectedIndexes.size) {
      throw new Error("FurAI returned a changed copy without identifying its records.");
    }

    const overrides = new Map();
    for (let index = 0; index < parsedArtifacts.length; index++) {
      const artifact = parsedArtifacts[index];
      const safeData = safeArtifacts[index];

      // This comes from FurAI's direct-reference hidden-entry plan and remains
      // correct even when old/stale metadata falsely advertises zero.
      if (!protectedIndexes.has(index)) continue;

      const wasGzip = await isBoardGzipBlob(artifact.rec.blob);
      const safeBlob = wasGzip
        ? await createBoardGzipBlob(JSON.stringify(safeData), `safe-${artifact.storageId}.json.gz`)
        : new Blob([JSON.stringify(safeData)], { type: "application/json" });

      overrides.set(artifact.storageId, {
        blob: safeBlob,
        info: {
          ...artifact.info,
          contentType: String(safeBlob.type || artifact.info.contentType || ""),
          size: String(safeBlob.size),
          furaiHiddenInstructions: preparedMode === "full" ? String(Math.max(0, preparedCount)) : "0",
          furaiProtectionMeta: "1",
          furaiAdultTags: preparedAdultMode === "full" ? String(Math.max(0, preparedAdultCount)) : "0",
          furaiPg13Meta: "1"
        }
      });
    }

    return overrides;
  };

  const buildConceptBoardBackupZip = async (
    scope = "page",
    pageName = activeGalleryName,
    onProgress = null
  ) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    report({ message: "Loading ZIP tools...", percent: null });
    const JSZip = await getJSZip();
    const zip = new JSZip();
    const normalizedScope = scope === "full" ? "full" : "page";
    const getArchiveId = createConceptBoardArchiveIdMapper();
    const furaiBridge = getFuraiArtifactBridge("furai-backup");
    const useFuraiExportGate = !!furaiBridge &&
      typeof furaiBridge.prepareArtifactExport === "function";
    const protectedArtifacts = new Map();
    const deferredPlans = [];
    let packagedItems = 0;

    zip.file(
      CONCEPT_BOARD_BACKUP_MANIFEST,
      JSON.stringify(getConceptBoardBackupManifest(normalizedScope, pageName), null, 2)
    );

    const packageItem = async (item, basePath) => {
      const storageId = assertConceptBoardStorageItemId(item?.id);
      const alreadyDeferred = protectedArtifacts.get(storageId);

      if (useFuraiExportGate && alreadyDeferred) {
        deferredPlans.push({ item, basePath, storageId });
        return;
      }

      const result = await addConceptBoardItemToZip(
        zip,
        item,
        basePath,
        getArchiveId,
        {
          beforeAdd({ storageId: readId, rec, blob, info }) {
            if (!(blob instanceof Blob) || !isFuraiArtifactSafetyBridgeRequired(info)) return false;

            if (!useFuraiExportGate) {
              const error = new Error(
                "This backup contains a protected, adult-tagged, or legacy FurAI artifact. Open this Concept Board inside FurAI to create the allowed version."
              );
              error.code = "CONCEPT_BOARD_FURAI_EXPORT_REQUIRED";
              throw error;
            }

            protectedArtifacts.set(readId, { storageId: readId, rec, info });
            deferredPlans.push({ item, basePath, storageId: readId });
            return true;
          }
        }
      );

      if (!result.deferred) {
        packagedItems++;
        if (packagedItems % 25 === 0) {
          report({ message: `Packaging ${packagedItems} items...`, percent: null });
        }
      }
    };

    if (normalizedScope === "full") {
      const galleryNames = getGalleryNames();
      for (let pageIndex = 0; pageIndex < galleryNames.length; pageIndex++) {
        const galleryName = assertConceptBoardPageName(galleryNames[pageIndex]);
        report({
          message: `Packaging page ${pageIndex + 1} of ${galleryNames.length}: ${galleryName}`,
          percent: null
        });
        const items = await kv[pre + galleryName].values();
        for (const item of items) {
          await packageItem(item, `galleries/${galleryName}/`);
        }
      }
    } else {
      pageName = assertConceptBoardPageName(pageName);
      report({ message: `Packaging page: ${pageName}`, percent: null });
      const items = await kv[pre + pageName].values();
      for (const item of items) await packageItem(item, "");
    }

    if (deferredPlans.length) {
      const overrides = await prepareDeferredFuraiBackupRecords(
        protectedArtifacts,
        normalizedScope,
        report,
        furaiBridge
      );

      for (const plan of deferredPlans) {
        const source = protectedArtifacts.get(plan.storageId)?.rec;
        const record = overrides?.get(plan.storageId) || source;
        await addConceptBoardItemToZip(
          zip,
          plan.item,
          plan.basePath,
          getArchiveId,
          { record }
        );
        packagedItems++;
        if (packagedItems % 25 === 0) {
          report({ message: `Packaging ${packagedItems} items...`, percent: null });
        }
      }
    }

    // ZIP layout, manifest, page metadata, and ordinary item records are unchanged.
    let lastReportedZipPercent = -1;
    return zip.generateAsync(
      { type: "blob", mimeType: "application/zip" },
      metadata => {
        const percent = Math.max(0, Math.min(100, Math.floor(Number(metadata?.percent) || 0)));
        if (percent !== lastReportedZipPercent) {
          lastReportedZipPercent = percent;
          report({ message: "Creating ZIP backup...", percent });
        }
      }
    );
  };

  const hasZipSignature = async blob => {
    if (!(blob instanceof Blob) || blob.size < 4) return false;
    const bytes = new Uint8Array(await blob.slice(0, 4).arrayBuffer());
    return bytes[0] === 0x50 && bytes[1] === 0x4b && (
      (bytes[2] === 0x03 && bytes[3] === 0x04) ||
      (bytes[2] === 0x05 && bytes[3] === 0x06) ||
      (bytes[2] === 0x07 && bytes[3] === 0x08)
    );
  };

  const loadConceptBoardZip = async (source, limits = {}, onProgress = null) => {
    if (source?.files && typeof source.file === "function") return source;
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };

    if (source instanceof Blob) {
      report({ message: "Checking ZIP backup...", percent: null });
      if (!(await hasZipSignature(source))) {
        throw new Error("This file is not a valid ZIP backup.");
      }

      const recommendedBytes = Number(limits.maxCompressedBytes);
      const warningBytes = Number(limits.warningCompressedBytes);
      const thresholds = [recommendedBytes, warningBytes].filter(value => Number.isFinite(value) && value > 0);
      const firstWarningAt = thresholds.length ? Math.min(...thresholds) : Number.POSITIVE_INFINITY;
      if (!limits.skipCompressedWarning && source.size > firstWarningAt) {
        const aboveRecommendation = Number.isFinite(recommendedBytes) && source.size > recommendedBytes;
        const proceed = await askConceptBoardConfirm(
          `Load this ${formatArtifactBytes(source.size)} Concept Board backup?`,
          {
            title: "Large backup",
            detail: aboveRecommendation
              ? `This is larger than the browser's estimated comfortable one-pass range of ${formatArtifactBytes(recommendedBytes)}. It can still be loaded, but it may use substantial memory. Your current data is not changed until you choose Smart Merge or Replace.`
              : "Large ZIP files can use substantial browser memory while they are checked and restored. Your current data is not changed until you choose Smart Merge or Replace.",
            confirmLabel: "Continue loading"
          }
        );
        if (!proceed) throw new Error("Import cancelled.");
      }
    }

    report({ message: "Opening ZIP backup...", percent: null });
    const JSZip = await getJSZip();
    const zip = await JSZip.loadAsync(source);
    const entries = Object.values(zip.files || {});

    const recommendedEntries = Number(limits.maxEntries);
    if (Number.isFinite(recommendedEntries) && entries.length > recommendedEntries) {
      const proceed = await askConceptBoardConfirm(
        `This backup contains ${entries.length.toLocaleString()} ZIP entries. Continue?`,
        {
          title: "Very large backup",
          detail: `The usual recommendation is up to ${recommendedEntries.toLocaleString()} entries. Concept Board will still try to restore the complete backup.`,
          confirmLabel: "Continue restoring"
        }
      );
      if (!proceed) throw new Error("Import cancelled.");
    }

    const recommendedUnpackedBytes = Number(limits.maxDeclaredUnpackedBytes);
    if (Number.isFinite(recommendedUnpackedBytes)) {
      let declaredTotal = 0;
      let hasUnknownSize = false;
      for (const entry of entries) {
        if (entry?.dir) continue;
        const size = getZipEntryDeclaredSize(entry);
        if (size == null) {
          hasUnknownSize = true;
          continue;
        }
        declaredTotal += size;
        if (!Number.isSafeInteger(declaredTotal)) {
          declaredTotal = Number.POSITIVE_INFINITY;
          break;
        }
      }

      if (declaredTotal > recommendedUnpackedBytes) {
        const proceed = await askConceptBoardConfirm(
          `This backup may expand to ${formatArtifactBytes(declaredTotal)}. Continue?`,
          {
            title: "Large expanded backup",
            detail: `This is above the browser's estimated comfortable range of ${formatArtifactBytes(recommendedUnpackedBytes)}. Concept Board will still try to restore it in full.`,
            confirmLabel: "Continue restoring"
          }
        );
        if (!proceed) throw new Error("Import cancelled.");
      } else if (hasUnknownSize && limits.requireDeclaredSizes) {
        const proceed = await askConceptBoardConfirm(
          "Some ZIP entry sizes cannot be checked before loading. Continue?",
          {
            title: "Backup size unavailable",
            detail: "Concept Board can still try to restore the backup. Large files may use substantial browser memory.",
            confirmLabel: "Continue restoring"
          }
        );
        if (!proceed) throw new Error("Import cancelled.");
      }
    }

    report({ message: `ZIP opened · ${entries.length.toLocaleString()} entries`, percent: null });
    return zip;
  };

  const readConceptBoardBackupManifest = async zip => {
    const entry = zip?.file?.(CONCEPT_BOARD_BACKUP_MANIFEST);
    if (!entry) return null;

    const declaredSize = getZipEntryDeclaredSize(entry);
    if (declaredSize != null && declaredSize > CONCEPT_BOARD_MANIFEST_MAX_BYTES) {
      throw new Error("The Concept Board backup manifest is unexpectedly large.");
    }

    let parsed;
    try {
      const raw = await entry.async("string");
      if (raw.length > CONCEPT_BOARD_MANIFEST_MAX_BYTES) {
        throw new Error("The Concept Board backup manifest is unexpectedly large.");
      }
      parsed = JSON.parse(raw);
    } catch (error) {
      if (error?.message?.includes("unexpectedly large")) throw error;
      throw new Error("The Concept Board backup manifest is invalid.");
    }

    if (!parsed || parsed.format !== CONCEPT_BOARD_BACKUP_FORMAT) return null;
    if (Number(parsed.version) !== CONCEPT_BOARD_BACKUP_VERSION) {
      throw new Error(`Unsupported Concept Board backup version: ${parsed.version ?? "unknown"}.`);
    }
    if (parsed.scope !== "full" && parsed.scope !== "page") {
      throw new Error("The Concept Board backup manifest has an invalid scope.");
    }
    if (parsed.scope === "page") parsed.pageName = assertConceptBoardPageName(parsed.pageName);
    return parsed;
  };

  const detectConceptBoardBackupScope = (zip, manifest = null) => {
    if (manifest?.scope === "full" || manifest?.scope === "page") return manifest.scope;
    return Object.entries(zip?.files || {}).some(([name, entry]) =>
      !entry.dir && /^galleries\/[^/]+\//.test(name)
    ) ? "full" : "page";
  };

  const buildPageZipIndex = zip => {
    const infoEntries = new Map();
    const mediaEntries = new Map();

    for (const [name, entry] of Object.entries(zip.files || {})) {
      if (entry.dir || name === CONCEPT_BOARD_BACKUP_MANIFEST || name.includes("/")) continue;
      if (name.endsWith(".info.json")) {
        const id = assertConceptBoardArchiveItemId(name.replace(/\.info\.json$/, ""));
        infoEntries.set(id, entry);
      } else {
        const id = name.replace(/\.[^.]+$/, "");
        if (CONCEPT_BOARD_ARCHIVE_ITEM_ID_RE.test(id) && id !== "." && id !== "..") mediaEntries.set(id, entry);
      }
    }

    return { infoEntries, mediaEntries };
  };

  const buildFullZipIndex = zip => {
    const infoEntries = new Map();
    const mediaEntries = new Map();

    for (const [name, entry] of Object.entries(zip.files || {})) {
      if (entry.dir) continue;

      const infoMatch = /^galleries\/([^/]+)\/([^/]+)\.info\.json$/.exec(name);
      if (infoMatch) {
        const galleryName = assertConceptBoardPageName(infoMatch[1], "page name in the ZIP");
        const id = assertConceptBoardArchiveItemId(infoMatch[2]);
        if (!infoEntries.has(galleryName)) infoEntries.set(galleryName, new Map());
        infoEntries.get(galleryName).set(id, entry);
        continue;
      }

      const mediaMatch = /^galleries\/([^/]+)\/([^/]+\.[^/]+)$/.exec(name);
      if (!mediaMatch) continue;
      const galleryName = String(mediaMatch[1] || "");
      const fileName = mediaMatch[2];
      const id = fileName.replace(/\.[^.]+$/, "");
      if (!CONCEPT_BOARD_PAGE_NAME_RE.test(galleryName) || !CONCEPT_BOARD_ARCHIVE_ITEM_ID_RE.test(id) || id === "." || id === "..") continue;
      if (!mediaEntries.has(galleryName)) mediaEntries.set(galleryName, new Map());
      mediaEntries.get(galleryName).set(id, entry);
    }

    return { infoEntries, mediaEntries };
  };

  const normalizeConceptBoardImportedMeta = (meta, storageId) => {
    const rawDate = Number(meta?.date);
    const rawRating = Number(meta?.rating);
    const rawW = Number(meta?.w);
    const rawH = Number(meta?.h);
    return {
      id: storageId,
      date: Number.isFinite(rawDate) && rawDate > 0 ? rawDate : Date.now(),
      rating: Number.isFinite(rawRating) ? rawRating : 0,
      w: Number.isFinite(rawW) && rawW > 0 && rawW <= 100000 ? rawW : 150,
      h: Number.isFinite(rawH) && rawH > 0 && rawH <= 100000 ? rawH : 150
    };
  };

  const parseConceptBoardInfoEntry = async (entry, archiveId) => {
    const declaredSize = getZipEntryDeclaredSize(entry);
    if (declaredSize != null && declaredSize > CONCEPT_BOARD_INFO_MAX_BYTES) {
      throw new Error(`Metadata for item "${archiveId}" is unexpectedly large.`);
    }

    const raw = await entry.async("string");
    if (raw.length > CONCEPT_BOARD_INFO_MAX_BYTES) {
      throw new Error(`Metadata for item "${archiveId}" is unexpectedly large.`);
    }

    let inf;
    try {
      inf = JSON.parse(raw);
    } catch {
      throw new Error(`Metadata for item "${archiveId}" is invalid JSON.`);
    }
    if (!inf || typeof inf !== "object" || Array.isArray(inf)) {
      throw new Error(`Metadata for item "${archiveId}" has an invalid structure.`);
    }

    const storageId = assertConceptBoardStorageItemId(inf.meta?.id ?? archiveId);
    return {
      archiveId,
      storageId,
      meta: normalizeConceptBoardImportedMeta(inf.meta, storageId),
      info: cleanInfo(inf.info || null),
      mime: inf.mime ? String(inf.mime) : null
    };
  };

  const getConceptBoardImportMode = async (scope, manifest = null, sourceName = "") => {
    if (scope === "page") {
      const manifestName = manifest?.scope === "page"
        ? String(manifest.pageName || "").trim()
        : "";
      const fileNameMatch = String(sourceName || "").match(/_PAGE-([a-zA-Z0-9_]+)_/);
      const originalName = manifestName || fileNameMatch?.[1] || "";
      const sourceDetail = originalName
        ? `Backup source: “${originalName}”.`
        : "The ZIP contains one page backup.";

      return String(await openConceptBoardDialog({
        title: "Load into current page",
        message: `Load this backup into the current page “${activeGalleryName}”?`,
        detail: `${sourceDetail}\nSmart Merge keeps current items and adds missing IDs. Replace Current Page clears this page first.`,
        actions: [
          { label: "Cancel", value: "" },
          { label: "Smart Merge", value: "merge", primary: true },
          { label: "Replace Current Page", value: "replace", danger: true }
        ],
        dismissValue: ""
      }) || "");
    }

    return String(await openConceptBoardDialog({
      title: "Load backup",
      message: "Choose how to load this whole-board backup.",
      detail: "Smart Merge keeps current pages and adds missing item IDs. Replace Whole Board clears the current board before restoring the backup.",
      actions: [
        { label: "Cancel", value: "" },
        { label: "Smart Merge", value: "merge", primary: true },
        { label: "Replace Whole Board", value: "replace", danger: true }
      ],
      dismissValue: ""
    }) || "");
  };

  const importConceptBoardPageZip = async (
    zip,
    manifest,
    sourceName = "",
    mode = "merge",
    onProgress = null
  ) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    const targetGallery = activeGalleryName;
    const importMode = mode === "replace" ? "replace" : "merge";
    const names = getGalleryNames();
    if (!names.includes(targetGallery)) saveGalleryNames([...names, targetGallery]);

    report({ message: "Reading page backup metadata...", percent: null });
    const { infoEntries, mediaEntries } = buildPageZipIndex(zip);
    if (!infoEntries.size) throw new Error("This page backup contains no Concept Board items.");

    const parsedInfos = [];
    const pageStorageIds = new Set();
    let parsedCount = 0;
    for (const [archiveId, infoEntry] of infoEntries) {
      const parsed = await parseConceptBoardInfoEntry(infoEntry, archiveId);
      if (pageStorageIds.has(parsed.storageId)) {
        throw new Error(`This page backup contains duplicate metadata for item "${parsed.storageId}".`);
      }
      pageStorageIds.add(parsed.storageId);
      parsedInfos.push(parsed);
      parsedCount++;
      if (parsedCount % 20 === 0 || parsedCount === infoEntries.size) {
        report({
          message: `Checking page items ${parsedCount} of ${infoEntries.size}...`,
          percent: (parsedCount / Math.max(1, infoEntries.size)) * 25
        });
      }
    }

    // Keep the established storage keys, item records, and replace behavior unchanged.
    if (importMode === "replace") {
      report({ message: "Preparing current page for restore...", percent: 25 });
      const oldItems = await kv[pre + targetGallery].values();
      await kv[pre + targetGallery].clear();
      for (const item of oldItems) {
        if (!pageStorageIds.has(item.id) && !(await isBlobReferenced(item.id, [targetGallery]))) {
          await blobs.delete(item.id);
        }
      }
    }

    let imported = 0;
    let skipped = 0;
    let processed = 0;
    for (const parsed of parsedInfos) {
      const { archiveId, storageId, meta, info, mime } = parsed;
      if (importMode === "merge" && await kv[pre + targetGallery].get(storageId)) {
        skipped++;
        processed++;
        if (processed % 20 === 0 || processed === parsedInfos.length) {
          report({
            message: `Restoring page items ${processed} of ${parsedInfos.length}...`,
            percent: 25 + (processed / Math.max(1, parsedInfos.length)) * 75
          });
        }
        continue;
      }

      const existingBlob = await blobs.get(storageId);
      if (importMode === "replace" || !existingBlob) {
        const mediaEntry = mediaEntries.get(archiveId);
        let blob = mediaEntry ? await mediaEntry.async("blob") : null;
        if (blob && !blob.type && mime) {
          blob = new Blob([await blob.arrayBuffer()], { type: mime });
        }
        await blobs.set(storageId, { blob, info });
      }

      await kv[pre + targetGallery].set(storageId, meta);
      imported++;
      processed++;
      if (processed % 20 === 0 || processed === parsedInfos.length) {
        report({
          message: `Restoring page items ${processed} of ${parsedInfos.length}...`,
          percent: 25 + (processed / Math.max(1, parsedInfos.length)) * 75
        });
      }
    }

    return { scope: "page", mode: importMode, targetGallery, imported, skipped };
  };

  const importConceptBoardFullZip = async (zip, mode = "merge", onProgress = null) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    const importMode = mode === "replace" ? "replace" : "merge";
    report({ message: "Reading whole-board backup metadata...", percent: null });
    const { infoEntries, mediaEntries } = buildFullZipIndex(zip);
    if (!infoEntries.size) throw new Error("This full backup contains no Concept Board pages.");

    const totalInfoEntries = Array.from(infoEntries.values()).reduce((sum, page) => sum + page.size, 0);
    const parsedPages = [];
    let parsedCount = 0;
    for (const [galleryName, galleryInfos] of infoEntries) {
      const parsedInfos = [];
      const pageStorageIds = new Set();
      for (const [archiveId, infoEntry] of galleryInfos) {
        const parsed = await parseConceptBoardInfoEntry(infoEntry, archiveId);
        if (pageStorageIds.has(parsed.storageId)) {
          throw new Error(`Page "${galleryName}" contains duplicate metadata for item "${parsed.storageId}".`);
        }
        pageStorageIds.add(parsed.storageId);
        parsedInfos.push(parsed);
        parsedCount++;
        if (parsedCount % 20 === 0 || parsedCount === totalInfoEntries) {
          report({
            message: `Checking backup items ${parsedCount} of ${totalInfoEntries}...`,
            percent: (parsedCount / Math.max(1, totalInfoEntries)) * 20
          });
        }
      }
      parsedPages.push([galleryName, parsedInfos]);
    }

    // Keep the established storage keys, item records, and replace behavior unchanged.
    if (importMode === "replace") {
      report({ message: "Preparing the board for restore...", percent: 20 });
      for (const galleryName of getGalleryNames()) await kv[pre + galleryName].clear();
      await blobs.clear();
      saveGalleryNames([]);
    }

    let imported = 0;
    let skipped = 0;
    let processed = 0;
    const importedPageNames = [];
    const restoredBlobIds = new Set();

    for (const [galleryName, parsedInfos] of parsedPages) {
      importedPageNames.push(galleryName);
      const names = getGalleryNames();
      if (!names.includes(galleryName)) saveGalleryNames([...names, galleryName]);

      for (const parsed of parsedInfos) {
        const { archiveId, storageId, meta, info, mime } = parsed;
        if (importMode === "merge" && await kv[pre + galleryName].get(storageId)) {
          skipped++;
          processed++;
          if (processed % 20 === 0 || processed === totalInfoEntries) {
            report({
              message: `Restoring backup items ${processed} of ${totalInfoEntries}...`,
              percent: 20 + (processed / Math.max(1, totalInfoEntries)) * 80
            });
          }
          continue;
        }

        const existingBlob = await blobs.get(storageId);
        const shouldRestoreBlob = importMode === "replace"
          ? !restoredBlobIds.has(storageId)
          : !existingBlob;

        let measured = { w: meta.w, h: meta.h };
        if (shouldRestoreBlob) {
          const mediaEntry = mediaEntries.get(galleryName)?.get(archiveId);
          let blob = mediaEntry ? await mediaEntry.async("blob") : null;
          if (blob && !blob.type && mime) {
            blob = new Blob([await blob.arrayBuffer()], { type: mime });
          }
          measured = blob ? await dims(blob) : measured;
          await blobs.set(storageId, { blob, info });
          restoredBlobIds.add(storageId);
        }

        await kv[pre + galleryName].set(storageId, {
          ...meta,
          w: measured.w || meta.w,
          h: measured.h || meta.h
        });
        imported++;
        processed++;
        if (processed % 20 === 0 || processed === totalInfoEntries) {
          report({
            message: `Restoring backup items ${processed} of ${totalInfoEntries}...`,
            percent: 20 + (processed / Math.max(1, totalInfoEntries)) * 80
          });
        }
      }
    }

    if (importMode === "replace") {
      saveGalleryNames(importedPageNames);
      if (!importedPageNames.includes(activeGalleryName)) {
        activeGalleryName = importedPageNames[0] || defaultGallery;
        localStorage[pre + "activeGalleryName"] = activeGalleryName;
      }
    }

    return { scope: "full", mode: importMode, imported, skipped, pageCount: parsedPages.length };
  };

  const importConceptBoardBackupZip = async (
    source,
    sourceName = "",
    limits = {},
    expectedScope = "auto",
    onProgress = null
  ) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    const zip = await loadConceptBoardZip(source, limits, report);
    report({ message: "Checking backup manifest...", percent: null });
    const manifest = await readConceptBoardBackupManifest(zip);
    const scope = detectConceptBoardBackupScope(zip, manifest);
    const expected = expectedScope === "full" || expectedScope === "page" ? expectedScope : "auto";

    if (expected !== "auto" && scope !== expected) {
      const actualLabel = scope === "full" ? "whole-board backup" : "page backup";
      const openedLabel = expected === "full" ? "Load Backup" : "Load into Current Page";
      const approved = await askConceptBoardConfirm(
        `This ZIP is a ${actualLabel}, but you opened ${openedLabel}. Continue with the detected backup type?`,
        {
          title: scope === "full" ? "Whole backup detected" : "Page backup detected",
          detail: "The ZIP was inspected first. You will choose Smart Merge or Replace next.",
          confirmLabel: scope === "full" ? "Continue to Backup" : "Continue to Page Load"
        }
      );
      if (!approved) return null;
    }

    const mode = await getConceptBoardImportMode(scope, manifest, sourceName);
    if (!mode) return null;

    return scope === "full"
      ? importConceptBoardFullZip(zip, mode, report)
      : importConceptBoardPageZip(zip, manifest, sourceName, mode, report);
  };

  const readConceptBoardResponseBlob = async (
    response,
    recommendedMaxBytes,
    warningBytes = getConceptBoardLinkWarningBytes(),
    onProgress = null
  ) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    const declaredSizeHeader = response.headers?.get?.("content-length");
    const declaredSize = declaredSizeHeader == null ? Number.NaN : Number(declaredSizeHeader);
    const recommendedBytes = Number(recommendedMaxBytes);
    let largeDownloadApproved = false;

    if (Number.isFinite(declaredSize)) {
      const aboveRecommendation = Number.isFinite(recommendedBytes) && declaredSize > recommendedBytes;
      if (aboveRecommendation || declaredSize > warningBytes) {
        const proceed = await askConceptBoardConfirm(
          `Download this ${formatArtifactBytes(declaredSize)} Concept Board backup?`,
          {
            title: "Large backup import",
            detail: aboveRecommendation
              ? `This is larger than the browser's estimated comfortable one-pass range of ${formatArtifactBytes(recommendedBytes)}. Concept Board will still try to download and restore the complete ZIP.`
              : "The ZIP will be held in browser memory while it is checked before loading.",
            confirmLabel: "Download backup"
          }
        );
        if (!proceed) throw new Error("Import cancelled.");
        largeDownloadApproved = true;
      }
    }

    report({ message: "Downloading ZIP backup...", percent: 0 });
    if (!response.body || typeof response.body.getReader !== "function") {
      const blob = await response.blob();
      if (!largeDownloadApproved) {
        const aboveRecommendation = Number.isFinite(recommendedBytes) && blob.size > recommendedBytes;
        if (aboveRecommendation || blob.size > warningBytes) {
          const proceed = await askConceptBoardConfirm(
            `Continue with this ${formatArtifactBytes(blob.size)} downloaded backup?`,
            {
              title: "Large backup import",
              detail: "Concept Board will still try to restore the complete ZIP. Large files can use substantial browser memory.",
              confirmLabel: "Continue restoring"
            }
          );
          if (!proceed) throw new Error("Import cancelled.");
        }
      }
      report({ message: "Download complete. Checking ZIP...", percent: 100 });
      return blob;
    }

    const reader = response.body.getReader();
    const chunks = [];
    let total = 0;
    let crossedWarning = largeDownloadApproved;
    let lastProgressReportAt = 0;
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        total += value.byteLength;

        const aboveRecommendation = Number.isFinite(recommendedBytes) && total > recommendedBytes;
        if (!crossedWarning && (aboveRecommendation || total > warningBytes)) {
          crossedWarning = true;
          const proceed = await askConceptBoardConfirm(
            "Continue downloading this large Concept Board backup?",
            {
              title: "Large backup import",
              detail: `${formatArtifactBytes(total)} has been received so far. Concept Board will still try to restore the full ZIP, which may use substantial browser memory.`,
              confirmLabel: "Continue downloading"
            }
          );
          if (!proceed) {
            try { await reader.cancel(); } catch {}
            throw new Error("Import cancelled.");
          }
        }

        chunks.push(value);
        const now = Date.now();
        if (now - lastProgressReportAt >= 100 || (Number.isFinite(declaredSize) && total >= declaredSize)) {
          lastProgressReportAt = now;
          report({
            message: `Downloading backup · ${formatArtifactBytes(total)} received`,
            percent: Number.isFinite(declaredSize) && declaredSize > 0
              ? (total / declaredSize) * 100
              : null
          });
        }
      }
    } finally {
      try { reader.releaseLock(); } catch {}
    }
    report({ message: "Download complete. Checking ZIP...", percent: 100 });
    return new Blob(chunks, { type: response.headers?.get?.("content-type") || "application/zip" });
  };

  const formatConceptBoardUploadError = (error, expiryMode) => {
    const code = String(error || "").trim();
    if (code === "file_too_big" || code === "over_daily_allowance") {
      return expiryMode === "24h"
        ? "The upload service could not accept this backup size right now. Use Download ZIP to keep the complete backup locally, or create separate page links."
        : "The permanent link service could not accept this backup size. Try the 24 Hours link, or use Download ZIP to keep the complete backup locally.";
    }
    return code ? `Upload failed: ${code.replaceAll("_", " ")}` : "The backup could not be uploaded.";
  };

  const createConceptBoardBackupLink = async (
    scope = "page",
    expiryMode = "24h",
    onProgress = null
  ) => {
    if (typeof upload !== "function") {
      throw new Error("The upload plugin is unavailable. Download the ZIP locally instead.");
    }
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };

    const normalizedScope = scope === "full" ? "full" : "page";
    const normalizedExpiry = expiryMode === "permanent" ? "permanent" : "24h";
    const zipBlob = await buildConceptBoardBackupZip(
      normalizedScope,
      activeGalleryName,
      report
    );
    // The live upload service decides its real quota. Large local exports remain available.
    if (zipBlob.size > getConceptBoardLinkWarningBytes()) {
      const proceed = await askConceptBoardConfirm(
        `Upload this ${formatArtifactBytes(zipBlob.size)} ZIP now?`,
        {
          title: "Large backup link",
          detail: "Large link uploads can temporarily use substantial browser memory. The ZIP itself remains unchanged, and local Download ZIP remains available if the service cannot accept it.",
          confirmLabel: "Upload"
        }
      );
      if (!proceed) throw new Error("Link creation cancelled.");
    }
    const fileName = getConceptBoardBackupFileName(normalizedScope, activeGalleryName);
    const zipFile = typeof File === "function"
      ? new File([zipBlob], fileName, { type: "application/zip" })
      : new Blob([zipBlob], { type: "application/zip" });
    const options = normalizedExpiry === "24h"
      ? { expires: Date.now() + CONCEPT_BOARD_LINK_EXPIRY_MS }
      : {};

    report({ message: `Uploading ${formatArtifactBytes(zipFile.size)} ZIP backup...`, percent: null });
    const result = await upload(zipFile, options);
    if (result?.error) throw new Error(formatConceptBoardUploadError(result.error, normalizedExpiry));

    const url = String(result?.url || "");
    if (!/^https?:\/\//i.test(url)) {
      throw new Error("The upload service did not return a valid backup link.");
    }

    // MIME is the source of truth, but a .zip URL is also clearer and safer for users.
    if (!/\.zip(?:$|[?#])/i.test(url)) {
      try {
        if (result?.deletionUrl) await fetch(String(result.deletionUrl));
      } catch {}
      throw new Error("The upload service did not preserve the ZIP file type.");
    }

    report({ message: "Backup link created.", percent: 100, state: "done" });
    return {
      url,
      size: Number(result?.size) || zipFile.size,
      scope: normalizedScope,
      expiryMode: normalizedExpiry
    };
  };

  const importConceptBoardBackupLink = async (
    rawUrl,
    expectedScope = "auto",
    onProgress = null
  ) => {
    const report = options => {
      if (typeof onProgress === "function") onProgress(options);
    };
    const url = String(rawUrl || "").trim();
    if (!/^https?:\/\//i.test(url)) throw new Error("Enter a valid http or https ZIP backup link.");

    report({ message: "Connecting to backup link...", percent: null });
    const response = await superFetch(url);
    if (!response?.ok) throw new Error(`Backup link request failed (HTTP ${response?.status || "error"}).`);

    const limits = getConceptBoardLinkImportLimits();
    const zipBlob = await readConceptBoardResponseBlob(
      response,
      limits.maxCompressedBytes,
      limits.warningCompressedBytes,
      report
    );
    return importConceptBoardBackupZip(
      zipBlob,
      url,
      { ...limits, skipCompressedWarning: true },
      expectedScope,
      report
    );
  };

  const copyConceptBoardText = async text => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      document.body.appendChild(textarea);
      textarea.select();
      const copied = document.execCommand("copy");
      textarea.remove();
      return copied;
    }
  };

  function openConceptBoardDirectLinkModal(initialScope = "page", expiryMode = "24h") {
    const selectedScope = initialScope === "full" ? "full" : "page";
    const selectedExpiry = expiryMode === "permanent" ? "permanent" : "24h";
    const expiryLabel = selectedExpiry === "24h" ? "24 Hours" : "Permanent";
    const scopeTitle = selectedScope === "full" ? `Save Backup · ${expiryLabel}` : `Save Page · ${expiryLabel}`;
    const scopeDetail = selectedScope === "full"
      ? `${getGalleryNames().length} page${getGalleryNames().length === 1 ? "" : "s"} · ZIP backup`
      : `${activeGalleryName} · ZIP page backup`;

    const overlay = $("div", {
      className: "localMediaGallery-modal-overlay",
      style: "display:flex;inset:0;position:fixed;background:rgba(0,0,0,.78);align-items:center;justify-content:center;z-index:10080;padding:12px;box-sizing:border-box;"
    });
    const modal = $("div", {
      className: "localMediaGallery-modal-shell",
      style: "width:min(430px,96vw);background:var(--background-color);color:var(--text-color);"
    });
    const header = $("div", { className: "localMediaGallery-modal-header" });
    header.append(
      $("div", {},
        $("div", { textContent: scopeTitle, style: "font-size:16px;font-weight:600;" }),
        $("div", { textContent: scopeDetail, style: "font-size:12px;opacity:.68;margin-top:2px;" })
      ),
      $("button", {
        innerHTML: "×",
        title: "Close",
        style: "border:none;background:none;color:inherit;font-size:24px;cursor:pointer;padding:2px 6px;",
        onclick: () => overlay.remove()
      })
    );

    const body = $("div", { style: "padding:14px;display:flex;flex-direction:column;gap:9px;" });
    if (selectedExpiry === "24h") {
      body.appendChild($("div", {
        textContent: "High-capacity link · much higher upload size and daily allowance.",
        style: "font-size:11px;line-height:1.45;opacity:.72;"
      }));
    }

    const status = $("div", {
      style: "display:block;font-size:12px;line-height:1.4;padding:9px 10px;border-radius:8px;background:var(--box-color);"
    });
    setConceptBoardInlineProgress(status, {
      message: "Packaging and uploading the ZIP backup...",
      state: "working"
    });
    const resultRow = $("div", { style: "display:none;grid-template-columns:minmax(0,1fr) auto;gap:8px;" });
    const resultInput = $("input", {
      readOnly: true,
      style: "min-width:0;padding:10px 11px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);"
    });
    const copyButton = $("button", {
      textContent: "Copy",
      style: "padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;font-weight:600;",
      onclick: async () => {
        if (!resultInput.value) return;
        const copied = await copyConceptBoardText(resultInput.value);
        copyButton.textContent = copied ? "Copied" : "Copy failed";
        setTimeout(() => { copyButton.textContent = "Copy"; }, 1200);
      }
    });
    resultRow.append(resultInput, copyButton);
    body.append(status, resultRow);

    const footer = $("div", { className: "localMediaGallery-modal-footer" });
    footer.appendChild($("button", {
      textContent: "Close",
      style: "min-height:38px;padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;",
      onclick: () => overlay.remove()
    }));

    modal.append(header, body, footer);
    overlay.appendChild(modal);
    overlay.onclick = event => { if (event.target === overlay) overlay.remove(); };
    document.body.appendChild(overlay);

    setTimeout(async () => {
      try {
        const result = await createConceptBoardBackupLink(
          selectedScope,
          selectedExpiry,
          progress => setConceptBoardInlineProgress(status, progress)
        );
        resultInput.value = result.url;
        resultRow.style.display = "grid";
        setConceptBoardInlineProgress(status, {
          message: `${selectedScope === "full" ? "Backup" : "Page"} link created · ${formatArtifactBytes(result.size)} · ${expiryLabel}`,
          percent: 100,
          state: "done"
        });
      } catch (error) {
        setConceptBoardInlineProgress(status, {
          message: formatConceptBoardTaskError(error, "create this backup link"),
          state: "error"
        });
      }
    }, 0);
  }

  function openConceptBoardImportLinkModal(onImported = null, expectedScope = "auto") {
    const expected = expectedScope === "full" || expectedScope === "page" ? expectedScope : "auto";
    const title = expected === "full" ? "Load Backup from Link" : expected === "page" ? "Load into Current Page from Link" : "Import Backup Link";
    const subtitle = expected === "full"
      ? "Whole-board ZIP · choose Smart Merge or Replace"
      : expected === "page"
        ? `Current page: ${activeGalleryName} · choose Smart Merge or Replace`
        : "ZIP scope is detected automatically";
    const overlay = $("div", {
      className: "localMediaGallery-modal-overlay",
      style: "display:flex;inset:0;position:fixed;background:rgba(0,0,0,.78);align-items:center;justify-content:center;z-index:10080;padding:12px;box-sizing:border-box;"
    });
    const modal = $("div", { className: "localMediaGallery-modal-shell", style: "width:min(500px,96vw);background:var(--background-color);color:var(--text-color);" });
    const header = $("div", { className: "localMediaGallery-modal-header" });
    header.append(
      $("div", {},
        $("div", { textContent: title, style: "font-size:16px;font-weight:600;" }),
        $("div", { textContent: subtitle, style: "font-size:12px;opacity:.68;margin-top:2px;" })
      ),
      $("button", { innerHTML: "×", title: "Close", style: "border:none;background:none;color:inherit;font-size:24px;cursor:pointer;padding:2px 6px;", onclick: () => overlay.remove() })
    );
    const body = $("div", { style: "padding:14px;display:flex;flex-direction:column;gap:10px;" });
    const input = $("input", {
      type: "url",
      placeholder: "https://user.uploads.dev/file/....zip",
      autocomplete: "off",
      style: "width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);"
    });
    const hint = $("div", {
      textContent: "",
      style: "font-size:12px;line-height:1.45;opacity:.7;"
    });
    const status = $("div", { style: "display:none;font-size:12px;line-height:1.4;padding:9px 10px;border-radius:8px;background:var(--box-color);" });
    body.append(input, hint, status);
    const footer = $("div", { className: "localMediaGallery-modal-footer" });
    const cancelButton = $("button", { textContent: "Cancel", style: "min-height:38px;padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;", onclick: () => overlay.remove() });
    const importButton = $("button", {
      textContent: "Load Link",
      style: "min-height:38px;padding:0 15px;border:none;border-radius:8px;background:var(--localMediaGallerySpecialColor);color:white;cursor:pointer;font-weight:600;",
      onclick: async () => {
        importButton.disabled = true;
        importButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin fa-fw"></i> Loading...';
        status.style.display = "block";
        setConceptBoardInlineProgress(status, {
          message: "Downloading and checking the ZIP backup...",
          state: "working"
        });
        try {
          const result = await importConceptBoardBackupLink(
            input.value,
            expected,
            progress => setConceptBoardInlineProgress(status, progress)
          );
          if (!result) {
            setConceptBoardInlineProgress(status, { message: "Import cancelled.", state: "done" });
            return;
          }
          if (typeof onImported === "function") await onImported(result);
          setConceptBoardInlineProgress(status, {
            message: result.scope === "full"
              ? `${result.mode === "replace" ? "Restored" : "Merged"} ${result.imported} item reference${result.imported === 1 ? "" : "s"} across ${result.pageCount} page(s)${result.skipped ? ` · ${result.skipped} existing skipped` : ""}.`
              : `${result.mode === "replace" ? "Replaced" : "Merged into"} "${result.targetGallery}" with ${result.imported} item${result.imported === 1 ? "" : "s"}${result.skipped ? ` · ${result.skipped} existing skipped` : ""}.`,
            percent: 100,
            state: "done"
          });
          setTimeout(() => overlay.remove(), 800);
        } catch (error) {
          setConceptBoardInlineProgress(status, {
            message: formatConceptBoardTaskError(error, "restore this linked backup"),
            state: "error"
          });
        } finally {
          importButton.disabled = false;
          importButton.textContent = "Load Link";
        }
      }
    });
    footer.append(cancelButton, importButton);
    modal.append(header, body, footer);
    overlay.appendChild(modal);
    overlay.onclick = event => { if (event.target === overlay) overlay.remove(); };
    document.body.appendChild(overlay);
    setTimeout(() => input.focus(), 0);
  }

  /* ───────────────────────────── local ZIP download/import */
  async function saveBackup() {
    const task = createConceptBoardTaskProgress({
      title: "Save Backup",
      message: "Preparing the whole Concept Board..."
    });
    try {
      const zipBlob = await buildConceptBoardBackupZip(
        "full",
        activeGalleryName,
        progress => task.update(progress)
      );
      task.update({ message: `Starting ${formatArtifactBytes(zipBlob.size)} download...`, percent: 100 });
      triggerDownload(zipBlob, getConceptBoardBackupFileName("full"));
      await nextConceptBoardPaint();
    } catch (error) {
      throw new Error(formatConceptBoardTaskError(error, "create this whole-board backup"));
    } finally {
      task.close();
    }
  }

  async function exportPage() {
    const galleryName = activeGalleryName;
    const task = createConceptBoardTaskProgress({
      title: "Save Page",
      message: `Preparing “${galleryName}”...`
    });
    try {
      const zipBlob = await buildConceptBoardBackupZip(
        "page",
        galleryName,
        progress => task.update(progress)
      );
      task.update({ message: `Starting ${formatArtifactBytes(zipBlob.size)} download...`, percent: 100 });
      triggerDownload(zipBlob, getConceptBoardBackupFileName("page", galleryName));
      await nextConceptBoardPaint();
    } catch (error) {
      throw new Error(formatConceptBoardTaskError(error, "create this page backup"));
    } finally {
      task.close();
    }
  }

  async function importPage(expectedScope = "auto") {
    return new Promise(resolve => {
      const input = $("input", { type: "file", accept: ".zip,application/zip", style: "display:none" });
      let settled = false;
      const onWindowFocus = () => {
        setTimeout(() => {
          if (!settled && !input.files?.length) finish(null);
        }, 300);
      };
      const finish = result => {
        if (settled) return;
        settled = true;
        window.removeEventListener("focus", onWindowFocus);
        input.remove();
        resolve(result || null);
      };
      input.oncancel = () => finish(null);
      input.onchange = async () => {
        let result = null;
        let task = null;
        let importError = null;
        try {
          const file = input.files[0];
          if (!file) return finish(null);
          task = createConceptBoardTaskProgress({
            title: "Load Concept Board Backup",
            message: `Checking ${formatArtifactBytes(file.size)} ZIP...`
          });
          result = await importConceptBoardBackupZip(
            file,
            file.name,
            getConceptBoardLocalImportLimits(),
            expectedScope,
            progress => task.update(progress)
          );
          task.close();
          task = null;
          if (result) {
            await showConceptBoardNotice(
              result.scope === "full"
                ? `${result.mode === "replace" ? "Restored" : "Merged"} ${result.imported} item reference${result.imported === 1 ? "" : "s"} across ${result.pageCount} page(s)${result.skipped ? ` · ${result.skipped} existing skipped` : ""}.`
                : `${result.mode === "replace" ? "Replaced" : "Merged into"} “${result.targetGallery}” with ${result.imported} item${result.imported === 1 ? "" : "s"}${result.skipped ? ` · ${result.skipped} existing skipped` : ""}.`,
              { title: result.mode === "replace" ? "Restore complete" : "Merge complete" }
            );
          }
        } catch (error) {
          importError = formatConceptBoardTaskError(error, "restore this backup");
        } finally {
          task?.close();
        }
        if (importError) {
          await showConceptBoardNotice(importError, { title: "Import failed" });
        }
        finish(result);
      };
      document.body.appendChild(input);
      window.addEventListener("focus", onWindowFocus, { once: true });
      input.click();
    });
  }

  const triggerDownload = (blob, filename) => {
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = filename;
    anchor.style.display = "none";
    document.body.appendChild(anchor);
    anchor.click();

    setTimeout(() => {
      anchor.remove();
      URL.revokeObjectURL(url);
    }, 10000);
  };

  async function add(blob, opts={}) {
    let folder = opts.folder ?? activeGalleryName
    let info = opts.info ?? null;
    info = cleanInfo(info);
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    const {w, h} = blob ? await dims(blob) : {w: 150, h: 150}; // Handle null blobs for text entries
    await blobs.set(id, {blob, info});
    await kv[pre+folder].set(id, {id, date:Date.now(), rating:0, w, h});
    const names=getGalleryNames();
    if(!names.includes(folder)) saveGalleryNames([...names, folder]);
    return id;
  }

  async function clearAllData(){
    const response = await askConceptBoardText(
      'Type "yes" to permanently delete all Concept Board data.',
      {
        title: "Clear all Concept Board data",
        detail: "This removes every page and stored item from this browser. This cannot be undone.",
        placeholder: "yes",
        confirmLabel: "Delete everything",
        validate: value => String(value).trim().toLowerCase() === "yes" || 'Type "yes" exactly to continue.'
      }
    );
    if (!response) return;
    for(const n of getGalleryNames()) await kv[pre+n].clear();
    await blobs.clear();
    saveGalleryNames([defaultGallery]);
    activeGalleryName = defaultGallery;
    localStorage.removeItem(pre+"activeGalleryName");
    localStorage.removeItem(pre+"seenPersistenceWarning");
    localStorage.removeItem(broadcastKey);
  }

  // --- Advanced Data Rescue ---
  async function runDataRescue () {
    const fixedName = "conceptBoard";
    const preOld = `localMediaGallery_${fixedName}.`;
    const preNew = `localMediaGallery_${btoa(fixedName)}.`;
    const pre = localStorage.getItem(preOld + "names") ? preOld : preNew;
    const masterPre = pre;
    const masterGalleriesKey = masterPre + "names";
    const masterActiveKey = masterPre + "activeGalleryName";
    const rescuePageName = "rescue_data";
    let masterBlobs;
    try { masterBlobs = kv[masterPre + "blobs"]; } catch { masterBlobs = null; }
  
    const rescueConfirmed = await askConceptBoardConfirm(
      "Scan this browser for lost Concept Board items?",
      {
        title: "Data Rescue",
        detail: "Recovered items return to their original pages when possible. Unclear items go to rescue_data. Existing data is kept.",
        confirmLabel: "Start scan"
      }
    );
    if (!rescueConfirmed) return;
  
    const overlay = document.createElement("div");
    overlay.style = "inset:0;position:fixed;background:rgba(0,0,0,0.86);color:#fff;font:16px system-ui,sans-serif;display:flex;align-items:center;justify-content:center;z-index:2147483647;padding:20px;text-align:center;";
    overlay.innerHTML = "⏳ Performing full recovery... Please wait, do not close this tab.";
    document.body.appendChild(overlay);
  
    let migrationOccurred = false;
    let newMasterNames;
    try {
      newMasterNames = (typeof getGalleryNames === "function") ? getGalleryNames() : JSON.parse(localStorage.getItem(masterGalleriesKey) || '["Default"]');
    } catch {
      newMasterNames = JSON.parse(localStorage.getItem(masterGalleriesKey) || '["Default"]');
    }
  
    const allKnownIDs = new Set();
    const allFoundIDs = new Set();
    let rescuedActivePage = null;
  
    try {
      // PHASE 0 — Index current board
      for (const page of newMasterNames) {
        try {
          const store = kv[masterPre + page];
          if (!store) continue;
          const items = await store.values();
          for (const it of items) if (it && it.id) allKnownIDs.add(it.id);
        } catch {}
      }
  
      // PHASE A — Find ghost blobs in own store
      if (masterBlobs && typeof masterBlobs.keys === "function") {
        const blobKeys = await masterBlobs.keys();
        for (const id of blobKeys) {
          if (allKnownIDs.has(id) || allFoundIDs.has(id)) continue;
          if (!newMasterNames.includes(rescuePageName)) newMasterNames.push(rescuePageName);
          await kv[masterPre + rescuePageName].set(id, { id, date: Date.now(), rating:0, w:150, h:150 });
          allFoundIDs.add(id);
          migrationOccurred = true;
        }
      }
  
      // Gather localStorage keys
      const allLSKeys = Object.keys(localStorage || {});
      // PHASE B — Detect and scan related gallery prefixes
      const potentialPrefixes = new Set();
      for (const k of allLSKeys) {
        if (k.endsWith('.names') || k.endsWith('.activeGalleryName') || k.endsWith('.gallery') || k.includes('localMediaGallery_')) {
          const prefix = k.replace(/(\.names|\.activeGalleryName|\.gallery)$/, '.');
          potentialPrefixes.add(prefix);
        }
      }
  
      for (const orphanPre of potentialPrefixes) {
        if (orphanPre === masterPre) continue;
        try {
          const orphanActivePage = localStorage.getItem(orphanPre + "activeGalleryName");
          if (orphanActivePage && !rescuedActivePage) rescuedActivePage = orphanActivePage;
          const orphanNamesRaw = localStorage.getItem(orphanPre + "names");
          if (!orphanNamesRaw) continue;
          let orphanedNames;
          try { orphanedNames = JSON.parse(orphanNamesRaw); } catch { orphanedNames = []; }
          for (const galName of orphanedNames.length ? orphanedNames : ["Default"]) {
            const orphanStore = kv[orphanPre + galName];
            if (!orphanStore) continue;
            const items = await orphanStore.values();
            for (const item of items) {
              if (!item || !item.id) continue;
              if (allKnownIDs.has(item.id) || allFoundIDs.has(item.id)) continue;
              let accepted = false;
              if (typeof item === "object" && ("id" in item && ("date" in item || "uploaded" in item || "info" in item))) accepted = true;
              try {
                const orphanBlobs = kv[orphanPre + "blobs"];
                const blobRecord = orphanBlobs ? await orphanBlobs.get(item.id) : null;
                if (!accepted && blobRecord && (blobRecord.blob !== undefined || blobRecord.data !== undefined || blobRecord.info !== undefined)) accepted = true;
                if (blobRecord && masterBlobs && !(await masterBlobs.get(item.id))) await masterBlobs.set(item.id, blobRecord);
              } catch {}
              if (!accepted) {
                const asStr = JSON.stringify(item || "");
                if (asStr.includes("data:image/") || asStr.match(/https?:\/\/.*\.(png|jpg|jpeg|webp|gif|mp4|webm)/i) || asStr.length > 1500) accepted = true;
              }
              if (!accepted) continue;
              await kv[masterPre + galName].set(item.id, item);
              allFoundIDs.add(item.id);
              migrationOccurred = true;
              if (!newMasterNames.includes(galName)) newMasterNames.push(galName);
            }
          }
        } catch {}
      }
  
      // PHASE C — Scan all kv-plugin stores
      const allKVKeys = allLSKeys.filter(k => k.startsWith('kv-plugin:'));
      const allStoreNames = [...new Set(allKVKeys.map(k => k.split(':').slice(2).join(':')))];
      for (const storeName of allStoreNames) {
        if (storeName.startsWith(masterPre)) continue;
        try {
          const store = kv[storeName];
          if (!store) continue;
          const entries = await store.entries();
          for (const [id, value] of entries) {
            if (allKnownIDs.has(id) || allFoundIDs.has(id)) continue;
            let isBlobLike = false;
            if (value && typeof value === "object") {
              if ("blob" in value || "info" in value || "data" in value || "file" in value || "content" in value) isBlobLike = true;
            } else if (typeof value === "string" && (value.includes("data:image/") || value.match(/^https?:\/\/.*\.(png|jpg|jpeg|webp|gif|mp4|webm)/i) || value.length > 1500)) {
              isBlobLike = true;
            }
            if (!isBlobLike) continue;
            if (masterBlobs && !(await masterBlobs.get(id))) await masterBlobs.set(id, { blob:value, info:{ originStore:storeName } });
            await kv[masterPre + rescuePageName].set(id, { id, date:Date.now(), rating:0, w:150, h:150 });
            allFoundIDs.add(id);
            migrationOccurred = true;
            if (!newMasterNames.includes(rescuePageName)) newMasterNames.push(rescuePageName);
          }
        } catch {}
      }
  
      // PHASE D — Scan raw localStorage values
      for (const key of allLSKeys) {
        try {
          if (key.startsWith('kv-plugin:')) continue;
          const v = localStorage.getItem(key);
          if (!v) continue;
          const looksLikeMedia = v.includes("data:image/") || v.includes("data:video/") || v.match(/https?:\/\/[^"]+\.(png|jpg|jpeg|webp|gif|mp4|webm)/i) || v.length > 1500;
          if (!looksLikeMedia) continue;
          const id = `ls:${key}:${(''+v).slice(0,64).replace(/\s+/g,'_')}`.slice(0,200);
          if (allKnownIDs.has(id) || allFoundIDs.has(id)) continue;
          if (masterBlobs && !(await masterBlobs.get(id))) await masterBlobs.set(id, { blob:v, info:{ originLocalStorageKey:key } });
          await kv[masterPre + rescuePageName].set(id, { id, date:Date.now(), rating:0, w:150, h:150 });
          allFoundIDs.add(id);
          migrationOccurred = true;
          if (!newMasterNames.includes(rescuePageName)) newMasterNames.push(rescuePageName);
        } catch {}
      }
  
      // FINALIZE — restore active page
      if (rescuedActivePage && newMasterNames.includes(rescuedActivePage)) {
        try { localStorage.setItem(masterActiveKey, rescuedActivePage); } catch {}
      }
  
      if (migrationOccurred) {
        try {
          if (typeof saveGalleryNames === "function") saveGalleryNames([...new Set(newMasterNames)]);
          else localStorage.setItem(masterGalleriesKey, JSON.stringify([...new Set(newMasterNames)]));
        } catch {}
        overlay.remove?.();
        await showConceptBoardNotice(
          "Recovered items were added to your Concept Board. The board will now reload.",
          { title: "Data recovery complete", label: "Reload" }
        );
        window.location.reload();
      } else {
        overlay.remove?.();
        await showConceptBoardNotice("No additional recoverable data was found.", { title: "Data Rescue" });
      }
  
    } catch (e) {
      overlay.remove?.();
      console.error("Data rescue failed:", e);
      await showConceptBoardNotice(e && e.message ? e.message : String(e), { title: "Data Rescue failed" });
    }
  }
  // --- end Advanced Data Rescue v2 ---





// show fullscreen gallery
  async function show() {
    const isMobile = window.matchMedia("(pointer: coarse)").matches && window.innerWidth < 500;
    /* --- NEW: Selection State --- */
    let selectedIds = new Set();
    let lastSelectedId = null;
    let selectAllBtn = null;
    let itemActionMenu = null;
    let itemActionAnchor = null;
    let closeItemActionMenu = () => {};
    const onItemActionOutsidePointer = e => {
      if (!itemActionMenu) return;
      if (itemActionMenu.contains(e.target) || itemActionAnchor?.contains(e.target)) return;
      closeItemActionMenu();
    };

    /* --- NEW: Search State & Logic --- */
    let searchQuery = "";
    let searchBarEl = null; 
    // RAM cache for text content so search is instant
    let searchIndex = Object.create(null);
    // Track what is currently visible for accurate Shift+Select ranges
    let displayedItems = [];
    let galleryLoadSequence = 0;
    let activeGalleryLoadTask = null;
    

    const parseSearchQuery = (q) => {
      const regex = /(-?"[^"]+"|-?\S+)/g; 
      const tokens = [];
      let m;
      while ((m = regex.exec(q)) !== null) {
        let term = m[1];
        let isNeg = term.startsWith("-");
        if (isNeg) term = term.slice(1);
        if (term.startsWith('"') && term.endsWith('"') && term.length > 1) {
          term = term.slice(1, -1);
        }
        tokens.push({ term: term.toLowerCase(), isNeg });
      }
      return tokens;
    };

    // Background process to load text data for search (Read-Only)
    const buildSearchIndex = async () => {
      for(const m of mediaArr) {
        if(searchIndex[m.id]) continue;
        const rec = await blobs.get(m.id);
        const info = rec?.info || {};
        // Combine ID, Keys, and Values into one searchable string
        const str = [m.id, ...Object.keys(info), ...Object.values(info)].join(" ").toLowerCase();
        searchIndex[m.id] = str;
      }
    };

    const matchesSearch = (item) => {
      if (!searchQuery.trim()) return true;
      const tokens = parseSearchQuery(searchQuery);
      // Use the index if available, otherwise fall back to ID
      const text = (searchIndex[item.id] || item.id).toLowerCase();
      
      for (const { term, isNeg } of tokens) {
        const found = text.includes(term);
        if (isNeg && found) return false; // Found a "-" term
        if (!isNeg && !found) return false; // Missing a required term
      }
      return true;
    };

    const getGridItemById = id => {
      const value = String(id);
      if (globalThis.CSS?.escape) {
        return grid.querySelector(`[data-id="${CSS.escape(value)}"]`);
      }
      return Array.from(grid.querySelectorAll("[data-id]")).find(el => el.dataset.id === value) || null;
    };

    // --- NEW: Helper to update visuals without re-rendering the whole grid ---
    const updateItemVisuals = (id) => {
      const el = getGridItemById(id);
      if (!el) return;
      
      const isSel = selectedIds.has(id);
      // Calculate size based on current view mode
      const btnSize =
        (viewMode === "list" || viewMode === "smallest") ? 24 :
        (viewMode === "details" || viewMode === "smaller") ? 28 :
        32;
      const isRowView = viewMode === "list" || viewMode === "details";

      // 1. Update item styles. Row views stay aligned like a normal file list.
      el.style.boxShadow = isSel ? "0 0 0 3px var(--localMediaGallerySpecialColor)" : "";
      el.style.transform = isSel && !isRowView ? "scale(0.96)" : "";
      el.style.transition = "all 0.1s";

      // 2. Update the Select Button (Icon & Color)
      const btn = el.querySelector('button[title="Select"]');
      if (btn) {
        btn.innerHTML = isSel 
          ? `<i class="fa-solid fa-check" style="font-size:${btnSize * 0.5}px;"></i>` 
          : `<i class="fa-regular fa-square-full" style="font-size:${btnSize * 0.5}px;"></i>`;
        
        btn.style.backgroundColor = isSel ? 'var(--localMediaGallerySpecialColor)' : 'rgba(0,0,0,0.8)';
        
        // Handle visibility logic manually since we aren't re-rendering
        btn.style.opacity = isSel ? '1' : '';
        btn.style.pointerEvents = isSel ? 'auto' : '';
      }
    };

    /* --- ADD THIS: dynamic select all UI logic --- */
    const updateSelectModeUI = () => {
      if (!selectAllBtn) return;
      if (selectedIds.size > 0) {
        selectAllBtn.style.display = "flex";
        // Check if everything currently visible is selected
        const allSelected = displayedItems.length > 0 && displayedItems.every(m => selectedIds.has(m.id));
        selectAllBtn.innerHTML = allSelected 
          ? `<i class="fa-solid fa-square-minus" style="margin-right:6px;"></i> Deselect All` 
          : `<i class="fa-solid fa-check-double" style="margin-right:6px;"></i> Select All`;
      } else {
        selectAllBtn.style.display = "none";
      }
    };
    
    // Helper to run actions on one item OR all selected items
    const runBatchAction = async (targetItem, actionType) => {
      const targets = (selectedIds.has(targetItem.id)) 
        ? mediaArr.filter(m => selectedIds.has(m.id)) 
        : [targetItem];

      if (actionType === "delete") {
        const confirmed = await askConceptBoardConfirm(
          `Delete ${targets.length} item${targets.length === 1 ? "" : "s"} from “${activeGalleryName}”?`,
          {
            title: targets.length === 1 ? "Delete item" : "Delete selected items",
            detail: "The stored file is removed only when no other page references it.",
            confirmLabel: "Delete",
            danger: true
          }
        );
        if (!confirmed) return;
        // Visual cleanup first
        targets.forEach(t => {
          const el = getGridItemById(t.id);
          if(el) el.style.opacity = 0.2;
        });
        
        for (const t of targets) {
          await kv[pre + activeGalleryName].delete(t.id);
          const isReferenced = await isBlobReferenced(t.id, [activeGalleryName]);
          if (!isReferenced) await blobs.delete(t.id);
        }
        selectedIds.clear();
        updateSelectModeUI();
        await loadGallery(); // Reload to refresh grid
      } 
      else if (actionType === "move") {
         // Re-use the move logic UI, but handle batching inside the OK button
         // Since the original move logic is complex (UI creation), we will hack it:
         // We trigger the move UI for the *first* item, but override the execution.
         // (Simpler approach below in the controls section)
      }
      else if (actionType === "rate") {
        const v = await askConceptBoardText(
          `Set any numeric rating for ${targets.length} item${targets.length === 1 ? "" : "s"}.`,
          {
            title: "Edit rating",
            detail: "Quick Rating uses 0–5 stars. Advanced rating can be any finite number.",
            value: Number.isFinite(Number(targetItem.rating)) ? targetItem.rating : 0,
            confirmLabel: "Apply",
            validate: value => Number.isFinite(Number(value)) || "Enter a valid number."
          }
        );
        if (v == null) return;
        const r = Number(v);
        for (const t of targets) {
          t.rating = r;
          await kv[pre + activeGalleryName].set(t.id, t);
        }
        render();
      }
      else if (actionType === "download") {
        if (targets.length === 1) {
          const only = targets[0];
          const rec = await blobs.get(only.id);
          const b = getMediaBlob(rec);
          if (b && isFuraiArtifactInfo(rec?.info || {})) {
            openFuraiArtifactViewer(only, rec);
            return;
          }
        }

        if (targets.length > 5) {
          const confirmed = await askConceptBoardConfirm(
            `Download ${targets.length} files individually?`,
            {
              title: "Download selected items",
              detail: "Your browser may ask for permission to allow multiple downloads.",
              confirmLabel: "Download"
            }
          );
          if (!confirmed) return;
        }
        const task = createConceptBoardTaskProgress({
          title: targets.length > 1 ? "Download Selected Items" : "Download Item",
          message: "Preparing download..."
        });
        let skippedFuraiArtifacts = 0;
        try {
          let processed = 0;
          for (const m of targets) {
            const rec = await blobs.get(m.id);
            const b = getMediaBlob(rec);
            const info = rec?.info || {};

            if (b && isFuraiArtifactExportGateRequired(info)) {
              // Protected or legacy FurAI artifacts need their Safe/Full gate.
              skippedFuraiArtifacts++;
            } else if (b) {
              downloadBoardItemBlob(m, b, info);
              await new Promise(r => setTimeout(r, 200));
            }

            processed++;
            task.update({
              message: `Starting downloads ${processed} of ${targets.length}...`,
              percent: (processed / Math.max(1, targets.length)) * 100
            });
          }
        } finally {
          task.close();
        }

        if (skippedFuraiArtifacts) {
          await showConceptBoardNotice(
            `${skippedFuraiArtifacts} FurAI artifact${skippedFuraiArtifacts === 1 ? " was" : "s were"} skipped. Open each one to choose Safe Copy or Full Copy.`,
            { title: "FurAI artifacts need individual export" }
          );
        }
      }
    };
    const toolbarDropdowns = [];
    const closeToolbarDropdowns = except => {
      toolbarDropdowns.forEach(dropdown => {
        if (dropdown !== except) dropdown.style.display = "none";
      });
    };
    const toggleToolbarDropdown = dropdown => {
      const shouldOpen = dropdown.style.display === "none";
      closeToolbarDropdowns(dropdown);
      dropdown.style.display = shouldOpen ? "block" : "none";
    };
    const onToolbarOutsidePointer = event => {
      if (!event.target.closest?.(".localMediaGallery-dropdown-host")) closeToolbarDropdowns();
    };

    document.getElementById("localMediaGallery_root")?.remove();
    const prevHtmlOv = document.documentElement.style.overflow;
    const prevBodyOv = document.body.style.overflow;
    document.documentElement.style.overflow = document.body.style.overflow = "hidden";

    const root=$("div",{id:"localMediaGallery_root", className:"localMediaGallery-root", style:"display:flex;position:fixed;inset:0;flex-direction:column;background:light-dark(#fff,#000);z-index:9999;"});
    document.body.appendChild(root);

    // close gallery on Esc (unless a lightbox is up)
    const closeGallery = () => {
      document.removeEventListener("keydown", onKeyGallery);
      document.documentElement.style.overflow = prevHtmlOv;
      document.body.style.overflow = prevBodyOv;
      window.removeEventListener("storage", onStorage);
      document.removeEventListener("pointerdown", onItemActionOutsidePointer, true);
      document.removeEventListener("pointerdown", onToolbarOutsidePointer, true);
      closeToolbarDropdowns();
      closeItemActionMenu();
      activeGalleryLoadTask?.close();
      activeGalleryLoadTask = null;
      // --- FIX #12: Disconnect the observer ---
      io?.disconnect();

      // --- FIX #5: Revoke all lingering blob URLs in the grid ---
      grid.querySelectorAll("img[src^='blob:'], video[src^='blob:']").forEach(el => {
        try { URL.revokeObjectURL(el.src); } catch (e) {}
      });
      // --- END FIXES ---
      root.remove();
    };
    
    const onKeyGallery = e => {
      if (conceptBoardDialogDepth > 0 || e.key !== "Escape") return;

      const openPanels = document.querySelectorAll(".localMediaGallery-modal-overlay");
      const topPanel = openPanels[openPanels.length - 1];
      if (topPanel) {
        const panelCloseButton = topPanel.querySelector('button[title="Close"]');
        if (panelCloseButton) {
          e.preventDefault();
          e.stopImmediatePropagation();
          panelCloseButton.click();
        }
        return;
      }

      if (itemActionMenu) {
        closeItemActionMenu();
        return;
      }
      if (!document.querySelector("[data-local-media-gallery-lightbox]")) closeGallery();
    };
    document.addEventListener("keydown", onKeyGallery);
    document.addEventListener("pointerdown", onItemActionOutsidePointer, true);
    document.addEventListener("pointerdown", onToolbarOutsidePointer, true);

    if(!localStorage[pre+"seenPersistenceWarning"]){
      root.appendChild(
        $("div",
          {style:"background:light-dark(rgb(255 226 151),rgb(110 76 0));padding:8px 12px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center;align-items:center;font-size:12px;line-height:1.45;border-bottom:1px solid rgba(128,128,128,.24);"},
          document.createTextNode(`This Concept Board is stored privately on your device only. Your browser may delete it if you clear your cache or if your device's storage is low - 𝗯𝗮𝗰𝗸𝘂𝗽 𝗿𝗲𝗴𝘂𝗹𝗮𝗿𝗹𝘆 via the menu! Note: Concept Board storage and backups are completely independent from your AI Furry Generator or FurAI accounts.`),
          $("button",{textContent:"Understood",style:"min-height:32px;padding:0 11px;border:1px solid rgba(128,128,128,.48);border-radius:8px;background:transparent;color:inherit;cursor:pointer;font-weight:600;",onclick:e=>{localStorage[pre+"seenPersistenceWarning"]=1;e.target.parentNode.remove();}})
        )
      );
    }

    const headerBarEl = root.appendChild($("div",{className:"localMediaGallery-toolbar"}));

    /* --- Search Bar UI --- */
    searchBarEl = $("div", {
      style: `
        top: 62px; left: 50%; transform: translateX(-50%); position: fixed;
        z-index: 2000000; display: none;
        width: min(360px, calc(100vw - 24px));
        min-height: 42px; padding: 0 12px;
        background: var(--box-color);
        border-radius: 12px;
        border: 1px solid rgba(128,128,128,.45);
        box-shadow: 0 12px 32px rgba(0,0,0,.24);
        align-items: center; gap: 9px;
        box-sizing: border-box;
      `
    });

    const searchIcon = $("i", { className: "fa-solid fa-magnifying-glass", style: "color: var(--text-color); opacity: 0.6; font-size: 13px;" });
    
    const searchInput = $("input", {
      type: "text",
      placeholder: "Search...",
      style: `
        background: transparent; border: none; outline: none;
        color: var(--text-color); font-size: 14px; flex: 1; min-width: 0;
      `
    });

    searchInput.oninput = (e) => {
      searchQuery = e.target.value;
      render();
    };

    const searchClose = $("button", {
      innerHTML: "✕",
      style: "background:none; border:none; color:var(--text-color); opacity: 0.6; cursor:pointer; font-size:13px; padding: 0 4px;",
      onclick: () => {
        searchQuery = "";
        searchInput.value = "";
        searchBarEl.style.display = "none";
        render();
      }
    });

    searchBarEl.append(searchIcon, searchInput, searchClose);
    root.appendChild(searchBarEl);
    
    const onStorage = e => {
      if (e.key === broadcastKey && e.newValue) {
        refreshFolderList();
        loadGallery();
      }
    };
    window.addEventListener("storage", onStorage);
    
    async function openAddItemPanel() {
      const overlay = $("div", { className:"localMediaGallery-modal-overlay", style: "display:flex;position:fixed;inset:0;background:rgba(0,0,0,0.8);align-items:center;justify-content:center;z-index:10001;" });
      const modal = $("div", { className:"localMediaGallery-modal-shell", style: "background:light-dark(#fff,#222);color:light-dark(#000,#fff);padding:18px;width:min(540px,94vw);display:flex;flex-direction:column;gap:14px;" });
      const titleEl = $("h3", { textContent: "Add New Item", style: "margin:0 0 2px;font-size:18px;font-weight:600;" });

      const titleInput = $("input", { className: "localMediaGallery-flat-field", placeholder: "Title", style: "min-height:40px;padding:8px 10px;width:100%;box-sizing:border-box;border-radius:8px;" });
      const descTextarea = $("textarea", { className: "localMediaGallery-flat-field", placeholder: "Description / Note", style: "padding:10px;width:100%;box-sizing:border-box;min-height:150px;resize:vertical;border-radius:8px;line-height:1.5;" });

      // --- Source Selection ---
      const sourceContainer = $("div", { className: "localMediaGallery-flat-panel", style: "padding:12px;border-radius:10px;" });
      const fileInput = $("input", { type: "file", style: "display:none;" });
      const urlInput = $("input", { className: "localMediaGallery-flat-field", placeholder: "Paste URL here", type: 'url', style: "min-height:40px;padding:8px 10px;width:100%;box-sizing:border-box;display:none;border-radius:8px;" });
      let selectedFile = null;
      const fileLabel = $("span", {textContent:"No file chosen",style:"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;opacity:.72;"});
      
      const fileRow = $("div", {style: "display:none; align-items:center; gap: 8px;"}, 
        $("button", { className: "localMediaGallery-flat-button", innerHTML: `<i class="fa fa-folder"></i> Choose File`, onclick: () => fileInput.click(), style: "min-height:38px;padding:0 12px;border-radius:8px;cursor:pointer;flex-shrink:0;" }),
        fileLabel
      );
      
      const sourceToggle = (type) => {
        fileRow.style.display = (type === 'file') ? 'flex' : 'none';
        urlInput.style.display = (type === 'url') ? 'block' : 'none';
        titleInput.placeholder = (type === 'note') ? "Title" : "Title (optional)";
        if(type !== 'file') { selectedFile = null; fileInput.value = ''; fileLabel.textContent="No file chosen"; }
        if(type !== 'url') { urlInput.value = ''; }
        updateAddButtonState();
      };
      
      const createRadio = (value, label, checked=false) => {
        const id = `radio-${value}-${Math.random()}`;
        const radio = $("input", { type:'radio', name:'sourceType', id, value, checked });
        radio.onchange = () => sourceToggle(value);
        return $("label", {htmlFor:id, style:"cursor:pointer;"}, radio, " "+label);
      };
      
      const radioGroup = $("div", {style:"display:flex;gap:12px;margin-bottom:10px;flex-wrap:wrap;"},
        createRadio('url', 'Import from URL', true), // 1st: URL (checked by default)
        createRadio('note', 'Note Only'),            // 2nd: Note
        createRadio('file', 'Upload File')           // 3rd: File
      );

      fileInput.onchange = () => {
        selectedFile = fileInput.files[0];
        fileLabel.textContent = selectedFile ? selectedFile.name : "No file chosen";
        updateAddButtonState();
      };

      sourceContainer.append(radioGroup, fileRow, urlInput);

      // --- Buttons ---
      const addBtn = $("button", { textContent: "Add Item", disabled: true, style:"min-height:40px;padding:0 16px;background:var(--localMediaGallerySpecialColor);color:white;border:none;border-radius:8px;cursor:pointer;font-weight:600;" });

      const updateAddButtonState = () => {
        const sourceType = modal.querySelector('input[name="sourceType"]:checked').value;
        let isValid = false;
        if (sourceType === 'note') {
          isValid = titleInput.value.trim() !== "" || descTextarea.value.trim() !== "";
        } else if (sourceType === 'file') {
          isValid = selectedFile !== null;
        } else if (sourceType === 'url') {
          isValid = urlInput.value.trim() !== "" && urlInput.checkValidity();
        }
        addBtn.disabled = !isValid;
        addBtn.style.opacity = addBtn.disabled ? 0.5 : 1;
      };
      
      titleInput.oninput = descTextarea.oninput = urlInput.oninput = updateAddButtonState;

      addBtn.onclick = async () => {
        const sourceType = modal.querySelector('input[name="sourceType"]:checked').value;
        addBtn.disabled = true;
        addBtn.textContent = "Adding...";
        try {
          const title = titleInput.value.trim();
          const desc = descTextarea.value.trim();
          const info = {};
          const appendAddedTime = () => {
            info.Added = new Date().toLocaleString();
          };

          if (title) {
            info[title] = desc;
          } else if (desc) {
            info[`Note ${new Date().toLocaleDateString()}`] = desc;
          }

          if (sourceType === 'file' && selectedFile) {
            appendAddedTime();
            await add(selectedFile, { info });
          } else if (sourceType === 'url' && urlInput.value.trim()) {
            const u = urlInput.value.trim();
            try {
              const resp = await superFetch(u);
              if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
              const b = await resp.blob();
              info.url = u;
              appendAddedTime();
              await add(b, { info });
            } catch (e) {
              await showConceptBoardNotice(e.message || String(e), { title: "URL import failed" });
            }
          } else if (sourceType === 'note') {
            appendAddedTime();
            await add(null, { info });
          }
          await loadGallery();
          overlay.remove();
        } catch (e) {
          await showConceptBoardNotice(e.message || String(e), { title: "Could not add item" });
        } finally {
          addBtn.disabled = false;
          addBtn.textContent = "Add Item";
        }
      };

      const closeBtn = $("button", {textContent: "Cancel", onclick: () => overlay.remove(), style:"min-height:40px;background:none;border:1px solid #888;padding:0 14px;border-radius:8px;color:inherit;cursor:pointer;"});
      const btnWrapper = $("div", {style:"display:flex;justify-content:flex-end;gap:9px;padding-top:2px;"}, closeBtn, addBtn);
      modal.append(titleEl, titleInput, descTextarea, sourceContainer, btnWrapper);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      overlay.onclick = e => { if (e.target === overlay) overlay.remove(); };
      sourceToggle('url'); // Replaces updateAddButtonState() to sync the UI to the URL option
    }

    const refreshAfterBackupImport = async () => {
      localStorage.setItem(broadcastKey, String(Date.now()));
      refreshFolderList();
      await loadGallery();
    };

    const openConceptBoardTransferPanel = action => {
      const configs = {
        savePage: {
          title: "Save Page",
          subtitle: activeGalleryName,
          actions: [
            { icon: "fa-solid fa-download", title: "Download ZIP", hint: "Save this page to your device", run: async () => exportPage() },
            { icon: "fa-solid fa-link", title: "Permanent Link", hint: "Long-term link · standard upload limits", run: () => openConceptBoardDirectLinkModal("page", "permanent") },
            { icon: "fa-solid fa-bolt", title: "24 Hours Link", hint: "Higher upload size and daily allowance", run: () => openConceptBoardDirectLinkModal("page", "24h") }
          ]
        },
        loadPage: {
          title: "Load into Current Page",
          subtitle: activeGalleryName,
          actions: [
            { icon: "fa-solid fa-file-import", title: "Upload Page ZIP", hint: "Choose Smart Merge or Replace for this current page", run: async () => { const result = await importPage("page"); if (result) await refreshAfterBackupImport(); } },
            { icon: "fa-solid fa-cloud-arrow-down", title: "Load from Link", hint: "Load a page backup link into this current page", run: () => openConceptBoardImportLinkModal(refreshAfterBackupImport, "page") }
          ]
        },
        saveBackup: {
          title: "Save Backup",
          subtitle: `${getGalleryNames().length} page${getGalleryNames().length === 1 ? "" : "s"}`,
          actions: [
            { icon: "fa-solid fa-download", title: "Download ZIP", hint: "Save the whole Concept Board", run: async () => saveBackup() },
            { icon: "fa-solid fa-link", title: "Permanent Link", hint: "Long-term link · standard upload limits", run: () => openConceptBoardDirectLinkModal("full", "permanent") },
            { icon: "fa-solid fa-bolt", title: "24 Hours Link", hint: "Higher upload size and daily allowance", run: () => openConceptBoardDirectLinkModal("full", "24h") }
          ]
        },
        loadBackup: {
          title: "Load Backup",
          subtitle: "Choose Smart Merge or Replace",
          actions: [
            { icon: "fa-solid fa-file-import", title: "Upload ZIP", hint: "Merge with or replace the whole current board", run: async () => { const result = await importPage("full"); if (result) await refreshAfterBackupImport(); } },
            { icon: "fa-solid fa-cloud-arrow-down", title: "Load from Link", hint: "Load a whole-board backup link", run: () => openConceptBoardImportLinkModal(refreshAfterBackupImport, "full") }
          ]
        }
      };
      const config = configs[action];
      if (!config) return;
      const overlay = $("div", { className: "localMediaGallery-modal-overlay", style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10083000;background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;" });
      const modal = $("div", { className: "localMediaGallery-modal-shell", style: "width:min(390px,96vw);background:var(--background-color);color:var(--text-color);" });
      const header = $("div", { className: "localMediaGallery-modal-header" });
      const closeButton = $("button", { type: "button", innerHTML: "×", title: "Close", style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;" });
      header.append(
        $("div", { style: "min-width:0;flex:1;text-align:left;" },
          $("div", { textContent: config.title, style: "font-size:16px;font-weight:600;text-align:left;" }),
          $("div", { textContent: config.subtitle, style: "font-size:12px;opacity:.68;margin-top:2px;text-align:left;" })
        ),
        closeButton
      );
      const body = $("div", { style: "padding:10px;display:flex;flex-direction:column;gap:6px;" });
      const close = () => overlay.remove();
      config.actions.forEach(item => {
        const button = $("button", {
          type: "button",
          style: "width:100%;padding:10px;border:0;border-radius:8px;background:var(--box-color);color:var(--text-color);cursor:pointer;display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;text-align:left;",
          onclick: async () => {
            close();
            try { await item.run(); }
            catch (error) { await showConceptBoardNotice(error.message || String(error), { title: `${config.title} failed` }); }
          }
        });
        button.append(
          $("i", { className: `${item.icon} fa-fw`, style: "margin-top:2px;text-align:center;" }),
          $("span", {},
            $("strong", { textContent: item.title, style: "display:block;font-size:13px;" }),
            $("small", { textContent: item.hint, style: "display:block;margin-top:2px;font-size:11px;line-height:1.35;opacity:.68;" })
          )
        );
        body.appendChild(button);
      });
      closeButton.onclick = close;
      overlay.onclick = event => { if (event.target === overlay) close(); };
      modal.append(header, body);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
    };

    const openConceptBoardMaintenancePanel = () => {
      const overlay = $("div", { className: "localMediaGallery-modal-overlay", style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10083000;background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;" });
      const modal = $("div", { className: "localMediaGallery-modal-shell", style: "width:min(400px,96vw);background:var(--background-color);color:var(--text-color);" });
      const header = $("div", { className: "localMediaGallery-modal-header" });
      const closeButton = $("button", { type: "button", innerHTML: "×", title: "Close", style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;" });
      header.append(
        $("div", { style: "display:flex;align-items:center;gap:8px;min-width:0;" },
          $("i", { className: "fa-solid fa-hard-drive fa-fw", style: "font-size:15px;" }),
          $("div", { textContent: "Storage", style: "font-size:16px;font-weight:600;" })
        ),
        closeButton
      );
      const body = $("div", { style: "padding:10px;display:flex;flex-direction:column;gap:6px;" });
      const storageCard = $("div", { style: "padding:10px;border-radius:8px;background:var(--box-color);text-align:left;display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;align-items:start;" });
      const storageIcon = $("i", {
        className: "fa-solid fa-database fa-fw localMediaGallery-leading-icon",
        ariaHidden: "true"
      });
      const storageCopy = $("div", { style: "display:block;min-width:0;text-align:left;" },
        $("strong", { textContent: "Browser storage", style: "display:block;font-size:13px;text-align:left;font-weight:600;" }),
        $("small", { textContent: "Checking usage and persistence status...", style: "display:block;margin-top:2px;font-size:11px;line-height:1.4;opacity:.68;text-align:left;" })
      );
      storageCard.append(storageIcon, storageCopy);
      body.appendChild(storageCard);
      Promise.all([
        typeof navigator.storage?.estimate === "function" ? navigator.storage.estimate() : Promise.resolve({ usage: 0, quota: 0 }),
        typeof navigator.storage?.persisted === "function" ? navigator.storage.persisted() : Promise.resolve(false)
      ]).then(([estimate, persisted]) => {
        const usage = Number(estimate?.usage) || 0;
        const quota = Number(estimate?.quota) || 0;
        const storageText = storageCopy.querySelector("small");
        storageText.textContent = `${formatArtifactBytes(usage)} used${quota ? ` of ~${formatArtifactBytes(quota)}` : ""} · ${persisted ? "persistent" : "temporary"} browser storage`;
        storageText.title = "Browser-reported storage estimate. The quota can be lower or higher on another device and can change over time.";
      }).catch(() => {
        storageCopy.querySelector("small").textContent = "This browser could not report storage usage or persistence status.";
      });
      const close = () => overlay.remove();
      const addAction = (icon, title, subtitle, handler, danger = false) => {
        const button = $("button", {
          type: "button",
          style: `width:100%;padding:10px;border:${danger ? "1px solid var(--alert-color)" : "0"};border-radius:8px;background:${danger ? "transparent" : "var(--box-color)"};color:${danger ? "var(--alert-color)" : "var(--text-color)"};cursor:pointer;display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;text-align:left;`,
          onclick: async () => { close(); await handler(); }
        });
        button.append(
          $("i", { className: `${icon} fa-fw localMediaGallery-leading-icon`, ariaHidden: "true" }),
          $("span", {},
            $("strong", { textContent: title, style: "display:block;font-size:13px;" }),
            $("small", { textContent: subtitle, style: "display:block;margin-top:2px;font-size:11px;line-height:1.35;opacity:.68;" })
          )
        );
        body.appendChild(button);
      };
      addAction("fa-solid fa-heart-pulse", "Data Rescue", "Find and restore missing Concept Board data", runDataRescue);
      addAction("fa-solid fa-trash", "Clear all storage", "Delete every page and stored item", async () => {
        await clearAllData();
        refreshFolderList();
        await loadGallery();
      }, true);
      closeButton.onclick = close;
      overlay.onclick = event => { if (event.target === overlay) close(); };
      modal.append(header, body);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
    };

    /* Compact toolbar menu. Detailed backup and maintenance actions live in small panels. */
    const menuItems = [
      ["addNewItem", "fa-solid fa-notes-medical", "Add New Item"],
      ["toggleBtns", () => getComputedStyle(document.documentElement).getPropertyValue("--localMediaGalleryBtnsDisplay").trim() === "none" ? "fa-solid fa-toggle-on" : "fa-solid fa-toggle-off", () => getComputedStyle(document.documentElement).getPropertyValue("--localMediaGalleryBtnsDisplay").trim() === "none" ? "Show item controls" : "Hide item controls"],
      ["savePage", "fa-solid fa-file-arrow-down", "Save Page"],
      ["loadPage", "fa-solid fa-file-arrow-up", "Load into Current Page"],
      ["saveBackup", "fa-solid fa-box-archive", "Save Backup"],
      ["loadBackup", "fa-solid fa-clock-rotate-left", "Load Backup"],
      ["maintenance", "fa-solid fa-hard-drive", "Storage"]
    ];

    const menuCtn = $("div", { className: "localMediaGallery-dropdown-host", style: "display:inline-block;position:relative;" });
    const menuBtn = $("button", {
      className: "localMediaGallery-toolbar-control",
      innerHTML: '<i class="fa-solid fa-bars fa-fw"></i>',
      title: "Menu",
      ariaLabel: "Concept Board menu"
    });
    const menuDropdown = $("div", {
      className: "custom-dropdown-list localMediaGallery-dropdown-list",
      style: "display:none;top:100%;left:0;right:auto;position:absolute;z-index:10050999;min-width:205px;"
    });
    toolbarDropdowns.push(menuDropdown);
    menuItems.forEach(([action, icon, label]) => {
      const getIcon = typeof icon === "function" ? icon : () => icon;
      const getLabel = typeof label === "function" ? label : () => label;
      const item = $("button", {
        type: "button",
        dataset: { action },
        innerHTML: `<i class="${getIcon()} fa-fw"></i><span>${getLabel()}</span>`,
        style: "width:100%;border:0;background:transparent;color:var(--text-color);cursor:pointer;display:flex;align-items:center;gap:9px;text-align:left;",
        onclick: async () => {
          menuDropdown.style.display = "none";
          if (action === "addNewItem") openAddItemPanel();
          if (action === "savePage" || action === "loadPage" || action === "saveBackup" || action === "loadBackup") openConceptBoardTransferPanel(action);
          if (action === "maintenance") openConceptBoardMaintenancePanel();
          if (action === "toggleBtns") {
            const current = getComputedStyle(document.documentElement).getPropertyValue("--localMediaGalleryBtnsDisplay").trim();
            const next = current === "none" ? "flex" : "none";
            document.documentElement.style.setProperty("--localMediaGalleryBtnsDisplay", next);
            render();
            const button = menuDropdown.querySelector('[data-action="toggleBtns"]');
            if (button) {
              button.innerHTML = `<i class="fa-solid ${next === "none" ? "fa-toggle-on" : "fa-toggle-off"} fa-fw"></i><span>${next === "none" ? "Show item controls" : "Hide item controls"}</span>`;
            }
          }
        }
      });
      menuDropdown.appendChild(item);
    });
    menuBtn.onclick = event => {
      event.stopPropagation();
      toggleToolbarDropdown(menuDropdown);
    };
    menuDropdown.onclick = event => event.stopPropagation();
    menuCtn.append(menuBtn, menuDropdown);
    headerBarEl.appendChild(menuCtn);

    /* custom folder picker with FA icons */
    const folderDropdown = $("div", {
      className: "localMediaGallery-dropdown-host",
      style: `
        display: inline-block;
        position: relative;
      `
    });

    const folderBtn = $("button", {
      className: "localMediaGallery-toolbar-control",
      title: "Switch folder",
      style: `
        padding: 4px 8px;
        font-size: 14px;
        border: 1px solid #444;
        border-radius: 3px;
        background: var(--background-color);
        color: var(--text-color);
        cursor: pointer;
        min-width: 100px;
        max-width: 130px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        text-align: left;
        display: inline-flex;
        align-items: center;
        gap: 7px;
      `,
      onmouseover: e => {
        e.currentTarget.style.background = "var(--box-color)";
      },
      onmouseout: e => {
        e.currentTarget.style.background = "var(--background-color)";
      }
    });

    const setFolderButtonLabel = pageName => {
      folderBtn.replaceChildren(
        $("span", {
          className: "material-symbols-outlined localMediaGallery-page-icon",
          textContent: "note_stack"
        }),
        $("span", {
          textContent: String(pageName || defaultGallery),
          style: "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;"
        })
      );
    };
    setFolderButtonLabel(activeGalleryName);

    const folderList = $("div", {
      className: "custom-dropdown-list localMediaGallery-dropdown-list",
      style: `
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 10050999;
        background: var(--background-color);
        border: 1px solid #555;
        min-width: 160px;
        box-shadow: 2px 2px 4px rgba(0,0,0,0.4);
        max-height: 240px;
        overflow-y: auto;
      `
    });
    toolbarDropdowns.push(folderList);

    const createConceptBoardPage = async () => {
      const names = getGalleryNames();
      const newName = await askConceptBoardText(
        "Choose a name for the new page.",
        {
          title: "New page",
          placeholder: "Page_name",
          confirmLabel: "Create page",
          validate: value => {
            const candidate = String(value).trim();
            if (!CONCEPT_BOARD_PAGE_NAME_RE.test(candidate)) return "Use only letters, numbers, and underscores (_).";
            if (names.includes(candidate)) return "That page already exists.";
            return true;
          }
        }
      );
      if (!newName) return false;
      const pageName = newName.trim();
      saveGalleryNames([...names, pageName]);
      activeGalleryName = pageName;
      localStorage[pre + "activeGalleryName"] = pageName;
      setFolderButtonLabel(pageName);
      refreshFolderList();
      await loadGallery();
      return true;
    };

    const renameConceptBoardPage = async oldName => {
      const names = getGalleryNames();
      const currentIndex = names.indexOf(oldName);
      if (currentIndex < 0) return false;

      return new Promise(resolve => {
        const overlay = $("div", {
          className: "localMediaGallery-modal-overlay",
          style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10085000;background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;"
        });
        const modal = $("div", {
          className: "localMediaGallery-modal-shell",
          role: "dialog",
          ariaModal: "true",
          style: "width:min(420px,96vw);background:var(--background-color);color:var(--text-color);"
        });
        const header = $("div", { className: "localMediaGallery-modal-header" });
        const closeButton = $("button", {
          type: "button",
          innerHTML: "×",
          title: "Close",
          ariaLabel: "Close",
          style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;"
        });
        header.append(
          $("div", { textContent: "Rename & Reorder Page", style: "font-size:16px;font-weight:600;" }),
          closeButton
        );

        const body = $("div", { style: "padding:16px;display:flex;flex-direction:column;gap:12px;" });
        const nameInput = $("input", {
          value: oldName,
          autocomplete: "off",
          style: "width:100%;min-height:40px;padding:9px 10px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);box-sizing:border-box;font:14px/1.4 system-ui,sans-serif;"
        });
        const positionSelect = $("select", {
          style: "width:100%;min-height:40px;padding:8px 10px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);box-sizing:border-box;"
        });
        names.forEach((name, index) => {
          const suffix = index === 0 ? "" : index === names.length - 1 ? "" : "";
          positionSelect.appendChild($("option", {
            value: String(index),
            textContent: `${index + 1}${suffix}`
          }));
        });
        positionSelect.value = String(currentIndex);

        const errorEl = $("div", {
          style: "display:none;padding:8px 10px;border-radius:7px;background:var(--box-color);color:var(--alert-color);font-size:12px;line-height:1.4;"
        });
        body.append(
          $("label", {},
            $("span", { textContent: "Page name", style: "display:block;font-size:12px;font-weight:600;margin-bottom:6px;opacity:.75;" }),
            nameInput
          ),
          $("label", {},
            $("span", { textContent: "Page order", style: "display:block;font-size:12px;font-weight:600;margin-bottom:6px;opacity:.75;" }),
            positionSelect
          ),
          $("div", { textContent: "Renaming keeps every item.", style: "font-size:12px;line-height:1.45;opacity:.68;" }),
          errorEl
        );

        const footer = $("div", { className: "localMediaGallery-modal-footer" });
        const cancelButton = $("button", {
          type: "button",
          textContent: "Cancel",
          style: "min-height:38px;padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;"
        });
        const saveButton = $("button", {
          type: "button",
          textContent: "Save Changes",
          style: "min-height:38px;padding:0 15px;border:0;border-radius:8px;background:var(--localMediaGallerySpecialColor);color:#fff;cursor:pointer;font-weight:600;"
        });
        footer.append(cancelButton, saveButton);

        let closed = false;
        const close = value => {
          if (closed) return;
          closed = true;
          document.removeEventListener("keydown", onKey);
          overlay.remove();
          resolve(value);
        };
        const onKey = event => {
          if (event.key === "Escape") close(false);
          if (event.key === "Enter") saveButton.click();
        };

        saveButton.onclick = async () => {
          const pageName = nameInput.value.trim();
          if (!CONCEPT_BOARD_PAGE_NAME_RE.test(pageName)) {
            errorEl.textContent = "Use only letters, numbers, and underscores (_).";
            errorEl.style.display = "block";
            nameInput.focus();
            return;
          }
          if (pageName !== oldName && names.includes(pageName)) {
            errorEl.textContent = "That page already exists.";
            errorEl.style.display = "block";
            nameInput.focus();
            return;
          }

          const targetIndex = Math.max(0, Math.min(names.length - 1, Number(positionSelect.value) || 0));
          const renamed = pageName !== oldName;
          const reordered = targetIndex !== currentIndex;
          if (!renamed && !reordered) {
            close(false);
            return;
          }

          saveButton.disabled = true;
          saveButton.textContent = "Saving...";
          try {
            if (renamed) {
              const items = await kv[pre + oldName].values();
              for (const item of items) await kv[pre + pageName].set(item.id, item);
              await kv[pre + oldName].clear();
            }

            const nextNames = names.filter(name => name !== oldName);
            nextNames.splice(targetIndex, 0, pageName);
            saveGalleryNames(nextNames);

            if (activeGalleryName === oldName) {
              activeGalleryName = pageName;
              localStorage[pre + "activeGalleryName"] = pageName;
              setFolderButtonLabel(pageName);
            }

            refreshFolderList();
            await loadGallery();
            close(true);
          } catch (error) {
            errorEl.textContent = error.message || String(error);
            errorEl.style.display = "block";
            saveButton.disabled = false;
            saveButton.textContent = "Save Changes";
          }
        };

        cancelButton.onclick = () => close(false);
        closeButton.onclick = () => close(false);
        overlay.onclick = event => { if (event.target === overlay) close(false); };
        document.addEventListener("keydown", onKey);
        modal.append(header, body, footer);
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        setTimeout(() => { nameInput.focus(); nameInput.select(); }, 0);
      });
    };

    const openMergePagesPanel = async () => {
      const names = getGalleryNames();
      if (names.length < 2) {
        await showConceptBoardNotice("Create at least two pages before merging.", { title: "Merge pages" });
        return;
      }

      const overlay = $("div", {
        className: "localMediaGallery-modal-overlay",
        style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10085000;background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;"
      });
      const modal = $("div", {
        className: "localMediaGallery-modal-shell",
        style: "width:min(420px,96vw);background:var(--background-color);color:var(--text-color);"
      });
      const header = $("div", { className: "localMediaGallery-modal-header" });
      const closeButton = $("button", {
        type: "button", innerHTML: "×", title: "Close",
        style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;"
      });
      header.append($("div", { textContent: "Merge pages", style: "font-size:16px;font-weight:600;" }), closeButton);
      const body = $("div", { style: "padding:16px;display:flex;flex-direction:column;gap:12px;" });
      const sourceSelect = $("select", { style: "width:100%;min-height:40px;padding:8px 10px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);box-sizing:border-box;" });
      const targetSelect = sourceSelect.cloneNode(false);
      names.forEach(name => {
        sourceSelect.appendChild($("option", { value: name, textContent: name }));
        targetSelect.appendChild($("option", { value: name, textContent: name }));
      });
      sourceSelect.value = activeGalleryName;
      targetSelect.value = names.find(name => name !== activeGalleryName) || names[0];
      const syncTarget = () => {
        if (targetSelect.value === sourceSelect.value) {
          targetSelect.value = names.find(name => name !== sourceSelect.value) || sourceSelect.value;
        }
      };
      sourceSelect.onchange = syncTarget;
      body.append(
        $("label", {}, $("span", { textContent: "Copy items from", style: "display:block;font-size:12px;font-weight:600;margin-bottom:6px;opacity:.75;" }), sourceSelect),
        $("label", {}, $("span", { textContent: "Merge into", style: "display:block;font-size:12px;font-weight:600;margin-bottom:6px;opacity:.75;" }), targetSelect),
        $("div", { textContent: "Items are copied by ID. Existing references stay unchanged, and duplicate IDs are ignored.", style: "font-size:12px;line-height:1.45;opacity:.68;" })
      );
      const footer = $("div", { className: "localMediaGallery-modal-footer" });
      const cancelButton = $("button", { type: "button", textContent: "Cancel", style: "min-height:38px;padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;" });
      const mergeButton = $("button", { type: "button", textContent: "Merge", style: "min-height:38px;padding:0 15px;border:0;border-radius:8px;background:var(--localMediaGallerySpecialColor);color:#fff;cursor:pointer;font-weight:600;" });
      const close = () => overlay.remove();
      cancelButton.onclick = close;
      closeButton.onclick = close;
      overlay.onclick = event => { if (event.target === overlay) close(); };
      mergeButton.onclick = async () => {
        const sourcePage = sourceSelect.value;
        const targetPage = targetSelect.value;
        if (sourcePage === targetPage) {
          await showConceptBoardNotice("Choose two different pages.", { title: "Merge pages" });
          return;
        }
        mergeButton.disabled = true;
        mergeButton.textContent = "Merging...";
        const itemsToCopy = await kv[pre + sourcePage].values();
        for (const item of itemsToCopy) await kv[pre + targetPage].set(item.id, item);
        close();
        await showConceptBoardNotice(
          `Merged ${itemsToCopy.length} item reference${itemsToCopy.length === 1 ? "" : "s"} from “${sourcePage}” into “${targetPage}”.`,
          { title: "Merge complete" }
        );
        await loadGallery();
      };
      footer.append(cancelButton, mergeButton);
      modal.append(header, body, footer);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
    };

    const openDeletePagePanel = async () => {
      const names = getGalleryNames();
      if (!names.length) {
        await showConceptBoardNotice("There are no pages to delete.", { title: "Delete page" });
        return;
      }
      const overlay = $("div", {
        className: "localMediaGallery-modal-overlay",
        style: "display:flex;inset:0;position:fixed;align-items:center;justify-content:center;z-index:10085000;background:rgba(0,0,0,.72);padding:14px;box-sizing:border-box;"
      });
      const modal = $("div", { className: "localMediaGallery-modal-shell", style: "width:min(390px,96vw);background:var(--background-color);color:var(--text-color);" });
      const header = $("div", { className: "localMediaGallery-modal-header" });
      const closeButton = $("button", { type: "button", innerHTML: "×", title: "Close", style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:24px;" });
      header.append($("div", { textContent: "Delete page", style: "font-size:16px;font-weight:600;" }), closeButton);
      const body = $("div", { style: "padding:16px;display:flex;flex-direction:column;gap:10px;" });
      const select = $("select", { style: "width:100%;min-height:40px;padding:8px 10px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--box-color);color:var(--text-color);box-sizing:border-box;" });
      names.forEach(name => select.appendChild($("option", { value: name, textContent: name })));
      select.value = activeGalleryName;
      body.append(
        $("div", { textContent: "Choose the page to remove.", style: "font-size:14px;" }),
        select,
        $("div", { textContent: "Files used by another page are kept. Unreferenced files on this page are removed.", style: "font-size:12px;line-height:1.45;opacity:.68;" })
      );
      const footer = $("div", { className: "localMediaGallery-modal-footer" });
      const cancelButton = $("button", { type: "button", textContent: "Cancel", style: "min-height:38px;padding:0 14px;border:1px solid rgba(128,128,128,.45);border-radius:8px;background:var(--background-color);color:var(--text-color);cursor:pointer;" });
      const deleteButton = $("button", { type: "button", textContent: "Delete page", style: "min-height:38px;padding:0 15px;border:1px solid var(--alert-color);border-radius:8px;background:transparent;color:var(--alert-color);cursor:pointer;font-weight:600;" });
      const close = () => overlay.remove();
      cancelButton.onclick = close;
      closeButton.onclick = close;
      overlay.onclick = event => { if (event.target === overlay) close(); };
      deleteButton.onclick = async () => {
        const pageName = select.value;
        const confirmed = await askConceptBoardConfirm(
          `Delete “${pageName}”?`,
          { title: "Delete page", detail: "This page cannot be restored unless it exists in a backup.", confirmLabel: "Delete", danger: true }
        );
        if (!confirmed) return;
        deleteButton.disabled = true;
        deleteButton.textContent = "Deleting...";
        const itemsToDelete = await kv[pre + pageName].values();
        for (const item of itemsToDelete) {
          if (!(await isBlobReferenced(item.id, [pageName]))) await blobs.delete(item.id);
        }
        await kv[pre + pageName].clear();
        let remaining = getGalleryNames().filter(name => name !== pageName);
        if (!remaining.length) remaining = [defaultGallery];
        saveGalleryNames(remaining);
        if (!remaining.includes(activeGalleryName)) activeGalleryName = remaining[0];
        localStorage[pre + "activeGalleryName"] = activeGalleryName;
        setFolderButtonLabel(activeGalleryName);
        refreshFolderList();
        await loadGallery();
        close();
      };
      footer.append(cancelButton, deleteButton);
      modal.append(header, body, footer);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
    };

    /* -- refreshFolderList -- */
    const refreshFolderList = () => {
      folderList.innerHTML = "";
      getGalleryNames().forEach(pageName => {
        const row = $("div", {
          className: "localMediaGallery-folder-row",
          style: "display:flex;align-items:center;width:100%;min-width:0;color:var(--text-color);font-size:13px;",
          onmouseover: event => event.currentTarget.style.background = "var(--box-color)",
          onmouseout: event => event.currentTarget.style.background = "transparent"
        });
        const pageButton = $("button", {
          type: "button",
          style: "min-width:0;flex:1;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;display:flex;align-items:center;gap:7px;text-align:left;",
          onclick: async event => {
            event.stopPropagation();
            activeGalleryName = pageName;
            localStorage[pre + "activeGalleryName"] = pageName;
            setFolderButtonLabel(pageName);
            folderList.style.display = "none";
            await loadGallery();
          }
        },
          $("span", { className: "material-symbols-outlined localMediaGallery-page-icon", textContent: "note_stack" }),
          $("span", { textContent: pageName, style: "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1;" })
        );
        const renameButton = $("button", {
          type: "button",
          title: `Rename or reorder ${pageName}`,
          ariaLabel: `Rename or reorder ${pageName}`,
          innerHTML: '<i class="fa-solid fa-ellipsis-vertical fa-sm"></i>',
          style: "width:28px;height:28px;flex-shrink:0;border:0;border-radius:6px;background:transparent;color:inherit;cursor:pointer;opacity:.72;",
          onclick: async event => {
            event.stopPropagation();
            folderList.style.display = "none";
            await renameConceptBoardPage(pageName);
          }
        });
        row.append(pageButton, renameButton);
        folderList.appendChild(row);
      });

      const addPageAction = (icon, label, handler, danger = false) => {
        folderList.appendChild($("button", {
          type: "button",
          innerHTML: `<i class="${icon} fa-fw localMediaGallery-page-icon"></i><span>${label}</span>`,
          style: `width:100%;padding:8px 10px;border:0;border-radius:7px;background:transparent;color:${danger ? "var(--alert-color)" : "var(--text-color)"};cursor:pointer;display:flex;align-items:center;gap:8px;text-align:left;font-size:13px;`,
          onclick: async () => {
            folderList.style.display = "none";
            await handler();
          }
        }));
      };
      folderList.appendChild($("div", { className: "localMediaGallery-menu-group-gap" }));
      addPageAction("fa-solid fa-plus", "Add new page", createConceptBoardPage);
      addPageAction("fa-solid fa-code-merge", "Merge Page", openMergePagesPanel);
      addPageAction("fa-solid fa-trash", "Delete page", openDeletePagePanel, true);
    };

    internalRefreshUI = refreshFolderList;
    
    folderBtn.onclick = event => {
      event.stopPropagation();
      toggleToolbarDropdown(folderList);
    };
    folderList.onclick = event => event.stopPropagation();
    
    refreshFolderList();
    folderDropdown.appendChild(folderBtn);
    folderDropdown.appendChild(folderList);
    headerBarEl.appendChild(folderDropdown);

    /* custom sort picker with Font Awesome */
    let sortValue = localStorage.getItem("gallerySortMode") || "dateDesc";

    const sortLabelMap = {
      dateDesc: "Newest",
      dateAsc: "Oldest",
      ratingDesc: "Favorite",
      ratingAsc: "Lowest Rated",
      random: "Random"
    };
      const sortIconMap = {
      dateDesc: "fa-solid fa-arrow-down-wide-short",
      dateAsc: "fa-solid fa-arrow-up-wide-short",
      ratingDesc: "fa-regular fa-star",
      ratingAsc: "fa-solid fa-heart-crack",
      random: "fa-solid fa-shuffle"
    };
    
    const sortDropdown = $("div", {
      className: "localMediaGallery-dropdown-host",
      style: "display:inline-block;position:relative;"
    });
    
    // --- START: MODIFIED sortBtn CREATION ---
    const sortBtnSpan = $("span", {
      textContent: sortLabelMap[sortValue],
      style: "overflow: hidden; white-space: nowrap; text-overflow: ellipsis;"
    });
    const sortBtn = $("button", {
      className: "localMediaGallery-toolbar-control",
      title: "Sort by",
      style: `
        padding: 4px 8px;
        font-size: 14px;
        border: 1px solid #444;
        border-radius: 3px;
        background: var(--background-color);
        color: var(--text-color);
        cursor: pointer;
        min-width: 100px;
        max-width: 100px; /* Kept, as requested */
        /* overflow, white-space, text-overflow REMOVED from here */
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 6px;
        text-align: left;
      `,
      onmouseover: e => {
        e.currentTarget.style.background = "var(--box-color)";
      },
      onmouseout: e => {
        e.currentTarget.style.background = "var(--background-color)";
      }
    }, $("i", { className: `${sortIconMap[sortValue]} fa-fw` }), sortBtnSpan);
    // --- END: MODIFIED sortBtn CREATION ---
    
    const sortList = $("div", {
      className: "custom-dropdown-list localMediaGallery-dropdown-list",
      style: `
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 10050999;
        background: var(--background-color);
        border: 1px solid #555;
        min-width: 160px;
        box-shadow: 2px 2px 4px rgba(0,0,0,0.4);
      `
    });
    toolbarDropdowns.push(sortList);

    // --- Search Trigger Item ---
    const searchTrigger = $("button", {
      innerHTML: `<i class="fa-solid fa-magnifying-glass fa-fw" style="margin-right:6px;"></i> Search`,
      style: `
        width: 100%; padding: 6px 10px; background: transparent;
        color: var(--text-color); border: none; cursor: pointer;
        font-size: 13px; text-align: left; display: flex; align-items: center;
        margin-bottom: 4px; border-radius: 7px;
      `,
      onmouseover: e => e.currentTarget.style.background = "var(--box-color)",
      onmouseout: e => e.currentTarget.style.background = "transparent",
      onclick: () => {
        sortList.style.display = "none";
        searchBarEl.style.top = `${Math.round(headerBarEl.getBoundingClientRect().bottom + 8)}px`;
        searchBarEl.style.display = "flex";
        searchInput.focus();
      }
    });
    sortList.appendChild(searchTrigger);
    
    Object.entries(sortLabelMap).forEach(([value, label]) => {
      const icon = sortIconMap[value];
      const btn = $("button", {
        innerHTML: `<i class="${icon} fa-fw" style="margin-right:6px;"></i>${label}`,
        style: `
          width: 100%;
          padding: 6px 10px;
          background: none;
          color: var(--text-color);
          border: none;
          cursor: pointer;
          font-size: 13px;
          text-align: left;
          display: flex;
          align-items: center;
        `,
        
        onmouseover: e => {
          e.currentTarget.style.background = "var(--box-color)";
        },
        onmouseout: e => {
          e.currentTarget.style.background = "var(--background-color)";
        },
        
        onclick: () => {
          sortValue = value;
          localStorage.setItem("gallerySortMode", value);
          // --- NEW UPDATE LOGIC ---
          sortBtn.querySelector("i").className = `${sortIconMap[value]} fa-fw`;
          sortBtn.querySelector("span").textContent = label;
          // --- END ---
          sortList.style.display = "none";          
          render();
        }
     
      });
      sortList.appendChild(btn);
    });
    
    sortBtn.onclick = event => {
      event.stopPropagation();
      toggleToolbarDropdown(sortList);
    };
    sortList.onclick = event => event.stopPropagation();
    
    sortDropdown.appendChild(sortBtn);
    sortDropdown.appendChild(sortList);
    headerBarEl.appendChild(sortDropdown);
    
    /* view mode */
    const viewIconMap = {
      regular: { icon: "auto_awesome_mosaic", tip: "Regular view" },
      smaller: { icon: "view_cozy", tip: "Compact view" },
      smallest: { icon: "grid_on", tip: "Dense view" },
      details: { icon: "view_agenda", tip: "Details view · thumbnail + metadata" },
      list: { icon: "format_list_bulleted", tip: "List view · ultra compact" }
    };
    const viewModeOrder = ["regular", "smaller", "smallest", "details", "list"];
    let viewMode = localStorage.getItem("galleryViewMode") || "smaller";
    if (!viewIconMap[viewMode]) viewMode = "smaller";
    
    const cycleViewMode = () => {
      const currentIndex = viewModeOrder.indexOf(viewMode);
      viewMode = viewModeOrder[(currentIndex + 1) % viewModeOrder.length];
    
      localStorage.setItem("galleryViewMode", viewMode);
      const { icon, tip } = viewIconMap[viewMode];
      viewModeBtn.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px; vertical-align:-3px;" title="${tip}">${icon}</span>`;
      render();
    };
    
    const viewModeBtn = $("button", {
      className: "localMediaGallery-toolbar-control",
      onclick: cycleViewMode,
      style: `
        padding: 4px 8px;
        font-size: 14px;
        border: 1px solid #444;
        border-radius: 3px;
        background: var(--background-color);
        color: var(--text-color);
        cursor: pointer;
      `,
      onmouseover: e => {
        e.currentTarget.style.background = "var(--box-color)";
      },
      onmouseout: e => {
        e.currentTarget.style.background = "var(--background-color)";
      }
    });
    viewModeBtn.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px; vertical-align:-3px;" title="${viewIconMap[viewMode].tip}">${viewIconMap[viewMode].icon}</span>`;
    headerBarEl.appendChild(viewModeBtn);

    
    /* spacer to push right items */
    headerBarEl.appendChild($("div", { style: "flex-grow: 1;" }));

    /* --- Select All Button --- */
    selectAllBtn = $("button", {
      className: "localMediaGallery-toolbar-control",
      style: `
        margin-right: 4px;
        padding: 6px 12px;
        font-size: 14px;
        border: 1px solid var(--localMediaGallerySpecialColor);
        border-radius: 3px;
        background: var(--localMediaGallerySpecialColor);
        color: white;
        cursor: pointer;
        display: none; /* Hidden until select mode */
        align-items: center;
        line-height: 1;
      `,
      onclick: () => {
        const allSelected = displayedItems.length > 0 && displayedItems.every(m => selectedIds.has(m.id));
        if (allSelected) {
          selectedIds.clear();
        } else {
          displayedItems.forEach(m => selectedIds.add(m.id));
        }
        displayedItems.forEach(m => updateItemVisuals(m.id));
        updateSelectModeUI();
      }
    });
    headerBarEl.appendChild(selectAllBtn);

    /* close */
    headerBarEl.appendChild($("button",{
      className: "localMediaGallery-toolbar-control",
      innerHTML: `<i class="fa-solid fa-xmark" style="font-size:14px;"></i> Close`,
      title: "Esc",
      style: `
        margin-right: 0; 
        background: light-dark(#ddd, #444);
        color: inherit;
        border: none;
        font-size: 14px;
        padding: 6px 12px; 
        border-radius: 3px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
      `,
      onclick: closeGallery,
      onmouseover: e => e.currentTarget.style.background = 'light-dark(#ccc, #555)',
      onmouseout: e => e.currentTarget.style.background = 'light-dark(#ddd, #444)'
    }));

    /* grid */
    const grid=root.appendChild($("div",{className:"localMediaGallery-grid",style:"flex:1;overflow:auto;display:flex;flex-wrap:wrap;align-content:flex-start;justify-content:center;"}));
    // Click background (empty space) to unselect all
    grid.onclick = (e) => {
      if(e.target === grid) {
        closeItemActionMenu();
        selectedIds.clear();
        render();
        updateSelectModeUI();
      }
    };
    grid.addEventListener("scroll", () => closeItemActionMenu(), { passive: true });

    /* --- NEW: Scroll Buttons (Material V3) --- */
    const scrollBtns = $("div", {
      style: "bottom:20px; right:20px; display:flex; position:fixed; flex-direction:column; gap:8px; z-index:2000000;"
    });

    const makeScrollBtn = (icon, fn) => $("button", {
      innerHTML: icon,
      title: "Scroll",
      style: `
        width: 32px; height: 32px; border-radius: 8px; /* Smaller, denser shape */
        background: var(--box-color); color: var(--text-color);
        border: 1px solid rgba(128,128,128, 0.5);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 12px; transition: transform 0.1s;
      `,
      onmouseover: e => e.currentTarget.style.filter = "brightness(0.9)",
      onmouseout: e => e.currentTarget.style.filter = "none",
      onmousedown: e => e.currentTarget.style.transform = "scale(0.92)",
      onmouseup: e => e.currentTarget.style.transform = "scale(1)",
      onclick: fn
    });

    scrollBtns.appendChild(makeScrollBtn('<i class="fa-solid fa-arrow-up"></i>', () => grid.scrollTo({ top: 0, behavior: 'smooth' })));
    scrollBtns.appendChild(makeScrollBtn('<i class="fa-solid fa-arrow-down"></i>', () => grid.scrollTo({ top: grid.scrollHeight, behavior: 'smooth' })));
    root.appendChild(scrollBtns);

    /* lazy loader */
    let io;
    const observe = () => {
      io?.disconnect();
      io = new IntersectionObserver(es =>
        es.forEach(async en => {
          if (!en.target.dataset.id) return;
          if (!en.target.isConnected) return;
          if (en.isIntersecting && !en.target.dataset.loaded) {
            en.target.dataset.loaded = 1;

            const itemId = en.target.dataset.id;
            const item = displayedItems.find(entry => entry.id === itemId)
              || mediaArr.find(entry => entry.id === itemId);
            if (!item) return;

            const rec = await blobs.get(itemId);
            if (!en.target.isConnected) return;

            const b = getMediaBlob(rec);
            const info = rec?.info || {};
            const linkedImageUrl = getLinkedImageUrl(info);
            const infoEntries = Object.entries(info);
 
            // Helper to handle click vs select logic
            const handleItemClick = (e, id) => {
              e.stopPropagation();
 
              if (selectedIds.size > 0 || e.shiftKey) {
                const was = selectedIds.has(id);
 
                // Case A: Shift+Click (Range) -> Loop and update
                if (e.shiftKey && lastSelectedId && lastSelectedId !== id) {
                  const idx1 = displayedItems.findIndex(x => x.id === lastSelectedId);
                  const idx2 = displayedItems.findIndex(x => x.id === id);
 
                  if (idx1 !== -1 && idx2 !== -1) {
                    const start = Math.min(idx1, idx2);
                    const end = Math.max(idx1, idx2);
                    for (let i = start; i <= end; i++) {
                      const targetId = displayedItems[i].id;
                      selectedIds.add(targetId);
                      updateItemVisuals(targetId); // <--- No Flash Loop
                    }
                  }
                  // No render() call
                } 
                // Case B: Single Toggle
                else {
                  if (was) selectedIds.delete(id);
                  else {
                    selectedIds.add(id);
                    lastSelectedId = id;
                  }
                  updateItemVisuals(id);
                }
                updateSelectModeUI();
              } else {
                // FurAI artifacts use their own read-only viewer. All legacy media,
                // links, and notes keep the original lightbox/info-editor behavior.
                if (b && isFuraiArtifactInfo(info)) {
                  openFuraiArtifactViewer(mediaArr.find(x => x.id === id), rec);
                } else if (
                  (b && (b.type.startsWith("image/") || b.type.startsWith("video/"))) ||
                  linkedImageUrl
                ) {
                  lightbox(id);
                } else {
                  openInfoEditor(mediaArr.find(x => x.id === id));
                }
              }
            };

            const createTextPreview = (iconHtml, title, description) => {
              const wrapper = $("div", {
                style: "width:100%;height:100%;display:flex;justify-content:center;align-items:center;padding:12px;background:#333;color:#fff;cursor:pointer;box-sizing:border-box;overflow:hidden;",
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              });
              const contentHolder = $("div", {
                style: "display:flex;align-items:center;gap:10px;max-width:100%;min-width:0;"
              });
              const iconWrapper = $("div", { style: "font-size:28px;flex-shrink:0;opacity:.9;" });
              iconWrapper.innerHTML = iconHtml;
              const textWrapper = $("div", { style: "min-width:0;text-align:left;" });
              const titleEl = $("div", {
                textContent: title,
                title: title,
                style: "font-size:14px;font-weight:bold;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;word-break:break-all;"
              });
              const descEl = $("p", {
                textContent: description,
                title: description,
                style: "font-size:12px;opacity:.8;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;line-height:1.4;word-break:break-word;"
              });
              textWrapper.append(titleEl, descEl);
              contentHolder.append(iconWrapper, textWrapper);
              wrapper.append(contentHolder);
              return wrapper;
            };

            const getCompactItemType = () => {
              if (b && isFuraiArtifactInfo(info)) return String(info.type || info.category || "FurAI");
              if (linkedImageUrl && !b) return "Image";
              if (!b) return info.url ? "Link" : "Note";
              if (b.type.startsWith("image/")) return "Image";
              if (b.type.startsWith("video/")) return "Video";
              if (b.type.startsWith("audio/")) return "Audio";
              if (info.url) return "Link";
              return "File";
            };

            const getCompactItemText = async (includeArtifactPreview = false) => {
              const ignoredKeys = new Set(["url", "Added", "Image URL", "imageUrl"]);
              const displayEntries = infoEntries.filter(([key]) => !ignoredKeys.has(key));
              const firstEntry = displayEntries[0] || null;
              let title = String(
                info.title ||
                firstEntry?.[0] ||
                info.fileName ||
                getCompactItemType()
              ).trim();
              let description = String(firstEntry?.[1] || "").trim();

              if (b && isFuraiArtifactInfo(info)) {
                title = getFuraiArtifactTitle(info);
                if (includeArtifactPreview) {
                  const preview = await getFuraiArtifactCardPreview(b, info);
                  title = preview.title || title;
                  description = preview.description || description;
                } else {
                  description = String(info.hashTag || info.type || info.category || "").trim();
                }
              }

              return { title, description };
            };

            const getCompactItemMeta = () => {
              const bits = [getCompactItemType()];
              if (b?.size) bits.push(formatArtifactBytes(b.size));
              if (
                b &&
                (b.type.startsWith("image/") || b.type.startsWith("video/")) &&
                Number(item.w) > 0 &&
                Number(item.h) > 0
              ) {
                bits.push(`${Math.round(item.w)}×${Math.round(item.h)}`);
              }
              if (Number.isFinite(Number(item.date)) && Number(item.date) > 0) {
                bits.push(new Date(Number(item.date)).toLocaleDateString());
              }
              if (Number(item.rating)) bits.push(`★ ${item.rating}`);
              return bits.join(" · ");
            };

            const createCompactListRow = async () => {
              const { title, description } = await getCompactItemText(false);
              const meta = getCompactItemMeta();
              const row = $("div", {
                style: "width:100%;height:100%;display:flex;align-items:center;gap:8px;padding:0 40px;background:var(--box-color);color:var(--text-color);cursor:pointer;box-sizing:border-box;overflow:hidden;",
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              });
              const icon = $("span", {
                className: "material-symbols-outlined",
                textContent: getCompactItemType() === "Image" ? "image" :
                  getCompactItemType() === "Video" ? "movie" :
                  getCompactItemType() === "Audio" ? "audio_file" :
                  getCompactItemType() === "Link" ? "link" :
                  getCompactItemType() === "Note" ? "description" : "draft",
                style: "font-size:17px;flex:0 0 18px;opacity:.72;"
              });
              const main = $("div", {
                style: "min-width:0;flex:1;display:flex;align-items:baseline;gap:7px;overflow:hidden;"
              });
              const titleEl = $("span", {
                textContent: title,
                title,
                style: "font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:0 1 auto;"
              });
              main.appendChild(titleEl);
              if (description) {
                main.appendChild($("span", {
                  textContent: description.replace(/\s+/g, " "),
                  title: description,
                  style: "font-size:11.5px;opacity:.62;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1;"
                }));
              }
              const metaEl = $("span", {
                textContent: meta,
                title: meta,
                style: `font-size:10.5px;opacity:.55;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:0 1 auto;max-width:38%;${isMobile ? "display:none;" : ""}`
              });
              row.append(icon, main, metaEl);
              return row;
            };

            const createDetailsRow = async () => {
              const { title, description } = await getCompactItemText(true);
              const meta = getCompactItemMeta();
              const row = $("div", {
                style: "width:100%;height:100%;display:flex;align-items:center;gap:9px;padding:6px 40px;background:var(--box-color);color:var(--text-color);cursor:pointer;box-sizing:border-box;overflow:hidden;",
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              });

              const preview = $("div", {
                style: `width:${isMobile ? 42 : 48}px;height:${isMobile ? 42 : 48}px;flex:0 0 ${isMobile ? 42 : 48}px;border-radius:4px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:light-dark(#ddd,#2b2b2b);`
              });

              if (b?.type?.startsWith("image/")) {
                const url = URL.createObjectURL(b);
                const img = $("img", {
                  src: url,
                  alt: "",
                  style: "width:100%;height:100%;object-fit:contain;"
                });
                img.onload = () => URL.revokeObjectURL(url);
                preview.appendChild(img);
              } else if (linkedImageUrl && !b) {
                preview.appendChild($("img", {
                  src: linkedImageUrl,
                  alt: "",
                  loading: "lazy",
                  decoding: "async",
                  style: "width:100%;height:100%;object-fit:contain;"
                }));
              } else {
                preview.appendChild($("span", {
                  className: "material-symbols-outlined",
                  textContent: getCompactItemType() === "Video" ? "movie" :
                    getCompactItemType() === "Audio" ? "audio_file" :
                    getCompactItemType() === "Link" ? "link" :
                    getCompactItemType() === "Note" ? "description" : "draft",
                  style: "font-size:22px;opacity:.7;"
                }));
              }

              const text = $("div", {
                style: "min-width:0;flex:1;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:2px;overflow:hidden;text-align:left;"
              });
              text.appendChild($("div", {
                textContent: title,
                title,
                style: "font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
              }));
              if (description) {
                text.appendChild($("div", {
                  textContent: description.replace(/\s+/g, " "),
                  title: description,
                  style: "font-size:11px;line-height:1.25;opacity:.66;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                }));
              }
              text.appendChild($("div", {
                textContent: meta,
                title: meta,
                style: "font-size:10px;line-height:1.2;opacity:.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
              }));

              row.append(preview, text);
              return row;
            };

            if (viewMode === "list") {
              en.target.appendChild(await createCompactListRow());
              return;
            }

            if (viewMode === "details") {
              en.target.appendChild(await createDetailsRow());
              return;
            }

            if (b && isFuraiArtifactInfo(info)) {
              const preview = await getFuraiArtifactCardPreview(b, info);
              if (!en.target.isConnected) return;
              const iconClass = getFuraiArtifactIcon(info.viewer);
              en.target.appendChild(createTextPreview(
                `<i class="${iconClass} fa-fw" style="color:var(--localMediaGallerySpecialColor);"></i>`,
                preview.title,
                preview.description
              ));
            } else if (linkedImageUrl && !b) {
              en.target.appendChild($("img", {
                src: linkedImageUrl,
                style: "width:100%;height:100%;object-fit:contain;background:#000;",
                loading: "lazy",
                decoding: "async",
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              }));
            } else if (!b && !info.url && infoEntries.length > 0) {
              const title = infoEntries[0][0];
              const description = infoEntries[0][1] || '';
              en.target.appendChild(createTextPreview('<i class="fa-regular fa-file-lines fa-fw fa-sm"></i>', title, description));
            } else if (b?.type?.startsWith("image/")) {
              const url = URL.createObjectURL(b);
              const img = $("img", {
                src: url,
                style: "width:100%;height:100%;",
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              });
              img.onload = () => URL.revokeObjectURL(url);
              en.target.appendChild(img);
            } else if (b?.type?.startsWith("video/")) {
              const url = URL.createObjectURL(b);
              const vid = $("video", {
                src: url,
                style: "width:100%;height:100%;",
                muted: true, loop: true, autoplay: true, playsInline: true,
                onclick: (e) => handleItemClick(e, en.target.dataset.id)
              });
              vid.onloadeddata = () => URL.revokeObjectURL(url);
              en.target.appendChild(vid);
            } else if (rec?.info?.url) {
              const url = rec.info.url;
              const lower = url.toLowerCase();

              if (lower.includes("youtube.com") || lower.includes("youtu.be")) {
                const videoId = lower.includes("watch?v=") ? new URL(url).searchParams.get("v") : url.split("/").pop();
                en.target.appendChild($("iframe", {
                  src: `https://www.youtube.com/embed/${videoId}`,
                  style: "width:100%;height:100%;border:0;",
                  referrerPolicy: "strict-origin-when-cross-origin",
                  allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
                  allowFullscreen: true
                }));
              } else if (lower.includes("spotify.com")) {
                const embed = url.replace("open.spotify.com", "open.spotify.com/embed")
                const wrapper = $("div", { style: "width:100%;height:100%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#000;" });
                const iframe = $("iframe", { src: embed, width: "100%", height: "152px", frameborder: "0", allowtransparency: "true", allow: "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture", style: "border:0;flex-shrink:0;" });
                wrapper.appendChild(iframe);
                en.target.appendChild(wrapper);
              } else if (/\.(mp4|webm|ogg)(\?.*)?$/.test(lower)) {
                const video = $("video", { src: url, style: "width:100%;height:100%;object-fit:contain;background:#000;", controls: true, playsInline: true });
                video.onclick = (e) => handleItemClick(e, en.target.dataset.id);
                en.target.appendChild(video);
              } else if (/\.(mp3|wav|flac|aac)(\?.*)?$/.test(lower)) {
                const wrapper = $("div", { style: "width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#222;" });
                const audio = $("audio", { src: url, style: "width:90%;", controls: true });
                wrapper.appendChild(audio);
                en.target.appendChild(wrapper);
              } else {
                const customEntry = infoEntries.find(([k, v]) => k !== 'url');
                const title = customEntry ? customEntry[0] : (info.url || 'Link');
                const description = customEntry ? customEntry[1] : '';
                en.target.appendChild(createTextPreview('<i class="fa-solid fa-link fa-fw fa-2xs"></i>', title, description));
              }
            } else if (b) {
              const customEntry = infoEntries.length > 0 ? infoEntries[0] : null;
              const title = customEntry ? customEntry[0] : 'File';
              const description = customEntry ? customEntry[1] : '';
              en.target.appendChild(createTextPreview('<i class="fa-regular fa-file-lines fa-fw fa-sm"></i>', title, description));
            }
          }
        }), { root: grid, rootMargin: "300px" });
      [...grid.children].forEach(c => io.observe(c));
    };

    /* lightbox with zoom */
    const lightbox = id0 => {
      // 1. USE displayedItems HERE
      let idx = displayedItems.findIndex(m => m.id === id0);
      
      const ov = $("div", {
        dataset: { localMediaGalleryLightbox: 1 },
        style: "display:flex;position:fixed;inset:0;background:rgba(0,0,0,.85);align-items:center;justify-content:center;z-index:10000;",
        onclick: e => e.target === ov && close()
      });
   
      // Added transition CSS here
      const holder = $("div", {
        style: "display:flex; align-items:center; justify-content:center; width:100%; height:100%; transition: opacity 0.2s ease; opacity: 1;"
      });

      let zoomed = false;
      let slideshowTimer = null; 
      let isTransitioning = false; // Prevent spam-clicking during fade
   
      const onKey = e => {
        if (conceptBoardDialogDepth > 0 || isTransitioning) return;
        if (e.key === "ArrowLeft" && idx > 0) { idx--; load(); }
        // 2. USE displayedItems HERE
        else if (e.key === "ArrowRight" && idx < displayedItems.length - 1) { idx++; load(); }
        else if (e.key === "Escape") close();
      };

      const close = () => {
        document.removeEventListener("keydown", onKey);
        clearInterval(slideshowTimer); 
        const el = holder.querySelector("img[src^='blob:'], video[src^='blob:']");
        if (el) URL.revokeObjectURL(el.src);
        ov.remove();
      };
      holder.onclick = e => {
        // Only close if clicking the empty space (holder), not the image itself
        if (e.target === holder) close();
      };
      
      document.addEventListener("keydown", onKey);
   
      const load = async () => {
        if (isTransitioning) return;
        isTransitioning = true;

        // 1. Brief Fade Out (if content exists)
        if (holder.hasChildNodes()) {
          holder.style.opacity = "0";
          await new Promise(r => setTimeout(r, 200)); // Wait for CSS transition
        }

        // Clean up previous blob
        const prevEl = holder.querySelector("img[src^='blob:'], video[src^='blob:']");
        if (prevEl) { try { URL.revokeObjectURL(prevEl.src); } catch (e) {} }
        
        holder.innerHTML = "";
        zoomed = false;
        
        // 3. USE displayedItems HERE
        if (idx < 0) idx = 0;
        if (idx >= displayedItems.length) idx = displayedItems.length - 1;

        // 4. USE displayedItems HERE
        const rec = await blobs.get(displayedItems[idx].id);
        const b = getMediaBlob(rec);
        const linkedImageUrl = getLinkedImageUrl(rec?.info || {});
        let el;
   
        if (b?.type.startsWith("image/") || linkedImageUrl) {
          const url = b ? URL.createObjectURL(b) : linkedImageUrl;
          el = $("img", { src: url, style: `max-width:90vw;max-height:90vh;object-fit:contain;transition:transform .3s;cursor:zoom-in;` });
          if (b) el.onload = () => URL.revokeObjectURL(url);
   
          const toggleZoom = (event) => {
            zoomed = !zoomed;
            if (zoomed) {
              const rect = el.getBoundingClientRect();
              let x = (event.type.startsWith("touch") ? event.changedTouches[0].clientX : event.clientX) - rect.left;
              let y = (event.type.startsWith("touch") ? event.changedTouches[0].clientY : event.clientY) - rect.top;
              const xPct = (x / rect.width) * 100;
              const yPct = (y / rect.height) * 100;
              el.style.transformOrigin = `${xPct}% ${yPct}%`;
              el.style.transform = "scale(2.5)";
              el.style.cursor = "zoom-out";
            } else {
              el.style.transform = "scale(1)";
              el.style.transformOrigin = "center center";
              el.style.cursor = "zoom-in";
            }
          };
   
          if (!('ontouchstart' in window)) { el.onclick = toggleZoom; }
          else {
            let lastTap = 0;
            el.ontouchend = e => {
              let now = Date.now();
              if (now - lastTap < 300) toggleZoom(e);
              lastTap = now;
            };
          }
   
        } else if (b?.type.startsWith("video/")) {
          const url = URL.createObjectURL(b);
          el = $("video", {
            src: url,
            style: "max-width:90vw;max-height:90vh;object-fit:contain;",
            controls: true,
            autoplay: true
          });
          el.onloadeddata = () => URL.revokeObjectURL(url);
        } else if (b) {
          el = $("audio", { src: URL.createObjectURL(b), controls: true });
        } else {
          // 5. USE displayedItems HERE
          openInfoEditor(displayedItems[idx]);
          close();
          return;
        }
   
        holder.appendChild(el);
        
        // 2. Fade In
        // Small delay to ensure browser renders the new DOM before fading in
        requestAnimationFrame(() => {
          holder.style.opacity = "1";
          isTransitioning = false;
        });

        // 6. USE displayedItems HERE
        btnPrev.style.opacity = idx === 0 ? 0.3 : 1;
        btnNext.style.opacity = idx === displayedItems.length - 1 ? 0.3 : 1;
      };
   
      const nav = (txt, d, side) => ov.appendChild($("button", {
        textContent: txt,
        style: `
          position: absolute; ${side}: 10px; top: 50%; transform: translateY(-50%);
          font-size: 32px; background: none; border: none; color: #fff; cursor: pointer;
        `,
        onclick: e => {
          e.stopPropagation();
          if (isTransitioning) return;
          // 7. USE displayedItems HERE
          if (idx + d < 0 || idx + d >= displayedItems.length) return;
          idx += d;
          load();
        }
      }));
   
      const btnPrev = nav("❮", -1, "left");
      ov.appendChild(holder);
      const btnNext = nav("❯", 1, "right");

      // --- Slideshow Button ---
      const playBtn = $("button", {
        title: "Auto-play",
        innerHTML: '<span class="material-symbols-outlined" style="font-size:26px; vertical-align:middle; position:relative; top:2px;">animated_images</span>',
        style: `
          position:absolute; top:10px; right:50px; 
          background:none; border:none; color:#fff; cursor:pointer;
          padding: 4px; border-radius: 50%; transition: color 0.2s;
        `,
        onclick: (e) => {
          e.stopPropagation();
          if (slideshowTimer) {
            // Stop
            clearInterval(slideshowTimer);
            slideshowTimer = null;
            playBtn.style.color = "#fff"; 
            // Show arrows again
            btnPrev.style.display = "";
            btnNext.style.display = "";
          } else {
            // Start
            playBtn.style.color = "var(--localMediaGallerySpecialColor)"; 
            // Hide arrows
            btnPrev.style.display = "none";
            btnNext.style.display = "none";
            
            slideshowTimer = setInterval(() => {
              if (isTransitioning) return; 
              // 8. USE displayedItems HERE
              if (idx >= displayedItems.length - 1) idx = 0; 
              else idx++;
              load();
            }, 4600); // slideshow interval span
          }
        }
      });
      ov.appendChild(playBtn);

      ov.appendChild($("button", {
        textContent: "✕",
        style: "position:absolute;top:10px;right:10px;font-size:24px;background:none;border:none;color:#fff;cursor:pointer;",
        onclick: close
      }));
   
      let startX = 0, endX = 0;
      ov.addEventListener("touchstart", e => startX = e.changedTouches[0].clientX);
      ov.addEventListener("touchend", e => {
        endX = e.changedTouches[0].clientX;
        const delta = endX - startX;
        if (Math.abs(delta) > 50) {
          if (delta > 0 && idx > 0) { idx--; load(); }
          // 9. USE displayedItems HERE
          else if (delta < 0 && idx < displayedItems.length - 1) { idx++; load(); }
        }
      });
   
      document.body.appendChild(ov);
      load();
    };

    /* FurAI artifact viewer: reads the original stored Blob without modifying it. */
    async function openFuraiArtifactViewer(m, rec = null) {
      if (!m) return;

      const record = rec || await blobs.get(m.id);
      const blob = getMediaBlob(record);
      const info = cleanInfo(record?.info || {});
      if (!blob || !isFuraiArtifactInfo(info)) return openInfoEditor(m);

      const viewer = String(info.viewer || "");
      const requiresFuraiHiddenGate = isFuraiArtifactExportGateRequired(info);
      const requiresFuraiPg13Gate = isFuraiArtifactPg13GateRequired(info);
      const requiresFuraiExportGate = requiresFuraiHiddenGate || requiresFuraiPg13Gate;
      const title = getFuraiArtifactTitle(info);
      const iconClass = getFuraiArtifactIcon(viewer);
      const overlay = $("div", {
        dataset: { localMediaGalleryArtifactViewer: 1 },
        style: "display:flex;position:fixed;inset:0;background:rgba(0,0,0,.82);align-items:center;justify-content:center;z-index:10002;padding:14px;box-sizing:border-box;"
      });
      const modal = $("div", {
        style: "width:min(980px,96vw);height:min(88vh,900px);background:var(--background-color);color:var(--text-color);border:1px solid rgba(128,128,128,.45);border-radius:12px;box-shadow:0 18px 50px rgba(0,0,0,.42);display:flex;flex-direction:column;overflow:hidden;"
      });
      const header = $("div", {
        style: "display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid rgba(128,128,128,.35);background:var(--box-color);flex-shrink:0;"
      });
      const icon = $("i", {
        className: `${iconClass} fa-fw`,
        style: "font-size:18px;color:var(--localMediaGallerySpecialColor);flex-shrink:0;"
      });
      const heading = $("div", { style: "min-width:0;flex:1;" });
      heading.append(
        $("div", { textContent: title, title, style: "font-size:16px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" }),
        $("div", {
          textContent: [info.type || info.category || "FurAI Artifact", formatArtifactBytes(blob.size), info.fileName || ""].filter(Boolean).join(" · "),
          style: "font-size:12px;opacity:.68;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;"
        })
      );
      const closeBtn = $("button", {
        innerHTML: '<i class="fa-solid fa-xmark"></i>',
        title: "Close",
        style: "width:32px;height:32px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer;flex-shrink:0;"
      });
      header.append(icon, heading, closeBtn);

      const tabBar = $("div", {
        style: "display:flex;gap:4px;padding:8px 12px 0;border-bottom:1px solid rgba(128,128,128,.28);background:var(--background-color);flex-shrink:0;"
      });
      const previewTab = $("button", {
        textContent: viewer === "furai-lorebook" || viewer === "furai-glossary" ? "Content" : "Readable View",
        style: "padding:8px 11px;border:0;border-bottom:2px solid var(--localMediaGallerySpecialColor);background:transparent;color:inherit;cursor:pointer;font-weight:650;"
      });
      const rawTab = $("button", {
        textContent: viewer === "furai-lorebook" || viewer === "furai-glossary" ? "Raw Text" : "Safe JSON",
        disabled: true,
        style: "padding:8px 11px;border:0;border-bottom:2px solid transparent;background:transparent;color:inherit;cursor:pointer;opacity:.45;"
      });
      tabBar.append(previewTab, rawTab);

      const content = $("div", {
        style: "flex:1;min-height:0;overflow:auto;padding:14px;background:var(--background-color);"
      });
      const previewPanel = $("div", { style: "min-height:100%;" });
      const rawPanel = $("pre", {
        style: "display:none;margin:0;min-height:100%;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;"
      });
      previewPanel.appendChild($("div", { textContent: "Loading original file…", style: "padding:24px;text-align:center;opacity:.65;" }));
      content.append(previewPanel, rawPanel);

      const footer = $("div", {
        style: "display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-top:1px solid rgba(128,128,128,.35);background:var(--box-color);flex-shrink:0;flex-wrap:wrap;"
      });
      const unchangedNote = $("div", {
        textContent: requiresFuraiPg13Gate
          ? "When 18+ access is unavailable, Concept Board uses a PG-13 version automatically. The original remains unchanged."
          : requiresFuraiHiddenGate
            ? "Protected setup stays outside Safe JSON unless Full Copy is unlocked. The original remains unchanged."
            : "The stored item is unchanged. Download readable JSON or compressed GZ.",
        style: "font-size:11px;opacity:.62;line-height:1.35;flex:1 1 220px;"
      });
      const footerActions = $("div", {
        style: "display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-left:auto;"
      });
      const downloadJsonBtn = $("button", {
        innerHTML: '<i class="fa-solid fa-file-code fa-fw"></i> Download JSON',
        style: "padding:8px 11px;border:1px solid rgba(128,128,128,.4);border-radius:7px;background:var(--background-color);color:var(--text-color);cursor:pointer;font-weight:600;white-space:nowrap;",
        onclick: async () => {
          try {
            const result = await downloadBoardArtifactFormat(m, blob, info, "json");
            unchangedNote.textContent = result?.cancelled
              ? "Download cancelled. The stored item is unchanged."
              : result?.adultTagMode === "pg13"
                ? "PG-13 version ready. Adult-only labels were removed. The original remains unchanged."
                : result?.mode === "safe"
                  ? "Safe Copy JSON downloaded. The stored item is unchanged."
                  : "Readable JSON downloaded. The stored item is unchanged.";
          } catch (error) {
            unchangedNote.textContent = `JSON download failed: ${error?.message || error}`;
          }
        }
      });
      const downloadGzipBtn = $("button", {
        innerHTML: '<i class="fa-solid fa-file-zipper fa-fw"></i> Download GZ',
        style: "padding:8px 11px;border:1px solid rgba(128,128,128,.4);border-radius:7px;background:var(--background-color);color:var(--text-color);cursor:pointer;font-weight:600;white-space:nowrap;",
        onclick: async () => {
          try {
            const result = await downloadBoardArtifactFormat(m, blob, info, "gz");
            unchangedNote.textContent = result?.cancelled
              ? "Download cancelled. The stored item is unchanged."
              : result?.adultTagMode === "pg13"
                ? "PG-13 version ready. Adult-only labels were removed. The original remains unchanged."
                : result?.mode === "safe"
                  ? "Safe Copy GZ downloaded. The stored item is unchanged."
                  : "Compressed GZ downloaded. The stored item is unchanged.";
          } catch (error) {
            unchangedNote.textContent = `GZ download failed: ${error?.message || error}`;
          }
        }
      });

      const furaiBridge = getFuraiArtifactBridge(viewer);
      const furaiReturnAction = getFuraiArtifactReturnAction(furaiBridge, viewer);
      let furaiReturnBtn = null;

      if (furaiBridge && furaiReturnAction) {
        furaiReturnBtn = $("button", {
          innerHTML: `<i class="${furaiReturnAction.icon} fa-fw"></i> ${furaiReturnAction.label}`,
          style: "padding:8px 11px;border:0;border-radius:7px;background:var(--localMediaGallerySpecialColor);color:#fff;cursor:pointer;font-weight:600;white-space:nowrap;",
          onclick: async () => {
            if (furaiReturnBtn.dataset.busy === "1") return;

            const originalHtml = furaiReturnBtn.innerHTML;
            furaiReturnBtn.dataset.busy = "1";
            furaiReturnBtn.disabled = true;
            furaiReturnBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin fa-fw"></i> Working…';
            unchangedNote.textContent = `Sending the original ${info.type || "file"} back to FurAI…`;

            try {
              const result = await furaiBridge.importArtifact({
                blob,
                info: { ...info },
                title,
                viewer,
                fileName: getArtifactDownloadName(m, blob, info)
              });

              if (result === false || result?.ok === false) {
                if (result?.cancelled) {
                  unchangedNote.textContent = result.message || "Action cancelled. The stored file is unchanged.";
                  delete furaiReturnBtn.dataset.busy;
                  furaiReturnBtn.disabled = false;
                  furaiReturnBtn.innerHTML = originalHtml;
                  return;
                }
                throw new Error(result?.message || "FurAI did not accept this artifact.");
              }

              unchangedNote.textContent = result?.message || "Added to FurAI. The stored file is unchanged.";

              if (result?.closeBoard) {
                close();
                setTimeout(closeGallery, 0);
                return;
              }

              if (result?.closeViewer) {
                close();
                return;
              }

              furaiReturnBtn.innerHTML = result?.alreadyExists
                ? '<i class="fa-solid fa-check fa-fw"></i> Already in FurAI'
                : '<i class="fa-solid fa-check fa-fw"></i> Added to FurAI';
            } catch (error) {
              console.error("Could not return Concept Board artifact to FurAI.", error);
              unchangedNote.textContent = `Could not add this item to FurAI: ${error?.message || error}`;
              delete furaiReturnBtn.dataset.busy;
              furaiReturnBtn.disabled = false;
              furaiReturnBtn.innerHTML = originalHtml;
            }
          }
        });
        footerActions.appendChild(furaiReturnBtn);
      }

      footerActions.append(downloadJsonBtn, downloadGzipBtn);
      footer.append(unchangedNote, footerActions);
      modal.append(header, tabBar, content, footer);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);

      let rawText = "";
      let rawRendered = false;
      let protectedCharacterStats = null;
      let closed = false;

      const close = () => {
        if (closed) return;
        closed = true;
        document.removeEventListener("keydown", onKey);
        overlay.remove();
      };
      const onKey = event => {
        if (conceptBoardDialogDepth > 0) return;
        if (event.key === "Escape") close();
      };
      closeBtn.onclick = close;
      overlay.onclick = event => { if (event.target === overlay) close(); };
      document.addEventListener("keydown", onKey);

      const setActiveTab = showRaw => {
        previewPanel.style.display = showRaw ? "none" : "block";
        rawPanel.style.display = showRaw ? "block" : "none";
        previewTab.style.borderBottomColor = showRaw ? "transparent" : "var(--localMediaGallerySpecialColor)";
        rawTab.style.borderBottomColor = showRaw ? "var(--localMediaGallerySpecialColor)" : "transparent";
        previewTab.style.opacity = showRaw ? ".72" : "1";
        rawTab.style.opacity = showRaw ? "1" : ".72";

        if (showRaw && !rawRendered) {
          rawPanel.textContent = rawText;
          rawRendered = true;
        }
      };
      previewTab.onclick = () => setActiveTab(false);
      rawTab.onclick = () => setActiveTab(true);

      const addMetaRow = (container, label, value) => {
        if (value == null || String(value).trim() === "") return;
        const row = $("div", {
          style: "display:grid;grid-template-columns:minmax(110px,170px) minmax(0,1fr);gap:10px;padding:8px 0;border-bottom:1px solid rgba(128,128,128,.2);"
        });
        row.append(
          $("strong", { textContent: label, style: "font-size:12px;opacity:.72;" }),
          $("div", { textContent: String(value), style: "font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere;" })
        );
        container.appendChild(row);
      };

      const addSection = (container, label, value) => {
        if (value == null || String(value).trim() === "") return;
        const section = $("section", {
          style: "margin:0 0 14px;padding:12px;border:1px solid rgba(128,128,128,.28);border-radius:9px;background:var(--box-color);"
        });
        section.append(
          $("div", { textContent: label, style: "font-size:12px;font-weight:600;color:var(--localMediaGallerySpecialColor);margin-bottom:7px;" }),
          $("div", { textContent: decodeArtifactText(value), style: "font-size:13px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere;" })
        );
        container.appendChild(section);
      };

      try {
        await new Promise(resolve => requestAnimationFrame(resolve));
        rawText = await readBoardArtifactText(
          blob,
          Math.min(getBoardArtifactMaxBytes(viewer), FURAI_BOARD_MAX_PREVIEW_BYTES)
        );
        if (closed) return;
        const hasFuraiSafeView = !!(
          furaiBridge && typeof furaiBridge.sanitizeArtifactView === "function"
        );
        const setRawTabAvailable = available => {
          rawTab.disabled = !available;
          rawTab.style.opacity = available ? ".72" : ".35";
          rawTab.title = available
            ? ""
            : "Open this protected FurAI artifact inside FurAI to view a Safe Copy.";
        };

        // Ordinary artifacts may expose their decoded raw view immediately.
        // Protected-capable FurAI artifacts stay disabled until sanitization
        // succeeds and rawText has been replaced with the Safe Copy.
        setRawTabAvailable(!requiresFuraiExportGate);
        previewPanel.innerHTML = "";

        if (viewer === "furai-lorebook" || viewer === "furai-glossary") {
          let contentText = rawText;
          try {
            const parsedArtifact = JSON.parse(rawText);
            if (parsedArtifact && typeof parsedArtifact.content === "string") {
              contentText = parsedArtifact.content;
              rawText = JSON.stringify(parsedArtifact, null, 2);
            }
          } catch (error) {}
          if (rawRendered) rawPanel.textContent = rawText;
          const textView = $("pre", {
            textContent: contentText,
            style: "margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.6 system-ui,sans-serif;"
          });
          previewPanel.appendChild(textView);
          return;
        }

        let parsed;
        try {
          parsed = JSON.parse(rawText);

          if (viewer === "furai-character") {
            protectedCharacterStats = getFuraiCharacterProtectionStats(parsed);
          }

          if (requiresFuraiExportGate) {
            if (hasFuraiSafeView) {
              const safeView = furaiBridge.sanitizeArtifactView(parsed);
              if (!safeView?.data || typeof safeView.data !== "object") {
                throw new Error("FurAI could not create a Safe JSON view.");
              }
              parsed = safeView.data;
              rawText = JSON.stringify(parsed, null, 2);
              setRawTabAvailable(true);

              if (Number(safeView.adultTagCount || 0) > 0 && safeView.adultTagMode === "pg13") {
                unchangedNote.textContent = "PG-13 version ready. Adult-only labels were removed. The original remains unchanged.";
                previewPanel.appendChild($("div", {
                  textContent: unchangedNote.textContent,
                  style: "margin:0 0 12px;padding:10px 12px;border:1px solid rgba(128,128,128,.38);border-radius:8px;background:var(--box-color);font-size:12px;line-height:1.45;"
                }));
              }
            } else {
              rawText = "Protected FurAI setup is hidden in Concept Board. Open this item inside FurAI to create a Safe Copy or unlock a Full Copy.";
            }
          } else {
            rawText = JSON.stringify(parsed, null, 2);
          }
          if (rawRendered) rawPanel.textContent = rawText;
        } catch (parseError) {
          previewPanel.append(
            $("div", {
              textContent: requiresFuraiExportGate
                ? "This protected FurAI file could not be parsed safely. Its raw data remains hidden."
                : "This file is not valid JSON. Its decoded content is still available in Raw View.",
              style: "padding:12px;border:1px solid var(--alert-color);border-radius:8px;color:var(--alert-color);"
            })
          );
          return;
        }

        if (viewer === "furai-chat") {
          const chat = parsed?.chat || parsed || {};
          const messages = Array.isArray(chat?.messages) ? chat.messages : [];
          const summary = $("div", { style: "display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px;" });
          [
            `${messages.length} message${messages.length === 1 ? "" : "s"}`,
            chat?.personality || info.mode || "Unknown mode",
            chat?.timestamp ? new Date(Number(chat.timestamp)).toLocaleString() : ""
          ].filter(Boolean).forEach(value => {
            summary.appendChild($("span", {
              textContent: String(value),
              style: "padding:5px 8px;border-radius:999px;background:var(--box-color);border:1px solid rgba(128,128,128,.3);font-size:11px;"
            }));
          });
          const transcript = $("pre", {
            textContent: buildReadableFuraiChat(parsed),
            style: "margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.62 system-ui,sans-serif;"
          });
          previewPanel.append(summary, transcript);
          return;
        }

        if (viewer === "furai-character") {
          const meta = $("div", { style: "margin-bottom:14px;" });
          const protection = protectedCharacterStats || getFuraiCharacterProtectionStats(parsed);
          addMetaRow(meta, "Name", parsed?.name || title);
          addMetaRow(meta, "Tag", parsed?.hashTag);
          addMetaRow(meta, "Avatar", parsed?.avatar);
          addMetaRow(meta, "Sprite", parsed?.sprite);
          addMetaRow(meta, "Format", parsed?.type || info.type || "character");
          if (protection.label) {
            addMetaRow(meta, "Hidden Instructions", `${protection.label} · Hidden in Concept Board`);
          }
          previewPanel.appendChild(meta);
          addSection(previewPanel, "Instruction / Personality", getFuraiPublicCharacterInstruction(parsed));
          addSection(previewPanel, "Opening System Message", parsed?.openingSystemMessage);
          addSection(previewPanel, "Opening Message", parsed?.openingMessage);
          addSection(previewPanel, "Opening Background", parsed?.openingBackground);
          addSection(previewPanel, "Opening Lorebook", parsed?.openingLorebook);
          addSection(previewPanel, "Creator Notes", getFuraiPublicCreatorNotes(parsed));
          return;
        }

        if (viewer === "furai-backup") {
          const keys = parsed && typeof parsed === "object" && !Array.isArray(parsed) ? Object.keys(parsed) : [];
          const chatCount = keys.filter(key => /^chat-/i.test(key)).length;
          const profileCount = keys.filter(key => /^profile-/i.test(key)).length;
          const loreCount = keys.filter(key => /lorebook|reference|glossary/i.test(key)).length;
          const summary = $("div", { style: "display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px;" });
          [
            `${keys.length} top-level keys`,
            `${chatCount} chat records`,
            `${profileCount} profile records`,
            loreCount ? `${loreCount} lore/glossary records` : ""
          ].filter(Boolean).forEach(value => summary.appendChild($("span", {
            textContent: value,
            style: "padding:5px 8px;border-radius:999px;background:var(--box-color);border:1px solid rgba(128,128,128,.3);font-size:11px;"
          })));
          previewPanel.appendChild(summary);

          const structure = $("div", {
            style: "border:1px solid rgba(128,128,128,.28);border-radius:9px;overflow:hidden;"
          });
          keys.forEach(key => {
            const value = parsed[key];
            let shape = typeof value;
            if (Array.isArray(value)) shape = `Array (${value.length})`;
            else if (value && typeof value === "object") shape = `Object (${Object.keys(value).length})`;
            else if (typeof value === "string") shape = `String (${value.length})`;
            addMetaRow(structure, key, shape);
          });
          previewPanel.appendChild(structure);
        }
      } catch (error) {
        console.error("Could not open FurAI artifact.", error);
        if (!closed) {
          previewPanel.innerHTML = "";
          previewPanel.appendChild($("div", {
            textContent: `Preview unavailable: ${error?.message || error} Download or return the original item without previewing it.`,
            style: "padding:12px;border:1px solid var(--alert-color);border-radius:8px;color:var(--alert-color);"
          }));
        }
      }
    }

    /* info editor modal */
    async function openInfoEditor(m){
      const autoResize = el => {
        el.style.height = "auto";
        const nextHeight = Math.min(Math.max(el.scrollHeight + 2, 36), 180);
        el.style.height = `${nextHeight}px`;
        el.style.overflowY = el.scrollHeight > 180 ? "auto" : "hidden";
      };

      if (!m) return;
      const rec = await blobs.get(m.id);
      if (!rec) return;
      const mediaBlob = getMediaBlob(rec);
      const infoOrig = cleanInfo(rec.info || {});
      const reservedFuraiInfo = {};
      if (isFuraiArtifactInfo(infoOrig)) {
        reservedFuraiInfo.viewer = infoOrig.viewer;
        if (Object.prototype.hasOwnProperty.call(infoOrig, "furaiHiddenInstructions")) {
          reservedFuraiInfo.furaiHiddenInstructions = infoOrig.furaiHiddenInstructions;
        }
        if (Object.prototype.hasOwnProperty.call(infoOrig, "furaiProtectionMeta")) {
          reservedFuraiInfo.furaiProtectionMeta = infoOrig.furaiProtectionMeta;
        }
        if (Object.prototype.hasOwnProperty.call(infoOrig, "furaiAdultTags")) {
          reservedFuraiInfo.furaiAdultTags = infoOrig.furaiAdultTags;
        }
        if (Object.prototype.hasOwnProperty.call(infoOrig, "furaiPg13Meta")) {
          reservedFuraiInfo.furaiPg13Meta = infoOrig.furaiPg13Meta;
        }
      }
      const reservedFuraiKeys = new Set(Object.keys(reservedFuraiInfo));
      const hasSameInfo = (left, right) => {
        const leftKeys = Object.keys(left || {});
        const rightKeys = Object.keys(right || {});
        return leftKeys.length === rightKeys.length &&
          leftKeys.every(key => Object.prototype.hasOwnProperty.call(right, key) && left[key] === right[key]);
      };

      const overlay = $("div", {
        className: "localMediaGallery-modal-overlay",
        style: "display:flex;position:fixed;inset:0;background:rgba(0,0,0,.8);align-items:center;justify-content:center;z-index:10001;"
      });
      const modal = $("div", {
        className: "localMediaGallery-modal-shell",
        style: "background:light-dark(#fff,#222);color:light-dark(#000,#fff);width:min(680px,94vw);height:min(82vh,760px);display:flex;flex-direction:column;"
      });

      const header = $("div", { className: "localMediaGallery-modal-header" });
      const heading = $("div", {
        innerHTML: '<i class="fa-solid fa-pen-to-square fa-fw" style="margin-right:8px;"></i>Edit item info',
        style: "font-size:16px;font-weight:600;min-width:0;"
      });
      const closeBtn = $("button", {
        type: "button",
        title: "Close",
        innerHTML: '<i class="fa-solid fa-xmark"></i>',
        style: "width:34px;height:34px;border:0;border-radius:8px;background:transparent;color:inherit;cursor:pointer;flex-shrink:0;"
      });
      header.append(heading, closeBtn);

      const list = $("div", {
        style: "flex:1;overflow:auto;display:flex;flex-direction:column;gap:10px;padding:14px 16px;justify-content:flex-start;box-sizing:border-box;"
      });

      const rows = [];
      const plusBtn = $("button", {
        type: "button",
        innerHTML: '<i class="fa-solid fa-plus fa-fw"></i> Add entry',
        style: "min-height:40px;width:100%;border-radius:9px;border:1px dashed #888;background:transparent;color:inherit;cursor:pointer;font-weight:600;",
        onclick: () => addRow("", "")
      });
      list.appendChild(plusBtn);

      const addRow = (k = "", v = "") => {
        const keyInp = $("input", {
          value: k,
          placeholder: "Title*",
          style: "width:100%;min-height:36px;padding:7px 8px;font-size:13px;font-weight:600;border:0;border-bottom:1px solid rgba(128,128,128,.28);background:transparent;color:inherit;box-sizing:border-box;outline:none;"
        });
        const valArea = $("textarea", {
          value: v,
          placeholder: "Description",
          rows: 1,
          style: "width:100%;padding:8px;min-height:36px;max-height:180px;resize:none;overflow:hidden;border:0;background:transparent;color:inherit;box-sizing:border-box;font:13px/1.5 system-ui,sans-serif;outline:none;",
          oninput: () => autoResize(valArea)
        });
        const row = $("div", {
          className: "localMediaGallery-field-card",
          style: "display:flex;gap:4px;flex-direction:column;"
        }, keyInp, valArea);
        rows.push({ keyInp, valArea });
        list.insertBefore(row, plusBtn);
        setTimeout(() => autoResize(valArea), 0);
      };

      for (const [k, v] of Object.entries(infoOrig)) {
        if (!reservedFuraiKeys.has(k)) addRow(k, v);
      }

      // Display-only image text. It is generated from the one stored Blob while
      // this editor is open and is deliberately excluded from rows/gather/save.
      // Legacy items that already contain imageDataUrl remain untouched.
      const hasStoredImageDataUrl = Object.keys(infoOrig).some(
        key => String(key).trim().toLowerCase() === "imagedataurl"
      );

      if (mediaBlob?.type?.startsWith("image/") && !hasStoredImageDataUrl) {
        const keyLabel = $("input", {
          value: "imageDataUrl",
          readOnly: true,
          title: "Generated from the stored image. Not saved as duplicate metadata.",
          style: "width:100%;min-height:36px;padding:7px 8px;font-size:13px;font-weight:600;border:0;border-bottom:1px solid rgba(128,128,128,.28);background:transparent;color:inherit;box-sizing:border-box;outline:none;opacity:.78;"
        });
        const valueArea = $("textarea", {
          value: "Preparing copyable image text...",
          readOnly: true,
          rows: 3,
          spellcheck: false,
          style: "width:100%;padding:8px;min-height:72px;max-height:180px;resize:vertical;overflow:auto;border:0;background:transparent;color:inherit;box-sizing:border-box;font:12px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace;outline:none;"
        });
        const hint = $("div", {
          textContent: "Temporary view generated from the stored image. It is not written into Concept Board data.",
          style: "font-size:11px;line-height:1.4;opacity:.62;padding:0 8px 3px;"
        });
        const copyButton = $("button", {
          type: "button",
          disabled: true,
          innerHTML: '<i class="fa-regular fa-copy fa-fw"></i> Copy image text',
          style: "align-self:flex-end;min-height:34px;padding:0 10px;border:1px solid rgba(128,128,128,.42);border-radius:7px;background:transparent;color:inherit;cursor:pointer;font-size:12px;"
        });
        const derivedRow = $("div", {
          className: "localMediaGallery-field-card",
          dataset: { localMediaGalleryDerivedInfo: "1" },
          style: "display:flex;gap:6px;flex-direction:column;"
        }, keyLabel, valueArea, hint, copyButton);
        list.insertBefore(derivedRow, plusBtn);

        copyButton.onclick = async () => {
          const value = String(valueArea.value || "");
          if (!value.startsWith("data:image/")) return;
          try {
            await navigator.clipboard.writeText(value);
          } catch (error) {
            valueArea.focus();
            valueArea.select();
            document.execCommand("copy");
          }
          const original = copyButton.innerHTML;
          copyButton.innerHTML = '<i class="fa-solid fa-check fa-fw"></i> Copied';
          setTimeout(() => {
            if (copyButton.isConnected) copyButton.innerHTML = original;
          }, 1000);
        };

        const reader = new FileReader();
        reader.onload = () => {
          const value = String(reader.result || "");
          valueArea.value = value || "Could not create image text.";
          copyButton.disabled = !value.startsWith("data:image/");
        };
        reader.onerror = () => {
          valueArea.value = "Could not create image text from this stored image.";
          copyButton.disabled = true;
        };
        reader.readAsDataURL(mediaBlob);
      }

      const footer = $("div", { className: "localMediaGallery-modal-footer" });
      const cancelBtn = $("button", {
        type: "button",
        textContent: "Cancel",
        style: "min-height:38px;padding:0 14px;border:1px solid #888;border-radius:8px;background:transparent;color:inherit;cursor:pointer;"
      });
      const saveBtn = $("button", {
        type: "button",
        innerHTML: '<i class="fa-solid fa-floppy-disk fa-fw"></i> Save',
        style: "min-height:38px;padding:0 16px;background:var(--localMediaGallerySpecialColor);color:white;border:0;border-radius:8px;cursor:pointer;font-weight:600;"
      });
      footer.append(cancelBtn, saveBtn);

      modal.append(header, list, footer);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);

      const gather = () => {
        const o = { ...reservedFuraiInfo };
        rows.forEach(({ keyInp, valArea }) => {
          const key = keyInp.value.trim();
          if (key && !reservedFuraiKeys.has(key)) {
            o[key] = String(valArea.value);
          }
        });
        return o;
      };
      const maybeClose = async () => {
        if (!hasSameInfo(gather(), infoOrig)) {
          const discard = await askConceptBoardConfirm(
            "Discard the changes made in this editor?",
            { title: "Unsaved changes", confirmLabel: "Discard", danger: true }
          );
          if (!discard) return false;
        }
        document.removeEventListener("keydown", onKey);
        overlay.remove();
        return true;
      };
      const onKey = async e => {
        if (conceptBoardDialogDepth > 0) return;
        if (e.key === "Escape") await maybeClose();
      };

      document.addEventListener("keydown", onKey);
      overlay.onclick = async e => { if (e.target === overlay) await maybeClose(); };
      closeBtn.onclick = cancelBtn.onclick = async e => {
        e.stopPropagation();
        await maybeClose();
      };
      saveBtn.onclick = async e => {
        const keys = rows.map(({ keyInp }) => keyInp.value.trim()).filter(Boolean);
        if (keys.some(key => reservedFuraiKeys.has(key))) {
          await showConceptBoardNotice(
            "FurAI system metadata cannot be edited here.",
            { title: "Reserved item info" }
          );
          return;
        }
        if (keys.length !== new Set(keys).size) {
          await showConceptBoardNotice("Each note title must be unique.", { title: "Duplicate title" });
          return;
        }
        e.stopPropagation();
        document.removeEventListener("keydown", onKey);
        await blobs.set(m.id, { blob: mediaBlob, info: gather() });
        overlay.remove();
        loadGallery();
      };
    }

    /* Shared item action menu: one menu for the whole gallery, one trigger per card. */
    closeItemActionMenu = () => {
      if (itemActionAnchor) itemActionAnchor.setAttribute("aria-expanded", "false");
      itemActionMenu?.remove();
      itemActionMenu = null;
      itemActionAnchor = null;
    };

    const positionItemActionMenu = (menu, anchor) => {
      const rect = anchor.getBoundingClientRect();
      const menuRect = menu.getBoundingClientRect();
      const margin = 10;
      let left = rect.right - menuRect.width;
      let top = rect.bottom + 6;

      left = Math.max(margin, Math.min(left, window.innerWidth - menuRect.width - margin));
      if (top + menuRect.height > window.innerHeight - margin) {
        top = rect.top - menuRect.height - 6;
      }
      top = Math.max(margin, Math.min(top, window.innerHeight - menuRect.height - margin));

      menu.style.left = `${Math.round(left)}px`;
      menu.style.top = `${Math.round(top)}px`;
    };

    const openMoveItemPanel = async m => {
      const folderNames = getGalleryNames();
      const wrapper = document.createElement("div");
      wrapper.className = "localMediaGallery-modal-overlay";
      wrapper.style.cssText = "inset:0;background:rgba(0,0,0,.6);position:fixed;display:flex;align-items:center;justify-content:center;z-index:999999;";

      const box = document.createElement("div");
      box.className = "localMediaGallery-modal-shell";
      box.style.cssText = "background:light-dark(#fff,#222);color:inherit;width:min(360px,94vw);display:flex;flex-direction:column;";

      const header = document.createElement("div");
      header.className = "localMediaGallery-modal-header";
      const label = document.createElement("strong");
      label.textContent = selectedIds.has(m.id) && selectedIds.size > 1
        ? `Move ${selectedIds.size} items`
        : "Move item";
      const closeBtn = document.createElement("button");
      closeBtn.type = "button";
      closeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
      closeBtn.title = "Close";
      closeBtn.style.cssText = "width:34px;height:34px;border:0;border-radius:8px;background:transparent;color:inherit;cursor:pointer;";
      header.append(label, closeBtn);

      const body = document.createElement("div");
      body.style.cssText = "padding:16px;display:flex;flex-direction:column;gap:10px;";
      const fieldLabel = document.createElement("label");
      fieldLabel.textContent = "Destination page";
      fieldLabel.style.cssText = "font-size:12px;font-weight:600;opacity:.72;";
      const select = document.createElement("select");
      select.style.cssText = "min-height:40px;padding:8px 10px;font:14px system-ui;width:100%;box-sizing:border-box;border-radius:8px;";
      folderNames.forEach(n => {
        const opt = document.createElement("option");
        opt.value = n;
        opt.textContent = n;
        if (n === activeGalleryName) opt.selected = true;
        select.appendChild(opt);
      });
      const optNew = document.createElement("option");
      optNew.value = "__new__";
      optNew.textContent = "+ New page...";
      select.appendChild(optNew);
      body.append(fieldLabel, select);

      const footer = document.createElement("div");
      footer.className = "localMediaGallery-modal-footer";
      const cancelBtn = document.createElement("button");
      cancelBtn.type = "button";
      cancelBtn.textContent = "Cancel";
      cancelBtn.style.cssText = "min-height:38px;padding:0 14px;border:1px solid #888;border-radius:8px;background:transparent;color:inherit;cursor:pointer;";
      const okBtn = document.createElement("button");
      okBtn.type = "button";
      okBtn.textContent = "Move";
      okBtn.style.cssText = "min-height:38px;padding:0 16px;border:0;border-radius:8px;background:var(--localMediaGallerySpecialColor);color:#fff;cursor:pointer;font-weight:600;";
      footer.append(cancelBtn, okBtn);

      box.append(header, body, footer);
      wrapper.appendChild(box);
      document.body.appendChild(wrapper);

      const close = () => wrapper.remove();
      closeBtn.onclick = cancelBtn.onclick = close;
      wrapper.onclick = e => { if (e.target === wrapper) close(); };

      okBtn.onclick = async () => {
        let targetPage = select.value;
        if (targetPage === "__new__") {
          const names = getGalleryNames();
          targetPage = await askConceptBoardText(
            "Choose a name for the destination page.",
            {
              title: "New destination page",
              placeholder: "Page_name",
              confirmLabel: "Create page",
              validate: value => {
                const candidate = String(value).trim();
                if (!CONCEPT_BOARD_PAGE_NAME_RE.test(candidate)) return "Use only letters, numbers, and underscores (_).";
                if (names.includes(candidate)) return "That page already exists.";
                return true;
              }
            }
          );
          if (!targetPage) return;
          targetPage = targetPage.trim();
          saveGalleryNames([...names, targetPage]);
        }
        if (!targetPage || targetPage === activeGalleryName) return close();

        const targets = selectedIds.has(m.id)
          ? mediaArr.filter(x => selectedIds.has(x.id))
          : [m];
        okBtn.disabled = true;
        okBtn.textContent = "Moving...";
        for (const item of targets) {
          await kv[pre + targetPage].set(item.id, item);
          await kv[pre + activeGalleryName].delete(item.id);
        }
        selectedIds.clear();
        await refreshFolderList();
        await loadGallery();
        close();
      };
    };

    const downloadItemOrSelection = async m => {
      if (selectedIds.has(m.id)) {
        await runBatchAction(m, "download");
        return;
      }

      const rec = await blobs.get(m.id);
      const blob = getMediaBlob(rec);
      const info = rec?.info || {};
      if (!blob) {
        await showConceptBoardNotice("This item is a note and has no file to download.", { title: "Nothing to download" });
        return;
      }
      if (info.url && blob.type.startsWith("text/")) {
        await showConceptBoardNotice("This item points to a web page rather than a downloadable file.", { title: "Link item" });
        return;
      }
      if (isFuraiArtifactInfo(info)) {
        openFuraiArtifactViewer(m, rec);
        return;
      }
      downloadBoardItemBlob(m, blob, info);
    };

    const openItemActionMenu = (m, anchor) => {
      const wasOpenForSameAnchor = itemActionMenu && itemActionAnchor === anchor;
      closeItemActionMenu();
      if (wasOpenForSameAnchor) return;

      itemActionAnchor = anchor;
      anchor.setAttribute("aria-expanded", "true");
      const menu = $("div", {
        className: "localMediaGallery-item-menu",
        role: "menu",
        onclick: e => e.stopPropagation()
      });
      itemActionMenu = menu;

      const isSelectionAction = selectedIds.has(m.id);
      const affectedCount = isSelectionAction ? selectedIds.size : 1;
      if (affectedCount > 1) {
        menu.appendChild($("div", {
          className: "localMediaGallery-item-menu-header",
          textContent: `${affectedCount} selected items`
        }));
      }

      const addAction = (icon, label, handler, options = {}) => {
        const btn = $("button", {
          type: "button",
          role: "menuitem",
          dataset: options.danger ? { danger: "1" } : {},
          innerHTML: `<i class="${icon} fa-fw"></i><span>${label}</span>`,
          onclick: async e => {
            e.stopPropagation();
            await handler(btn);
          }
        });
        menu.appendChild(btn);
        return btn;
      };

      addAction("fa-solid fa-pen-to-square", "Edit info", async () => {
        closeItemActionMenu();
        await openInfoEditor(m);
      });

      addAction("fa-solid fa-download", affectedCount > 1 ? `Download ${affectedCount} items` : "Download", async () => {
        closeItemActionMenu();
        await downloadItemOrSelection(m);
      });

      const ratingTargets = isSelectionAction
        ? mediaArr.filter(item => selectedIds.has(item.id))
        : [m];

      const readRatingState = () => {
        const values = ratingTargets.map(item => Number(item.rating) || 0);
        const same = values.every(value => value === values[0]);
        const current = same ? values[0] : null;
        const quick = Number.isInteger(current) && current >= 1 && current <= 5
          ? current
          : 0;
        return { same, current, quick };
      };

      const ratingRow = $("div", {
        role: "group",
        ariaLabel: affectedCount > 1 ? `Quick rating for ${affectedCount} items` : "Quick rating",
        style: "padding:4px 6px 6px 6px;display:flex;flex-direction:column;align-items:stretch;gap:1px;box-sizing:border-box;"
      });

      const ratingTopRow = $("div", {
        style: "width:100%;min-height:28px;display:grid;grid-template-columns:22px minmax(0,1fr) auto;align-items:center;column-gap:4px;"
      });

      const ratingHeaderIcon = $("i", {
        className: "fa-regular fa-star fa-fw",
        style: "width:22px;min-width:22px;text-align:center;opacity:1;color:inherit;transform:translateX(1px);"
      });

      const ratingLabel = $("div", {
        style: "min-width:0;display:flex;align-items:center;gap:6px;"
      });

      const ratingValue = $("span", {
        style: "min-width:0;max-width:72px;padding:1px 6px;border-radius:999px;background:var(--box-color);font-size:10px;opacity:.72;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
      });

      ratingLabel.append(
        $("span", {
          textContent: "Rate",
          style: "font-size:12.5px;font-weight:500;white-space:nowrap;"
        }),
        ratingValue
      );

      const editRatingBtn = $("button", {
        type: "button",
        title: "Edit numeric rating",
        ariaLabel: "Edit numeric rating",
        innerHTML: '<i class="fa-solid fa-pen"></i>',
        style: "width:26px;min-width:26px;height:26px;min-height:26px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:11px;",
        onmouseover: e => { e.currentTarget.style.background = "var(--box-color)"; },
        onmouseout: e => { e.currentTarget.style.background = "transparent"; },
        onclick: async e => {
          e.stopPropagation();
          closeItemActionMenu();
          await runBatchAction(m, "rate");
        }
      });

      ratingTopRow.append(ratingHeaderIcon, ratingLabel, editRatingBtn);

      const stars = $("div", {
        style: "display:flex;align-items:center;justify-content:flex-start;gap:0;padding:0;"
      });
      const starButtons = [];

      const refreshQuickRatingUI = () => {
        const { same, current, quick } = readRatingState();

        ratingValue.textContent = same ? String(current) : "Mixed";
        ratingValue.title = same
          ? `Current rating: ${current}`
          : "Selected items have different ratings";

        starButtons.forEach((button, index) => {
          const star = index + 1;
          const filled = star <= quick;
          button.innerHTML = `<i class="${filled ? "fa-solid" : "fa-regular"} fa-star"></i>`;
          button.style.color = filled ? "light-dark(#a86f00,#f2c14e)" : "inherit";
          button.style.opacity = filled ? "1" : ".42";
          button.title = quick === star
            ? "Clear quick rating"
            : `Quick rate ${star} star${star === 1 ? "" : "s"}`;
          button.setAttribute(
            "aria-label",
            quick === star
              ? "Clear quick rating"
              : `Rate ${star} star${star === 1 ? "" : "s"}`
          );
        });
      };

      for (let star = 1; star <= 5; star++) {
        const starBtn = $("button", {
          type: "button",
          style: "width:20px;min-width:20px;height:22px;min-height:22px;padding:0;border:0;border-radius:4px;background:transparent;color:inherit;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:11px;",
          onmouseover: e => {
            e.currentTarget.style.background = "var(--box-color)";
            e.currentTarget.style.opacity = "1";
          },
          onmouseout: e => {
            e.currentTarget.style.background = "transparent";
            refreshQuickRatingUI();
          },
          onclick: async e => {
            e.stopPropagation();

            const { quick } = readRatingState();
            const nextRating = quick === star ? 0 : star;

            for (const item of ratingTargets) {
              item.rating = nextRating;
              await kv[pre + activeGalleryName].set(item.id, item);
            }

            // Keep the menu open so the user can continue adjusting the rating.
            refreshQuickRatingUI();
          }
        });

        starButtons.push(starBtn);
        stars.appendChild(starBtn);
      }

      const ratingStarsRow = $("div", {
        style: "display:flex;align-items:center;justify-content:flex-start;padding:0 0 0 2px;"
      });
      ratingStarsRow.appendChild(stars);

      refreshQuickRatingUI();
      ratingRow.append(ratingTopRow, ratingStarsRow);
      menu.appendChild(ratingRow);

      addAction("fa-solid fa-arrow-right-from-bracket", affectedCount > 1 ? `Move ${affectedCount} items` : "Move to page", async () => {
        closeItemActionMenu();
        await openMoveItemPanel(m);
      });

      menu.appendChild($("div", { className: "localMediaGallery-item-menu-group-gap" }));

      const deleteLabel = affectedCount > 1 ? `Delete ${affectedCount} items` : "Delete item";
      addAction("fa-solid fa-trash", deleteLabel, async () => {
        closeItemActionMenu();
        await runBatchAction(m, "delete");
      }, { danger: true });

      root.appendChild(menu);
      positionItemActionMenu(menu, anchor);
    };

    /* item controls */
    const controls = (m, ph) => {
      let btnSize = 32;
      if (viewMode === "list") btnSize = 24;
      else if (viewMode === "details" || viewMode === "smaller") btnSize = 28;
      else if (viewMode === "smallest") btnSize = 24;

      const isSelected = selectedIds.has(m.id);
      const controlInset = (viewMode === "list" || viewMode === "smallest") ? 5 : viewMode === "details" ? 6 : 7;

      const layer = $("div", {
        style: "position:absolute;inset:0;z-index:999910;pointer-events:none;"
      });

      const selBtn = $("button", {
        className: "localMediaGallery-card-action",
        dataset: { localMediaGalleryBar: 1 },
        title: "Select",
        type: "button",
        style: `
          position:absolute;top:${controlInset}px;left:${controlInset}px;
          width:${btnSize}px;height:${btnSize}px;border-radius:7px;
          pointer-events:auto;
          background-color:${isSelected ? "var(--localMediaGallerySpecialColor)" : "rgba(0,0,0,.78)"};
          ${isSelected ? "opacity:1;pointer-events:auto;" : ""}
        `,
        onclick: e => {
          e.stopPropagation();
          closeItemActionMenu();
          const wasSelected = selectedIds.has(m.id);

          if (e.shiftKey && lastSelectedId && lastSelectedId !== m.id) {
            const idx1 = displayedItems.findIndex(x => x.id === lastSelectedId);
            const idx2 = displayedItems.findIndex(x => x.id === m.id);
            if (idx1 !== -1 && idx2 !== -1) {
              const start = Math.min(idx1, idx2);
              const end = Math.max(idx1, idx2);
              for (let i = start; i <= end; i++) {
                const targetId = displayedItems[i].id;
                selectedIds.add(targetId);
                updateItemVisuals(targetId);
              }
            }
          } else {
            if (wasSelected) selectedIds.delete(m.id);
            else {
              selectedIds.add(m.id);
              lastSelectedId = m.id;
            }
            updateItemVisuals(m.id);
          }
          updateSelectModeUI();
        }
      });
      selBtn.innerHTML = isSelected
        ? '<i class="fa-solid fa-check"></i>'
        : '<i class="fa-regular fa-square"></i>';

      const moreBtn = $("button", {
        className: "localMediaGallery-card-action",
        dataset: { localMediaGalleryBar: 1 },
        title: "More actions",
        type: "button",
        style: `
          position:absolute;top:${controlInset}px;right:${controlInset}px;
          width:${btnSize}px;height:${btnSize}px;border-radius:7px;
          pointer-events:auto;
        `,
        onclick: e => {
          e.stopPropagation();
          openItemActionMenu(m, moreBtn);
        }
      });
      moreBtn.innerHTML = '<i class="fa-solid fa-ellipsis-vertical"></i>';
      moreBtn.setAttribute("aria-label", "More actions");
      moreBtn.setAttribute("aria-haspopup", "menu");
      moreBtn.setAttribute("aria-expanded", "false");

      layer.append(selBtn, moreBtn);
      return layer;
    };

    const sortFn = () => {
      switch (sortValue) {
        case "random": return () => 0; // Do nothing, array is pre-shuffled
        case "dateAsc": return (a, b) => a.date - b.date;
        case "ratingDesc": return (a, b) => b.rating - a.rating;
        case "ratingAsc": return (a, b) => a.rating - b.rating;
        default: return (a, b) => b.date - a.date; // dateDesc
      }
    };
    
    /* render */
    const render = () => {
      closeItemActionMenu();
      // Fix: Revoke all lingering blob URLs before rerender
      grid.querySelectorAll("img[src^='blob:'], video[src^='blob:']").forEach(el => {
        try { URL.revokeObjectURL(el.src); } catch (e) {}
      });
      grid.innerHTML = "";
      
      const h = viewMode === "list"
        ? 36
        : viewMode === "details"
          ? (isMobile ? 56 : 60)
          : viewMode === "regular"
            ? 300
            : viewMode === "smaller"
              ? 200
              : 150;
      const isRowView = viewMode === "list" || viewMode === "details";

      // --- 1. NEW CODE MOVED HERE (Start) ---
      const addItemBtn = $("div", {
        className: "localMediaGallery-card localMediaGallery-add-card",
        title: "Add New Item",
        tabIndex: 0,
        role: "button",
        style: `
          flex:0 0 ${isRowView ? "100%" : `${h}px`};
          height:${h}px;
          cursor:pointer;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:${isRowView ? 16 : h / 4}px;
        `,
        onclick: openAddItemPanel,
        onkeydown: event => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openAddItemPanel();
          }
        }
      });
      addItemBtn.innerHTML = `<i class="fa fa-plus fa-2xs"></i>`;
      grid.appendChild(addItemBtn);
      // --- NEW CODE ENDS ---

      // --- random sorting ---
      if (sortValue === "random") {
        if (!window.randomOrderApplied) {
          // Shuffle mediaArr in place
          for (let i = mediaArr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [mediaArr[i], mediaArr[j]] = [mediaArr[j], mediaArr[i]];
          }
          window.randomOrderApplied = true;
        }
      } else {
        // Reset the flag if sort is no longer random
        window.randomOrderApplied = false;
      }

      // 2. Filter & Sort -> 3. Render Items AFTER the button
      displayedItems = mediaArr.filter(matchesSearch).sort(sortFn());
      
      displayedItems.forEach(m => {
        let w = m.w ? (m.w / m.h) * h : h;
        /* --- NEW: Selection Visuals --- */
        const isSel = selectedIds.has(m.id);
        const selStyle = isSel
          ? `box-shadow:0 0 0 3px var(--localMediaGallerySpecialColor);${isRowView ? "" : "transform:scale(0.96);"}transition:all .1s;`
          : ``;
        if (isMobile && !isRowView) w = Math.min(w, window.innerWidth - 12);
        const cardBasis = isRowView ? "100%" : `${w}px`;
        const ph=$("div", {
          className:"localMediaGallery-card",
          dataset:{id:m.id, localMediaGalleryItem:1}, 
          style:`flex:0 0 ${cardBasis};height:${h}px;background:light-dark(#ddd,#444);position:relative;max-width:100%;box-sizing:border-box; ${selStyle}`
        });
        ph.appendChild(controls(m, ph));
        grid.appendChild(ph);
      });

      observe();
      updateSelectModeUI();
    };
    
    /* load gallery */
    const loadGallery = async() => {
      const sequence = ++galleryLoadSequence;
      activeGalleryLoadTask?.close();
      const task = createConceptBoardTaskProgress({
        title: "Loading Concept Board Page",
        message: `Loading “${activeGalleryName}”...`
      });
      activeGalleryLoadTask = task;

      try {
        const nextMediaArr = await kv[pre + activeGalleryName].values();
        if (sequence !== galleryLoadSequence) return;
        mediaArr = nextMediaArr;
        buildSearchIndex(); // Start indexing text in background (Async)
        task.update({
          message: `Rendering ${mediaArr.length.toLocaleString()} item${mediaArr.length === 1 ? "" : "s"}...`,
          percent: null
        });
        if (mediaArr.length >= 100) task.show();
        await nextConceptBoardPaint();
        if (sequence !== galleryLoadSequence) return;
        render();
        await nextConceptBoardPaint();
      } finally {
        task.close();
        if (activeGalleryLoadTask === task) activeGalleryLoadTask = null;
      }
    };
    loadGallery();
  }


  return {add,show,getActiveFolderName:()=>activeGalleryName,clearAllData};
  
$meta
  title = AI Furry Generator Concept Board
  description = An improved, all-in-one concept board. Save notes, images, and play links from Spotify or YouTube.
  image = https://user.uploads.dev/file/fdcd4651692a065a2a857fd577d5c8c1.jpg
  header 
    mode = minimal