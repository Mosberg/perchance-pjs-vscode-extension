// 2025-10-31 built for https://perchance.org/ai-furry-generator

$output
  No Style ⓘ
    prompt = [input.description]
    negative = [input.negative || ""]
    modifiers
      default style = [userModifiers.defaultStyles]
      default modifier
        ─── Furry Buff ─── = [""]
        ectomorph = , athletic build, slim yet firm, fit and jacked, vein, toned muscles, tall with long and lean limbs 
        mesomorph = , big muscles, broad shoulders, veiny muscles, vein
        endomorph = , huge muscles, chunky, slightly chubby, musclegut, love handles
        chest = , pecs, collarbone, big pecs, huge pecs
        back = , back muscles, back groove, shoulder blades, broad back, latissimus dorsi, thick neck
        shoulders = , broad shoulders, deltoids
        arms = , thick arms, muscular arms, biceps, triceps, forearm muscles, veiny arms
        core = , abs, serratus, obliques, v-cut
        legs = , thick thighs, muscular legs, quads, gluteal muscles
