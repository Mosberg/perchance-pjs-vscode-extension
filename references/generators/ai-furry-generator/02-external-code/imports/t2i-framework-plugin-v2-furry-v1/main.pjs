    ___imageStudioRuntime746291937 = null;
    try{ runtime.dispose(); }catch(error){ console.warn("Image Studio cleanup failed:", error); }
  };

  const ___ensureImageStudioRuntime746291937 = () => {
    if(___imageStudioRuntime746291937) return ___imageStudioRuntime746291937;
    ___imageStudioRuntime746291937 = ___createImageStudioRuntime746291937(___disposeImageStudioRuntime746291937);
    return ___imageStudioRuntime746291937;
  };

  // Always-light public bridge. It does not create Studio until a method that
  // actually needs the runtime is called.
  window.aifgImageStudioBridge = Object.freeze({
    isBatchBusy(){
      return ___imageStudioRuntime746291937?.isBatchBusy?.() === true;
