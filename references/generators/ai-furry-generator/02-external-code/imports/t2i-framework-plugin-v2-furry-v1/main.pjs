  window.__destroySocialIframes = function(container) {
    if (!container) return;

    container.querySelectorAll('iframe').forEach(frame => {
      if (typeof window.aifgRemoveIframe === 'function') {
        window.aifgRemoveIframe(frame);
      } else {
        frame.remove();
      }
    });

    container.replaceChildren();
  };

  window.__socialPanelMemory = (() => {
    const existingTimers = window.__socialPanelMemory?.timers || {
      comments: null,
      gallery: null
    };

    const clear = panel => {
      const timer = existingTimers[panel];
      if (!timer) return;
      clearTimeout(timer);
      existingTimers[panel] = null;
    };

    const getMode = panel => {
      const mode = localStorage.getItem(`pl_mem_${panel}`) || '3min';
      return ['immediate', '3min', 'forever'].includes(mode) ? mode : '3min';
    };

    const getDelay = () => {
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      return isIOS ? 60000 : 180000;
    };

    const open = (panel, mount) => {
      clear(panel);
      mount();
    };

    const close = (panel, unmount) => {
      clear(panel);

      const mode = getMode(panel);
      if (mode === 'forever') return;
      if (mode === 'immediate') {
        unmount();
        return;
      }

      existingTimers[panel] = setTimeout(() => {
        existingTimers[panel] = null;
        unmount();
      }, getDelay());
    };

    return { timers: existingTimers, clear, getMode, open, close };
  })();

  window.__mountCommentsPanel = function() {
    const container = document.getElementById('commentsPluginCtn654732');
    if (!container || container.childElementCount > 0) return;
    container.appendChild(window.generateCommentsPluginElement85638294());
  };

  window.__unmountCommentsPanel = function() {
    const container = document.getElementById('commentsPluginCtn654732');
    window.__destroySocialIframes(container);
  };

  window.__aifgGalleryResumeSrc = window.__aifgGalleryResumeSrc || "";

  window.__captureGalleryResumeSrc = function(frame) {
    if (!frame) return "";
    const src = String(frame.getAttribute('src') || frame.src || '').trim();
    if (!src || src === 'about:blank' || src.startsWith('about:blank#')) return "";
    window.__aifgGalleryResumeSrc = src;
    frame.dataset.aifgGalleryResumeSrc = src;
    return src;
  };

  // When Gallery starts folded, keep the exact server-rendered plugin iframe shell
  // but prevent its document from loading. Renaming the Gallery class also keeps
  // startup changeAll() from trying to navigate the dormant about:blank frame.
  window.__makeDormantInitialGalleryHtml = function(html) {
    return String(html || '').replace(
      /<iframe\b[^>]*class=["'][^"']*text-to-image-plugin-gallery[^"']*["'][^>]*>/i,
      tag => {
        const srcMatch = tag.match(/\bsrc=(["'])(.*?)\1/i);
        if (!srcMatch || !srcMatch[2]) return tag;

        const quote = srcMatch[1];
        const realSrc = srcMatch[2];

        return tag
          .replace(/text-to-image-plugin-gallery/g, 'text-to-image-plugin-gallery-dormant')
          .replace(/\bsrc=(["'])(.*?)\1/i, `src=${quote}about:blank${quote}`)
          .replace(/>$/, ` data-aifg-gallery-resume-src=${quote}${realSrc}${quote}>`);
      }
    );
  };

  window.__mountGalleryPanel = function() {
    const container = document.getElementById('imageGalleryCtn8569284');
    if (!container) return;

    const savedGallery = localStorage.getItem('t2i_current_folder') || 'public';
    window.__t2iCurrentGallery = savedGallery;
    window.__t2iCurrentFolder = savedGallery;

    const galleryFrames = [...container.querySelectorAll(
      'iframe.text-to-image-plugin-gallery, iframe.text-to-image-plugin-gallery-dormant'
    )];

    // The main Gallery owns exactly one iframe shell. If an older toggle cycle or
    // hot-reload left an extra shell behind, remove it before doing any mount work.
    let frame = galleryFrames.shift() || null;
    galleryFrames.forEach(extraFrame => {
      if (typeof window.aifgRemoveIframe === 'function') {
        window.aifgRemoveIframe(extraFrame);
      } else {
        extraFrame.remove();
      }
    });

    let wasDormant = false;

    // socialFeatures=button legitimately begins without Gallery markup.
    // Create a dormant shell first so the loader can bind before the real URL starts.
    if (!frame) {
      const galleryHtml = window.__makeDormantInitialGalleryHtml(
        window.generateImageGalleryHtml358402048()
      );
      if (!galleryHtml) return;

      // This container is single-owner: never append a second Gallery beneath stale markup.
      container.replaceChildren();
      container.insertAdjacentHTML('beforeend', galleryHtml);

      frame = container.querySelector(
        'iframe.text-to-image-plugin-gallery, iframe.text-to-image-plugin-gallery-dormant'
      );
      if (!frame) return;
    }

    if (frame.classList.contains('text-to-image-plugin-gallery-dormant')) {
      wasDormant = true;
      frame.classList.remove('text-to-image-plugin-gallery-dormant');
      frame.classList.add('text-to-image-plugin-gallery');
    }

    const currentSrc = String(frame.getAttribute('src') || '').trim();
    const isBlank = !currentSrc || currentSrc === 'about:blank' || currentSrc.startsWith('about:blank#');

    if (isBlank) {
      const resumeSrc = frame.dataset.aifgGalleryResumeSrc || window.__aifgGalleryResumeSrc || '';
      if (!resumeSrc) return;

      window.__aifgGalleryResumeSrc = resumeSrc;
      const loaderHost = window.__getGalleryLoaderHost?.() || frame.parentElement;

      // Replay a remembered search once, after the controlled first load. The base URL
      // already contains the saved folder, so an empty search needs no second navigation.
      if (wasDormant && typeof window.changeAll === 'function') {
        const rememberSearch = localStorage.getItem('pl_rememberGallerySearch') === 'true';
        const tagValue = rememberSearch ? (localStorage.getItem('lookForThis') || '') : '';
        const badTagValue = rememberSearch ? (localStorage.getItem('dontLookForThis') || '') : '';

        if (tagValue.trim() || badTagValue.trim()) {
          const readyEvent = typeof window.aifgLoadIframe === 'function' ? 'aifg:iframe-ready' : 'load';
          frame.addEventListener(readyEvent, () => {
            window.changeAll?.(tagValue, badTagValue);
          }, { once: true });
        }
      }

      if (typeof window.aifgLoadIframe === 'function') {
        window.aifgLoadIframe(frame, resumeSrc, {
          label: 'Loading Gallery…',
          host: loaderHost,
          fullHost: true,
          readyDelayMs: 250
        });
      } else {
        frame.setAttribute('src', resumeSrc);
      }
    } else {
      window.__captureGalleryResumeSrc(frame);
      const loaderHost = window.__getGalleryLoaderHost?.() || frame.parentElement;

      if (typeof window.aifgLoadIframe === 'function') {
        // This is idempotent for a tracked ready frame, so returning to a retained
        // tab hides stale masks without reloading. An untracked frame is navigated
        // once through the loader so readiness can no longer be missed.
        window.aifgLoadIframe(frame, currentSrc, {
          label: 'Loading Gallery…',
          host: loaderHost,
          fullHost: true,
          readyDelayMs: 250
        });
      }
    }

    const nameEl = document.getElementById('currentGalleryName');
    if (nameEl) nameEl.textContent = savedGallery;

    if (typeof window.__updateGalleryFilterBtn === 'function') {
      window.__updateGalleryFilterBtn();
    }
  };

  window.__unmountGalleryPanel = function() {
    const container = document.getElementById('imageGalleryCtn8569284');
    const loaderHost = document.getElementById('imageGalleryLoaderHost8569284');
    const frame = container?.querySelector('iframe.text-to-image-plugin-gallery');

    window.aifgHideIframeMasks?.(loaderHost);
    if (!frame) return;

    window.__captureGalleryResumeSrc(frame);

    // Keep only a clean, blank iframe shell. The Gallery document itself is fully unloaded,
    // and replace:true also discards the old iframe's loader/runtime state.
    if (typeof window.aifgUnloadIframe === 'function') {
      window.aifgUnloadIframe(frame, { replace: true });
    } else {
      frame.setAttribute('src', 'about:blank');
    }
  };

  window.__syncSocialPanelMounts = function() {
    const commentsOpen = localStorage.getItem('commentToggleOpen') !== '0';
    const commentButton = document.getElementById('commentToggleBtn');
    const commentContainer = document.getElementById('commentsPluginCtn654732');
    const commentArrow = document.getElementById('commentArrow');
    const commentLine = document.getElementById('commentBottomLine');

    if (commentButton) commentButton.dataset.hidden = commentsOpen ? '' : '1';
    if (commentContainer) commentContainer.style.display = commentsOpen ? '' : 'none';
    if (commentLine) commentLine.style.display = commentsOpen ? 'block' : 'none';
    if (commentArrow) commentArrow.style.transform = commentsOpen ? 'rotate(0deg)' : 'rotate(-90deg)';

    if (commentsOpen) {
      window.__socialPanelMemory.open('comments', window.__mountCommentsPanel);
    } else {
      window.__socialPanelMemory.close('comments', window.__unmountCommentsPanel);
    }

    const galleryOpen = localStorage.getItem('galleryCollapsed') !== 'true';
    const galleryContainer = document.getElementById('galleryBodyContainer');
    const galleryArrow = document.getElementById('galleryArrow');
    const galleryLine = document.getElementById('galleryBottomLine');

    if (galleryContainer) galleryContainer.style.display = galleryOpen ? 'block' : 'none';
    if (galleryLine) galleryLine.style.display = galleryOpen ? 'block' : 'none';
    if (galleryArrow) galleryArrow.style.transform = galleryOpen ? 'rotate(0deg)' : 'rotate(-90deg)';

    if (galleryOpen) {
      window.__socialPanelMemory.open('gallery', window.__mountGalleryPanel);
      setTimeout(window.__galleryUpdateZoomAll, 50);
    } else {
      window.__socialPanelMemory.close('gallery', window.__unmountGalleryPanel);
    }
  };

  window.__toggleCommentsPanel = function() {
    const button = document.getElementById('commentToggleBtn');
    const container = document.getElementById('commentsPluginCtn654732');
    const arrow = document.getElementById('commentArrow');
    const line = document.getElementById('commentBottomLine');
    if (!button || !container) return;

    const isClosed = button.dataset.hidden === '1';

    if (isClosed) {
      button.dataset.hidden = '';
      localStorage.setItem('commentToggleOpen', '1');
      container.style.display = '';
      if (line) line.style.display = 'block';
      if (arrow) arrow.style.transform = 'rotate(0deg)';
      window.__socialPanelMemory.open('comments', window.__mountCommentsPanel);
    } else {
      button.dataset.hidden = '1';
      localStorage.setItem('commentToggleOpen', '0');
      container.style.display = 'none';
      if (line) line.style.display = 'none';
      if (arrow) arrow.style.transform = 'rotate(-90deg)';
      window.__socialPanelMemory.close('comments', window.__unmountCommentsPanel);
    }
  };

  window.__showSocialsButtonClickHandler98347938 = function() {
    showHideGalleryAndCommentsButtonsCtn83728732671.style.display = '';
