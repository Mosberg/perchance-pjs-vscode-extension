  window.___selectElChangeEvent746291937 = function(event) {
    let inputName = this.dataset.name;
    let userInputSpec = window.___userSettings746291937.userInputs[inputName];
    let optionsList = userInputSpec.compiledOptions;

    let displayName;
    let titleName;

    if (this.value.startsWith("ref:optionKeyName:")) {
      let key = this.value.split(":")[2];
      let selectedOption = optionsList[key];

      window.input[inputName] = selectedOption;
      userInputSpec.value = selectedOption;

      displayName = selectedOption?.name ? String(selectedOption.name) : key;
      titleName = key;
    } else {
      window.input[inputName] = this.value;
      userInputSpec.value = this.value;

      displayName = this.value;
      titleName = this.value;
    }

    let visualSelectBtn = this.parentElement.querySelector(".visual-select-btn");
    if (visualSelectBtn) {
      visualSelectBtn.innerHTML = displayName;
      visualSelectBtn.title = String(titleName || "Select.")
        .replace(/<[^>]*>?/gm, "")
        .replace(/"/g, "&quot;")
        .trim();
    }

    if (!event._isInitCall) {
      if (userInputSpec.remember) {
        saveRememberedInput(inputName, this.value);
      }
    }

    if (!event._isInitCall) {
      updateInputVisibilities();
    }
  };

