  window.__sharePromptButtonResetTimer746291937 = null;
  window.__isFocusedSharePrompt746291937 = function() {
    return document.documentElement?.dataset?.workspaceLayout === "dock";
  };

  window.__setFocusedSharePromptState746291937 = function(state) {
    if(!window.shareSettingsBtn758374 || !window.__isFocusedSharePrompt746291937()) return;

    clearTimeout(window.__sharePromptButtonResetTimer746291937);
    shareSettingsBtn758374.dataset.focusShareState = state;

    let iconHtml = '<i class="fa-solid fa-share-nodes" aria-hidden="true"></i>';
    let label = "Share prompt";

    if(state === "loading") {
      iconHtml = '<i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>';
      label = "Creating share link";
    } else if(state === "success") {
      iconHtml = '<i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>';
      label = "Prompt link copied";
      window.__sharePromptButtonResetTimer746291937 = setTimeout(() => {
        window.__setFocusedSharePromptState746291937("idle");
      }, 2200);
    } else if(state === "error") {
      iconHtml = '<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>';
      label = "Share prompt failed";
      window.__sharePromptButtonResetTimer746291937 = setTimeout(() => {
        window.__setFocusedSharePromptState746291937("idle");
      }, 2800);
    }

    shareSettingsBtn758374.innerHTML = iconHtml;
    shareSettingsBtn758374.title = label;
    shareSettingsBtn758374.setAttribute("aria-label", label);
  };

  window.__restoreClassicSharePromptButton746291937 = function() {
    if(!window.shareSettingsBtn758374 || window.__isFocusedSharePrompt746291937()) return;
    clearTimeout(window.__sharePromptButtonResetTimer746291937);
    delete shareSettingsBtn758374.dataset.focusShareState;
    shareSettingsBtn758374.innerHTML = '<i class="fa-solid fa-share-nodes fa-2xs fa-fw" style="position:relative; top:2.4px;font-size:0.7rem;"></i> Share Prompt';
    shareSettingsBtn758374.title = "";
    shareSettingsBtn758374.removeAttribute("aria-label");
  };

  window.__generateSettingsShareLink084722 = async function generateShareLink() {

    // EDIT: decided to show this on every click now, since it's obviously not super commonly clicked (so an extra tap is not a big burden), and i think it being close to the generate button means people were clicking it accidentally sometimes.
    // if(!localStorage.knowsHowShareLinksWork) {
    // heuristic to try to warn about their scratchpad being shared too:
    let includingScratchpadWarning = "";
    let sharableScratchpadExists = Object.values(window.___userSettings746291937.userInputs).find(o => (o.getName === "scratchpad" || o.getName === "notes" || o.getName === "notepad") && !o.excludeFromShareLink);
    if(sharableScratchpadExists) includingScratchpadWarning = `, 𝗶𝗻𝗰𝗹𝘂𝗱𝗶𝗻𝗴 the scratchpad text`;

    let confirmed = await window.aifgConfirm(`This will create a sharable link to a snapshot of the settings you've specified above${includingScratchpadWarning}.`, { title:"Share Prompt", okText:"Create link" });
    if(!confirmed) return;

    localStorage.knowsHowShareLinksWork = "1";
    // }

    const focusedShare = window.__isFocusedSharePrompt746291937();

    if(!window.CompressionStream) {
      if(focusedShare) window.__setFocusedSharePromptState746291937("error");
      window.aifgAlert("Share links use a feature that's only available in modern browsers. Please upgrade your browser to the latest version to use this feature.");
      return;
    }

    if(focusedShare) {
      shareLinkCtn83927376.style.display = "none";
      shareSettingsBtn758374.style.display = "";
      shareSettingsBtn758374.disabled = true;
      window.__setFocusedSharePromptState746291937("loading");

      try {
        let dataJsonStr = JSON.stringify(getAllUserInputValues());
        let blob = await fetch("data:text/plain;charset=utf-8,"+dataJsonStr.replace(/#/g, "%23")).then(res => res.blob());
        let compressedBlob = await compressBlobWithGzip(blob);
        let { url, error } = await upload(compressedBlob);

        if(error) {
          window.__setFocusedSharePromptState746291937("error");
          window.aifgAlert(`Error: ${error}${error === "disallowed_content" ? ". ⚠️ Your content was blocked by the moderation system due to potentially inappropriate elements. If your content is safe, please ensure all characters involved are explicitly described as 18 years or older. Ambiguity may trigger false positives." : ""}`);
          return;
        }

        const shareUrl = `https://perchance.org/${window.generatorName}#data=`+url.replace("https://user.uploads.dev/file/", "uup1:");
        await navigator.clipboard.writeText(shareUrl);
        window.__setFocusedSharePromptState746291937("success");
      } catch(error) {
        console.error(error);
        window.__setFocusedSharePromptState746291937("error");
        window.aifgAlert("Unable to create or copy the share link right now. Please try again.");
      } finally {
        shareSettingsBtn758374.disabled = false;
      }
      return;
    }

    // Classic mode keeps the original Share Prompt + visible URL slot workflow.
    shareLinkCtn83927376.style.display = "none";
    shareSettingsBtn758374.disabled = true;
    shareSettingsBtn758374.innerHTML = `<span style="display:inline-block; animation:rotate 1.5s linear infinite;"><i class="fa-solid fa-spinner"></i></span> uploading settings...`;

    let dataJsonStr = JSON.stringify(getAllUserInputValues());
    let blob = await fetch("data:text/plain;charset=utf-8,"+dataJsonStr.replace(/#/g, "%23")).then(res => res.blob());
    let compressedBlob = await compressBlobWithGzip(blob);

    let { url, size, error } = await upload(compressedBlob);
    if(error) {
      shareSettingsLinkInputEl759307.value = `error: ${error}`;
      window.aifgAlert(`Error: ${error}${error === "disallowed_content" ? ". ⚠️ Your content was blocked by the moderation system due to potentially inappropriate elements. If your content is safe, please ensure all characters involved are explicitly described as 18 years or older. Ambiguity may trigger false positives." : ""}`);
    } else {
      shareSettingsLinkInputEl759307.value = `https://perchance.org/${window.generatorName}#data=`+url.replace("https://user.uploads.dev/file/", "uup1:");
    }

    shareLinkCtn83927376.style.display = "";
    shareSettingsBtn758374.innerHTML = `<i class="fa-solid fa-share-nodes fa-2xs fa-fw"style="position:relative;top:2.4px;;font-size:0.7rem;"></i> Share Prompt`;
    shareSettingsBtn758374.disabled = false;
    shareSettingsBtn758374.style.display = "none";
  }

  async function compressBlobWithGzip(blob) {
    const cs = new CompressionStream('gzip');
    const compressedStream = blob.stream().pipeThrough(cs);
    let outputBlob = await new Response(compressedStream).blob();
    return new Blob([outputBlob], { type: "application/gzip" }); // <-- to add the correct mime type
  }

  async function loadDataFromUrlHash() {
    let success = false;
    if(!window.DecompressionStream) {
      window.aifgAlert("Share links use a browser feature that's only available in modern browsers. Please upgrade your browser to the latest version (ideally Chrome or Edge) to allow for loading data from character share links.");
      return {success, error:"browser_compat"};
    }

    let loadingModal = document.createElement('div');
    loadingModal.innerHTML = `<div style="top: 0; left: 0; position: fixed; width: 100%; height: 100%; background-color: #ebebeb; z-index: 9999; display: flex; justify-content: center; align-items: center;">
      <div style="padding: 20px; background-color: var(--box-color); border-radius: 8px;">
        <span style="display:inline-block; animation:rotate 1.5s linear infinite;"><i class="fa-solid fa-spinner"></i></span> loading share prompt...
      </div>
    </div>`;
    loadingModal = loadingModal.firstElementChild;
    document.body.append(loadingModal);

    try {
      let hashText = window.location.hash.slice(1);
      if(!hashText.startsWith("data=")) {
        throw new Error("Invalid share URL.");
      }
      let fileUrl = hashText.replace(/^data=/, "");
      if(fileUrl.startsWith("uup1:")) {
        fileUrl = fileUrl.replace("uup1:", "https://user.uploads.dev/file/");
      }
      let fetchOptions = {};
      if(window.AbortSignal && AbortSignal.timeout) fetchOptions.signal = AbortSignal.timeout(10000);
      let blob = await fetch(fileUrl, fetchOptions).then(res => res.ok ? res.blob() : null).catch(console.error);

      if(!blob) {

        loadingModal.remove();

        await confirmAsync(`It seems you've tried to load a share URL, but the file specified by the URL does not exist. If you believe it should exist, you can ask for help on the community forum, or check if the file has been quarantined:\n\nperchance.org/quarantined-files`, {hideCancel:true});

        return {success:false, error:"loading_cancelled_by_user"};

      }
      let text;
      if(fileUrl.endsWith(".gz")) {
        let decompressedBlob = await decompressBlobWithGzip(blob);
        text = await decompressedBlob.text();
      } else {
        text = await blob.text();
      }
      let data = JSON.parse(text);
      if(data.___format === "t2i-framework-format1") {
        let confirmed = await confirmAsync("𝗛𝗲𝗮𝗱𝘀 𝘂𝗽: You're loading a share link. This will overwrite your existing saved prompt and scratchpad. 𝗖𝗼𝗻𝘁𝗶𝗻𝘂𝗲?\n\n(You can click cancel and then load the share link in your browser's incognito mode to avoid overwriting any existing data.)");
        if(!confirmed) {
          window.location.hash = "";
          loadingModal.remove();
          return {success, error:"loading_cancelled_by_user"};
        }
        importUserInputValues(data);
        success = true;
      } else {
        window.aifgAlert("Unknown share link data format.");
      }
    } catch(e) {
      window.aifgAlert(`Failed to load share link data: ${e.message}`);
      console.error(e);
    }

    loadingModal.remove();
    return {success};
  }

  async function decompressBlobWithGzip(blob) {
    const ds = new DecompressionStream("gzip");
    const decompressedStream = blob.stream().pipeThrough(ds);
    return await new Response(decompressedStream).blob();
  }

  function getAllUserInputValues() {
    let userInputs = {};
    for(let key in window.___userSettings746291937.userInputs) {
      if(window.___userSettings746291937.userInputs[key].excludeFromShareLink) continue;
      let value = window.___userSettings746291937.userInputs[key]._element?.value;
      if(value !== undefined) {
        userInputs[key] = value;
      }
    }
    userInputs.___format = "t2i-framework-format1";

    // === NEW: SAVE GUIDANCE SCALE IN EXPORT ===
    userInputs.___guidanceScale = localStorage.getItem('t2i_guidance_scale') || 7;
    // =========================================

    return userInputs;
  }

  function importUserInputValues(data) {
    for(let key in window.___userSettings746291937.userInputs) {
      if(window.___userSettings746291937.userInputs[key].excludeFromShareLink) continue;
      let value = window.___userSettings746291937.userInputs[key]._element?.value;
      if(value !== undefined) {
        if(data[key] !== undefined) {
          let el = window.___userSettings746291937.userInputs[key]._element;
          el.value = data[key];
          if(el.onchange) el.onchange({_isInitCall:true});
          if(el.oninput) el.oninput({_isInitCall:true});
        }
      }
    }
    // === NEW: LOAD GUIDANCE SCALE FROM EXPORT ===
    if(data.___guidanceScale !== undefined) {
      window.___updateGuidance(data.___guidanceScale);
    }
    // ============================================
  }

  function animateImageIntoTarget({imgEl, sourceEl, targetEl, durationMs, wiggle}={}) {
    const srcRect = sourceEl.getBoundingClientRect()
    let tgtRect = targetEl.getBoundingClientRect();
    imgEl.style.cssText = `top:${srcRect.top}px;left:${srcRect.left}px; position: fixed; width:${srcRect.width}px;height:${srcRect.height}px;margin:0;pointer-events:none;z-index:9999;transition:top ${durationMs}ms cubic-bezier(.4,0,.2,1),left ${durationMs}ms cubic-bezier(.4,0,.2,1),width ${durationMs}ms cubic-bezier(.4,0,.2,1),height ${durationMs}ms cubic-bezier(.4,0,.2,1)`;
    if (!imgEl.parentNode) document.body.appendChild(imgEl);
    imgEl.getBoundingClientRect(); // force reflow
    imgEl.style.top = tgtRect.top + tgtRect.height / 2 + 'px';
    imgEl.style.left = tgtRect.left + tgtRect.width / 2 + 'px';
    imgEl.style.width = imgEl.style.height = '0px';

    imgEl.addEventListener('transitionend', () => {
      imgEl.remove();
      if (!wiggle) return;
      const anim = 'wiggle' + Math.random().toString(36).slice(2);
      const styleEl = Object.assign(document.createElement('style'), {
        id: anim,
        textContent: `@keyframes ${anim}{0%,100%{transform:rotate(0deg)}20%{transform:rotate(-5deg)}40%{transform:rotate(5deg)}60%{transform:rotate(-3deg)}80%{transform:rotate(3deg)}}`
      });
      document.head.appendChild(styleEl);
      targetEl.style.animation = `${anim} 400ms ease-in-out`;
      targetEl.addEventListener('animationend', () => { targetEl.style.animation = ''; styleEl.remove(); }, { once: true });
    }, { once: true });
  }


  if(settings.imageButtons?.privateSave) {
    window.t2i_privateGallery = createMediaGalleryPlugin();
    document.addEventListener("keydown", e => {
      if (e.shiftKey && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "g") {
        e.preventDefault();
        window.t2i_privateGallery.show();
      }
    });
  }

  const t2iBuildConceptBoardInfo = (source = {}, imageCtn = null) => {
    const inputs = source?.inputs && typeof source.inputs === "object" ? source.inputs : {};
    const meta = source?.meta && typeof source.meta === "object" ? source.meta : {};
    const read = (...values) => {
      for (const raw of values) {
        if (raw == null) continue;
        const value = typeof raw === "object"
          ? raw.evaluateItem ?? raw.value ?? raw.getName
          : raw;
        if (!["string", "number", "boolean"].includes(typeof value)) continue;
        const text = String(value).trim();
        if (text && text !== "[object Object]") return text;
      }
      return "";
    };
    const currentInput = name => {
      const value = window.input?.[name];
      return read(value?._element?.value, value?.value, value?.evaluateItem, value);
    };
    const prompt = read(source.prompt, inputs.prompt, meta.prompt);
    const promptField = name => {
      const prefix = `(${name}:::`;
      const start = prompt.toLowerCase().indexOf(prefix.toLowerCase());
      if (start < 0) return "";
      const valueStart = start + prefix.length;
      const end = prompt.indexOf(")", valueStart);
      return end < 0 ? "" : prompt.slice(valueStart, end).trim();
    };
    const formatDate = value => {
      if (value == null || value === "") return new Date().toLocaleString();
      if (typeof value === "string" && !/^\d+(?:\.\d+)?$/.test(value.trim())) {
        const parsed = new Date(value);
        return Number.isNaN(parsed.getTime()) ? value.trim() : parsed.toLocaleString();
      }
      const numeric = Number(value);
      const parsed = new Date(numeric < 1e12 ? numeric * 1000 : numeric);
      return Number.isNaN(parsed.getTime()) ? new Date().toLocaleString() : parsed.toLocaleString();
    };
    let frameImageUrl = "";
    try {
      const image = imageCtn?.querySelector?.("iframe")?.contentDocument?.querySelector?.("img");
      frameImageUrl = read(image?.currentSrc, image?.src);
    } catch {}

    const postTitle = read(
      source.postTitle, source.title, source.saveTitle,
      inputs.postTitle, inputs.title, inputs.saveTitle,
      meta.postTitle, meta.title, meta.saveTitle,
      promptField("saveTitle"), currentInput("usertitle")
    );
    const postDescription = read(
      source.postDescription, source.description, source.saveDescription,
      inputs.postDescription, inputs.saveDescription, inputs.userdescription,
      meta.postDescription, meta.description, meta.saveDescription,
      promptField("saveDescription"), currentInput("userdescription")
    );
    const style = read(
      imageCtn?.querySelector?.(".t2i-random-style-label")?.textContent,
      source.styleName, source.style, source.artStyleName, source.artStyle,
      inputs.styleName, inputs.style, inputs.artStyleName, inputs.artStyle,
      meta.styleName, meta.style, meta.artStyleName, meta.artStyle,
      window.input?.artStyle?.getName
    );
    const negativePrompt = read(source.negativePrompt, inputs.negativePrompt, meta.negativePrompt);
    const seed = source.seed ?? inputs.seed ?? meta.seed;
    const guidanceScale = source.guidanceScale ?? inputs.guidanceScale ?? meta.guidanceScale;
    const dateValue = read(
      source.createdAt, source.timestamp, source.postedAt, source.date, source.time,
      inputs.createdAt, inputs.timestamp, inputs.date,
      meta.createdAt, meta.timestamp, meta.postedAt, meta.date, meta.time
    );
    const rawImageUrl = read(source.imageUrl, source.dataUrl, meta.imageUrl, frameImageUrl);
    const imageUrl = /^https?:\/\//i.test(rawImageUrl) ? rawImageUrl : "";
    const info = {};

    if (postTitle) info["Post Title"] = postTitle;
    if (postDescription) info["Post Description"] = postDescription;
    if (style) info.Style = style;
    if (source.comment) info.comment = String(source.comment);
    if (prompt) info.prompt = prompt;
    if (negativePrompt) info.negativePrompt = negativePrompt;
    if (seed != null && String(seed).trim() !== "") info.seed = String(seed);
    if (guidanceScale != null && String(guidanceScale).trim() !== "") info.guidanceScale = String(guidanceScale);
    info["Date / Time"] = formatDate(dateValue);
    if (imageUrl) info["Image URL"] = imageUrl;
    return info;
  };

  const t2iGetConceptBoardAddOpts = (info, destTypeKey, destNameKey) => {
    const addOpts = { info };
    const destType = localStorage.getItem(destTypeKey) || 'current';
    const destName = localStorage.getItem(destNameKey);

    if(destType === 'specific' && destName && destName.trim() !== '') {
      addOpts.folder = destName.trim();
    }

    return addOpts;
  };

  const t2iGetGeneratorConceptBoardAddOpts = info =>
    t2iGetConceptBoardAddOpts(info, 'genSaveDestType', 'genSaveDestName');

  const t2iGetPromptHistoryConceptBoardAddOpts = info =>
    t2iGetConceptBoardAddOpts(info, 'promptHistorySaveDestType', 'promptHistorySaveDestName');

  const t2iSaveGeneratedResultToConceptBoard = async (imageCtn, { animate = true, addOptsBuilder = t2iGetGeneratorConceptBoardAddOpts } = {}) => {
    const iframe = imageCtn?.querySelector?.("iframe");
    const textToImagePluginOutput = iframe?.textToImagePluginOutput;
    if(!textToImagePluginOutput?.dataUrl) throw new Error("Image generation is not complete yet.");

    const imageBlob = await fetch(textToImagePluginOutput.dataUrl).then(response => response.blob());
    const addOpts = addOptsBuilder(
      t2iBuildConceptBoardInfo(textToImagePluginOutput, imageCtn)
    );

    await window.t2i_privateGallery.add(imageBlob, addOpts);

    if(animate) {
      const targetEl = document.getElementById("floatingBtn");
      if(targetEl && iframe) {
        const imgEl = document.createElement("img");
        imgEl.src = textToImagePluginOutput.dataUrl;
        animateImageIntoTarget({
          imgEl,
          sourceEl: iframe,
          targetEl,
          durationMs: 700,
          wiggle: true
        });
      }
    }
  };

  window.t2i_privateGallerySave = async function(btn, imageCtn) {
    if(btn) btn.disabled = true;

    try {
      await t2iSaveGeneratedResultToConceptBoard(imageCtn, { animate: true });
    } catch(e) {
      console.error(e);
      if(/not complete yet/i.test(String(e?.message || e))) {
        window.aifgAlert("Please wait for the image to finish generating before using the 'private save' feature.");
      }
    } finally {
      if(btn) {
        setTimeout(() => {
          if(btn) btn.disabled = false;
        }, 1000);
      }
    }
  };

  const t2iReadHistoryInput = name => {
    const spec = window.___userSettings746291937?.userInputs?.[name];
    const element = spec?._element;
    const selectedLabel = element?.selectedOptions?.[0]?.textContent?.trim?.() || "";
    const inputValue = window.input?.[name];

    let resolvedValue = "";
    try {
      const raw = inputValue?.evaluateItem ?? inputValue?.value ?? inputValue;
      if(["string", "number", "boolean"].includes(typeof raw)) resolvedValue = String(raw).trim();
    } catch(e) {}

    return {
      element,
      label: selectedLabel,
      value: resolvedValue
    };
  };

  const t2iReadHistoryStylePrompt = () => {
    const artStyle = window.input?.artStyle;
    if(!artStyle || typeof artStyle !== "object") return "";

    try {
      const rawPrompt = artStyle.prompt;
      if(rawPrompt == null) return "";

      const value = rawPrompt?.evaluateItem !== undefined ? rawPrompt.evaluateItem : rawPrompt;

      if(["string", "number", "boolean"].includes(typeof value)) {
        return String(value).trim();
      }
    } catch(e) {}

    return "";
  };

  window.t2i_capturePromptHistorySnapshot = function(numImages) {
    const promptSpec = window.___userSettings746291937?.userInputs?.description
      || window.___userSettings746291937?.userInputs?.prompt;
    const postTitleSpec = window.___userSettings746291937?.userInputs?.usertitle;
    const postDescriptionSpec = window.___userSettings746291937?.userInputs?.userdescription;
    const promptText = String(promptSpec?._element?.value ?? "");
    const postTitle = String(postTitleSpec?._element?.value ?? "");
    const postDescription = String(postDescriptionSpec?._element?.value ?? "");
    const style = t2iReadHistoryInput("artStyle");
    const stylePrompt = t2iReadHistoryStylePrompt();
    const shape = t2iReadHistoryInput("shape");
    const tagsSpec = window.___userSettings746291937?.userInputs?.tags;
    const tagsContainer = tagsSpec?._element?.closest?.(".input-ctn");
    const tags = [];

    if(tagsContainer) {
      for(const chip of tagsContainer.querySelectorAll(".t2iChip.on")) {
        const tagName = String(chip.dataset.chipName || "").trim();
        if(tagName) tags.push(tagName);
      }
    }

    return {
      postTitle,
      postDescription,
      prompt: promptText,
      style: style.label || style.value,
      stylePrompt,
      resolution: shape.label || shape.value,
      resolutionValue: shape.value && shape.value !== shape.label ? shape.value : "",
      guidanceScale: String(localStorage.getItem("t2i_guidance_scale") || "7"),
      batchSize: Number(numImages) || 1,
      tags,
      createdAt: Date.now()
    };
  };

  window.t2i_savePromptHistorySnapshot = async function(snapshot) {
    if(localStorage.getItem("pl_autoSavePromptHistory") !== "true" || !snapshot) return false;

    const created = new Date(snapshot.createdAt || Date.now());
    const info = {
      "Post Title": String(snapshot.postTitle ?? ""),
      "Post Description": String(snapshot.postDescription ?? ""),
      "User Prompt Input": String(snapshot.prompt ?? ""),
      Style: String(snapshot.style || "Default"),
      guidanceScale: String(snapshot.guidanceScale || "7"),
      Resolution: String(snapshot.resolution || "Default"),
      "Batch Size": String(snapshot.batchSize || 1),
      "Date / Time": created.toLocaleString()
    };

    if(snapshot.stylePrompt) info["Prompt Used"] = String(snapshot.stylePrompt);
    if(snapshot.resolutionValue) info["Resolution Value"] = String(snapshot.resolutionValue);
    if(Array.isArray(snapshot.tags) && snapshot.tags.length) info.Tags = snapshot.tags.join(", ");

    const historyBlob = new Blob([""], { type: "text/plain" });
    await window.t2i_privateGallery.add(
      historyBlob,
      t2iGetPromptHistoryConceptBoardAddOpts(info)
    );
    return true;
  };

  window.t2i_autoSaveFirstSuccessfulBatchImage = function(imageContainers) {
    if(localStorage.getItem("pl_autoSavePromptHistory") !== "true") return;
    if(localStorage.getItem("pl_autoSavePromptHistoryFirstImage") !== "true") return;

    const containers = Array.from(imageContainers || []).filter(Boolean);
    if(!containers.length) return;

    const deadline = Date.now() + 10 * 60 * 1000;

    const check = async () => {

      const firstReady = containers.find(imageCtn => {
        const out = imageCtn?.querySelector?.("iframe")?.textToImagePluginOutput;
        return !!out?.dataUrl;
      });

      if(firstReady) {
        try {
          // Same generated-result save core as manual save, but use Prompt History's own destination.
          await t2iSaveGeneratedResultToConceptBoard(firstReady, {
            animate: false,
            addOptsBuilder: t2iGetPromptHistoryConceptBoardAddOpts
          });
        } catch(e) {
          console.error("Automatic preview Concept Board save failed:", e);
        }
        return;
      }

      if(Date.now() >= deadline || containers.every(imageCtn => !imageCtn?.isConnected)) return;
      setTimeout(check, 300);
    };

    setTimeout(check, 300);
  };

  window.t2i_batchZoom = async function(btn, imageCtn) {
    if (btn) btn.disabled = true;  // only disable if btn is a real <button>
    try {
      const iframe = imageCtn.querySelector("iframe");
      const out = iframe && iframe.textToImagePluginOutput;
      if (!out) return window.aifgAlert("Please wait for the image to finish generating before using this feature.");

      // create modal lightbox (no saving, no target animation)
      const overlay = document.createElement("div");
      overlay.setAttribute("role", "dialog");
      overlay.setAttribute("aria-modal", "true");
      overlay.style = "inset:0; position: fixed; background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:9999;";

      function close() {
        document.removeEventListener("keydown", onKey);
        overlay.remove();
      }
      function onKey(e) { if (e.key === "Escape") close(); }

      overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
      document.addEventListener("keydown", onKey);

      const img = document.createElement("img");
      img.src = out.dataUrl;
      img.alt = "";
      img.style = "max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px;box-shadow:0 0 20px rgba(0,0,0,0.6);cursor:zoom-in;transform-origin:center center;transform:scale(1);transition:transform 200ms ease-out;";

      let zoomed = false;
      img.addEventListener("click", (e) => {
        e.stopPropagation(); // prevent closing overlay
        zoomed = !zoomed;
        if (zoomed) {
          // get click position relative to image
          const rect = img.getBoundingClientRect();
          const xPercent = ((e.clientX - rect.left) / rect.width) * 100;
          const yPercent = ((e.clientY - rect.top) / rect.height) * 100;
          img.style.transformOrigin = `${xPercent}% ${yPercent}%`;
          img.style.transform = "scale(2.5)";
          img.style.cursor = "zoom-out";
        } else {
          img.style.transformOrigin = "center center";
          img.style.transform = "scale(1)";
          img.style.cursor = "zoom-in";
        }
      });

      const closeBtn = document.createElement("button");
      closeBtn.textContent = "✕";
      closeBtn.setAttribute("aria-label", "Close");
      closeBtn.style = "position:absolute;top:20px;right:30px;font-size:24px;color:#fff;background:transparent;border:none;cursor:pointer;line-height:1;";
      closeBtn.addEventListener("click", close);

      overlay.append(img, closeBtn);
      document.body.appendChild(overlay);
    } catch(e) {
      console.error(e);
    }
    setTimeout(() => { if (btn) btn.disabled = false; }, 1000);
  };
