  function ___smoothAiOutput746291937(writeFn, options = {}) {
    let frame = 0;
    let nextValue = "";
    let visibleValue = "";
    let lastWrittenValue = null;
    let lastFrameAt = 0;
    let lastCursorAt = 0;
    let cursorOn = true;
    let typing = false;

    const raf = window.requestAnimationFrame || (fn => setTimeout(() => fn(Date.now()), 16));
    const caf = window.cancelAnimationFrame || clearTimeout;
    const minFrameMs = options.minFrameMs || 28;
    const cursorMs = options.cursorMs || 480;
    const showCursor = !!options.cursor;

    const getStep = (lag) => {
      if(lag > 160) return 22;
      if(lag > 80) return 12;
      if(lag > 32) return 6;
      if(lag > 10) return 3;
      return 1;
    };

    const writeText = () => {
      const displayValue = visibleValue + (showCursor && typing && cursorOn ? " |" : "");

      if(displayValue === lastWrittenValue) return;

      lastWrittenValue = displayValue;
      writeFn(displayValue, {
        rawValue: visibleValue,
        targetValue: nextValue,
        typing
      });
    };

    const run = (now = Date.now()) => {
      frame = 0;

      if(now - lastFrameAt < minFrameMs) {
        frame = raf(run);
        return;
      }

      lastFrameAt = now;

      if(showCursor && typing && now - lastCursorAt >= cursorMs) {
        cursorOn = !cursorOn;
        lastCursorAt = now;
      }

      if(
        visibleValue.length > nextValue.length ||
        nextValue.slice(0, visibleValue.length) !== visibleValue
      ) {
        let same = 0;
        let max = Math.min(visibleValue.length, nextValue.length);

        while(same < max && visibleValue[same] === nextValue[same]) {
          same++;
        }

        visibleValue = visibleValue.slice(0, same);
        lastWrittenValue = null;
      }

      const lag = nextValue.length - visibleValue.length;

      if(lag > 0) {
        visibleValue = nextValue.slice(0, visibleValue.length + getStep(lag));
      }

      writeText();

      if(visibleValue.length < nextValue.length || (showCursor && typing)) {
        frame = raf(run);
      }
    };

    const scheduleText = () => {
      if(frame) return;
      frame = raf(run);
    };

    const writeDirect = (value) => {
      if(frame) caf(frame);
      frame = 0;
      typing = false;
      lastWrittenValue = value;
      writeFn(value, {
        rawValue: value,
        targetValue: value,
        typing: false
      });
    };

    return {
      set(value) {
        if(typeof value !== "string" && value != null) {
          writeDirect(value);
          return;
        }

        nextValue = value == null ? "" : value;
        typing = true;
        scheduleText();
      },

      flush(value) {
        if(arguments.length) nextValue = value == null ? "" : value;

        if(frame) caf(frame);
        frame = 0;

        typing = false;
        visibleValue = nextValue;
        writeText();
      },

      cancel() {
        if(frame) caf(frame);
        frame = 0;
        typing = false;
      }
    };
  }

