          <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(0,0,0,0.82),rgba(0,0,0,0.35));color:white;padding:5px 3px;text-align:center;font-size:0.72rem;font-weight:500;line-height:1.15;pointer-events:none;text-shadow:0 1px 2px black;">
            ${getOptionName(key, opt)}
