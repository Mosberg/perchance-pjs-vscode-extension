        const guidanceTipText = `Controls how strictly the model follows your prompt. Default is 7. Use (guidanceScale:::X) to override it, where X ranges from 1–30. Lower values allow more creative freedom and can produce richer, more complex results but may become messy; higher values follow the prompt more strictly and give clearer outputs, though they may look more cartoonish. If multiple guidance scales appear, only the last one will be applied.`.replace(/"/g, "&quot;");

        guidanceHtml = `
          <div id="guidanceScaleCtn" class="guidance-scale-ctn" style="display:flex; justify-content:flex-end; align-items:center; gap:6px; margin-top:6px; font-size:0.75rem; color:var(--text-color); opacity:0.7; transition: opacity 0.2s ease;">
            ${guidanceLockHtml}
            <span style="font-weight:600; margin-right:4px;">Guidance:</span>
            <input type="range" id="guidanceSlider" min="1" max="30" step="1" value="7"
              oninput="window.___updateGuidance(this.value)"
              style="width:80px; cursor:pointer;">
            <button type="button" id="guidanceMinusBtn" onclick="window.___updateGuidance(parseInt(document.getElementById('guidanceSlider').value)-1)" style="padding:0 6px; background:transparent; border:1px solid var(--border-color); color:inherit; border-radius:4px; cursor:pointer; min-width:24px;">-</button>
            <span id="guidanceDisplay" style="min-width:18px; text-align:center; font-weight:600;">7</span>
            <button type="button" id="guidancePlusBtn" onclick="window.___updateGuidance(parseInt(document.getElementById('guidanceSlider').value)+1)" style="padding:0 6px; background:transparent; border:1px solid var(--border-color); color:inherit; border-radius:4px; cursor:pointer; min-width:24px;">+</button>
            <span class="input-tip-btn" title="${guidanceTipText}" onclick="window.___showInputHint746291937(this)" style="margin-left:2px;">
              <span class="material-symbols-outlined" style="font-size:1.1em; vertical-align:-0.15em;">info</span>
            </span>
