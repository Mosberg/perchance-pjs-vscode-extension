    window.aifgAlert = (message, options = {}) => window.aifgDialog({ ...options, mode:"alert", message });
    window.aifgConfirm = (message, options = {}) => window.aifgDialog({ ...options, mode:"confirm", message });
    window.aifgPrompt = (message, value = "", options = {}) => window.aifgDialog({ ...options, mode:"prompt", message, value });
