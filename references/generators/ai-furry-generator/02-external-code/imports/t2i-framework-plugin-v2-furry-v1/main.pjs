  function ___escapeGallerySearchRegex(text) {
    return String(text).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function ___formatGallerySearchPattern(query) {
    return String(query || "")
      .replace(/"([^"]+)"/g, (_, quotedText) => {
        const safeText = ___escapeGallerySearchRegex(quotedText.trim());
        return safeText ? `(^|[^a-z0-9])${safeText}($|[^a-z0-9])` : "";
      })
      .replace(/\bAND\b/gi, '.*')
      .replace(/\bOR\b/gi, '|')
      .replace(/\s*\|\s*/g, '|')
      .replace(/\s*\.\*\s*/g, '.*')
      .trim();
  }

  window.changeAll = function(tagName, badTags, useUnifiedLoader = true) {
    if(tagName === undefined && badTags === undefined) return;

    const rawTagName = tagName || "";
    const rawBadTags = badTags || "";

    const formatTagName = ___formatGallerySearchPattern(rawTagName);
    const formatBadTags = rawBadTags
      .split(",")
      .map(tag => tag.trim())
      .filter(tag => tag !== "")
      .map(tag => ___formatGallerySearchPattern(tag))
      .filter(tag => tag !== "");

    const iframes = [...document.querySelectorAll('iframe.text-to-image-plugin-gallery')];

    for (const iframe of iframes) {
      const url = new URL(iframe.src);

      const hash = url.hash;
      const rawData = decodeURIComponent(hash)
        .replace(/^#data=/, "")
        .replace(/^"/, "")
        .replace(/"$/, "");
      const dataObj = JSON.parse(rawData);

      url.searchParams.set('subChannel', window.__t2iCurrentGallery || 'public');
      url.searchParams.set('contentFilter', window.__getGalleryContentFilter());

      const bannedTags = formatBadTags.map(tag => `/${tag}/i`);

      if (formatTagName) {
        bannedTags.unshift(`/^(?!.*(${formatTagName})).*$/i`);
      }

      let basePromptBans = [];

      if (Array.isArray(settings.galleryOptions.bannedPromptPhrases)) {
        basePromptBans = [...settings.galleryOptions.bannedPromptPhrases];
      }
      else if (settings.galleryOptions.bannedPromptPhrases && settings.galleryOptions.bannedPromptPhrases.selectAll) {
        basePromptBans = settings.galleryOptions.bannedPromptPhrases.selectAll.map(a => a.evaluateItem || a.getName);
      }

      dataObj.bannedPromptPhrases = [
        ...basePromptBans,
        ...bannedTags
      ];
      url.hash = "#data=" + encodeURIComponent(JSON.stringify(dataObj));

      localStorage.setItem("lookForThis", rawTagName);
      localStorage.setItem("dontLookForThis", rawBadTags);

      if (useUnifiedLoader && window.aifgReloadIframe) {
        const loaderHost = window.__getGalleryLoaderHostForIframe?.(iframe) || iframe.parentElement;
        window.aifgReloadIframe(iframe, url.toString(), {
          label: "Loading Gallery…",
          host: loaderHost,
          fullHost: true
        });
      } else {
        // Theme changes keep the gallery's original direct navigation path.
        iframe.src = url.toString();
      }
    }
  };

  // Re-define original basic generator for the gallery
  window.generateImageGalleryHtml358402048 = function() {
    const settings = window.___userSettings746291937;
    if(!settings.galleryOptions || !settings.galleryOptions.gallery) return "";

    settings.galleryOptions.forceColorScheme = window.getCurrentColorScheme();
    settings.galleryOptions.subChannel = window.__t2iCurrentGallery || 'public';
    settings.galleryOptions.contentFilter = window.__getGalleryContentFilter();
    window.__t2iFolders = window.__t2iGalleries;

    // Apply custom buttons back to options
    if(settings.imageButtons?.privateSave && !settings.galleryOptions.customButton) {
      settings.galleryOptions.customButton = {
        emoji: "⭐",
        onClick: async (data) => {
          const storageMode = localStorage.getItem('gallerySaveStorageMode') || 'link';
          let imageBlob = null;

          if (storageMode === 'file') {
            const response = await fetch(data.imageUrl);
            if (!response.ok) throw new Error(`Could not save Gallery image copy (${response.status}).`);
            imageBlob = await response.blob();
          }

          let addOpts = { info: t2iBuildConceptBoardInfo(data) };
          let destType = localStorage.getItem('gallerySaveDestType');
          let destName = localStorage.getItem('gallerySaveDestName');
          if(destType === 'specific' && destName && destName.trim() !== '') {
            addOpts.folder = destName.trim();
          }
          await window.t2i_privateGallery.add(imageBlob, addOpts);
        },
      };
    }
    if(!settings.galleryOptions.customButton2) {
      settings.galleryOptions.customButton2 = {
        emoji: "💬",
        onClick: async (data) => {
          let options = { channel: "image-"+data.imageId.slice(0, 25), style: "display:block; height:100%; width:100%;" };
          let def = settings.defaultCommentOptions;
          for(let k of ["commentPlaceholderText", "submitButtonText", "forceColorScheme"]) if(def[k]!==undefined) options[k]=def[k];
          const commentHostId = `aifgImageCommentHost${Date.now()}`;
          window.showModal(`<div id="${commentHostId}" style="height:95vh; width:95vw; max-height:600px; max-width:900px; position:relative;">${window.___commentsPlugin746291937(options)}</div>`);
          requestAnimationFrame(() => {
            window.aifgAttachFirstIframeLoader?.(commentHostId, "Loading Comments…");
          });
        },
      };
    }

    // FIX 3: Safe Event Listener Attachment (Bypasses Perchance Syntax Error)
    setTimeout(() => {
      window.__galleryUpdateZoomAll();

      const tIn = document.getElementById('galleryTagInputEl');
      const bIn = document.getElementById('galleryBadTagInputEl');
      const sBtn = document.getElementById('gallerySearchIconBtn');

      const doSearch = () => {
        if(typeof window.changeAll === 'function' && tIn && bIn) {
          window.changeAll(tIn.value, bIn.value);
        }
      };

      const rememberGallerySearch = localStorage.getItem('pl_rememberGallerySearch') === 'true';
      const savedTag = rememberGallerySearch ? (localStorage.getItem("lookForThis") || "") : "";
      const savedBad = rememberGallerySearch ? (localStorage.getItem("dontLookForThis") || "") : "";

      if (!rememberGallerySearch) {
        localStorage.removeItem("lookForThis");
        localStorage.removeItem("dontLookForThis");
      }

      const checkAutoReset = () => {
        const currentTag = localStorage.getItem("lookForThis") || "";
        const currentBad = localStorage.getItem("dontLookForThis") || "";

        // If both boxes become empty after a previous search, rebuild default gallery
        if (tIn.value.trim() === "" && bIn.value.trim() === "" && (currentTag !== "" || currentBad !== "")) {
          doSearch();
        }
      };

      if(tIn) {
        tIn.value = savedTag;
        tIn.onkeydown = (e) => {
          if(e.ctrlKey && e.key === 'Enter') {
            e.preventDefault();
            doSearch();
          }
        };
        tIn.oninput = checkAutoReset;
      }

      if(bIn) {
        bIn.value = savedBad;
        bIn.onkeydown = (e) => {
          if(e.ctrlKey && e.key === 'Enter') {
            e.preventDefault();
            doSearch();
          }
        };
        bIn.oninput = checkAutoReset;
      }

      if(sBtn) sBtn.onclick = doSearch;

      if (rememberGallerySearch && savedBad.trim() !== "") {
        const excludeGroup = document.getElementById('galleryExcludeGroup');
        const mobileToggleBtn = document.getElementById('mobileSearchToggleBtn');

        if (window.innerWidth <= 650) {
          if (excludeGroup) excludeGroup.classList.add('expanded');
          if (mobileToggleBtn) mobileToggleBtn.classList.add('hidden');
        }
      }
    }, 500);

    return window.___textToImagePlugin746291937(settings.galleryOptions).evaluateItem;
  };

  try {
    let isSafari = navigator.vendor && navigator.vendor.indexOf('Apple') > -1 && navigator.userAgent && navigator.userAgent.indexOf('CriOS') == -1 && navigator.userAgent.indexOf('FxiOS') == -1;
    let isTouchScreen = window.matchMedia("(pointer: coarse)").matches;
    if(isSafari && window.inner < 800 && isTouchScreen) {
      let viewportMetaEl = document.querySelector("[name=viewport]");
      if(!viewportMetaEl.getAttribute("content").includes("maximum-scale")) {
        viewportMetaEl.setAttribute("content", viewportMetaEl.getAttribute("content") + ", maximum-scale=1");
      }
      console.log("Safari iOS detected. Added maximum-scale attribute to prevent zooming:", viewportMetaEl.getAttribute("content"));
    }
  } catch(e) {
