      let options = [];

      let thereAreImports = false;
      item.compiledOptions = new Map();
      let nameToForcedPosition = {};
      let groupIndex = -1;

      for(let key of item.options.getAllKeys) {
        groupIndex++;
        if(key.startsWith("meta:import")) {
          thereAreImports = true;
          let tagImportWeights = {};
          if(item.options[key].tagWeights) {
            tagImportWeights = Object.fromEntries(item.options[key].tagWeights.evaluateItem.split(",").map(t => {
              let tag = t.split(":")[0].trim();
              let factor = Number(t.split(":")[1] ?? 10);
              if(isNaN(factor)) factor = 10;
              return [tag, factor];
            }));
          }
          let intraGroupSortingEpsilon = 0.00001;
          for(let optionItem of item.options[key].from.selectAll) {
            if(item.compiledOptions.has(optionItem.getName)) continue;
            optionItem.___groupIndex = groupIndex;
            item.compiledOptions.set(optionItem.getName, optionItem);

            if(optionItem["meta:position"]) {
              nameToForcedPosition[optionItem.getName] = optionItem["meta:position"];
            }

            if(optionItem["meta:tags"]) {
              optionItem.___intraGroupRankingScore = 0;
              let thereWereTagWeightMatches = false;
              for(let [tag, inherentTagWeight] of Object.entries(optionItem["meta:tags"])) {
                if(tagImportWeights[tag] !== undefined) {
                  thereWereTagWeightMatches = true;
                  optionItem.___intraGroupRankingScore += inherentTagWeight*tagImportWeights[tag];
                }
              }
              if(!thereWereTagWeightMatches) {
                let inherentTagWeights = Object.values(optionItem["meta:tags"]);
                optionItem.___intraGroupRankingScore = 1;
              }
            } else {
              optionItem.___intraGroupRankingScore = 1;
            }

            optionItem.___intraGroupRankingScore += intraGroupSortingEpsilon;
            intraGroupSortingEpsilon -= intraGroupSortingEpsilon*0.00001;
          }
        } else {
          item.options[key].___groupIndex = groupIndex;
          item.options[key].___intraGroupRankingScore = 1;

          item.compiledOptions.set(key, item.options[key]);

          if(item.options[key]["meta:position"]) {
            nameToForcedPosition[key] = item.options[key]["meta:position"];
          }
        }
      }

      let entries = [...item.compiledOptions.entries()];
      if(thereAreImports) {
        entries = entries.filter(e => e[1].___intraGroupRankingScore > 0);
        entries.sort((a, b) => a[1].___groupIndex - b[1].___groupIndex || b[1].___intraGroupRankingScore - a[1].___intraGroupRankingScore);
      }

      for(let [name, position] of Object.entries(nameToForcedPosition)) {
        let index = entries.findIndex(([key]) => key === name);
        if(index !== -1) {
          let [removed] = entries.splice(index, 1);
          entries.splice(position, 0, removed);
        }
      }
      item.compiledOptions = Object.fromEntries(entries);
      options.push(...entries.map(([name, obj]) => name).map(n => {
        let hasSubKeys = false;
        if(item.compiledOptions[n].getAllKeys && item.compiledOptions[n].getAllKeys.length > 0) hasSubKeys = true;
        let keyName = n;
        let display = item.compiledOptions[n].name ?? n;
        let value = item.compiledOptions[n];
        return {
          value,
          display,
          keyName:n,
          hasSubKeys,
          disabled: item.compiledOptions[n]["meta:disabled"] === true,
          image: item.compiledOptions[n]["meta:image"],
          selected: item.compiledOptions[n]["meta:selected"] === true,
        };
      }));
      let selectedOpt = options.find(opt => opt.selected);
      if(!selectedOpt) options[0].selected = true;
      let selectElHtml = `
        <select style="${item.type === "visual-select" ? "display:none;" : ""} width:-webkit-fill-available; width:-moz-available; width:fill-available; max-width:9rem;"
        data-name="${item.getName}" onchange="window.___selectElChangeEvent746291937.bind(this)(event);">
          ${options.map(opt => `<option value="${opt.hasSubKeys ? `ref:optionKeyName:${opt.keyName}` : opt.value}" ${opt.disabled ? "disabled" : ""}  ${opt.selected ? "selected" : ""}>${opt.display}</option>`).join("\n")}
        </select>
      `;
      if (item.type === "visual-select") {
        let selectedOption = options.find(opt => opt.selected) || options[0];

        // Clean hover title for the closed visual-select button
        let plainTitle = String(selectedOption?.display || 'Select.')
          .replace(/<[^>]*>?/gm, '')
          .replace(/"/g, '&quot;')
          .trim();

        if (item.getName === "artStyle") {
          plainTitle = "Random";
        }

        if (item.getName === "shape") {
          plainTitle = String(selectedOption?.name || selectedOption?.keyName || "Aspect Ratio")
            .replace(/<[^>]*>?/gm, "")
            .replace(/"/g, "&quot;")
            .trim();
        }

        selectElHtml = `
          <button class="visual-select-btn"
            style="
              width: 100%;
              min-height: 25.5px;
              padding: 1px 8px;
              font-size: 0.85rem;
              cursor: pointer;
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
              text-align: left;
              display: block;
            "
            title="${plainTitle}"
            onclick="window.___openVisualSelectModal('${item.getName}')">
            ${selectedOption?.display || 'Select...'}
          </button>

          <select style="display:none;"
            data-name="${item.getName}" onchange="window.___selectElChangeEvent746291937.bind(this)(event);">
            ${options.map(opt => `<option value="${opt.hasSubKeys ? `ref:optionKeyName:${opt.keyName}` : opt.value}" ${opt.disabled ? "disabled" : ""} ${opt.selected ? "selected" : ""}>${opt.display}</option>`).join("\n")}
          </select>
        `;
      }

      // Full-row behavior is shared with the other input types through CSS.
      let html = `<div class="input-ctn input-type-select ${item.takesUpFullRow ? "takesUpFullRow" : ""}">
        <div class="input-inner" style="${widthStyle}">
          <div class="input-label">
            <span style="width:max-content;">${item.label || item.getName.sentenceCase}</span>
            ${tipText ? ` <span class="input-tip-btn" title="${tipText}" onclick="window.___showInputHint746291937(this)"><span class="material-symbols-outlined" style="font-size: 1.1em; vertical-align: -0.15em;">info</span></i></span>` : ""}
          </div>
          <div class="input-wrapper">
            ${selectElHtml}
          </div>
        </div>
      </div>`;

      return html;
    }


  }).join("\n");

  const COLOR_SCHEME_STORAGE_KEY = 'forceColorScheme';
  const FOLLOW_SYSTEM_SCHEME_STORAGE_KEY = 'followSystemColorScheme';
  const REAL_COLOR_SCHEMES = ['light', 'grey', 'dark'];

  window.getSystemColorScheme = function() {
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? "dark" : "light";
  };

  window.isFollowingSystemColorScheme = function() {
    return localStorage.getItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY) === '1';
  };

  window.ensureColorSchemePreference = function() {
    const savedScheme = localStorage.getItem(COLOR_SCHEME_STORAGE_KEY);
    const savedFollowSystem = localStorage.getItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY);

    // Migrate the earlier picker value. "auto" is never passed into the theme system.
    if (savedScheme === 'auto') {
      const systemScheme = window.getSystemColorScheme();
      localStorage.setItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY, '1');
      localStorage.setItem(COLOR_SCHEME_STORAGE_KEY, systemScheme);
      return systemScheme;
    }

    if (REAL_COLOR_SCHEMES.includes(savedScheme)) {
      if (savedFollowSystem !== '1') {
        localStorage.setItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY, '0');
      }
      return savedScheme;
    }

    // First-time arrivals follow the system, but the stored/applied theme is real Light or Dark.
    const systemScheme = window.getSystemColorScheme();
    localStorage.setItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY, '1');
    localStorage.setItem(COLOR_SCHEME_STORAGE_KEY, systemScheme);
    return systemScheme;
  };

  window.getCurrentColorSchemeMode = function() {
    return window.ensureColorSchemePreference();
  };

  window.getCurrentColorScheme = function() {
    return window.getCurrentColorSchemeMode();
  };

  window.getColorSchemeModeIcon = function(mode) {
    return mode === 'light' ? 'light_mode' :
      mode === 'grey' ? 'chrome_reader_mode' :
      'nightlight';
  };

  window.getColorSchemeModeLabel = function(mode) {
    return mode === 'light' ? 'Light theme' :
      mode === 'grey' ? 'Read mode' :
      'Dark theme';
  };

  window.getColorSchemePickerLabel = function() {
    return window.isFollowingSystemColorScheme()
      ? 'Auto (follow browser setting)'
      : window.getColorSchemeModeLabel(window.getCurrentColorSchemeMode());
  };

  window.applyRealColorSchemeChoice = function(scheme) {
    if (!REAL_COLOR_SCHEMES.includes(scheme)) {
      throw new Error("scheme should be 'light', 'grey' or 'dark'");
    }

    localStorage.setItem(COLOR_SCHEME_STORAGE_KEY, scheme);
    setColorScheme(scheme);
  };

  window.toggleManualDarkMode_jv83hb27igksf = function() {
    if (window.isFollowingSystemColorScheme()) {
      // Picker sequence: Auto -> Light.
      localStorage.setItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY, '0');
      window.applyRealColorSchemeChoice('light');
    } else {
      const currentMode = window.getCurrentColorSchemeMode();

      if (currentMode === 'light') {
        window.applyRealColorSchemeChoice('grey');
      } else if (currentMode === 'grey') {
        window.applyRealColorSchemeChoice('dark');
      } else {
        // Picker sequence: Dark -> Auto. Auto only chooses the real preset upstream.
        localStorage.setItem(FOLLOW_SYSTEM_SCHEME_STORAGE_KEY, '1');
        window.applyRealColorSchemeChoice(window.getSystemColorScheme());
      }
    }

    // Regenerate comments only. Gallery theme is updated separately without rebuilding unrelated UI.
    const commentsCtn = document.getElementById("commentsPluginCtn654732");
    if(commentsCtn && commentsCtn.querySelector("iframe")) {
      window.__unmountCommentsPanel();
      window.__mountCommentsPanel();
    }
  };

  // AIFG accent override: lightweight aesthetic mapping.
  // The picked hue/saturation/lightness are preserved as a seed, then each
  // Light/Read/Dark palette keeps its own tone structure with simple HSL ratios.
  const AIFG_ACCENT_OVERRIDE_KEY = 'pl_accentOverride';
  const AIFG_ACCENT_COLOR_KEY = 'pl_accentColor';

  // [base saturation, base lightness, hue offset, optional alpha]
  const AIFG_ACCENT_RECIPE = {
    light: {
      '--link-color': [16, 48, -19],
      '--active-tab-background': [100, 88, -12],
      '--main-color': [65, 52, -11]
    },
    grey: {
      '__body-text': [18, 23, 0],
      '--link-color': [16, 48, -19],
      '--box-color': [21, 81, -4],
      '--active-comment-channel-tab-color': [20, 81, -3],
      '--tabbed-comments-background': [21, 81, -4],
      '--border-color': [15, 81, 1],
      '--active-tab-background': [31, 88, -3],
      '--main-color': [24, 47, -6],
      '--text-color': [18, 23, 0],
      '--button-color': [21, 81, -4],
      '--floatingpanel-bg-color': [23, 92, -4],
      '--floatingpanel-border-color': [50, 18, 4, .12],
      '--floatingpanel-button-color': [21, 81, -4],
      '--embedctn-bg-color': [19, 92, -1],
      '--backtotop-color': [28, 95, -5],
      '--usercountbg-color': [24, 47, -6, .15],
      '--pagebtn-color': [24, 91, 2],
      '--pagebtn-color-hover': [25, 89, -1]
    },
    dark: {
      '--link-color': [100, 81, 29],
      '--active-tab-background': [100, 15, -11],
      '--main-color': [64, 12, -11]
    }
  };

  // Built-in Light accent #1378E4 in HSL. New colors are mapped relative to it.
  const AIFG_BASE_ACCENT_S = 84.615;
  const AIFG_BASE_ACCENT_L = 48.431;

  function aifgNormalizeAccentHex(value) {
    const raw = String(value || '').trim().replace(/^#/, '');
    if (/^[0-9a-f]{3}$/i.test(raw)) {
      return '#' + raw.split('').map(ch => ch + ch).join('').toUpperCase();
    }
    return /^[0-9a-f]{6}$/i.test(raw) ? '#' + raw.toUpperCase() : '';
  }

  function aifgHexToHsl(hex) {
    const normalized = aifgNormalizeAccentHex(hex);
    if (!normalized) return null;

    const r = parseInt(normalized.slice(1, 3), 16) / 255;
    const g = parseInt(normalized.slice(3, 5), 16) / 255;
    const b = parseInt(normalized.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    const d = max - min;
    const l = (max + min) / 2;

    let h = 0;
    let s = 0;

    if (d) {
      s = d / (1 - Math.abs(2 * l - 1));
      h = max === r ? ((g - b) / d) % 6
        : max === g ? (b - r) / d + 2
        : (r - g) / d + 4;
      h = (h * 60 + 360) % 360;
    }

    return { h, s: s * 100, l: l * 100 };
  }

  function aifgClamp100(v) {
    return Math.max(0, Math.min(100, v));
  }

  function aifgHsl(h, s, l, a) {
    h = Math.round((h % 360 + 360) % 360);
    s = +aifgClamp100(s).toFixed(2);
    l = +aifgClamp100(l).toFixed(2);
    return a == null ? `hsl(${h} ${s}% ${l}%)` : `hsl(${h} ${s}% ${l}% / ${a})`;
  }

  window.getAifgBaseThemeAccent = function() {
    return window.__aifgBaseThemeAccent || '#1378E4';
  };

  window.getAifgAccentOverride = function() {
    return {
      enabled: localStorage.getItem(AIFG_ACCENT_OVERRIDE_KEY) === 'true',
      color: aifgNormalizeAccentHex(localStorage.getItem(AIFG_ACCENT_COLOR_KEY)) || '#1378E4'
    };
  };

  window.applyAifgAccentOverride = function(actualScheme, forcedHex) {
    if (!REAL_COLOR_SCHEMES.includes(actualScheme)) return false;

    const saved = window.getAifgAccentOverride();
    const accent = aifgNormalizeAccentHex(forcedHex) || saved.color;
    if (!forcedHex && !saved.enabled) return false;

    const picked = aifgHexToHsl(accent);
    if (!picked) return false;

    // Keep the picked color's character without letting Light/Read/Dark collapse
    // into the same brightness. Saturation is proportional; lightness is a
    // compressed ratio around AIFG blue so pale/muted/dark choices remain distinct.
    const saturationScale = picked.s / AIFG_BASE_ACCENT_S;
    const lightnessRatio = picked.l / AIFG_BASE_ACCENT_L;
    const lightnessPower = actualScheme === 'dark' ? 0.45 : 0.35;
    const toneScale = Math.pow(lightnessRatio, lightnessPower);

    Object.entries(AIFG_ACCENT_RECIPE[actualScheme] || {}).forEach(([token, v]) => {
      const color = aifgHsl(
        picked.h + v[2],
        v[0] * saturationScale,
        v[1] * toneScale,
        v[3]
      );
      if (token === '__body-text') document.body.style.color = color;
      else document.documentElement.style.setProperty(token, color);
    });

    // One user seed -> three coordinated accents.
    // Light uses the exact pick. Read/Dark keep their own brightness structure.
    const special = actualScheme === 'light'
      ? accent
      : actualScheme === 'grey'
        ? aifgHsl(picked.h - 8.63, 25 * saturationScale, 53 * toneScale)
        : aifgHsl(picked.h, 91 * saturationScale, 41 * toneScale);

    document.documentElement.style.setProperty('--special-color', special);
    document.documentElement.style.setProperty('--primary-color', special);
    document.documentElement.dataset.accentOverride = 'true';
    document.documentElement.dataset.accentColor = accent;
    return true;
  };

  window.setColorScheme = function(actualScheme) {
    if (!REAL_COLOR_SCHEMES.includes(actualScheme)) {
      throw new Error("actualScheme should be 'light', 'grey' or 'dark'");
    }

    // The live theme system receives only the real preset.
    document.documentElement.dataset.scheme = actualScheme;
    document.documentElement.dataset.schemeMode = actualScheme;

    const modeBtn = document.querySelector("#darkModeBtn_875979f948");
    if (modeBtn) {
      const followsSystem = window.isFollowingSystemColorScheme();
      const currentIcon = followsSystem ? 'hdr_auto' : window.getColorSchemeModeIcon(actualScheme);
      const currentLabel = followsSystem ? window.getColorSchemePickerLabel() : window.getColorSchemeModeLabel(actualScheme);
      modeBtn.innerHTML = `<span class="material-symbols-outlined" style="display:inline-block;width:30px;text-align:center;">${currentIcon}</span>`;
      modeBtn.title = currentLabel;
      modeBtn.setAttribute('aria-label', currentLabel);
    }

    // --- THEME VARS (your existing values) ---
    if(actualScheme === "dark") {
      document.documentElement.style.colorScheme = "dark";
      document.body.style.color = "#d8d4cf";
      document.body.style.backgroundColor = "#131516";
      document.documentElement.style.setProperty('--link-color', '#9E9EFF');
      document.documentElement.style.setProperty('--box-color', '#2a2a2a'); // CAUTION!!!! --> do not rename this variable - it is being used in "user-land" on some generators
      document.documentElement.style.setProperty('--active-comment-channel-tab-color', '#5b5b5b');
      document.documentElement.style.setProperty('--tabbed-comments-background', '#121212');
      document.documentElement.style.setProperty('--border-color', '#36363B');
      document.documentElement.style.setProperty('--background-color', '#131516');
      document.documentElement.style.setProperty('--active-tab-background', '#00334d');
      document.documentElement.style.setProperty('--main-color', '#0B2532');
      document.documentElement.style.setProperty('--text-color', '#d8d4cf');
      document.documentElement.style.setProperty('--alert-color', '#ca4949');
      document.documentElement.style.setProperty('--warning-color', '#ee1b2b');
      document.documentElement.style.setProperty('--button-color', '#5b5b5b');
      document.documentElement.style.setProperty('--special-color', '#0a66c9');
      document.documentElement.style.setProperty('--floatingpanel-bg-color', '#2A2A2A');
      document.documentElement.style.setProperty('--floatingpanel-border-color', 'rgba(255, 255, 255, 0.5)');
      document.documentElement.style.setProperty('--embedctn-bg-color', '#323232');
      document.documentElement.style.setProperty('--floatingpanel-button-color', '#131516');
      document.documentElement.style.setProperty('--backtotop-color', '#232323');
      document.documentElement.style.setProperty('--usercountbg-color', 'rgba(19, 21, 22, 0.3)');
      document.documentElement.style.setProperty('--pagebtn-color', '#6B6B6B');
      document.documentElement.style.setProperty('--pagebtn-color-hover', '#7B7B7B');
      document.documentElement.style.setProperty('--active-chip','#6B6B6B');

    } else if (actualScheme === "grey") {
      document.documentElement.style.colorScheme = "light";
      document.body.style.color = "#2F3944";
      document.body.style.backgroundColor = "#F3F2F0";
      document.documentElement.style.setProperty('--link-color', '#67878F');
      document.documentElement.style.setProperty('--box-color', '#C5D0D9');
      document.documentElement.style.setProperty('--active-comment-channel-tab-color', '#C6D0D9');
      document.documentElement.style.setProperty('--tabbed-comments-background', '#C5D0D9');
      document.documentElement.style.setProperty('--border-color', '#C7CED6');
      document.documentElement.style.setProperty('--background-color', '#F3F2F0');  // '#E7ECF0');
      document.documentElement.style.setProperty('--active-tab-background', '#D7E1EA');
      document.documentElement.style.setProperty('--main-color', '#5B7C93');
      document.documentElement.style.setProperty('--special-color', '#6A8FA5');
      document.documentElement.style.setProperty('--text-color', '#2F3944');
      document.documentElement.style.setProperty('--alert-color', '#fc5b5b');
      document.documentElement.style.setProperty('--warning-color', '#ee1b2b');
      document.documentElement.style.setProperty('--button-color', '#C5D0D9');
      document.documentElement.style.setProperty('--floatingpanel-bg-color', '#E7ECF0');
      document.documentElement.style.setProperty('--floatingpanel-border-color', 'rgba(23,42,69,0.12)');
      document.documentElement.style.setProperty('--floatingpanel-button-color', '#C5D0D9');
      document.documentElement.style.setProperty('--embedctn-bg-color', '#E6EAEE');
      document.documentElement.style.setProperty('--backtotop-color', '#EFF3F6');
      document.documentElement.style.setProperty('--usercountbg-color', 'rgba(91,124,147,0.15)');
      document.documentElement.style.setProperty('--pagebtn-color', '#E3E8EE');
      document.documentElement.style.setProperty('--pagebtn-color-hover', '#DCE3EA');
      document.documentElement.style.setProperty('--active-chip','#FFFFFF');

    } else {
      document.documentElement.style.colorScheme = "light";
      document.body.style.color = "black";
      document.body.style.backgroundColor = "white";
      document.documentElement.style.setProperty('--link-color', '#67878F');
      document.documentElement.style.setProperty('--box-color', '#E8E8E8');
      document.documentElement.style.setProperty('--active-comment-channel-tab-color', '#C6C6C6');
      document.documentElement.style.setProperty('--border-color', '#E0E0E0');
      document.documentElement.style.setProperty('--background-color', 'white');
      document.documentElement.style.setProperty('--tabbed-comments-background', '#CFCFCF');
      document.documentElement.style.setProperty('--active-tab-background', '#C3ECFF');
      document.documentElement.style.setProperty('--main-color', '#339ED4');
      document.documentElement.style.setProperty('--text-color', 'black');
      document.documentElement.style.setProperty('--alert-color', '#fc5b5b');
      document.documentElement.style.setProperty('--warning-color', '#ee1b2b');
      document.documentElement.style.setProperty('--button-color', '#e0e0e0');
      document.documentElement.style.setProperty('--special-color', '#1378e4');
      document.documentElement.style.setProperty('--floatingpanel-bg-color', '#EBEBEB');
      document.documentElement.style.setProperty('--floatingpanel-border-color', 'rgba(0, 0, 0, 0.5)');
      document.documentElement.style.setProperty('--embedctn-bg-color', '#ebebeb');
      document.documentElement.style.setProperty('--floatingpanel-button-color', '#CFCFCF');
      document.documentElement.style.setProperty('--backtotop-color', '#FFFFFF');
      document.documentElement.style.setProperty('--usercountbg-color', 'rgba(255, 255, 255, 0.3)');
      document.documentElement.style.setProperty('--pagebtn-color', '#EEEEEE');
      document.documentElement.style.setProperty('--pagebtn-color-hover', '#E5E5E5');
      document.documentElement.style.setProperty('--active-chip','#C2C4C6');
    }

    // Capture the generator/season skin's own accent before applying a user override.
    // Reset-to-theme returns to this layer; a saved user accent is always reapplied after it.
    window.__aifgBaseThemeAccent =
      getComputedStyle(document.documentElement).getPropertyValue('--special-color').trim() ||
      (actualScheme === 'dark' ? '#0A66C9' : actualScheme === 'grey' ? '#6A8FA5' : '#1378E4');

    document.documentElement.dataset.accentOverride = 'false';
    document.documentElement.removeAttribute('data-accent-color');
    document.documentElement.style.removeProperty('--primary-color');

    window.applyAifgAccentOverride(actualScheme);

    // ensure button text/UI syncs immediately
    if (typeof updateColorSchemeButton === 'function') updateColorSchemeButton();
  }

  if (!window.__aifgAutoThemeListenerInstalled && window.matchMedia) {
    const autoThemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const applyAutoThemeChange = () => {
      if (!window.isFollowingSystemColorScheme()) return;

      // Auto disappears here: select and apply the normal real preset.
      window.applyRealColorSchemeChoice(window.getSystemColorScheme());

      const commentsCtn = document.getElementById("commentsPluginCtn654732");
      if (commentsCtn && commentsCtn.querySelector("iframe")) {
        window.__unmountCommentsPanel();
        window.__mountCommentsPanel();
      }
    };

    if (autoThemeQuery.addEventListener) {
      autoThemeQuery.addEventListener('change', applyAutoThemeChange);
    } else if (autoThemeQuery.addListener) {
      autoThemeQuery.addListener(applyAutoThemeChange);
    }
    window.__aifgAutoThemeListenerInstalled = true;
  }

