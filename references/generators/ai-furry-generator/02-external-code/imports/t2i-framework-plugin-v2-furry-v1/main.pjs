            <div style="font-weight:600; font-size:0.9rem; margin-bottom:8px; opacity:0.8; display:flex; align-items:center; gap:8px;">
              <i class="fa-solid fa-comments"></i> AI Character Chat
            </div>

            <div style="background:rgba(0,0,0,0.2); padding:4px 4px 4px 10px; border-radius:6px; border:1px solid var(--border-color,#444); display:flex; align-items:center; gap:8px; margin-bottom:10px;">
              <input type="text" value="${standardLink}" readonly style="flex:1; background:transparent; border:none; color:inherit; font-size:0.8rem; outline:none; opacity:0.8; text-overflow:ellipsis; font-family:inherit;">
              <button class="opt-btn copy-btn" data-url="${standardLink}" style="padding:6px 10px; border-radius:6px; border:none; background:var(--button-color,#333); color:inherit; cursor:pointer; font-weight:600; font-size:0.75rem; min-width:50px;">Copy</button>
            </div>

            <button onclick="window.open('${standardLink}', '_blank')" class="opt-btn" style="width:100%; padding:10px; border-radius:6px; border:1px solid var(--border-color,#555); background:transparent; color:inherit; font-size:0.9rem; font-weight:500; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;">
              Open AI Character Chat
