        <div class="t2i-tool-stage-shell">
          <div class="t2i-tool-float-controls" data-ui="viewControls" hidden>
            <button class="t2i-tool-button" data-ui="checker" type="button" title="Checker light" aria-label="Checker light"><i class="fa-solid fa-sun fa-fw"></i></button>
            <label class="t2i-tool-label is-zoom" data-ui="zoomWrap"><i class="fa-solid fa-magnifying-glass-plus fa-fw"></i><input data-ui="zoom" type="range" min="5" max="500" step="1" value="100" aria-label="Zoom"></label>
            <button class="t2i-tool-button" data-ui="zoomReset" type="button" title="Fit image">Fit</button>
          </div>
          <div class="t2i-tool-stage" data-ui="stage">
            <div class="t2i-tool-progress" data-ui="progress"><div class="t2i-tool-status"><i class="fa-solid fa-spinner fa-spin" data-ui="spinner"></i><span data-ui="status">please wait…</span></div><div class="t2i-tool-bar" data-ui="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" hidden><span data-ui="fill"></span></div></div>
            <div class="t2i-editor-wrap" data-ui="editorWrap" hidden><div class="t2i-editor-scroller" data-ui="editorScroller"><canvas class="t2i-editor-canvas" data-ui="canvas"></canvas></div><div class="t2i-editor-cursor" data-ui="cursor" hidden></div></div>
            <div class="t2i-compare-wrap" data-ui="compareWrap" hidden>
              <div class="t2i-compare-stage">
                <img data-ui="compareBefore" alt="Before upscale">
                <div class="t2i-compare-after-clip" data-ui="compareAfterClip"><img data-ui="compareAfter" alt="After upscale"></div>
                <div class="t2i-compare-divider" data-ui="compareDivider"><span>↔</span></div>
                <div class="t2i-compare-label before">Before</div><div class="t2i-compare-label after">After</div>
              </div>
              <input class="t2i-compare-slider" data-ui="compareSlider" type="range" min="0" max="100" value="50" aria-label="Before and after comparison">
            </div>
          </div>
          <div class="t2i-mini-map" data-ui="miniMap" hidden><canvas data-ui="miniMapCanvas" width="148" height="148"></canvas><span class="t2i-mini-map-view" data-ui="miniMapView"></span></div>
        </div>
        <div class="t2i-tool-actions"><button class="t2i-tool-button" data-ui="secondary" hidden>Abort</button><button class="t2i-tool-button" data-ui="next" hidden></button><button class="t2i-tool-button" data-ui="save" hidden><i class="fa-solid fa-notes-medical fa-fw"></i> Save to Concept Board</button><button class="t2i-tool-button" data-ui="copy" hidden><i class="fa-solid fa-link fa-fw"></i> Copy image link</button><button class="t2i-tool-button primary" data-ui="download" hidden><i class="fa-solid fa-download fa-fw"></i> Download</button></div>
      </div>`;
    document.body.appendChild(overlay);

    ui = { overlay };
    overlay.querySelectorAll("[data-ui]").forEach(element => ui[element.dataset.ui] = element);

    const copyText = async text => {
      try { await navigator.clipboard.writeText(text); }
      catch(_) {
        const input = document.createElement("textarea");
        input.value = text; input.readOnly = true; input.style.cssText = "position:absolute;left:-9999px;top:0;opacity:0";
        document.body.appendChild(input); input.select();
        const copied = document.execCommand("copy"); input.remove();
        if(!copied) throw new Error("Your browser blocked clipboard access.");
      }
    };

    const saveCurrentStudioResultToConceptBoard = async (button, activeJob = job) => {
      if(!activeJob || activeJob !== job) return;
      if(!window.t2i_privateGallery?.add) {
        throw new Error("Concept Board is not available on this page.");
      }

      const idleHtml = button.innerHTML;
      button.disabled = true;

      try {
        const blob = await ensureCurrentResultBlob();
        if(!blob || job !== activeJob) return;

        const addOpts = t2iGetGeneratorConceptBoardAddOpts(
          activeJob.conceptInfo && typeof activeJob.conceptInfo === "object"
            ? activeJob.conceptInfo
            : {}
        );

        await window.t2i_privateGallery.add(blob, addOpts);
        if(job !== activeJob) return;

        button.innerHTML = '<i class="fa-solid fa-check fa-fw"></i> Saved';
        setTimeout(() => {
          if(button.isConnected && job === activeJob) button.innerHTML = idleHtml;
        }, 1800);
      } finally {
        if(button.isConnected && job === activeJob) button.disabled = false;
      }
    };

    ui.close.onclick = () => requestDispose();
    ui.secondary.onclick = () => requestDispose();
    ui.download.onclick = async () => {
      try {
        const blob = await ensureCurrentResultBlob();
        if(blob) downloadBlob(blob, job.filename || filename(job.suffix || "", blob.type || "image/webp"));
      } catch(error) { window.aifgAlert("Error: " + error.message); }
    };
    ui.save.onclick = async () => {
      try {
        await saveCurrentStudioResultToConceptBoard(ui.save);
      } catch(error) {
        window.aifgAlert("Error: " + error.message);
      }
    };
    ui.next.onclick = async () => {
      try {
        const blob = await ensureCurrentResultBlob();
        if(blob) run(job.task === "upscale" ? "remove-background" : "upscale", blob, { conceptInfo: job?.conceptInfo || {} });
      } catch(error) { window.aifgAlert("Error: " + error.message); }
    };
    ui.copy.onclick = async () => {
      if(!job) return;
      const activeJob = job;
      const idleHtml = '<i class="fa-solid fa-link fa-fw"></i> Copy image link';
      ui.copy.disabled = true;
      try {
        const blob = await ensureCurrentResultBlob();
        if(!blob) return;
        if(!activeJob.shareUrl) {
          const uploadId = ++activeJob.uploadId;
          ui.copy.innerHTML = '<i class="fa-solid fa-spinner fa-spin fa-fw"></i> Uploading…';
          const { url, error } = await upload(blob);
          if(job !== activeJob || activeJob.uploadId !== uploadId) return;
          if(error === "file_too_big") throw new Error("File too big for permanent storage.");
          if(error === "over_daily_allowance") throw new Error("Daily permanent upload limit reached.");
          if(error || !url) throw new Error(error || "Image upload failed.");
          activeJob.shareUrl = url;
        }
        await copyText(activeJob.shareUrl);
        if(job === activeJob) ui.copy.innerHTML = '<i class="fa-solid fa-check fa-fw"></i> Copied';
      } catch(error) {
        if(job === activeJob) { ui.copy.innerHTML = idleHtml; window.aifgAlert("Error: " + error.message); }
      } finally { if(job === activeJob) ui.copy.disabled = false; }
    };

    ui.checker.onclick = () => {
      const dark = !ui.stage.classList.contains("checker-dark");
      ui.stage.classList.toggle("checker-dark", dark);
      ui.checker.title = dark ? "Checker dark" : "Checker light";
      ui.checker.setAttribute("aria-label", ui.checker.title);
      ui.checker.innerHTML = dark
        ? '<i class="fa-solid fa-moon fa-fw"></i>'
        : '<i class="fa-solid fa-sun fa-fw"></i>';
    };
    ui.compareSlider.oninput = updateCompareSlider;
    ui.zoom.oninput = () => editor && setEditorZoom((Number(ui.zoom.value) || 100) / 100, false);
    ui.zoomReset.onclick = () => editor && setEditorZoom("fit");
    ui.erase.onclick = () => setEditorMode("erase");
    ui.wand.onclick = () => setEditorMode("wand");
    ui.autoClean.onclick = applyAutoClean;
    ui.aiClean.onclick = runEditorAiClean;
    ui.studioUpscale.onclick = async () => {
      let choice = null;
      try {
        const width = editor?.canvas?.width || 1;
        const height = editor?.canvas?.height || 1;
        choice = await openUpscaleChoice(width, height);
        if(!choice) return;

        if(editor) {
          studioReturnState = {
            blob: await canvasToBlobAsync(editor.canvas, "image/png", 1),
            checkerDark: ui.stage.classList.contains("checker-dark"),
            mode: editor.mode,
            brushSize: editor.brushSize,
            similarity: editor.similarity,
            zoom: editor.zoom
          };
        }

        const blob = await ensureCurrentResultBlob();
        if(!blob) {
          try { choice.popup?.close?.(); } catch(_) {}
          return;
        }

        await run(
          choice.kind === "bigger" ? "bigger-upscale" : "upscale",
          blob,
          { keepStudioState: true, biggerPopup: choice.popup || null, conceptInfo: job?.conceptInfo || {} }
        );
      } catch(error) {
        if(choice?.kind === "bigger") clearPendingBiggerHandoff(true);
        else {
          try { choice?.popup?.close?.(); } catch(_) {}
        }
        window.aifgAlert("Error: " + error.message);
      }
    };
    ui.undo.onclick = editorUndo;
    ui.redo.onclick = editorRedo;
    ui.brush.oninput = () => { if(editor) { editor.brushSize = Number(ui.brush.value) || 30; ui.brushValue.textContent = String(Math.round(editor.brushSize)); } };
    ui.similarity.oninput = () => { if(editor) { editor.similarity = Number(ui.similarity.value) || 32; ui.similarityValue.textContent = `${Math.round(editor.similarity)}%`; } };
    ui.editorScroller.addEventListener("scroll", updateMiniMapView, {passive:true});
    ui.canvas.addEventListener("pointerdown", onCanvasPointerDown);
    ui.canvas.addEventListener("pointermove", onCanvasPointerMove);
    ui.canvas.addEventListener("pointerup", onCanvasPointerUp);
    ui.canvas.addEventListener("pointercancel", onCanvasPointerUp);
    ui.canvas.addEventListener("pointerleave", onCanvasPointerUp);
    ui.canvas.addEventListener("pointerenter", () => { if(editor) ui.cursor.hidden = false; });
    ui.miniMap.addEventListener("pointerdown", onMiniMapPointerDown, {passive:false});
    ui.miniMap.addEventListener("pointermove", onMiniMapPointerMove, {passive:false});
    ui.miniMap.addEventListener("pointerup", onMiniMapPointerUp);
    ui.miniMap.addEventListener("pointercancel", onMiniMapPointerUp);
    window.addEventListener("resize", () => { if(editor) setEditorZoom("fit", false); updateCompareSlider(); }, {passive:true});
    return ui;
  };

  const createUpscaleUi = () => {
    if(upscaleUi?.overlay?.isConnected) return upscaleUi;

    if(!document.getElementById("t2iUpscaleStudioStyle")) {
      const style = document.createElement("style");
      style.id = "t2iUpscaleStudioStyle";
      style.textContent = `
        .t2i-upscale-overlay[hidden]{display:none!important}
        .t2i-upscale-overlay{inset:0;position:fixed;z-index:2147483641;display:flex;align-items:center;justify-content:center;padding:10px;background:rgba(0,0,0,.74)}
        .t2i-upscale-dialog{width:min(96vw,1440px);height:min(94dvh,1080px);display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border-color);border-radius:14px;background:var(--box-color);color:var(--text-color);box-shadow:0 16px 48px rgba(0,0,0,.44)}
        .t2i-upscale-head,.t2i-upscale-actions{display:flex;align-items:center;gap:8px;padding:10px 12px}.t2i-upscale-head{justify-content:space-between;border-bottom:1px solid var(--border-color);font-weight:600}.t2i-upscale-toolbar{position:absolute;top:14px;right:14px;z-index:4;display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid rgba(127,127,127,.18);border-radius:12px;background:rgba(24,26,30,.78);backdrop-filter:blur(10px);box-shadow:0 10px 24px rgba(0,0,0,.22)}.t2i-upscale-actions{justify-content:flex-end;flex-wrap:wrap;border-top:1px solid var(--border-color)}.t2i-upscale-short{display:none}
        .t2i-upscale-stage{position:relative;flex:1;min-height:0;padding:18px;display:flex;flex-direction:column;gap:12px;--t2i-up-a:rgba(0,0,0,.08);--t2i-up-b:#f1f3f5;background-color:var(--t2i-up-b);background-image:linear-gradient(45deg,var(--t2i-up-a) 25%,transparent 25%),linear-gradient(-45deg,var(--t2i-up-a) 25%,transparent 25%),linear-gradient(45deg,transparent 75%,var(--t2i-up-a) 75%),linear-gradient(-45deg,transparent 75%,var(--t2i-up-a) 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}
        .t2i-upscale-stage.is-dark{--t2i-up-a:rgba(255,255,255,.08);--t2i-up-b:#171b20}
        .t2i-upscale-compare{position:relative;flex:1;min-height:240px;overflow:hidden;border:1px solid rgba(127,127,127,.22);border-radius:12px;background:rgba(127,127,127,.04);cursor:ew-resize;touch-action:none}.t2i-upscale-compare.is-pan{cursor:grab}.t2i-upscale-compare.is-pan.is-dragging{cursor:grabbing}
        .t2i-upscale-compare>img,.t2i-upscale-after,.t2i-upscale-after img{position:absolute;left:0;top:0;user-select:none;-webkit-user-drag:none}.t2i-upscale-compare>img,.t2i-upscale-after img{transform-origin:0 0}.t2i-upscale-after{overflow:hidden;pointer-events:none;inset:0}
        .t2i-upscale-divider{position:absolute;top:0;bottom:0;width:2px;background:#fff;box-shadow:0 0 0 1px rgba(0,0,0,.28);pointer-events:none}.t2i-upscale-divider span{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:999px;background:rgba(0,0,0,.6);color:#fff}
        .t2i-upscale-label{position:absolute;top:12px;padding:5px 9px;border-radius:999px;background:rgba(0,0,0,.58);color:#fff;font-size:.82rem;font-weight:650}.t2i-upscale-label.before{left:12px}.t2i-upscale-label.after{right:12px}
        .t2i-upscale-progress{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:5;width:min(80%,430px);padding:18px 20px;border-radius:12px;background:rgba(0,0,0,.48);color:#fff;text-align:center;backdrop-filter:blur(10px)}
        .t2i-upscale-percent{font-size:1.3rem;font-weight:750}.t2i-upscale-bar{height:5px;margin-top:10px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.22)}.t2i-upscale-bar span{display:block;width:0;height:100%;background:#fff;border-radius:inherit;transition:width .12s linear}
        .t2i-upscale-btn,.t2i-upscale-close,.t2i-upscale-label-ui input{font:inherit}.t2i-upscale-btn{min-height:34px;padding:6px 12px;border:1px solid var(--border-color);border-radius:8px;background:transparent;color:inherit;cursor:pointer}.t2i-upscale-btn.primary{border-color:transparent;background:var(--special-color,#0a66c9);color:#fff}.t2i-upscale-close{border:0;background:transparent;color:inherit;cursor:pointer;font-size:1.1rem}.t2i-upscale-label-ui{display:flex;align-items:center;gap:6px;font-size:.9rem}.t2i-upscale-label-ui input[type="range"]{width:96px}.t2i-upscale-mini-map{position:absolute;right:18px;bottom:18px;width:148px;height:148px;overflow:hidden;border-radius:10px;border:1px solid rgba(127,127,127,.22);background:rgba(0,0,0,.42);backdrop-filter:blur(6px);z-index:4;touch-action:none}.t2i-upscale-mini-map canvas{display:block;width:100%;height:100%}.t2i-upscale-mini-view{position:absolute;border:2px solid var(--special-color,#0a66c9);box-sizing:border-box;background:rgba(10,102,201,.12);pointer-events:none}.t2i-upscale-value{opacity:.78;font-size:.88rem;min-width:46px;text-align:right}
        @media(max-width:860px){.t2i-upscale-overlay{padding:3px}.t2i-upscale-dialog{width:calc(100vw - 6px);height:calc(100dvh - 6px);border-radius:9px}.t2i-upscale-head{min-height:40px;box-sizing:border-box;padding:6px 8px}.t2i-upscale-stage{padding:0;gap:0}.t2i-upscale-compare{border-radius:0;border-left:0;border-right:0}.t2i-upscale-toolbar{top:7px;right:7px;max-width:calc(100% - 14px);padding:5px 6px;gap:4px;border-radius:9px}.t2i-upscale-btn{min-height:30px;padding:4px 7px;font-size:.8rem}.t2i-upscale-toolbar .t2i-upscale-btn{min-width:30px;padding:4px 6px}.t2i-upscale-label-ui{gap:4px;font-size:.78rem}.t2i-upscale-label-ui input[type="range"]{width:62px}.t2i-upscale-value{min-width:38px;font-size:.78rem}.t2i-upscale-actions{min-height:42px;box-sizing:border-box;justify-content:flex-end;flex-wrap:nowrap;gap:4px;padding:6px 7px;overflow-x:auto;overflow-y:hidden}.t2i-upscale-actions .t2i-upscale-btn{flex:0 0 auto;white-space:nowrap}.t2i-upscale-long{display:none}.t2i-upscale-short{display:inline}.t2i-upscale-mini-map{width:92px;height:92px;right:7px;bottom:7px}.t2i-upscale-progress{width:min(76%,360px);padding:14px 16px}}
        @media(max-width:430px){.t2i-upscale-toolbar{left:7px;right:7px;justify-content:flex-end}.t2i-upscale-label-ui input[type="range"]{width:54px}.t2i-upscale-value{min-width:34px}.t2i-upscale-copy-btn .t2i-upscale-short{display:none}.t2i-upscale-actions{padding-left:5px;padding-right:5px}.t2i-upscale-mini-map{width:84px;height:84px}}
      `;
      document.head.appendChild(style);
    }

    const overlay = document.createElement("div");
    overlay.className = "t2i-upscale-overlay";
    overlay.hidden = true;
    overlay.innerHTML = `
      <div class="t2i-upscale-dialog" role="dialog" aria-modal="true">
        <div class="t2i-upscale-head"><span data-up="title">Upscale 2×</span><div style="display:flex;align-items:center;gap:6px;"><button class="t2i-upscale-close" data-up="close" type="button" aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div></div>
        <div class="t2i-upscale-stage" data-up="stage">
          <div class="t2i-upscale-toolbar" data-up="toolbar" hidden>
            <button class="t2i-upscale-btn" data-up="checker" type="button" title="Checker light" aria-label="Checker light"><i class="fa-solid fa-sun fa-fw"></i></button>
            <label class="t2i-upscale-label-ui"><i class="fa-solid fa-magnifying-glass-plus fa-fw"></i><input data-up="zoom" type="range" min="5" max="500" step="1" value="100" aria-label="Zoom"></label>
            <button class="t2i-upscale-btn" data-up="zoomReset" type="button">Fit</button>
          </div>
          <input data-up="slider" type="range" min="0" max="100" value="50" hidden aria-hidden="true" tabindex="-1">
          <div class="t2i-upscale-compare" data-up="compare" hidden>
            <img data-up="before" alt="Before upscale">
            <div class="t2i-upscale-after" data-up="afterClip"><img data-up="after" alt="After upscale"></div>
            <div class="t2i-upscale-divider" data-up="divider"><span>↔</span></div>
            <div class="t2i-upscale-label before">Before</div><div class="t2i-upscale-label after">After</div>
          </div>
          <div class="t2i-upscale-progress" data-up="progress"><div class="t2i-upscale-percent" data-up="percent">0%</div><div data-up="status" style="margin-top:4px;font-size:.82rem;line-height:1.35;opacity:.78;">Preparing…</div><div class="t2i-upscale-bar"><span data-up="fill"></span></div></div>
          <div class="t2i-upscale-mini-map" data-up="miniMap" hidden><canvas data-up="miniMapCanvas" width="148" height="148"></canvas><span class="t2i-upscale-mini-view" data-up="miniMapView"></span></div>
        </div>
        <div class="t2i-upscale-actions"><button class="t2i-upscale-btn" data-up="abort" type="button" hidden><i class="fa-solid fa-stop fa-fw"></i><span>Abort</span></button><button class="t2i-upscale-btn" data-up="back" type="button" hidden><i class="fa-solid fa-arrow-left fa-fw"></i><span class="t2i-upscale-long">Back to Studio</span><span class="t2i-upscale-short">Studio</span></button><button class="t2i-upscale-btn" data-up="save" type="button" hidden><i class="fa-solid fa-notes-medical fa-fw"></i><span class="t2i-upscale-long">Save to Concept Board</span><span class="t2i-upscale-short">Save</span></button><button class="t2i-upscale-btn t2i-upscale-copy-btn" data-up="copy" type="button" hidden><i class="fa-solid fa-link fa-fw"></i><span class="t2i-upscale-long">Copy image link</span><span class="t2i-upscale-short">Copy</span></button><button class="t2i-upscale-btn primary" data-up="download" type="button" hidden><i class="fa-solid fa-download fa-fw"></i><span>Download</span></button></div>
      </div>`;
    document.body.appendChild(overlay);
    upscaleUi = {overlay};
    overlay.querySelectorAll("[data-up]").forEach(el => upscaleUi[el.dataset.up] = el);
    upscaleUi.close.onclick = () => requestDispose();
    upscaleUi.save.onclick = async () => {
      try {
        await saveCurrentStudioResultToConceptBoard(upscaleUi.save);
      } catch(error) {
        window.aifgAlert("Error: " + error.message);
      }
    };
    upscaleUi.checker.onclick = () => {
      const dark = !upscaleUi.stage.classList.contains("is-dark");
      upscaleUi.stage.classList.toggle("is-dark", dark);
      upscaleUi.checker.title = dark ? "Checker dark" : "Checker light";
      upscaleUi.checker.setAttribute("aria-label", upscaleUi.checker.title);
      upscaleUi.checker.innerHTML = dark
        ? '<i class="fa-solid fa-moon fa-fw"></i>'
        : '<i class="fa-solid fa-sun fa-fw"></i>';
    };
    upscaleUi.slider.oninput = updateUpscaleCompareSlider;
    upscaleUi.zoom.oninput = () => setUpscaleZoom((Number(upscaleUi.zoom.value) || 100) / 100, false);
    upscaleUi.zoomReset.onclick = () => setUpscaleZoom("fit");
    upscaleUi.compare.addEventListener("pointerdown", onUpscaleComparePointerDown);
    upscaleUi.compare.addEventListener("pointermove", onUpscaleComparePointerMove);
    upscaleUi.compare.addEventListener("pointerup", onUpscaleComparePointerUp);
    upscaleUi.compare.addEventListener("pointercancel", onUpscaleComparePointerUp);
    upscaleUi.miniMap.addEventListener("pointerdown", onUpscaleMiniMapPointerDown, {passive:false});
    upscaleUi.miniMap.addEventListener("pointermove", onUpscaleMiniMapPointerMove, {passive:false});
    upscaleUi.miniMap.addEventListener("pointerup", onUpscaleMiniMapPointerUp);
    upscaleUi.miniMap.addEventListener("pointercancel", onUpscaleMiniMapPointerUp);
    window.addEventListener("resize", () => { if(upscaleUi?.overlay && !upscaleUi.overlay.hidden && upscaleUi.compare && !upscaleUi.compare.hidden) setUpscaleZoom("fit"); }, {passive:true});
    upscaleUi.abort.onclick = () => {
      if(!isUpscaleTask(job?.task) || job.finished) return;
      const keepStudio = !!studioReturnState;
      if(job.task === "bigger-upscale") clearBiggerSession(true);
      else {
        try { job.upscaler?.close?.(); } catch(_) {}
      }
      cleanup(true, keepStudio);
      if(keepStudio && studioReturnState) {
        pendingStudioRestore = studioReturnState;
        void run("studio", studioReturnState.blob, { keepStudioState: true, restoreState: studioReturnState, conceptInfo: job?.conceptInfo || {} });
      }
    };
    upscaleUi.back.onclick = async () => {
      if(!studioReturnState) return;
      try {
        pendingStudioRestore = studioReturnState;
        await run("studio", studioReturnState.blob, { keepStudioState: true, restoreState: studioReturnState, conceptInfo: job?.conceptInfo || {} });
      } catch(error) {
        window.aifgAlert("Error: " + error.message);
      }
    };
    upscaleUi.download.onclick = () => { if(job?.resultUrl) download(job.resultUrl, job.filename); };
    upscaleUi.copy.onclick = async () => {
      if(!job?.resultBlob) return;
      const activeJob = job;
      upscaleUi.copy.disabled = true;
      try {
        if(!activeJob.shareUrl) {
          upscaleUi.copy.innerHTML = '<i class="fa-solid fa-spinner fa-spin fa-fw"></i> Uploading…';
          const {url,error} = await upload(activeJob.resultBlob);
          if(job !== activeJob) return;
          if(error || !url) throw new Error(error || "Image upload failed.");
          activeJob.shareUrl = url;
        }
        try { await navigator.clipboard.writeText(activeJob.shareUrl); }
        catch(_) {
          const input = document.createElement("textarea");
          input.value = activeJob.shareUrl; input.style.cssText = "position:absolute;left:-9999px";
          document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove();
        }
        if(job === activeJob) upscaleUi.copy.innerHTML = '<i class="fa-solid fa-check fa-fw"></i> Copied';
      } catch(error) {
        if(job === activeJob) { upscaleUi.copy.innerHTML = '<i class="fa-solid fa-link fa-fw"></i> Copy image link'; window.aifgAlert("Error: " + error.message); }
      } finally {
        if(job === activeJob) upscaleUi.copy.disabled = false;
      }
    };
    return upscaleUi;
  };

  const clampUpscalePan = () => {
    if(!upscaleUi?.view) return;
    const view = upscaleUi.view;
    const compare = upscaleUi.compare;
    if(!compare) return;
    const compareW = Math.max(1, compare.clientWidth);
    const compareH = Math.max(1, compare.clientHeight);
    const scaledW = view.imageWidth * view.zoom;
    const scaledH = view.imageHeight * view.zoom;
    const minPanX = scaledW <= compareW ? (compareW - scaledW) / 2 : compareW - scaledW;
    const maxPanX = scaledW <= compareW ? (compareW - scaledW) / 2 : 0;
    const minPanY = scaledH <= compareH ? (compareH - scaledH) / 2 : compareH - scaledH;
    const maxPanY = scaledH <= compareH ? (compareH - scaledH) / 2 : 0;
    view.panX = clamp(view.panX, minPanX, maxPanX);
    view.panY = clamp(view.panY, minPanY, maxPanY);
  };

  const applyUpscaleView = () => {
    if(!upscaleUi?.view || !upscaleUi.before || !upscaleUi.after) return;
    const view = upscaleUi.view;
    clampUpscalePan();
    const width = `${view.imageWidth}px`;
    const height = `${view.imageHeight}px`;
    const transform = `translate(${view.panX}px, ${view.panY}px) scale(${view.zoom})`;
    [upscaleUi.before, upscaleUi.after].forEach(img => {
      img.style.width = width;
      img.style.height = height;
      img.style.transform = transform;
    });
    upscaleUi.compare.classList.toggle("is-pan", view.zoom > (view.fitZoom + 0.001));
    if(upscaleUi.zoom) upscaleUi.zoom.value = String(clamp(Math.round(view.zoom * 100), 5, 500));
    updateUpscaleMiniMap();
    updateUpscaleMiniMapView();
  };

  const setUpscaleZoom = (value, recenter = true) => {
    if(!upscaleUi?.compare || !upscaleUi.before?.naturalWidth) return;
    const compareW = Math.max(1, upscaleUi.compare.clientWidth);
    const compareH = Math.max(1, upscaleUi.compare.clientHeight);
    const view = upscaleUi.view || (upscaleUi.view = {});
    view.imageWidth = upscaleUi.before.naturalWidth || 1;
    view.imageHeight = upscaleUi.before.naturalHeight || 1;
    view.fitZoom = clamp(Math.min(compareW / view.imageWidth, compareH / view.imageHeight) || 1, 0.05, 10);
    const oldZoom = view.zoom || view.fitZoom;
    const centerX = recenter ? view.imageWidth / 2 : clamp((compareW / 2 - (view.panX || 0)) / oldZoom, 0, view.imageWidth);
    const centerY = recenter ? view.imageHeight / 2 : clamp((compareH / 2 - (view.panY || 0)) / oldZoom, 0, view.imageHeight);
    view.zoom = value === "fit" ? view.fitZoom : clamp(Number(value) || view.fitZoom, 0.05, 5);
    view.panX = compareW / 2 - centerX * view.zoom;
    view.panY = compareH / 2 - centerY * view.zoom;
    applyUpscaleView();
  };

  const updateUpscaleMiniMap = () => {
    if(!upscaleUi?.miniMap || upscaleUi.miniMap.hidden || !upscaleUi.view) return;
    const canvas = upscaleUi.miniMapCanvas;
    const ctx = canvas.getContext("2d", {alpha:true});
    if(!ctx) return;
    const view = upscaleUi.view;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const scale = Math.min(canvas.width / view.imageWidth, canvas.height / view.imageHeight);
    const drawW = view.imageWidth * scale;
    const drawH = view.imageHeight * scale;
    const dx = (canvas.width - drawW) / 2;
    const dy = (canvas.height - drawH) / 2;
    ctx.drawImage(upscaleUi.before, dx, dy, drawW, drawH);
    view.miniMap = { scale, dx, dy, drawW, drawH };
  };

  const updateUpscaleMiniMapView = () => {
    if(!upscaleUi?.view?.miniMap || upscaleUi.miniMap.hidden) return;
    const view = upscaleUi.view;
    const mm = view.miniMap;
    const compareW = Math.max(1, upscaleUi.compare.clientWidth);
    const compareH = Math.max(1, upscaleUi.compare.clientHeight);
    const visibleX = clamp((0 - view.panX) / view.zoom, 0, view.imageWidth);
    const visibleY = clamp((0 - view.panY) / view.zoom, 0, view.imageHeight);
    const visibleW = clamp(compareW / view.zoom, 0, view.imageWidth - visibleX);
    const visibleH = clamp(compareH / view.zoom, 0, view.imageHeight - visibleY);
    upscaleUi.miniMapView.style.left = `${mm.dx + visibleX * mm.scale}px`;
    upscaleUi.miniMapView.style.top = `${mm.dy + visibleY * mm.scale}px`;
    upscaleUi.miniMapView.style.width = `${Math.max(8, visibleW * mm.scale)}px`;
    upscaleUi.miniMapView.style.height = `${Math.max(8, visibleH * mm.scale)}px`;
  };

  const setUpscaleViewportFromMiniMap = (clientX, clientY) => {
    if(!upscaleUi?.view?.miniMap) return;
    const rect = upscaleUi.miniMap.getBoundingClientRect();
    const scaleX = upscaleUi.miniMapCanvas.width / Math.max(1, rect.width);
    const scaleY = upscaleUi.miniMapCanvas.height / Math.max(1, rect.height);
    const localX = clamp((clientX - rect.left) * scaleX, 0, upscaleUi.miniMapCanvas.width);
    const localY = clamp((clientY - rect.top) * scaleY, 0, upscaleUi.miniMapCanvas.height);
    const view = upscaleUi.view;
    const mm = view.miniMap;
    const imageX = clamp((localX - mm.dx) / Math.max(mm.scale, 0.0001), 0, view.imageWidth);
    const imageY = clamp((localY - mm.dy) / Math.max(mm.scale, 0.0001), 0, view.imageHeight);
    const compareW = Math.max(1, upscaleUi.compare.clientWidth);
    const compareH = Math.max(1, upscaleUi.compare.clientHeight);
    view.panX = compareW / 2 - imageX * view.zoom;
    view.panY = compareH / 2 - imageY * view.zoom;
    applyUpscaleView();
  };

  const onUpscaleMiniMapPointerDown = event => {
    if(!upscaleUi?.view?.miniMap) return;
    event.preventDefault();
    upscaleUi.miniDragging = true;
    try { upscaleUi.miniMap.setPointerCapture?.(event.pointerId); } catch(_) {}
    setUpscaleViewportFromMiniMap(event.clientX, event.clientY);
  };

  const onUpscaleMiniMapPointerMove = event => {
    if(!upscaleUi?.miniDragging) return;
    event.preventDefault();
    setUpscaleViewportFromMiniMap(event.clientX, event.clientY);
  };

  const onUpscaleMiniMapPointerUp = event => {
    if(!upscaleUi?.miniDragging) return;
    upscaleUi.miniDragging = false;
    try { upscaleUi.miniMap.releasePointerCapture?.(event.pointerId); } catch(_) {}
  };

  const clearJobResult = activeJob => {
    if(!activeJob) return;
    activeJob.uploadId = (activeJob.uploadId || 0) + 1;
    activeJob.shareUrl = null;
    if(activeJob.resultUrl) URL.revokeObjectURL(activeJob.resultUrl);
    activeJob.resultUrl = null;
    activeJob.resultBlob = null;
  };

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  const getAifgCheckerDark = () => {
    if(typeof window.getCurrentColorScheme === "function") {
      return window.getCurrentColorScheme() === "dark";
    }
    const explicit = document.documentElement?.dataset?.scheme;
    if(explicit === "dark") return true;
    if(explicit === "light" || explicit === "grey") return false;
    return !!window.matchMedia?.("(prefers-color-scheme: dark)")?.matches;
  };

  const updateEditorCursor = point => {
    if(!ui?.cursor || !editor) return;
    if(!point) { ui.cursor.hidden = true; return; }
    ui.cursor.hidden = false;
    ui.cursor.className = `t2i-editor-cursor ${editor.mode === "wand" ? "is-wand" : "is-erase"}`;
    if(editor.mode === "erase") ui.cursor.style.setProperty("--size", `${Math.max(8, Math.round(editor.brushSize * editor.zoom))}px`);
    else ui.cursor.style.removeProperty("--size");
    const rect = ui.editorWrap.getBoundingClientRect();
    ui.cursor.style.left = `${point.clientX - rect.left}px`;
    ui.cursor.style.top = `${point.clientY - rect.top}px`;
  };

  const setMiniMapViewportFromClient = (clientX, clientY) => {
    if(!editor?.miniMap) return;
    const rect = ui.miniMap.getBoundingClientRect();
    const scaleX = ui.miniMapCanvas.width / Math.max(1, rect.width);
    const scaleY = ui.miniMapCanvas.height / Math.max(1, rect.height);
    const localX = clamp((clientX - rect.left) * scaleX, 0, ui.miniMapCanvas.width);
    const localY = clamp((clientY - rect.top) * scaleY, 0, ui.miniMapCanvas.height);
    const mm = editor.miniMap;
    const sourceX = clamp((localX - mm.dx) / Math.max(mm.scale, 0.0001), 0, editor.canvas.width);
    const sourceY = clamp((localY - mm.dy) / Math.max(mm.scale, 0.0001), 0, editor.canvas.height);
    const maxLeft = Math.max(0, ui.editorScroller.scrollWidth - ui.editorScroller.clientWidth);
    const maxTop = Math.max(0, ui.editorScroller.scrollHeight - ui.editorScroller.clientHeight);
    const canvasLeft = ui.canvas.offsetLeft;
    const canvasTop = ui.canvas.offsetTop;
    ui.editorScroller.scrollLeft = clamp(canvasLeft + sourceX * editor.zoom - ui.editorScroller.clientWidth / 2, 0, maxLeft);
    ui.editorScroller.scrollTop = clamp(canvasTop + sourceY * editor.zoom - ui.editorScroller.clientHeight / 2, 0, maxTop);
    updateMiniMapView();
  };

  const updateUpscaleCompareFromClient = clientX => {
    if(!upscaleUi?.compare) return;
    const rect = upscaleUi.compare.getBoundingClientRect();
    const value = clamp(((clientX - rect.left) / Math.max(1, rect.width)) * 100, 0, 100);
    upscaleUi.slider.value = String(Math.round(value));
    updateUpscaleCompareSlider();
  };

  const updateCompareSlider = () => {
    if(!ui || ui.compareWrap.hidden) return;
    const value = clamp(Number(ui.compareSlider.value) || 50, 0, 100);
    ui.compareAfterClip.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
    ui.compareDivider.style.left = `${value}%`;
  };

  const updateEditorButtons = () => {
    if(!ui) return;
    const active = !!editor;
    ui.toolbar.hidden = !active && ui.compareWrap.hidden;
    ui.editorGroup.hidden = !active;
    ui.viewControls.hidden = !active;
    ui.miniMap.hidden = !active;
    if(active) {
      ui.undo.disabled = !editor.undo.length || !!editor.busy;
      ui.redo.disabled = !editor.redo.length || !!editor.busy;
      [ui.autoClean,ui.aiClean,ui.studioUpscale,ui.wand,ui.erase,ui.brush,ui.similarity,ui.zoom].forEach(el => { if(el) el.disabled = !!editor.busy; });
      updateEditorCursor(editor.lastClientPoint || null);
    } else if(ui.cursor) {
      ui.cursor.hidden = true;
    }
  };

  const setEditorMode = mode => {
    if(!editor) return;
    editor.mode = mode === "wand" ? "wand" : "erase";
    ui.erase.classList.toggle("is-active", editor.mode === "erase");
    ui.wand.classList.toggle("is-active", editor.mode === "wand");
    ui.brushWrap.hidden = editor.mode !== "erase";
    ui.similarityWrap.hidden = editor.mode !== "wand";
    updateEditorCursor(editor.lastClientPoint || null);
  };

  const captureSnapshot = () => {
    if(!editor?.ctx) return null;
    try { return editor.ctx.getImageData(0, 0, editor.canvas.width, editor.canvas.height); }
    catch(_) { return null; }
  };

  const pushUndoSnapshot = () => {
    if(!editor) return;
    const snapshot = captureSnapshot();
    if(!snapshot) return;
    editor.undo.push(snapshot);
    if(editor.undo.length > 20) editor.undo.shift();
    editor.redo.length = 0;
    updateEditorButtons();
  };

  const applySnapshot = snapshot => {
    if(!editor?.ctx || !snapshot) return;
    editor.ctx.putImageData(snapshot, 0, 0);
    clearJobResult(job);
    updateMiniMap();
    updateEditorButtons();
  };

  const editorUndo = () => {
    if(!editor?.undo.length) return;
    const current = captureSnapshot();
    const previous = editor.undo.pop();
    if(current) editor.redo.push(current);
    applySnapshot(previous);
  };

  const editorRedo = () => {
    if(!editor?.redo.length) return;
    const current = captureSnapshot();
    const next = editor.redo.pop();
    if(current) editor.undo.push(current);
    applySnapshot(next);
  };

  const setEditorZoom = (value, recenter = true) => {
    if(!editor || !ui?.editorScroller) return;
    const scroller = ui.editorScroller;
    const fitX = Math.max(1, scroller.clientWidth - 48) / editor.canvas.width;
    const fitY = Math.max(1, scroller.clientHeight - 48) / editor.canvas.height;
    editor.fitZoom = clamp(Math.min(fitX, fitY, 1) || 1, 0.04, 5);
    editor.zoom = value === "fit" ? editor.fitZoom : clamp(Number(value) || editor.fitZoom, 0.04, 5);
    ui.canvas.style.width = `${Math.max(1, Math.round(editor.canvas.width * editor.zoom))}px`;
    ui.canvas.style.height = `${Math.max(1, Math.round(editor.canvas.height * editor.zoom))}px`;
    ui.zoomReset.textContent = Math.abs(editor.zoom - editor.fitZoom) < 0.001 ? "Fit" : `${Math.round(editor.zoom * 100)}%`;
    requestAnimationFrame(() => {
      if(recenter) {
        scroller.scrollLeft = Math.max(0, ui.canvas.offsetLeft + ui.canvas.offsetWidth / 2 - scroller.clientWidth / 2);
        scroller.scrollTop = Math.max(0, ui.canvas.offsetTop + ui.canvas.offsetHeight / 2 - scroller.clientHeight / 2);
      }
      updateMiniMap();
    });
  };

  const updateMiniMapView = () => {
    if(!editor || ui.miniMap.hidden || !editor.miniMap) return;
    const scrollerRect = ui.editorScroller.getBoundingClientRect();
    const canvasRect = ui.canvas.getBoundingClientRect();
    const visibleX = clamp((scrollerRect.left - canvasRect.left) / editor.zoom, 0, editor.canvas.width);
    const visibleY = clamp((scrollerRect.top - canvasRect.top) / editor.zoom, 0, editor.canvas.height);
    const visibleW = clamp(scrollerRect.width / editor.zoom, 0, editor.canvas.width - visibleX);
    const visibleH = clamp(scrollerRect.height / editor.zoom, 0, editor.canvas.height - visibleY);
    const mm = editor.miniMap;
    ui.miniMapView.style.left = `${mm.dx + visibleX * mm.scale}px`;
    ui.miniMapView.style.top = `${mm.dy + visibleY * mm.scale}px`;
    ui.miniMapView.style.width = `${Math.max(8, visibleW * mm.scale)}px`;
    ui.miniMapView.style.height = `${Math.max(8, visibleH * mm.scale)}px`;
  };

  const updateMiniMap = () => {
    if(!editor || ui.miniMap.hidden) return;
    const canvas = ui.miniMapCanvas;
    const ctx = canvas.getContext("2d", {alpha:true});
    if(!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const scale = Math.min(canvas.width / editor.canvas.width, canvas.height / editor.canvas.height);
    const drawW = editor.canvas.width * scale;
    const drawH = editor.canvas.height * scale;
    const dx = (canvas.width - drawW) / 2;
    const dy = (canvas.height - drawH) / 2;
    ctx.drawImage(editor.canvas, dx, dy, drawW, drawH);
    editor.miniMap = {scale, dx, dy, drawW, drawH};
    updateMiniMapView();
  };

  const onMiniMapPointerDown = event => {
    if(!editor?.miniMap || editor.busy || event.button > 0) return;
    event.preventDefault();
    editor.miniMapDragging = true;
    try { ui.miniMap.setPointerCapture?.(event.pointerId); } catch(_) {}
    setMiniMapViewportFromClient(event.clientX, event.clientY);
  };

  const onMiniMapPointerMove = event => {
    if(!editor?.miniMapDragging || editor.busy) return;
    event.preventDefault();
    setMiniMapViewportFromClient(event.clientX, event.clientY);
  };

  const onMiniMapPointerUp = event => {
    if(!editor?.miniMapDragging) return;
    editor.miniMapDragging = false;
    try { ui.miniMap.releasePointerCapture?.(event.pointerId); } catch(_) {}
  };

  const getCanvasPoint = event => {
    if(!editor) return null;
    const rect = ui.canvas.getBoundingClientRect();
    const x = (event.clientX - rect.left) * editor.canvas.width / Math.max(1, rect.width);
    const y = (event.clientY - rect.top) * editor.canvas.height / Math.max(1, rect.height);
    if(x < 0 || y < 0 || x >= editor.canvas.width || y >= editor.canvas.height) return null;
    return {x, y};
  };

  const eraseAt = point => {
    if(!editor?.ctx || !point) return;
    editor.ctx.save();
    editor.ctx.globalCompositeOperation = "destination-out";
    editor.ctx.beginPath();
    editor.ctx.arc(point.x, point.y, Math.max(2, editor.brushSize / 2), 0, Math.PI * 2);
    editor.ctx.fill();
    editor.ctx.restore();
    clearJobResult(job);
  };

  const eraseStroke = (from, to) => {
    if(!editor?.ctx || !from || !to) return;
    editor.ctx.save();
    editor.ctx.globalCompositeOperation = "destination-out";
    editor.ctx.lineCap = "round";
    editor.ctx.lineJoin = "round";
    editor.ctx.lineWidth = Math.max(2, editor.brushSize);
    editor.ctx.strokeStyle = "rgba(0,0,0,1)";
    editor.ctx.beginPath();
    editor.ctx.moveTo(from.x, from.y);
    editor.ctx.lineTo(to.x, to.y);
    editor.ctx.stroke();
    editor.ctx.restore();
    clearJobResult(job);
  };

  const floodErase = (imageData, startX, startY, similarity) => {
    const {width:W, height:H, data:d} = imageData;
    const px = clamp(Math.round(startX), 0, W - 1);
    const py = clamp(Math.round(startY), 0, H - 1);
    const start = (py * W + px) * 4;
    if(d[start + 3] === 0) return false;
    const sr = d[start], sg = d[start + 1], sb = d[start + 2], sa = d[start + 3];
    const tolerance = clamp(Number(similarity) || 32, 1, 100) / 100 * Math.sqrt(3) * 255;
    const match = i => {
      const alpha = d[i + 3];
      if(alpha === 0) return false;
      const dr = d[i] - sr, dg = d[i + 1] - sg, db = d[i + 2] - sb;
      return Math.sqrt(dr * dr + dg * dg + db * db) <= tolerance && Math.abs(alpha - sa) <= 64;
    };
    const visited = new Uint8Array(W * H);
    const stack = [py * W + px];
    visited[py * W + px] = 1;
    let changed = false;
    while(stack.length) {
      const current = stack.pop();
      d[current * 4 + 3] = 0;
      changed = true;
      const x = current % W, y = (current / W) | 0;
      if(x > 0 && !visited[current - 1] && match((current - 1) * 4)) { visited[current - 1] = 1; stack.push(current - 1); }
      if(x < W - 1 && !visited[current + 1] && match((current + 1) * 4)) { visited[current + 1] = 1; stack.push(current + 1); }
      if(y > 0 && !visited[current - W] && match((current - W) * 4)) { visited[current - W] = 1; stack.push(current - W); }
      if(y < H - 1 && !visited[current + W] && match((current + W) * 4)) { visited[current + W] = 1; stack.push(current + W); }
    }
    return changed;
  };

  const cleanBackgroundLikeReference = canvas => {
    const ctx = canvas.getContext("2d", {willReadFrequently:true});
    const W = canvas.width, H = canvas.height;
    if(W * H > 4e6) return false;
    const src = ctx.getImageData(0, 0, W, H);
    const d = src.data;
    const counts = new Map();
    const countPx = (i, j) => {
      const p = (j * W + i) * 4;
      if(d[p + 3] > 128) {
        const key = ((d[p] >> 3) << 10) | ((d[p + 1] >> 3) << 5) | (d[p + 2] >> 3);
        counts.set(key, (counts.get(key) || 0) + 1);
      }
    };
    for(let i = 0; i < W; i++) { countPx(i, 0); countPx(i, H - 1); }
    for(let j = 1; j < H - 1; j++) { countPx(0, j); countPx(W - 1, j); }
    let bgKey = null, best = 0;
    for(const [key, value] of counts) if(value > best) { best = value; bgKey = key; }
    if(bgKey === null) return false;
    const bgR = ((bgKey >> 10) & 31) << 3;
    const bgG = ((bgKey >> 5) & 31) << 3;
    const bgB = (bgKey & 31) << 3;
    const distance = (r, g, b) => Math.abs(r - bgR) + Math.abs(g - bgG) + Math.abs(b - bgB);
    const visited = new Uint8Array(W * H);
    const queue = [];
    const isBg = q => {
      const alpha = d[q + 3];
      if(alpha <= 90) return true;
      const delta = distance(d[q], d[q + 1], d[q + 2]);
      if(alpha <= 220) return delta <= 64;
      return delta <= 36;
    };
    const push = (x, y) => {
      if(x < 0 || y < 0 || x >= W || y >= H) return;
      const idx = y * W + x;
      if(visited[idx]) return;
      if(isBg(idx * 4)) { visited[idx] = 1; queue.push(idx); }
    };
    for(let i = 0; i < W; i++) { push(i, 0); push(i, H - 1); }
    for(let j = 1; j < H - 1; j++) { push(0, j); push(W - 1, j); }
    while(queue.length) {
      const idx = queue.pop();
      const x = idx % W, y = (idx / W) | 0;
      push(x + 1, y); push(x - 1, y); push(x, y + 1); push(x, y - 1);
    }
    let cleared = 0;
    for(let idx = 0; idx < W * H; idx++) if(visited[idx]) { d[idx * 4 + 3] = 0; cleared++; }
    if(!cleared) return false;
    const fringe = new Uint8Array(W * H);
    const soft = (x, y) => x >= 0 && y >= 0 && x < W && y < H && visited[y * W + x] === 1;
    for(let y = 0; y < H; y++) {
      for(let x = 0; x < W; x++) {
        const idx = y * W + x;
        if(!visited[idx] && (soft(x + 1, y) || soft(x - 1, y) || soft(x, y + 1) || soft(x, y - 1))) fringe[idx] = 1;
      }
    }
    for(let idx = 0; idx < W * H; idx++) {
      if(fringe[idx] && d[idx * 4 + 3] < 235) d[idx * 4 + 3] = Math.max(0, Math.min(255, Math.round(d[idx * 4 + 3] * 0.5)));
    }
    ctx.putImageData(src, 0, 0);
    return true;
  };

  const applyAutoClean = () => {
    if(!editor || editor.busy) return;
    pushUndoSnapshot();
    if(cleanBackgroundLikeReference(editor.canvas)) {
      clearJobResult(job);
      updateMiniMap();
    }
    updateEditorButtons();
  };

  const onCanvasPointerDown = event => {
    if(!editor || editor.busy || event.button !== 0) return;
    editor.lastClientPoint = { clientX: event.clientX, clientY: event.clientY };
    updateEditorCursor(editor.lastClientPoint);
    const point = getCanvasPoint(event);
    if(!point) return;
    if(editor.mode === "wand") {
      pushUndoSnapshot();
      const imageData = editor.ctx.getImageData(0, 0, editor.canvas.width, editor.canvas.height);
      const changed = floodErase(imageData, point.x, point.y, editor.similarity);
      if(changed) { editor.ctx.putImageData(imageData, 0, 0); clearJobResult(job); updateMiniMap(); }
      updateEditorButtons();
      return;
    }
    pushUndoSnapshot();
    editor.drawing = true;
    editor.lastPoint = point;
    ui.canvas.setPointerCapture?.(event.pointerId);
    eraseAt(point);
    updateMiniMap();
  };

  const onCanvasPointerMove = event => {
    if(!editor) return;
    editor.lastClientPoint = { clientX: event.clientX, clientY: event.clientY };
    updateEditorCursor(editor.lastClientPoint);
    if(!editor.drawing || editor.busy) return;
    const point = getCanvasPoint(event);
    if(point) {
      eraseStroke(editor.lastPoint || point, point);
      editor.lastPoint = point;
      updateMiniMap();
    }
  };

  const onCanvasPointerUp = event => {
    if(editor && event?.type === "pointerleave") updateEditorCursor(null);
    if(!editor?.drawing) return;
    editor.drawing = false;
    editor.lastPoint = null;
    try { ui.canvas.releasePointerCapture?.(event.pointerId); } catch(_) {}
    updateEditorButtons();
  };

  const loadImageBlob = blob => new Promise((resolve, reject) => {
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error("Could not load image.")); };
    img.src = url;
  });

  const openImageStudio = async activeJob => {
    const response = await fetch(activeJob.inputUrl);
    if(!response.ok) throw new Error("Could not read the generated image.");
    const img = await loadImageBlob(await response.blob());
    if(job !== activeJob) return;
    ui.title.textContent = "Image Studio";
    ui.progress.hidden = true;
    ui.editorWrap.hidden = false;
    ui.compareWrap.hidden = true;
    ui.toolbar.hidden = false;
    ui.editorGroup.hidden = false;
    ui.next.hidden = true;
    ui.save.hidden = !window.t2i_privateGallery?.add;
    ui.copy.hidden = false;
    ui.download.hidden = false;
    ui.secondary.hidden = true;
    ui.secondary.textContent = "Abort";
    ui.close.setAttribute("aria-label", "Close");
    ui.canvas.width = img.naturalWidth || img.width;
    ui.canvas.height = img.naturalHeight || img.height;
    const ctx = ui.canvas.getContext("2d", {alpha:true, willReadFrequently:true});
    ctx.clearRect(0,0,ui.canvas.width,ui.canvas.height);
    ctx.drawImage(img,0,0);
    editor = {canvas:ui.canvas,ctx,zoom:1,fitZoom:1,brushSize:30,similarity:32,mode:"erase",drawing:false,lastPoint:null,lastClientPoint:null,undo:[],redo:[],busy:false,miniMap:null,miniMapDragging:false};
    activeJob.finished = true;
    const restore = pendingStudioRestore;
    pendingStudioRestore = null;
    const darkCanvas = restore ? !!restore.checkerDark : getAifgCheckerDark();
    ui.stage.classList.toggle("checker-dark", darkCanvas);
    ui.checker.title = darkCanvas ? "Checker dark" : "Checker light";
    ui.checker.setAttribute("aria-label", ui.checker.title);
    ui.checker.innerHTML = darkCanvas
      ? '<i class="fa-solid fa-moon fa-fw"></i>'
      : '<i class="fa-solid fa-sun fa-fw"></i>';
    editor.brushSize = restore?.brushSize || 30;
    editor.similarity = restore?.similarity || 32;
    ui.brush.value = String(Math.round(editor.brushSize));
    ui.brushValue.textContent = String(Math.round(editor.brushSize));
    ui.similarity.value = String(Math.round(editor.similarity));
    ui.similarityValue.textContent = `${Math.round(editor.similarity)}%`;
    setEditorMode(restore?.mode || "erase");
    updateEditorButtons();
    requestAnimationFrame(() => setEditorZoom(Number.isFinite(restore?.zoom) ? restore.zoom : "fit"));
  };

  const runEditorAiClean = async () => {
    if(!job || !editor || editor.busy) return;
    const activeJob = job;
    editor.busy = true;
    updateEditorButtons();
    pushUndoSnapshot();
    const blob = await canvasToBlobAsync(editor.canvas, "image/png", 1);
    const tempUrl = URL.createObjectURL(blob);
    ui.progress.hidden = false;
    ui.secondary.hidden = false;
    ui.secondary.textContent = "Abort";
    ui.close.setAttribute("aria-label", "Abort and close");
    setProgress("loading AI background cleaner…");
    stopWorker();
    const created = createWorker();
    activeJob.worker = created.worker;
    activeJob.workerUrl = created.workerUrl;
    const finish = () => {
      URL.revokeObjectURL(tempUrl);
      if(editor) editor.busy = false;
      ui.progress.hidden = true;
      ui.secondary.hidden = true;
      ui.close.setAttribute("aria-label", "Close");
      updateEditorButtons();
    };
    activeJob.worker.onmessage = async ({data = {}}) => {
      if(job !== activeJob) return finish();
      if(data.type === "progress") return setProgress(data.text || "processing…", Number(data.percent));
      if(data.type === "processing") return setProgress(data.text || "processing…");
      if(data.type === "error") { stopWorker(); finish(); window.aifgAlert(friendlyError(data.message)); return; }
      if(data.type === "result") {
        stopWorker();
        try {
          const img = await loadImageBlob(data.blob);
          if(job !== activeJob || !editor) return;
          editor.ctx.clearRect(0,0,editor.canvas.width,editor.canvas.height);
          editor.ctx.drawImage(img,0,0,editor.canvas.width,editor.canvas.height);
          clearJobResult(activeJob);
          updateMiniMap();
        } finally { finish(); }
      }
    };
    activeJob.worker.onerror = error => { stopWorker(); finish(); window.aifgAlert(friendlyError(error?.message || "worker stopped")); };
    activeJob.worker.postMessage({task:"remove-background",imageUrl:tempUrl,wasmThreads:backgroundWasmThreads()});
  };

  const ensureCurrentResultBlob = async () => {
    if(!job) return null;
    if(editor && job.task === "studio") {
      if(job.resultBlob) return job.resultBlob;
      job.resultBlob = await canvasToBlobAsync(editor.canvas, "image/webp", 0.96);
      job.resultUrl = URL.createObjectURL(job.resultBlob);
      job.filename = filename(job.suffix || "-nobg", job.resultBlob.type || "image/webp");
      return job.resultBlob;
    }
    return job.resultBlob || null;
  };

  const updateUpscaleCompareSlider = () => {
    if(!upscaleUi) return;
    const value = clamp(Number(upscaleUi.slider.value) || 50, 0, 100);
    upscaleUi.afterClip.style.clipPath = `inset(0 0 0 ${value}%)`;
    upscaleUi.divider.style.left = `${value}%`;
  };

  const onUpscaleComparePointerDown = event => {
    if(!upscaleUi || event.button > 0) return;
    upscaleUi.dragging = true;
    upscaleUi.compare.classList.add("is-dragging");
    try { upscaleUi.compare.setPointerCapture?.(event.pointerId); } catch(_) {}
    updateUpscaleCompareFromClient(event.clientX);
  };

  const onUpscaleComparePointerMove = event => {
    if(!upscaleUi?.dragging) return;
    updateUpscaleCompareFromClient(event.clientX);
  };

  const onUpscaleComparePointerUp = event => {
    if(!upscaleUi?.dragging) return;
    upscaleUi.dragging = false;
    upscaleUi.compare.classList.remove("is-dragging");
    try { upscaleUi.compare.releasePointerCapture?.(event.pointerId); } catch(_) {}
  };

  const showUpscaleCompare = activeJob => {
    const target = createUpscaleUi();
    const resultSize = activeJob.resultWidth && activeJob.resultHeight
      ? ` · ${activeJob.resultWidth} × ${activeJob.resultHeight}`
      : "";
    target.title.textContent = `${activeJob.doneTitle || "Upscaled"}${resultSize}`;
    target.progress.hidden = true;
    target.compare.hidden = false;
    target.slider.hidden = true;
    target.toolbar.hidden = false;
    target.abort.hidden = true;
    target.miniMap.hidden = false;
    target.before.src = activeJob.inputUrl;
    target.after.src = activeJob.resultUrl;
    target.slider.value = "50";
    target.view = null;
    const initView = () => requestAnimationFrame(() => setUpscaleZoom("fit"));
    target.before.onload = initView;
    if(target.before.complete && target.before.naturalWidth) initView();
    updateUpscaleCompareSlider();
    target.back.hidden = !studioReturnState;
    target.save.hidden = !window.t2i_privateGallery?.add;
    target.copy.hidden = false;
    target.download.hidden = false;
  };

  const stopWorker = () => {
    if(!job) return;
    if(job.worker) {
      job.worker.onmessage = job.worker.onerror = null;
      job.worker.terminate();
      job.worker = null;
    }
    if(job.workerUrl) URL.revokeObjectURL(job.workerUrl);
    job.workerUrl = null;
  };

  const releaseInput = () => {
    if(!job) return;
    if(job.ownsInput && job.inputUrl) URL.revokeObjectURL(job.inputUrl);
    job.inputUrl = null;
    job.ownsInput = false;
  };

  const resetUi = hide => {
    if(!ui) return;
    ui.progress.hidden = false;
    ui.spinner.className = "fa-solid fa-spinner fa-spin";
    ui.status.textContent = "please wait…";
    ui.bar.hidden = true;
    ui.fill.style.width = "0%";
    ui.toolbar.hidden = true;
    ui.editorGroup.hidden = true;
    ui.viewControls.hidden = true;
    ui.editorWrap.hidden = true;
    ui.compareWrap.hidden = true;
    ui.miniMap.hidden = true;
    ui.canvas.width = ui.canvas.height = 1;
    ui.canvas.style.width = ui.canvas.style.height = "";
    ui.cursor.hidden = true;
    ui.zoom.value = "100";
    ui.download.hidden = ui.next.hidden = ui.save.hidden = ui.copy.hidden = true;
    ui.save.disabled = false;
    ui.save.innerHTML = '<i class="fa-solid fa-notes-medical fa-fw"></i> Save to Concept Board';
    ui.copy.disabled = false;
    ui.copy.innerHTML = '<i class="fa-solid fa-link fa-fw"></i> Copy image link';
    ui.secondary.hidden = true;
    ui.secondary.textContent = "Abort";
    ui.close.setAttribute("aria-label", "Close");
    if(hide) ui.overlay.hidden = true;
  };

  const resetUpscaleUi = hide => {
    if(!upscaleUi) return;
    upscaleUi.title.textContent = "Upscale 2×";
    const checkerDark = studioReturnState
      ? !!studioReturnState.checkerDark
      : getAifgCheckerDark();
    upscaleUi.stage.classList.toggle("is-dark", checkerDark);
    upscaleUi.checker.title = checkerDark ? "Checker dark" : "Checker light";
    upscaleUi.checker.setAttribute("aria-label", upscaleUi.checker.title);
    upscaleUi.checker.innerHTML = checkerDark
      ? '<i class="fa-solid fa-moon fa-fw"></i>'
      : '<i class="fa-solid fa-sun fa-fw"></i>';
    upscaleUi.percent.textContent = "0%";
    if(upscaleUi.status) upscaleUi.status.textContent = "Preparing…";
    upscaleUi.fill.style.width = "0%";
    upscaleUi.progress.hidden = false;
    upscaleUi.compare.hidden = true;
    upscaleUi.slider.hidden = true;
    upscaleUi.toolbar.hidden = true;
    upscaleUi.abort.hidden = true;
    upscaleUi.miniMap.hidden = true;
    upscaleUi.before.removeAttribute("src");
    upscaleUi.after.removeAttribute("src");
    upscaleUi.view = null;
    upscaleUi.zoom.value = "100";
    upscaleUi.back.hidden = true;
    upscaleUi.save.hidden = true;
    upscaleUi.copy.hidden = true;
    upscaleUi.download.hidden = true;
    upscaleUi.save.disabled = false;
    upscaleUi.save.innerHTML = '<i class="fa-solid fa-notes-medical fa-fw"></i><span class="t2i-upscale-long">Save to Concept Board</span><span class="t2i-upscale-short">Save</span>';
    upscaleUi.copy.disabled = false;
    upscaleUi.copy.innerHTML = '<i class="fa-solid fa-link fa-fw"></i> Copy image link';
    if(hide) upscaleUi.overlay.hidden = true;
  };

  const cleanup = (hide = true, keepStudioState = false) => {
    stopWorker();
    clearBiggerSession(true);
    if(job) {
      job.uploadId++;
      releaseInput();
      if(job.resultUrl) URL.revokeObjectURL(job.resultUrl);
      job.resultBlob = job.shareUrl = job.resultUrl = null;
      job = null;
    }
    editor = null;
    if(!keepStudioState) {
      studioReturnState = null;
      pendingStudioRestore = null;
    }
    resetUi(hide);
    resetUpscaleUi(hide);
  };

  const setProgress = (text, percent) => {
    const valid = Number.isFinite(percent);
    const value = valid ? clamp(Math.round(percent), 0, 100) : 0;
    if(job?.task === "upscale") {
      const target = upscaleUi;
      if(!target) return;
      target.percent.textContent = `${value}%`;
      target.fill.style.width = `${value}%`;
      return;
    }
    if(job?.task === "bigger-upscale") {
      const target = upscaleUi;
      if(!target) return;
      target.percent.textContent = valid ? `${value}%` : "…";
      if(target.status) target.status.textContent = text || "Working…";
      target.fill.style.width = valid ? `${value}%` : "0%";
      return;
    }
    if(!ui) return;
    ui.spinner.className = "fa-solid fa-spinner fa-spin";
    ui.status.textContent = text || "Working…";
    ui.bar.hidden = !valid;
    ui.fill.style.width = valid ? `${value}%` : "0%";
  };

  const postImageToBiggerPics = (handoff, targetWindow) => {
    if(!handoff || handoff.sent || !targetWindow) return;
    targetWindow.postMessage({
      type: "bigger-pics-image",
      url: handoff.dataUrl,
      name: handoff.name,
      site: handoff.site,
      format: "jpeg"
    }, BIGGER_PICS_ORIGIN);
    handoff.sent = true;
  };

  const finishBiggerPicsResult = (session, data) => {
    if(!session || !data?.blob) return;
    const blob = data.blob;
    const blobType = String(blob?.type || "").toLowerCase();
    if(typeof blob?.arrayBuffer !== "function" || (blobType && !blobType.startsWith("image/"))) return;

    session.received = true;
    if(session.pollTimer) clearInterval(session.pollTimer);
    if(biggerSession === session) biggerSession = null;

    const activeJob = session.job;
    if(job !== activeJob) return;

    activeJob.resultWidth = Math.max(0, Math.round(Number(data.width) || 0));
    activeJob.resultHeight = Math.max(0, Math.round(Number(data.height) || 0));
    finishJobResult(activeJob, blob);
  };

  const onBiggerPicsMessage = event => {
    if(event.origin !== BIGGER_PICS_ORIGIN) return;
    const data = event.data || {};

    // The popup may become ready before Studio has finished switching from
    // editor -> upscale result view. Send immediately anyway, exactly like
    // the reference implementation.
    const pending = biggerPendingHandoff;
    if(pending) {
      if(data.type === "bigger-pics-ready") {
        // Match the working reference: the trusted app origin may message from
        // a child/app window, so answer the actual event.source instead of
        // requiring it to equal the top-level popup WindowProxy.
        postImageToBiggerPics(pending, event.source);
        return;
      }
      if(data.type === "bigger-pics-result" && data.blob) {
        pending.result = data;
        return;
      }
    }

    const session = biggerSession;
    if(!session || job !== session.job) return;

    if(data.type === "bigger-pics-ready") {
      postImageToBiggerPics(session, event.source);
      if(session.sent) setProgress("Upscaling on bigger.pics…");
      return;
    }

    if(data.type === "bigger-pics-result" && data.blob) {
      finishBiggerPicsResult(session, data);
    }
  };

  window.addEventListener("message", onBiggerPicsMessage);

  const startBiggerPicsJob = activeJob => {
    const popup = activeJob.biggerPopup;
    if(!popup || popup.closed) {
      clearPendingBiggerHandoff(false);
      showError("bigger_popup_closed");
      return;
    }

    const pending = biggerPendingHandoff?.popup === popup
      ? biggerPendingHandoff
      : null;
    if(pending) biggerPendingHandoff = null;

    // Normally this comes straight from the Studio canvas prepared in the
    // user's click. Keep a fallback only for unusual programmatic callers.
    let fallbackDataUrl = "";
    if(!pending) {
      try {
        if(/^data:/i.test(activeJob.inputUrl)) fallbackDataUrl = activeJob.inputUrl;
      } catch(_) {}
    }

    const session = biggerSession = {
      job: activeJob,
      popup,
      dataUrl: pending?.dataUrl || fallbackDataUrl,
      name: pending?.name || filename("", "image/jpeg"),
      site: pending?.site || `${window.location.hostname}${window.location.pathname}`.replace(/\/+$/, ""),
      sent: !!pending?.sent,
      received: false,
      pollTimer: 0
    };

    if(!session.dataUrl) {
      clearBiggerSession(true);
      showError("Could not prepare the image for bigger.pics.");
      return;
    }

    session.pollTimer = setInterval(() => {
      if(biggerSession !== session) return;
      let closed = false;
      try { closed = popup.closed; } catch(_) {}
      if(!closed || session.received) return;

      clearBiggerSession(false);
      if(job === activeJob && !activeJob.finished) showError("bigger_popup_closed");
    }, 500);

    setProgress(session.sent ? "Upscaling on bigger.pics…" : "Waiting for bigger.pics…");

    // A very fast result can theoretically arrive while Studio is switching
    // jobs. Do not lose it.
    if(pending?.result) finishBiggerPicsResult(session, pending.result);
  };

  const createWorker = () => {
    const source = `
      self.onmessage=async({data:{task,imageUrl,wasmThreads}})=>{
        let pipe,result,error;
        const post=(type,text,percent)=>self.postMessage({type,text,percent});
        let last=-1;
        const progress=p=>{
          let n=Number(p?.progress);
          if(!Number.isFinite(n)&&Number(p?.total)>0)n=Number(p.loaded)/Number(p.total)*100;
          if(!Number.isFinite(n))return;
          if(n<=1)n*=100;
          n=Math.max(0,Math.min(100,Math.round(n)));
          if(n!==last){last=n;post("progress","loading model "+n+"%",n)}
        };
        try{
          if(task!=="remove-background")throw Error("Unsupported worker task.");
          post("progress","loading tools…");
          const transformers=await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.2.0");
          transformers.env.allowLocalModels=false;
          transformers.env.useBrowserCache=true;
          transformers.env.useWasmCache=true;
          transformers.env.backends.onnx.wasm.proxy=false;
          if(transformers.env.backends?.onnx?.wasm&&Number(wasmThreads)>0){
            transformers.env.backends.onnx.wasm.numThreads=Math.max(1,Math.floor(Number(wasmThreads)));
          }
          pipe=await transformers.pipeline("background-removal","onnx-community/ormbg-ONNX",{progress_callback:progress});
          post("processing","removing background…");
          let output=await pipe([imageUrl]),image=Array.isArray(output)?output[0]:output;
          if(!image?.toBlob)throw Error("The image model returned no result.");
          post("progress","preparing image…");
          result=await image.toBlob();
          output=image=null;
        }catch(reason){
          error=reason?.message||String(reason);
        }finally{
          if(pipe?.dispose)try{await pipe.dispose()}catch(_){}
        }
        self.postMessage(error?{type:"error",message:error}:{type:"result",blob:result});
      };`;
    const workerUrl = URL.createObjectURL(new Blob([source], { type: "text/javascript" }));
    return { worker: new Worker(workerUrl, { type: "module" }), workerUrl };
  };

  const friendlyError = raw => {
    const text = String(raw || "").toLowerCase();
    if(job?.task === "bigger-upscale") {
      if(/bigger_popup_closed/.test(text)) return "bigger.pics was closed before it returned an upscaled image. Open it again and keep the popup open until you use “Send this back”.";
      if(/could not read the image|prepare image/.test(text)) return "The image could not be prepared for bigger.pics. Try again with another image.";
      return "bigger.pics did not return an upscaled image. Try again, and make sure pop-ups are allowed.";
    }
    if(/safe_output_limit/.test(text)) return "This image is too large to upscale safely on this device. Try a smaller image.";
    if(/bad_alloc|out of memory|not enough memory|failed to allocate|allocation failed/.test(text)) return job?.task === "upscale" ? "This image is too large for the browser to upscale safely. Try a smaller image or close other apps and try again." : "Your device ran out of memory while processing this image. Try a smaller image or close other apps and try again.";
    if(/failed to fetch|network|download|load failed|quota|model download failed/.test(text)) return job?.task === "upscale" ? "The AI model could not be downloaded. Check your connection and try again." : "The tool could not finish loading. Check your connection and try again.";
    return job?.task === "upscale" ? "This image could not be upscaled. Try again or use a smaller image." : "The background could not be removed. Try again with another image.";
  };

  const showError = raw => {
    if(!job) return;
    stopWorker();
    releaseInput();
    job.finished = job.failed = true;
    if(isUpscaleTask(job.task)) {
      const target = createUpscaleUi();
      target.title.textContent = job.task === "bigger-upscale" ? "bigger.pics upscale failed" : "Upscale failed";
      target.abort.hidden = true;
      target.percent.textContent = friendlyError(raw);
      target.percent.style.fontSize = ".95rem";
      if(target.status) target.status.textContent = "";
      target.fill.style.width = "0%";
      if(job.task === "bigger-upscale") target.back.hidden = !studioReturnState;
      return;
    }
    ui.title.textContent = "Studio failed";
    ui.spinner.className = "fa-solid fa-triangle-exclamation";
    ui.status.textContent = friendlyError(raw);
    ui.bar.hidden = ui.download.hidden = ui.next.hidden = ui.copy.hidden = true;
    ui.secondary.hidden = true;
    ui.secondary.textContent = "Abort";
  };

  const finishJobResult = (activeJob, blob) => {
    if(job !== activeJob || !blob) return;
    stopWorker();
    clearJobResult(activeJob);
    activeJob.finished = true;
    activeJob.resultBlob = blob;
    activeJob.resultUrl = URL.createObjectURL(blob);
    activeJob.filename = filename(activeJob.suffix, blob.type || "image/webp");
    if(isUpscaleTask(activeJob.task)) showUpscaleCompare(activeJob);
  };

  const isMobileDevice = () =>
    navigator.userAgentData?.mobile === true ||
    /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || "");

  const backgroundWasmThreads = () =>
    isMobileDevice()
      ? 2
      : Math.max(1, Math.min(4, Number(navigator.hardwareConcurrency) || 4));

  const startBackgroundWorker = () => {
    if(!job) return;
    stopWorker();
    const activeJob = job;
    const created = createWorker();
    activeJob.worker = created.worker;
    activeJob.workerUrl = created.workerUrl;

    activeJob.worker.onmessage = ({ data = {} }) => {
      if(job !== activeJob) return;
      if(data.type === "progress") return setProgress(data.text || "processing…", Number(data.percent));
      if(data.type === "processing") return setProgress(data.text || "processing…");
      if(data.type === "error") {
        console.error(activeJob.title + " failed:", data.message);
        return showError(data.message);
      }
      if(data.type === "result") finishJobResult(activeJob, data.blob);
    };

    activeJob.worker.onerror = error => {
      if(job !== activeJob) return;
      console.error(activeJob.title + " worker failed:", error);
      showError(error?.message || "worker stopped");
    };

    activeJob.worker.postMessage({
      task: "remove-background",
      imageUrl: activeJob.inputUrl,
      wasmThreads: backgroundWasmThreads()
    });
  };

  const friendlyUpscaleError = raw => {
    const value = String(raw || "");
    const lower = value.toLowerCase();
    if(/upscale_cancelled/.test(lower)) return "Upscale cancelled.";
    if(/safe_output_limit/.test(lower)) return "This image is too large to upscale safely on this device. Use a smaller image and try again.";
    if(/bad_alloc|out of memory|not enough memory|failed to allocate|allocation failed/.test(lower)) return "Your device ran out of memory while upscaling. Close other tabs/apps and try again.";
    if(/failed to fetch|network|download|load failed|quota|model download failed/.test(lower)) return "The AI model could not be downloaded. Check your connection and try again.";
    return "Upscale failed: " + value;
  };

  const getUpscaleDeviceProfile = () => {
    const hardwareThreads = Math.max(1, navigator.hardwareConcurrency || 4);
    const isMobile = isMobileDevice();
    const memoryGB = Number(navigator.deviceMemory || 0);
    const lowMemory = memoryGB > 0 && memoryGB <= 4;
    const veryConstrained = lowMemory || hardwareThreads <= 4;
    const mobileSafe = isMobile || veryConstrained;
    return {
      isMobile,
      mobileSafe,
      maxOutputPixels: mobileSafe ? 3145728 : 8388608
    };
  };

  const UPSCALE_DESKTOP_SOURCE_SCALE = 0.9;
  const UPSCALE_MOBILE_FAST_SOURCE_SCALE = 0.5;
  const UPSCALE_MOBILE_PREF_KEY = "t2iUpscaleMobilePrefV2";
  const UPSCALE_MOBILE_PROMPT_NEVER_KEY = "t2iUpscaleMobilePromptNeverV2";

  const upscaleSourceScaleForPref = pref =>
    pref === "fast50" ? UPSCALE_MOBILE_FAST_SOURCE_SCALE : UPSCALE_DESKTOP_SOURCE_SCALE;

  const readUpscaleMobilePref = () => {
    try{
      const pref = localStorage.getItem(UPSCALE_MOBILE_PREF_KEY) || "";
      return pref === "fast50" || pref === "quality90" ? pref : "";
    }catch(_){
      return "";
    }
  };

  const readUpscalePromptNever = () => {
    try{ return localStorage.getItem(UPSCALE_MOBILE_PROMPT_NEVER_KEY) === "1"; }
    catch(_){ return false; }
  };

  const saveUpscaleMobilePref = (pref, never) => {
    try{
      localStorage.setItem(UPSCALE_MOBILE_PREF_KEY, pref);
      if(never) localStorage.setItem(UPSCALE_MOBILE_PROMPT_NEVER_KEY, "1");
    }catch(_){}
  };

  const openUpscaleMobilePrompt = (jobTotal = 1) => {
    if(!document.getElementById("t2iUpscaleMobilePromptStyle")){
      const style = document.createElement("style");
      style.id = "t2iUpscaleMobilePromptStyle";
      style.textContent = `
        .t2i-upscale-pref-overlay[hidden]{display:none!important}
        .t2i-upscale-pref-overlay{inset:0;position:fixed;z-index:10002;display:flex;align-items:center;justify-content:center;padding:14px;background:rgba(0,0,0,.72)}
        .t2i-upscale-pref-card{width:min(500px,calc(100vw - 28px));padding:18px;border:1px solid var(--border-color);border-radius:10px;background:var(--box-color);color:var(--text-color);box-shadow:0 12px 36px rgba(0,0,0,.38);font-family:sans-serif}
        .t2i-upscale-pref-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
        .t2i-upscale-pref-head strong{font-size:1rem}
        .t2i-upscale-pref-close{border:0;background:transparent;color:inherit;cursor:pointer;font-size:1.1rem;opacity:.72}
        .t2i-upscale-pref-close:hover{opacity:1}
        .t2i-upscale-pref-card p{margin:0 0 8px;line-height:1.45}
        .t2i-upscale-pref-note{opacity:.68;font-size:.82rem}
        .t2i-upscale-pref-remember{display:flex;align-items:center;gap:7px;margin:12px 0;cursor:pointer;font-size:.88rem}
        .t2i-upscale-pref-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
        .t2i-upscale-pref-actions button{min-height:36px;padding:7px 10px;border:1px solid var(--border-color);border-radius:7px;background:transparent;color:inherit;cursor:pointer;font:inherit;font-weight:600}
        .t2i-upscale-pref-actions button:last-child{border-color:transparent;background:var(--special-color,#0a66c9);color:#fff}
      `;
      document.head.appendChild(style);
    }

    const overlay = document.createElement("div");
    overlay.className = "t2i-upscale-pref-overlay";
    overlay.innerHTML = `
      <div class="t2i-upscale-pref-card" role="dialog" aria-modal="true" aria-labelledby="t2iUpscalePrefTitle">
        <div class="t2i-upscale-pref-head">
          <strong id="t2iUpscalePrefTitle">Upscale on mobile</strong>
          <button class="t2i-upscale-pref-close" type="button" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <p>Choose speed or quality for this device.</p>
        <p class="t2i-upscale-pref-note">${Math.max(1, Number(jobTotal) || 1)} image${Math.max(1, Number(jobTotal) || 1) === 1 ? "" : "s"} · First use downloads the AI model.</p>
        <label class="t2i-upscale-pref-remember"><input type="checkbox"> Never show again</label>
        <div class="t2i-upscale-pref-actions">
          <button type="button" data-choice="quality90">Quality · 90%</button>
          <button type="button" data-choice="fast50">Fast · 50%</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);

    return new Promise(resolve => {
      let settled = false;
      const closeBtn = overlay.querySelector(".t2i-upscale-pref-close");
      const remember = overlay.querySelector('input[type="checkbox"]');
      const fastBtn = overlay.querySelector('[data-choice="fast50"]');
      const qualityBtn = overlay.querySelector('[data-choice="quality90"]');
      const previousFocus = document.activeElement;

      const cleanupPrompt = () => {
        document.removeEventListener("keydown", onKey, true);
        overlay.remove();
        if(previousFocus && typeof previousFocus.focus === "function") previousFocus.focus();
      };
      const finish = value => {
        if(settled) return;
        settled = true;
        cleanupPrompt();
        resolve(value);
      };
      const onKey = event => {
        if(event.key !== "Escape") return;
        event.preventDefault();
        event.stopPropagation();
        finish(null);
      };

      overlay.onclick = event => { if(event.target === overlay) finish(null); };
      closeBtn.onclick = () => finish(null);
      fastBtn.onclick = () => finish({pref:"fast50", never:remember.checked});
      qualityBtn.onclick = () => finish({pref:"quality90", never:remember.checked});
      document.addEventListener("keydown", onKey, true);
      setTimeout(() => fastBtn.focus(), 0);
    });
  };

  const resolveUpscaleSourceScale = async (profile, jobTotal = 1) => {
    if(!profile.isMobile) return UPSCALE_DESKTOP_SOURCE_SCALE;

    if(readUpscalePromptNever()){
      return upscaleSourceScaleForPref(readUpscaleMobilePref() || "fast50");
    }

    const choice = await openUpscaleMobilePrompt(jobTotal);
    if(!choice) return null;
    if(choice.never) saveUpscaleMobilePref(choice.pref, true);
    return upscaleSourceScaleForPref(choice.pref);
  };

  const releaseCanvasMemory = canvas => {
    if(!canvas) return;
    try{
      canvas.width = 1;
      canvas.height = 1;
    }catch(_){}
  };

  const canvasToBlobAsync = (canvas, type, quality = 0.95) => {
    if(!canvas) return Promise.reject(new Error("Missing canvas."));
    if(typeof canvas.toBlob === "function"){
      return new Promise((resolve, reject) => {
        canvas.toBlob(blob => {
          if(blob) resolve(blob);
          else reject(new Error("Could not encode upscaled image."));
        }, type, quality);
      });
    }
    try{
      const dataUrl = canvas.toDataURL(type, quality);
      return fetch(dataUrl).then(response => response.blob());
    }catch(error){
      return Promise.reject(error);
    }
  };

  const upscaleOutputMime = sourceMime =>
    String(sourceMime || "").toLowerCase() === "image/jpeg"
      ? "image/jpeg"
      : "image/webp";

  const UPSCALE_RRDB_GENERAL = {
    expectedBytes: 2426664,
    model: "https://user.uploads.dev/file/89a19a1e51a6fba2128084950a55fece.json",
    weights: "https://user.uploads.dev/file/94fce5ef5347e011a05621065d271fc3.bin"
  };

  const makeUpscaler = (sourceScale = UPSCALE_DESKTOP_SOURCE_SCALE) => {
    const profile = getUpscaleDeviceProfile();
    const rrdbSourceScale = Math.max(
      UPSCALE_MOBILE_FAST_SOURCE_SCALE,
      Math.min(1, Number(sourceScale) || UPSCALE_DESKTOP_SOURCE_SCALE)
    );
    const state = {tf:null, backend:"", model:null, pending:false, closed:false};

    const fetchCached = async url => {
      if("caches" in window){
        try{
          const cache = await caches.open("aifg-upscale-rrdb-v1");
          const hit = await cache.match(url);
          if(hit) return hit;
        }catch(_){}
      }

      const response = await fetch(url, {cache:"force-cache"});
      if(!response.ok) throw new Error("Model download failed (HTTP " + response.status + ").");

      if("caches" in window){
        try{
          const cache = await caches.open("aifg-upscale-rrdb-v1");
          void cache.put(url, response.clone()).catch(() => {});
        }catch(_){}
      }
      return response;
    };

    const expectedShardBytes = manifest => {
      let total = 0;
      for(const part of manifest || []) for(const weight of part.weights || []){
        const elems = (weight.shape || []).reduce((a, b) => a * b, 1);
        total += weight.quantization && weight.quantization.dtype === "float16" ? elems * 2 : elems * 4;
      }
      return total;
    };

    const ensureTf = async onProgress => {
      if(state.tf) return state.tf;
      onProgress?.("loading upscale engine…", 2);
      const tf = await import("https://esm.sh/@tensorflow/tfjs@4.22.0");
      try{ await import("https://esm.sh/@tensorflow/tfjs-backend-webgpu@4.22.0"); }catch(_){}

      const backends = profile.isMobile
        ? ["webgl", "webgpu", "cpu"]
        : ["webgpu", "webgl", "cpu"];

      for(const backend of backends){
        try{
          if(!(await tf.setBackend(backend))) continue;
          await tf.ready();
          const probe = tf.tensor1d([1]);
          await probe.data();
          probe.dispose();
          state.backend = backend;
          break;
        }catch(_){}
      }

      if(!state.backend) throw new Error("TensorFlow.js could not start an available backend.");
      state.tf = tf;
      return tf;
    };

    const loadModel = async onProgress => {
      if(state.model) return state.model;
      const tf = await ensureTf(onProgress);
      onProgress?.("loading RRDB General…", 5);
      const modelResponse = await fetchCached(UPSCALE_RRDB_GENERAL.model);
      const artifacts = await modelResponse.clone().json();
      const weightsResponse = await fetchCached(UPSCALE_RRDB_GENERAL.weights);
      const weights = new Uint8Array(await weightsResponse.arrayBuffer());
      const expected = expectedShardBytes(artifacts.weightsManifest);

      if(expected !== UPSCALE_RRDB_GENERAL.expectedBytes || weights.byteLength !== expected){
        throw new Error("RRDB model files do not match.");
      }

      state.model = await tf.loadGraphModel(UPSCALE_RRDB_GENERAL.model, {
        onProgress: fraction => onProgress?.(
          "loading RRDB General…",
          5 + Math.round(Number(fraction || 0) * 10)
        ),
        fetchFunc: path => Promise.resolve(
          /\.bin$/i.test(String(path))
            ? new Response(weights, {status:200})
            : new Response(
              JSON.stringify(artifacts),
              {status:200, headers:{"content-type":"application/json"}}
            )
        )
      });
      return state.model;
    };

    const tilePositions = length => {
      const tile = 64, overlap = 12;
      if(length <= tile) return [0];
      const positions = [], step = tile - overlap;
      for(let p = 0; p < length - tile; p += step) positions.push(p);
      const last = length - tile;
      if(positions[positions.length - 1] !== last) positions.push(last);
      return positions;
    };

    const cropFor = (positions, index) => {
      const tile = 64, start = positions[index];
      const left = index === 0 ? 0 : positions[index - 1] + tile - start;
      const right = index === positions.length - 1 ? 0 : start + tile - positions[index + 1];
      return {before:Math.floor(left / 2), after:Math.ceil(right / 2)};
    };

    const applyAlpha = (source, canvas) => {
      const mask = document.createElement("canvas");
      try{
        mask.width = canvas.width;
        mask.height = canvas.height;
        const mctx = mask.getContext("2d");
        mctx.imageSmoothingEnabled = true;
        mctx.imageSmoothingQuality = "high";
        mctx.drawImage(source, 0, 0, mask.width, mask.height);
        mctx.globalCompositeOperation = "source-in";
        mctx.fillStyle = "#000";
        mctx.fillRect(0, 0, mask.width, mask.height);

        const ctx = canvas.getContext("2d");
        ctx.globalCompositeOperation = "destination-in";
        ctx.drawImage(mask, 0, 0);
        ctx.globalCompositeOperation = "source-over";
      }finally{
        releaseCanvasMemory(mask);
      }
    };

    const predictTile = async (tf, model, tile, outTile) => {
      const input = tf.tidy(() =>
        tf.browser.fromPixels(tile).toFloat().div(255).expandDims(0)
      );
      const raw = model.predict(input);
      const pred = Array.isArray(raw) ? raw[0] : raw;
      const vis = tf.tidy(() => pred.squeeze([0]).clipByValue(0, 1));
      try{
        await tf.browser.toPixels(vis, outTile);
      }finally{
        input.dispose();
        if(Array.isArray(raw)) raw.forEach(t => t?.dispose?.());
        else raw?.dispose?.();
        vis.dispose();
      }
    };

    const runRrdb = async (imageUrl, onProgress, shouldCancel) => {
      const tf = await ensureTf(onProgress);
      if(shouldCancel?.()) throw new Error("upscale_cancelled");
      const model = await loadModel(onProgress);
      if(shouldCancel?.()) throw new Error("upscale_cancelled");

      const response = await fetch(imageUrl);
      if(!response.ok) throw new Error("Could not read the generated image.");
      const sourceBlob = await response.blob();
      const bitmap = await createImageBitmap(sourceBlob);
      let work = null, aiCanvas = null, finalCanvas = null, tile = null, outTile = null;

      try{
        const outputPixels = bitmap.width * 2 * bitmap.height * 2;
        if(profile.maxOutputPixels > 0 && outputPixels > profile.maxOutputPixels){
          throw new Error("safe_output_limit");
        }

        const inputW = Math.max(1, Math.round(bitmap.width * rrdbSourceScale));
        const inputH = Math.max(1, Math.round(bitmap.height * rrdbSourceScale));
        const workW = Math.max(64, inputW);
        const workH = Math.max(64, inputH);

        work = document.createElement("canvas");
        work.width = workW;
        work.height = workH;
        const wctx = work.getContext("2d", {alpha:true});
        wctx.imageSmoothingEnabled = true;
        wctx.imageSmoothingQuality = "high";
        wctx.drawImage(bitmap, 0, 0, inputW, inputH);

        if(inputW < workW){
          wctx.drawImage(work, inputW - 1, 0, 1, inputH, inputW, 0, workW - inputW, inputH);
        }
        if(inputH < workH){
          wctx.drawImage(work, 0, inputH - 1, workW, 1, 0, inputH, workW, workH - inputH);
        }

        aiCanvas = document.createElement("canvas");
        aiCanvas.width = inputW * 4;
        aiCanvas.height = inputH * 4;
        const actx = aiCanvas.getContext("2d", {alpha:true});
        const xp = tilePositions(workW);
        const yp = tilePositions(workH);
        const total = xp.length * yp.length;
        let done = 0;

        tile = document.createElement("canvas");
        tile.width = tile.height = 64;
        outTile = document.createElement("canvas");
        outTile.width = outTile.height = 256;
        const tctx = tile.getContext("2d", {alpha:true});

        for(let yi = 0; yi < yp.length; yi++){
          for(let xi = 0; xi < xp.length; xi++){
            if(shouldCancel?.()) throw new Error("upscale_cancelled");

            const x = xp[xi], y = yp[yi];
            tctx.clearRect(0, 0, 64, 64);
            tctx.drawImage(work, x, y, 64, 64, 0, 0, 64, 64);
            await predictTile(tf, model, tile, outTile);

            const cx = cropFor(xp, xi), cy = cropFor(yp, yi);
            const sx = cx.before * 4, sy = cy.before * 4;
            const sw = (64 - cx.before - cx.after) * 4;
            const sh = (64 - cy.before - cy.after) * 4;

            actx.drawImage(
              outTile,
              sx, sy, sw, sh,
              (x + cx.before) * 4,
              (y + cy.before) * 4,
              sw, sh
            );

            done++;
            onProgress?.("processing…", 15 + done / total * 82);

            // Desktop work must not depend on timer/frame scheduling, because
            // hidden desktop tabs can heavily throttle those queues. Keep the
            // cooperative yield only on actual mobile devices.
            if(profile.isMobile && done < total && done % 4 === 0){
              await yieldBackgroundSafeTask();
            }
          }
        }

        const exactW = bitmap.width * 2;
        const exactH = bitmap.height * 2;
        let resultCanvas = null;

        if(aiCanvas.width === exactW && aiCanvas.height === exactH){
          resultCanvas = aiCanvas;
          aiCanvas = null;
        }else{
          finalCanvas = document.createElement("canvas");
          finalCanvas.width = exactW;
          finalCanvas.height = exactH;
          const fctx = finalCanvas.getContext("2d", {alpha:true});
          fctx.imageSmoothingEnabled = true;
          fctx.imageSmoothingQuality = "high";
          fctx.drawImage(
            aiCanvas,
            0, 0, aiCanvas.width, aiCanvas.height,
            0, 0, exactW, exactH
          );
          resultCanvas = finalCanvas;
          finalCanvas = null;
        }

        applyAlpha(bitmap, resultCanvas);
        onProgress?.("preparing result…", 100);
        return {canvas:resultCanvas, sourceMime:sourceBlob.type || ""};
      }finally{
        try{ bitmap.close(); }catch(_){}
        releaseCanvasMemory(work);
        releaseCanvasMemory(aiCanvas);
        releaseCanvasMemory(finalCanvas);
        releaseCanvasMemory(tile);
        releaseCanvasMemory(outTile);
      }
    };

    return {
      profile,
      async upscale(imageUrl, onProgress, shouldCancel){
        if(state.closed) throw new Error("Upscaler stopped.");
        if(state.pending) throw new Error("Upscaler busy");
        state.pending = true;
        try{
          return await runRrdb(imageUrl, onProgress, shouldCancel);
        }catch(error){
          throw new Error(friendlyUpscaleError(error && error.message ? error.message : error));
        }finally{
          state.pending = false;
        }
      },
      close(){
        state.closed = true;
        try{ state.model?.dispose?.(); }catch(_){}
        state.model = null;
      }
    };
  };

  const runUpscaleJob = async (activeJob, sourceScale) => {
    const upscaler = makeUpscaler(sourceScale);
    activeJob.upscaler = upscaler;

    try{
      const result = await upscaler.upscale(
        activeJob.inputUrl,
        (text, percent) => {
          if(job === activeJob) setProgress(text || "processing…", Number(percent));
        },
        () => job !== activeJob
      );

      if(job !== activeJob){
        releaseCanvasMemory(result?.canvas);
        return;
      }

      const sourceMime = activeJob.sourceMime || result.sourceMime || "";
      const outputMime = upscaleOutputMime(sourceMime);
      const quality = outputMime === "image/jpeg" ? 0.94 : 0.95;
      const blob = await canvasToBlobAsync(result.canvas, outputMime, quality);
      releaseCanvasMemory(result.canvas);

      if(job !== activeJob) return;
      finishJobResult(activeJob, blob);
    }catch(error){
      if(job !== activeJob) return;
      console.error(activeJob.title + " failed:", error);
      showError(error?.message || String(error));
    }finally{
      upscaler.close();
      if(activeJob.upscaler === upscaler) activeJob.upscaler = null;
    }
  };

  const configFor = task => {
    if(task === "upscale") return {title:"Upscaling image 2×",doneTitle:"Upscaled · Local AI",suffix:"-2x"};
    if(task === "bigger-upscale") return {title:"Upscaling with bigger.pics",doneTitle:"Upscaled · bigger.pics",suffix:"-bigger"};
    return {title:"Image Studio",doneTitle:"Image Studio",suffix:"-studio"};
  };

  const run = async (task, sourceBlob = null, options = {}) => {
    if(job && !job.finished) {
      if(isUpscaleTask(job.task)) createUpscaleUi().overlay.hidden = false;
      else createUi().overlay.hidden = false;
      return;
    }

    let inputUrl = "";
    let sourceMime = "";
    let conceptInfo = options.conceptInfo && typeof options.conceptInfo === "object"
      ? options.conceptInfo
      : {};
    if(sourceBlob) {
      inputUrl = URL.createObjectURL(sourceBlob);
      sourceMime = String(sourceBlob.type || "").toLowerCase();
    } else {
      try {
        const sourceOutput = getOutput();
        inputUrl = sourceOutput.dataUrl;
        sourceMime = mimeOf(inputUrl);
        conceptInfo = t2iBuildConceptBoardInfo(sourceOutput, window._currentImageCtn);
      } catch(error) {
        window.aifgAlert("Error: " + error.message);
        return;
      }
      window.closeImageMenu();
    }

    let upscaleProfile = null;
    let sourceScale = null;
    if(task === "upscale") {
      upscaleProfile = getUpscaleDeviceProfile();
      sourceScale = await resolveUpscaleSourceScale(upscaleProfile);
      if(sourceScale == null) {
        if(sourceBlob) URL.revokeObjectURL(inputUrl);
        return;
      }
    } else if(task === "bigger-upscale" && (!options.biggerPopup || options.biggerPopup.closed)) {
      if(sourceBlob) URL.revokeObjectURL(inputUrl);
      window.aifgAlert("The bigger.pics popup is unavailable. Allow pop-ups and try again.");
      return;
    }

    cleanup(true, !!options.keepStudioState);
    if(options.restoreState) pendingStudioRestore = options.restoreState;

    const config = configFor(task);
    job = {
      task,...config,inputUrl,sourceMime,ownsInput:!!sourceBlob,
      worker:null,workerUrl:null,resultBlob:null,resultUrl:null,shareUrl:null,uploadId:0,filename:null,
      upscaleProfile,sourceScale,upscaler:null,biggerPopup:options.biggerPopup || null,finished:false,failed:false,
      conceptInfo,resultWidth:0,resultHeight:0
    };
    const activeJob = job;

    if(isUpscaleTask(task)) {
      const target = createUpscaleUi();
      resetUpscaleUi(false);
      target.overlay.hidden = false;
      if(task === "bigger-upscale") target.title.textContent = config.title;
      target.abort.hidden = false;
      target.percent.style.fontSize = "1.3rem";

      if(task === "bigger-upscale") {
        setProgress("Waiting for bigger.pics…");
        startBiggerPicsJob(activeJob);
      } else {
        setProgress("Upscaling…", 0);
        void runUpscaleJob(activeJob, sourceScale);
      }
      return;
    }

    const target = createUi();
    resetUi(false);
    target.overlay.hidden = false;
    target.title.textContent = "Image Studio";
    target.progress.hidden = false;
    target.secondary.hidden = false;
    target.secondary.textContent = "Abort";
    target.close.setAttribute("aria-label", "Abort and close");
    setProgress("Opening studio…");
    try {
      await openImageStudio(activeJob);
    } catch(error) {
      if(job === activeJob) {
        console.error("Image Studio failed:", error);
        showError(error?.message || String(error));
      }
    }
  };

  const saveOriginal = async () => {
    try {
      const source = getOutput().dataUrl;
      const sourceMime = mimeOf(source);
      window.closeImageMenu();
      if(/^data:/i.test(source) && sourceMime) return download(source, filename("", sourceMime));
      const response = await fetch(source);
      if(!response.ok) throw Error("Could not read the generated image.");
      const blob = await response.blob();
      downloadBlob(blob, filename("", blob.type || sourceMime || "image/png"));
    } catch(error) {
      window.aifgAlert("Error: " + error.message);
    }
  };

  // Sidebar/standalone UI lives in the importing generator. Keep this
  // framework surface intentionally small: it only bridges external image
  // Blobs into the existing Studio and reuses one RRDB instance for a
  // sequential imported-image batch. Generated result batches are untouched.
  let standaloneBatchBusy = false;
  let standaloneBatchUpscaler = null;
  let standaloneBiggerBusy = false;
  let standaloneBiggerPopup = null;

  const validateExternalImageBlob = blob => {
    if(!(blob instanceof Blob) || !String(blob.type || "").toLowerCase().startsWith("image/")){
      throw new Error("Please choose an image file.");
    }
    return blob;
  };

  // Never use requestAnimationFrame for job progression: browsers pause rAF
  // in hidden tabs. MessageChannel yields without tying the queue to painting.
  const yieldBackgroundSafeTask = () => new Promise(resolve => {
    if(typeof MessageChannel === "function") {
      const channel = new MessageChannel();
      channel.port1.onmessage = () => {
        channel.port1.close();
        channel.port2.close();
        resolve();
      };
      channel.port2.postMessage(0);
      return;
    }
    setTimeout(resolve, 0);
  });

  const yieldStandaloneBatchMain = yieldBackgroundSafeTask;

  const publicBridge = Object.freeze({
    isBatchBusy(){
      return standaloneBatchBusy || standaloneBiggerBusy;
    },

    async openBlob(blob){
      validateExternalImageBlob(blob);
      if(standaloneBatchBusy || standaloneBiggerBusy) throw new Error("Batch upscale is still running.");
      await run("studio", blob);
    },

    async upscaleBatch(items, options = {}){
      if(standaloneBatchBusy || standaloneBiggerBusy) throw new Error("Batch upscale is already running.");
      if(job && !job.finished) throw new Error("Close the active Image Studio job before starting a batch upscale.");

      const sourceItems = Array.from(items || []).map((item, index) => {
        const blob = item instanceof Blob ? item : item?.blob;
        validateExternalImageBlob(blob);
        return {
          blob,
          name: String(item?.name || `image-${index + 1}`),
          sourceMime: String(blob.type || "").toLowerCase()
        };
      });
      if(!sourceItems.length) throw new Error("Add at least one image first.");

      const profile = getUpscaleDeviceProfile();
      const sourceScale = await resolveUpscaleSourceScale(profile, sourceItems.length);
      if(sourceScale == null) return {cancelled:true, results:[], error:null};

      const shouldCancelItem = index => {
        try { return options.shouldCancelItem?.(index) === true; }
        catch(_) { return false; }
      };
      const emitProgress = payload => {
        try { options.onProgress?.(payload); }
        catch(_) {}
      };

      const results = [];
      standaloneBatchBusy = true;
      const upscaler = makeUpscaler(sourceScale);
      standaloneBatchUpscaler = upscaler;

      try{
        for(let index = 0; index < sourceItems.length; index++){
          const item = sourceItems[index];

          if(shouldCancelItem(index)){
            emitProgress({index, number:index+1, total:sourceItems.length, name:item.name, text:"Cancelled", percent:0, done:true, cancelled:true});
            continue;
          }

          const inputUrl = URL.createObjectURL(item.blob);
          let canvas = null;
          const itemShouldCancel = () => shouldCancelItem(index);

          emitProgress({index, number:index+1, total:sourceItems.length, name:item.name, text:"Preparing…", percent:0});

          try{
            let result;
            try{
              result = await upscaler.upscale(
                inputUrl,
                (text, percent) => emitProgress({
                  index, number:index+1, total:sourceItems.length, name:item.name,
                  text:text || "Upscaling…", percent:Number(percent)
                }),
                itemShouldCancel
              );
            }catch(error){
              if(shouldCancelItem(index)){
                emitProgress({index, number:index+1, total:sourceItems.length, name:item.name, text:"Cancelled", percent:0, done:true, cancelled:true});
                continue;
              }
              throw error;
            }

            canvas = result?.canvas;
            if(shouldCancelItem(index)){
              emitProgress({index, number:index+1, total:sourceItems.length, name:item.name, text:"Cancelled", percent:0, done:true, cancelled:true});
              continue;
            }

            const sourceMime = item.sourceMime || result?.sourceMime || "";
            const outputMime = upscaleOutputMime(sourceMime);
            const quality = outputMime === "image/jpeg" ? 0.94 : 0.95;
            const outputBlob = await canvasToBlobAsync(canvas, outputMime, quality);
            const output = {blob:outputBlob, name:item.name, sourceMime, outputMime, scale:2, sourceIndex:index};
            results.push(output);

            emitProgress({index, number:index+1, total:sourceItems.length, name:item.name, text:"Done", percent:100, done:true, result:output});
          }finally{
            URL.revokeObjectURL(inputUrl);
            releaseCanvasMemory(canvas);
          }

          if(profile.isMobile) await yieldStandaloneBatchMain();
        }

        return {cancelled:false, results, error:null};
      }catch(error){
        const message = friendlyUpscaleError(error?.message || String(error));
        return {cancelled:false, results, error:new Error(message)};
      }finally{
        try{ upscaler.close(); }catch(_){}
        if(standaloneBatchUpscaler === upscaler) standaloneBatchUpscaler = null;
        standaloneBatchBusy = false;
      }
    },

    upscaleBigger(item, options = {}){
      if(standaloneBatchBusy || standaloneBiggerBusy) {
        return Promise.reject(new Error("Batch upscale is already running."));
      }
      if(job && !job.finished) {
        return Promise.reject(new Error("Close the active Image Studio job before starting a batch upscale."));
      }

      const blob = item instanceof Blob ? item : item?.blob;
      validateExternalImageBlob(blob);
      const name = String(item?.name || "image");
      const sourceMime = String(blob.type || "").toLowerCase();

      const popup = window.open(BIGGER_PICS_URL, "_blank");
      if(!popup) return Promise.reject(new Error("Popup blocked. Allow pop-ups for this site, then try again."));

      standaloneBiggerBusy = true;
      standaloneBiggerPopup = popup;

      return new Promise(resolve => {
        let settled = false;
        let dataUrl = "";
        let readySource = null;
        let sent = false;
        let closePoll = 0;
        let cancelPoll = 0;

        const emitProgress = payload => {
          try { options.onProgress?.(payload); }
          catch(_) {}
        };
        const shouldCancel = () => {
          try { return options.shouldCancel?.() === true; }
          catch(_) { return false; }
        };
        const cleanupExternal = closePopup => {
          window.removeEventListener("message", onMessage);
          if(closePoll) clearInterval(closePoll);
          if(cancelPoll) clearInterval(cancelPoll);
          if(closePopup){
            try{ if(popup && !popup.closed) popup.close(); }catch(_){}
          }
          if(standaloneBiggerPopup === popup) standaloneBiggerPopup = null;
          standaloneBiggerBusy = false;
        };
        const finish = value => {
          if(settled) return;
          settled = true;
          cleanupExternal(false);
          resolve(value);
        };
        const sendIfReady = () => {
          if(sent || !dataUrl || !readySource || settled) return;
          readySource.postMessage({
            type:"bigger-pics-image",
            url:dataUrl,
            name:name.replace(/\.[a-z0-9]+$/i, "") + ".jpg",
            site:`${window.location.hostname}${window.location.pathname}`.replace(/\/+$/, ""),
            format:"jpeg"
          }, BIGGER_PICS_ORIGIN);
          sent = true;
          emitProgress({text:"Sent to bigger.pics", percent:50});
        };
        const onMessage = event => {
          if(event.origin !== BIGGER_PICS_ORIGIN) return;
          const data = event.data || {};

          if(data.type === "bigger-pics-ready"){
            readySource = event.source;
            sendIfReady();
            return;
          }

          if(data.type === "bigger-pics-result" && data.blob){
            const resultBlob = data.blob;
            const resultType = String(resultBlob?.type || "").toLowerCase();
            if(typeof resultBlob?.arrayBuffer !== "function") return;
            if(resultType && !resultType.startsWith("image/")) return;

            emitProgress({text:"Done", percent:100, done:true});
            finish({
              cancelled:false,
              result:{
                blob:resultBlob,
                name:data.name || name,
                sourceMime,
                outputMime:resultType || "image/jpeg",
                scale:4,
                width:Math.max(0, Math.round(Number(data.width) || 0)),
                height:Math.max(0, Math.round(Number(data.height) || 0))
              },
              error:null
            });
          }
        };

        window.addEventListener("message", onMessage);
        emitProgress({text:"Waiting for bigger.pics", percent:0});

        const reader = new FileReader();
        reader.onload = () => {
          dataUrl = String(reader.result || "");
          if(!dataUrl){
            cleanupExternal(true);
            finish({cancelled:false, result:null, error:new Error("Could not prepare this image.")});
            return;
          }
          sendIfReady();
        };
        reader.onerror = () => {
          cleanupExternal(true);
          finish({cancelled:false, result:null, error:new Error("Could not prepare this image.")});
        };
        reader.readAsDataURL(blob);

        closePoll = setInterval(() => {
          let closed = false;
          try{ closed = popup.closed; }catch(_){}
          if(!closed || settled) return;
          finish({cancelled:true, result:null, error:null});
        }, 400);

        cancelPoll = setInterval(() => {
          if(settled || !shouldCancel()) return;
          cleanupExternal(true);
          finish({cancelled:true, result:null, error:null});
        }, 200);
      });
    }
  });

  const dispose = () => {
    try{ standaloneBatchUpscaler?.close?.(); }catch(_){}
    standaloneBatchUpscaler = null;
    standaloneBatchBusy = false;
    standaloneBiggerBusy = false;
    try{ if(standaloneBiggerPopup && !standaloneBiggerPopup.closed) standaloneBiggerPopup.close(); }catch(_){}
    standaloneBiggerPopup = null;
    clearBiggerSession(true);
    clearPendingBiggerHandoff(true);
    window.removeEventListener("message", onBiggerPicsMessage);
    cleanup(true);

    try{ ui?.overlay?.remove?.(); }catch(_){}
    try{ upscaleUi?.overlay?.remove?.(); }catch(_){}
    ui = null;
    upscaleUi = null;
    editor = null;
    studioReturnState = null;
    pendingStudioRestore = null;

    ["t2iImageToolStyle", "t2iUpscaleStudioStyle", "t2iUpscaleMobilePromptStyle", "t2iUpscaleChoiceStyle"].forEach(id => {
      try{ document.getElementById(id)?.remove?.(); }catch(_){}
