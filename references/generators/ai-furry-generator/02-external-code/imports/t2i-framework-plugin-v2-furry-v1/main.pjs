  window.openImageStudioFromBlob = blob => window.aifgImageStudioBridge.openBlob(blob);
  window.upscaleImportedImageBatch = (items, options) => window.aifgImageStudioBridge.upscaleBatch(items, options);
  window.upscaleImportedImageWithBiggerPics = (item, options) => window.aifgImageStudioBridge.upscaleBigger(item, options);
  window.isImportedImageBatchUpscaleBusy = () => window.aifgImageStudioBridge.isBatchBusy();

  window.menuActionDownload = () => ___ensureImageStudioRuntime746291937().saveOriginal();
  window.menuActionStudio = () => ___ensureImageStudioRuntime746291937().run("studio");
  window.menuActionRemoveBackground = window.menuActionStudio;
  window.menuActionUpscale = window.menuActionStudio;
  window.addEventListener("pagehide", ___disposeImageStudioRuntime746291937, { once: true });

  window.___showNextTitle746291937 = function() {
    document.getElementById("t2iIntroMessageEl")?.remove();
    const titleEl = document.getElementById("pageTitleEl48759084793");
