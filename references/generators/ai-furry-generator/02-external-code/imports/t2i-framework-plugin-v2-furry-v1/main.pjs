  // NEW: Word Count Logic (Updated selector for Top-Right placement)
  window.___updateWordCount = function(el) {
    let val = el.value.trim();
    let count = val === "" ? 0 : val.split(/\s+/).length;

    let counter = el.closest('.input-inner').querySelector(".word-count-display");
    if(!counter) return;

    if (count < 600) {
      // Safe Zone
      counter.style.color = "var(--text-color)";
      counter.style.opacity = "0.5";
      counter.style.fontWeight = "normal";
      counter.innerHTML = `${count} words`;
    } else if (count <= 800) {
      // Approaching Limit
      counter.style.color = "var(--text-color)";
      counter.style.opacity = "0.8";
      counter.style.fontWeight = "normal";
      counter.innerHTML = `${count} / 800`;
    } else if (count <= 1000) {
      // Over Soft Limit (Orange)
      counter.style.color = "light-dark(#e65100, #fb923c)";
      counter.style.opacity = "1";
      counter.style.fontWeight = "bold";
      counter.innerHTML = `${count} / 800`;
    } else {
      // Hard Limit / Warning (Red + Icon)
      counter.style.color = "light-dark(#b91c1c, #f87171)";
      counter.style.opacity = "1";
      counter.style.fontWeight = "bold";
      counter.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${count} words`;
    }
  };



