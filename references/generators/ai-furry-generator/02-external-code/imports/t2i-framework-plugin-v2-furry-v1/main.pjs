      }

      let foldToggleState = item.foldToggleState;

      let html = `
        <div class="input-ctn input-type-text ${item.takesUpFullRow ? "takesUpFullRow" : ""}" data-fold-toggle-state="${foldToggleState}">
          <div class="input-inner" style="${widthStyle}">
