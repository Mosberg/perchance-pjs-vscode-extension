          cancelButton.onclick = () => finish(cancelResult);
          ui.actions.appendChild(cancelButton);
        }
        const okButton = ___aifgDialogButton746291937(options.okText || (options.danger ? "Continue" : "OK"), { primary: !options.danger, danger: !!options.danger });
        okButton.onclick = accept;
        ui.actions.appendChild(okButton);
      }

      const onKeyDown = event => {
        if(event.key === "Escape") {
          event.preventDefault();
          finish(cancelResult);
          return;
        }
        if(event.key === "Enter" && mode !== "choice" && !event.shiftKey) {
          event.preventDefault();
          accept();
        }
      };

      ui.overlay.onclick = event => {
        if(event.target === ui.overlay) finish(cancelResult);
      };
      document.addEventListener("keydown", onKeyDown, true);
      ui.overlay.style.display = "flex";
      requestAnimationFrame(() => {
        if(mode === "prompt") {
          ui.input.focus();
          ui.input.select();
        } else {
          ui.actions.querySelector("button:last-child")?.focus();
        }
      });
    };

    window.aifgDialog = function(options = {}) {
