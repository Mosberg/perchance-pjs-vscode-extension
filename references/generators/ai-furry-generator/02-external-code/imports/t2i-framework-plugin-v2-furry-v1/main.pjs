    window.t2i_generateShareLinkForCharacter = async function (json, imgSrc) {
      if (!window.CompressionStream) return window.aifgAlert("Browser too old.");

      // --- 1. PREPARE DATA (STRICT SEPARATION) ---

      const source = json.addCharacter;
      const charName = source.name || "Unknown";

      // Look for 'roleInstruction' first (from generator), fallback to 'description'
      const charDesc = source.roleInstruction || source.description || "";

      // Payload A: FurAI Strict Format
      const furAiPayload = {
        ver: "1.0",
        type: "character",
        name: charName,
        avatar: imgSrc,
        instruction: charDesc,
        defaultSprite: "",
        customEmotions: {},
        emotionAvatars: {},
        emotionSprites: {}
      };

      // Payload B: Standard Chat Format
      const standardPayload = {
        addCharacter: {
          name: charName,
          description: charDesc,
          ...source
        }
      };

      const cleanName = charName
        .replace(/\s+/g, "_")
        .replaceAll("~", "")
        .replaceAll(`"`, "");

      try {
        // Helper for rate-limit
        const sleep = ms => new Promise(res => setTimeout(res, ms));

        // --- 2. UPLOAD PROCESS (SEQUENTIAL) ---

        // STEP 1: Upload FurAI File (Plain Text)
        const blobFurAI = new Blob([JSON.stringify(furAiPayload)], { type: "text/plain" });
        const resFurAI = await upload(blobFurAI);
        if (resFurAI.error) throw new Error("FurAI upload failed: " + resFurAI.error);
        const furAiFileUrl = resFurAI.url;

        // Breather
        await sleep(500);

        // STEP 2: Upload Standard Chat File (GZIP)
        const rawBlobStandard = new Blob([JSON.stringify(standardPayload)], { type: "text/plain" });
        const cs = new CompressionStream("gzip");
        const compressedStream = rawBlobStandard.stream().pipeThrough(cs);
        const outputBlob = await new Response(compressedStream).blob();

        const resStandard = await upload(new Blob([outputBlob], { type: "application/gzip" }));
        if (resStandard.error) throw new Error("Standard upload failed: " + resStandard.error);
        const standardFileUrl = resStandard.url;

        // --- 3. LINK CONSTRUCTION ---

        // Link 1: FurAI (Uses ?char_import=FULL_URL)
        const furAiLink = `https://perchance.org/fur-ai?char_import=${furAiFileUrl}&name=${cleanName}`;

        // Link 2: Standard Chat (Uses data=Name~ID)
        const standardId = standardFileUrl.replace("https://user.uploads.dev/file/", "");
        const standardLink = `https://perchance.org/ai-character-chat?data=${cleanName}~${standardId}`;

        // --- 4. UI CONSTRUCTION ---
        const overlay = document.createElement("div");
        overlay.style.cssText =
          "inset:0;z-index:999999;position: fixed;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s ease;font-family:sans-serif;";

        const card = document.createElement("div");
        card.style.cssText =
          "width:90%;max-width:500px;background:var(--box-color,#1a1a1a);border:1px solid var(--border-color,#333);border-radius:12px;padding:24px;color:var(--text-color,#fff);display:flex;flex-direction:column;gap:16px;transform:scale(0.95);transition:transform 0.2s cubic-bezier(0.2,0.8,0.2,1);max-height:90vh;overflow-y:auto;";

        const style = document.createElement("style");
        style.textContent =
          ".opt-scroll::-webkit-scrollbar{width:6px}.opt-scroll::-webkit-scrollbar-thumb{background:rgba(127,127,127,0.3);border-radius:3px}";
        card.appendChild(style);
        card.className = "opt-scroll";

        card.innerHTML = `
          <div style="text-align:center; margin-bottom:0px;">
            <img src="${imgSrc}" style="width:70px;height:70px;border-radius:50%;object-fit:cover;margin-bottom:10px;border:2px solid var(--border-color,#444);">
            <h2 style="margin:0;font-size:1.3rem;">Character Ready!</h2>
            <p style="margin:4px 0 0;opacity:0.7;font-size:0.95rem;font-weight:600;">${charName}</p>
          </div>

          <div style="background:linear-gradient(135deg,rgba(255,255,255,0.05),rgba(255,255,255,0.01)); border:1px solid var(--special-color,#0a66c9); border-radius:10px; padding:16px; display:flex; flex-direction:column; gap:12px;">

            <div style="display:flex; align-items:center; gap:12px;">
              <div style="
                width: 48px; height: 48px;
                background: var(--special-color, #0a66c9);
                color: white;
                border-radius: 12px;
                display: flex; align-items: center; justify-content: center;
                box-shadow: 0 2px 6px rgba(0,0,0,0.2);
                flex-shrink: 0;
              ">
                <span class="material-symbols-outlined" style="font-size:1.8rem;">chrome_reader_mode</span>
              </div>

              <div style="flex:1;">
                <div style="font-weight:700; font-size:1rem; color:var(--text-color, #fff);">FurAI 🦊 Group Chat</div>
                <div style="font-size:0.75rem; opacity:0.7;">Visual Novel | Multi-Character Roleplay</div>
              </div>
            </div>

            <div style="background:rgba(0,0,0,0.3); padding:4px 4px 4px 10px; border-radius:6px; border:1px solid var(--border-color,#444); display:flex; align-items:center; gap:8px;">
              <input type="text" value="${furAiLink}" readonly style="flex:1; background:transparent; border:none; color:inherit; font-size:0.8rem; outline:none; opacity:0.8; text-overflow:ellipsis; font-family:inherit;">
              <button class="opt-btn copy-btn" data-url="${furAiLink}" style="padding:6px 10px; border-radius:6px; border:none; background:var(--button-color,#444); color:inherit; cursor:pointer; font-weight:600; font-size:0.75rem; min-width:50px;">Copy</button>
            </div>

            <button onclick="window.open('${furAiLink}', '_blank')" class="opt-btn" style="width:100%; padding:10px; border-radius:6px; border:none; background:var(--special-color,#0a66c9); color:white; font-size:0.9rem; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;">
