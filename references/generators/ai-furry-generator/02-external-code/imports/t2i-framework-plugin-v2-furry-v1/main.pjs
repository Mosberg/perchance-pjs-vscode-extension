  window.__deleteFolder = async function(idx) {
    window.__closeKebab();
    let folder = window.__t2iGalleries[idx];
    if (folder.items.length === 0) {
      if(!await window.aifgConfirm(`Delete empty folder '${folder.folder}'?`, { title:"Delete folder", okText:"Delete", danger:true })) return;
      window.__t2iGalleries.splice(idx, 1);
    } else {
      const action = await window.aifgChoice(`Delete folder '${folder.folder}'?`, [
        { label:"Keep galleries", value:"keep", primary:true },
        { label:"Delete all", value:"delete", danger:true }
      ], { title:"Delete folder", cancelText:"Cancel" });
      if (action === null) return;
      if (action === "keep") {
        let items = folder.items;
        window.__t2iGalleries.splice(idx, 1, ...items);
      } else if (action === "delete") {
        if(!await window.aifgConfirm("Delete every gallery shortcut inside this folder? This cannot be undone.", { title:"Delete all galleries", okText:"Delete all", danger:true })) return;
        window.__t2iGalleries.splice(idx, 1);
        let stillExists = false;
        window.__t2iGalleries.forEach(g => {
          if (typeof g === 'string') { if (g === window.__t2iCurrentGallery) stillExists = true; }
          else { if (g.items.includes(window.__t2iCurrentGallery)) stillExists = true; }
        });
        if (!stillExists) window.__selectGallery("public");
      }
    }
    if(window.__t2iGalleries.length === 0) window.__t2iGalleries = ['public'];
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__renderGalleryMenu();
  };

  window.__sanitizeGalleryName = function(name) {
    return String(name || '').trim().toLowerCase().replace(/[ _]+/g, '-').replace(/[^a-z0-9\-]/g, '');
  };

  window.__sanitizeFolderName = function(name) {
    return String(name || '').trim();
  };

  window.__layoutHasGallery = function(layout, name) {
    if (!Array.isArray(layout) || !name) return false;
    return layout.some(entry => {
      if (typeof entry === 'string') return entry === name;
      if (entry && typeof entry === 'object' && Array.isArray(entry.items)) return entry.items.includes(name);
      return false;
    });
  };

  window.__normalizeGalleryLayout = function(layout) {
    if (!Array.isArray(layout)) return null;

    const out = [];
    const seenGalleryNames = new Set();

    layout.forEach(entry => {
      if (typeof entry === 'string') {
        const safeName = window.__sanitizeGalleryName(entry);
        if (!safeName || seenGalleryNames.has(safeName)) return;
        seenGalleryNames.add(safeName);
        out.push(safeName);
        return;
      }

      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) return;

      const safeFolder = window.__sanitizeFolderName(entry.folder);
      if (!safeFolder) return;

      const rawItems = Array.isArray(entry.items) ? entry.items : [];
      const cleanItems = [];

      rawItems.forEach(item => {
        const safeName = window.__sanitizeGalleryName(item);
        if (!safeName || seenGalleryNames.has(safeName)) return;
        seenGalleryNames.add(safeName);
        cleanItems.push(safeName);
      });

      out.push({
        folder: safeFolder,
        isOpen: entry.isOpen !== false,
        items: cleanItems
      });
    });

    if (!seenGalleryNames.has('public')) out.unshift('public');
    if (out.length === 0) out.push('public');

    return out;
  };

  window.__readStoredGalleryLayout = function() {
    const rawLayout = typeof window.__readRawGalleryLayoutFromStorage === 'function'
      ? window.__readRawGalleryLayoutFromStorage()
      : ['public'];
    return window.__normalizeGalleryLayout(rawLayout) || ['public'];
  };

  window.__resolveGalleryCurrent = function(layout, preferredCurrent, fallbackCurrent = 'public') {
    if (window.__layoutHasGallery(layout, preferredCurrent)) return preferredCurrent;
    if (window.__layoutHasGallery(layout, fallbackCurrent)) return fallbackCurrent;
    return window.__layoutHasGallery(layout, 'public') ? 'public' : layout.find(entry => typeof entry === 'string') || 'public';
  };

  window.__buildGalleryLayoutPayload = function(layout, currentGallery) {
    const canonicalLayout = window.__normalizeGalleryLayout(layout) || ['public'];
    const canonicalCurrent = window.__resolveGalleryCurrent(canonicalLayout, currentGallery, 'public');
    return {
      format: 'gallery-layout-v1',
      galleries: canonicalLayout,
      currentGallery: canonicalCurrent
    };
  };

  window.__syncGalleryLayoutState = function(layout, currentGallery) {
    const payload = window.__buildGalleryLayoutPayload(layout, currentGallery);

    window.__t2iGalleries = payload.galleries;
    window.__t2iFolders = payload.galleries;
    window.__t2iCurrentGallery = payload.currentGallery;
    window.__t2iCurrentFolder = payload.currentGallery;

    localStorage.setItem('t2i_gallery_folders', JSON.stringify(payload.galleries));
    localStorage.setItem('t2i_current_folder', payload.currentGallery);

    const nameEl = document.getElementById('currentGalleryName');
    if (nameEl) nameEl.textContent = payload.currentGallery;

    return payload;
  };

  window.__refreshGalleryLayoutUi = function() {
    if (document.getElementById('galleryDropdownMenu') && typeof window.__renderGalleryMenu === 'function') {
      window.__renderGalleryMenu();
    }

    const openGalleryFrames = document.querySelectorAll('iframe.text-to-image-plugin-gallery');
    if (!openGalleryFrames.length || typeof window.changeAll !== 'function') return;

    const tagInput = document.getElementById('galleryTagInputEl');
    const badTagInput = document.getElementById('galleryBadTagInputEl');
    window.changeAll(tagInput ? tagInput.value : '', badTagInput ? badTagInput.value : '');
  };

  window.__writeCanonicalGalleryLayoutBox = function(payload) {
    const box = document.getElementById('galleryLayoutTransferBox');
    const text = JSON.stringify(payload, null, 2);
    if (box) box.value = text;
    return text;
  };

  window.__copyGalleryLayout = async function() {
    const storedLayout = window.__readStoredGalleryLayout();
    const storedCurrent = localStorage.getItem('t2i_current_folder') || 'public';
    const payload = window.__buildGalleryLayoutPayload(storedLayout, storedCurrent);

    // Keep both runtime aliases aligned with the actual saved state without opening the gallery.
    window.__t2iGalleries = payload.galleries;
    window.__t2iFolders = payload.galleries;
    window.__t2iCurrentGallery = payload.currentGallery;
    window.__t2iCurrentFolder = payload.currentGallery;

    const text = window.__writeCanonicalGalleryLayoutBox(payload);

    try {
      await navigator.clipboard.writeText(text);
      window.aifgAlert('Gallery layout copied to clipboard.');
    } catch (err) {
      const box = document.getElementById('galleryLayoutTransferBox');
      if (box) {
        box.focus();
        box.select();
      }
      window.aifgAlert('Gallery layout is ready in the text box. Copy it manually.');
    }
  };

  window.__importGalleryLayout = function(mode) {
    const box = document.getElementById('galleryLayoutTransferBox');
    const raw = box ? box.value.trim() : '';

    if (!raw) return window.aifgAlert('Paste a gallery layout first.');
    if (mode !== 'replace' && mode !== 'merge') return window.aifgAlert('Unknown gallery layout import mode.');

    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch (err) {
      return window.aifgAlert('Invalid JSON. Paste a valid gallery layout export.');
    }

    const incomingGalleries = Array.isArray(parsed) ? parsed : parsed?.galleries;
    const incomingCurrent = typeof parsed?.currentGallery === 'string' ? parsed.currentGallery : 'public';
    const normalizedIncoming = window.__normalizeGalleryLayout(incomingGalleries);

    if (!normalizedIncoming) return window.aifgAlert('Invalid gallery layout data.');

    const receivingLayout = window.__readStoredGalleryLayout();
    const receivingCurrent = localStorage.getItem('t2i_current_folder') || window.__t2iCurrentGallery || 'public';
    let nextLayout;

    if (mode === 'merge') {
      nextLayout = receivingLayout;

      normalizedIncoming.forEach(entry => {
        if (typeof entry === 'string') {
          if (!window.__layoutHasGallery(nextLayout, entry)) nextLayout.push(entry);
          return;
        }

        const existingFolder = nextLayout.find(item =>
          item && typeof item === 'object' && !Array.isArray(item) && item.folder === entry.folder
        );

        if (existingFolder) {
          entry.items.forEach(name => {
            if (!window.__layoutHasGallery(nextLayout, name)) existingFolder.items.push(name);
          });
          if (entry.isOpen) existingFolder.isOpen = true;
          return;
        }

        nextLayout.push({
          folder: entry.folder,
          isOpen: entry.isOpen !== false,
          items: entry.items.filter(name => !window.__layoutHasGallery(nextLayout, name))
        });
      });

      nextLayout = window.__normalizeGalleryLayout(nextLayout) || ['public'];
    } else {
      nextLayout = normalizedIncoming;
    }

    const preferredCurrent = mode === 'merge'
      ? window.__resolveGalleryCurrent(nextLayout, receivingCurrent, incomingCurrent)
      : window.__resolveGalleryCurrent(nextLayout, incomingCurrent, 'public');

    const payload = window.__syncGalleryLayoutState(nextLayout, preferredCurrent);
    window.__writeCanonicalGalleryLayoutBox(payload);
    window.__refreshGalleryLayoutUi();

    window.aifgAlert(mode === 'merge' ? 'Gallery layout merged.' : 'Gallery layout replaced.');
  };

  setTimeout(() => {
    window.__initGalleryMenu();
    if (document.getElementById('galleryDropdownMenu')) window.__renderGalleryMenu();
