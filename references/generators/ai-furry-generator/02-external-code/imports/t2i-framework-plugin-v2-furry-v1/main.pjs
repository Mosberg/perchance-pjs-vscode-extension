    if(val > 30) val = 30;

    let slider = document.getElementById('guidanceSlider');
    let display = document.getElementById('guidanceDisplay');

    if(slider) {
      slider.value = val;

      // Calculate percentage (min is 1, max is 30, so range is 29)
      let percentage = ((val - 1) / 29) * 100;

      // Draw the "filled" effect using a linear gradient!
      slider.style.background = `linear-gradient(to right, var(--text-color) ${percentage}%, var(--border-color) ${percentage}%)`;
    }

    if(display) {
      display.textContent = val;
      // Make 7 slightly transparent, regular opacity for everything else
      display.style.opacity = (val === 7) ? "0.4" : "1";
    }

    localStorage.setItem('t2i_guidance_scale', val);
  };

  // === NEW: GUIDANCE SCALE LOCK ===
  window.___toggleGuidanceLock = function() {
