  window.___pageLoadHandler746291937 = function() {

    // let pageUrlIsShareLink = window.location.hash.slice(1).startsWith("data=");

    // Restore the real Light/Grey/Dark preset. The separate upstream controller may follow the system.
    setColorScheme(window.getCurrentColorSchemeMode());

    if(socialFeatures === "enabled") {
      window.__syncSocialPanelMounts();
    }

    let generateClickCount = localStorage.generateClickCount ? Number(localStorage.generateClickCount) : 0;

    if(thisGeneratorIsUsingClickCountBasedSocialDisplay && !localStorage.theyKnowAboutClickCountBasedSocialDisplay) {
      // clickCountBasedSocialDisplayNotifierEl.style.display = "";
    }

    if(generateClickCount === 0) {
      // bottomClickHelperEl.style.display = "";
      leftClickHelperEl.style.display = "";
      rightClickHelperEl.style.display = "";
    }

    // DELETE THIS BLOCK
    // if(generateClickCount === 0) {
    //  shareLinkOuterCtn2893827.style.display = "";
    // }

    // Do init stuff like triggering oninput/onchange for each input right after init.
    setTimeout(async () => {
      // --- TABBED SCRATCHPAD BINDING (STARTUP) ---
      // 1. Priority: Read directly from LocalStorage (Instant)
      let rawJson = localStorage.t2i_tabbed_scratchpad_data;

      // 2. Fallback: Read from Element (For Share Links/First Loads)
      if (!rawJson) {
        let tabInputSpec = window.___userSettings746291937.userInputs.tabbedScratchpad;
        if (tabInputSpec && tabInputSpec._element) {
          rawJson = tabInputSpec._element.value;
        }
      }

      if (rawJson) {
        try {
          let data = JSON.parse(rawJson);
          data.tabs.forEach(tab => {
            if (!tab.text) return;
            tab.text.split("\n").forEach(line => {
              let parts = line.split("=");
              if (parts.length < 2) return;

              let key = parts[0].trim();
              let val = parts.slice(1).join("=").trim();

              // Register variable if it is Uppercase/Numbers/Underscore
              if (key && /^[A-Z0-9_]+$/.test(key)) {
                // FIXED: Set as raw string to match Legacy Scratchpad behavior
                // (Old code used {evaluateItem: val}, which caused issues)
                window[key] = val;
              }
            });
          });
          console.log("Tabbed Scratchpad variables bound successfully.");
        } catch (e) { console.error("Tabbed Scratchpad Init Error:", e); }
      }
      // -----------------------------------------------------------

      // ---------------------------------------------------------
      //                 NEW: CHIPS INITIALIZATION
      // ---------------------------------------------------------
      userInputsCtn8462746262.querySelectorAll('.input-type-chips').forEach(ctn => {
        let hiddenInput = ctn.querySelector('.chip-hidden-input');
        if (!hiddenInput) return;

        let storageKey = "t2i_chip_state_" + hiddenInput.dataset.name;
        let savedState = null;
        try { savedState = JSON.parse(localStorage.getItem(storageKey)); } catch(e) {}

        ctn.querySelectorAll('.t2iChip').forEach(chip => {
          let name = chip.dataset.chipName;
          let isOn;

          // Determine state (Saved vs Default)
          if (savedState && savedState[name] !== undefined) {
            isOn = savedState[name];
          } else {
            isOn = (chip.dataset.def === "true");
          }

          // Visual Update
          if (isOn) chip.classList.add('on');
          else chip.classList.remove('on');
        });

        // Create the Magic Object immediately
        window.___updateChipState(ctn);
      });
      // ---------------------------------------------------------

      if(localStorage.autoShowSocialsNextTime && document.querySelector("#showSocialsButton927514532")) {
        if (socialFeatures != "enabled")  document.querySelector("#showSocialsButton927514532").click();
      }

      // --- LOOP 1: Element Binding ---
      userInputsCtn8462746262.querySelectorAll('input, select, textarea').forEach(el => {
        if (!el.dataset.name) return; // <-- ADDED FIX
        let userInputSpec = window.___userSettings746291937.userInputs[el.dataset.name];
        if (userInputSpec) userInputSpec._element = el; // <-- ADDED FIX
      });

      for(let h of initHandlers) {
        let element = window.___userSettings746291937.userInputs[h.inputName]._element;
        element.addEventListener(h.eventName, h.handler);
      }

      // --- LOOP 2: Set Initial Values ---
      userInputsCtn8462746262.querySelectorAll('input, select, textarea').forEach(el => {
        if (!el.dataset.name) return; // <-- ADDED FIX
        let userInputSpec = window.___userSettings746291937.userInputs[el.dataset.name];
        if (!userInputSpec) return; // <-- ADDED FIX

        let value;
        if(userInputSpec.remember) {
          value = getRememberedInput(el.dataset.name);
        } else if(el.tagName === "TEXTAREA" || (el.tagName === "INPUT" && el.type === "text")) { // <-- just to be sure
          // value = localStorage["t2i_tempRememberedInput_fisuyr9hf_"+el.dataset.name];
        }
        if(value !== undefined) {
          el.value = value;
          // <select> options can be removed by gen authors, so if the option doesn't exist, we just set it to the first option:
          if((userInputSpec.type === "select" || userInputSpec.type === "visual-select") && ![...el.querySelectorAll(`option`)].find(el => el.value === value)) { // && userInputSpec.compiledOptions[value.replace(/^ref:optionKeyName:/, "")] === undefined
            el.value = el.querySelector("option").value;
          }
        }

        // Initialize the input state without treating page load as a user edit.
        if(el.onchange) el.onchange({_isInitCall:true});
        if(el.oninput) el.oninput({_isInitCall:true});
      });

      // Remembered/default Style is now available in window.input. Refresh each
      // dependent modifier container once so its dropdowns appear on first load.
      new Set(initHandlers.map(handler => handler.handler)).forEach(handler => handler());

      updateInputVisibilities();
      window.___applyInputHintVisibility();

      // --- LOOP 3: Rotating 'Example' Placeholders ---
      userInputsCtn8462746262.querySelectorAll('input, select, textarea').forEach(el => {
        if (!el.dataset.name) return; // <-- ADDED FIX
        let userInputSpec = window.___userSettings746291937.userInputs[el.dataset.name];
        if (!userInputSpec) return; // <-- ADDED FIX

        let examplesList = userInputSpec.examples;
        if(examplesList && ((el.nodeName === "INPUT" && el.type === "text") || el.nodeName === "TEXTAREA")) {
          // set rotating placeholder text on text inputs
          function nextExample() {
            if(userInputSpec.useVariables && window[el.dataset.name.toUpperCase()]) {
              window.ignorePerchanceErrors(() => {
                el.placeholder = window[el.dataset.name.toUpperCase()].evaluateItem;
              });
            } else {
              let text = selectLeaf(examplesList).evaluateItem;
              // try a few times to get a different one to the last-displayed one:
              if(text === el.placeholder) text = selectLeaf(examplesList).evaluateItem;
              if(text === el.placeholder) text = selectLeaf(examplesList).evaluateItem;
              if(text === el.placeholder) text = selectLeaf(examplesList).evaluateItem;

              // simple hack to save me a headache with escaping (e.g. for scratchpad placholder text)
              text = text.replace(/&lsqb;/g, "[");
              text = text.replace(/&rsqb;/g, "]");
              text = text.replace(/&lcub;/g, "{");
              text = text.replace(/&rcub;/g, "}");

              el.placeholder = text;
            }
          }
          nextExample();

          const performanceProfile = localStorage.getItem("pl_performanceProfileV1");
          if (performanceProfile !== "balance" && performanceProfile !== "minimal") {
            setInterval(nextExample, 3250);
          }
        }
      });

      // set up click handlers for the 'random' buttons:
      userInputsCtn8462746262.querySelectorAll('.random-input-btn-ctn').forEach(el => {
        if(el.querySelector(".random-input-btn")) {
          el.querySelector(".random-input-btn").onclick = function() {
            let inputEl = el.closest(".input-ctn").querySelector("input, textarea");

            // 1. Snapshot for Undo
            if(typeof forcePushUndoState === 'function') forcePushUndoState(inputEl);

            let userInputSpec = window.___userSettings746291937.userInputs[el.dataset.inputName];
            let targetVar = el.dataset.inputName.toUpperCase(); // e.g. "DESCRIPTION"

            // 2. The Logic: Check Global -> Use It -> Else Default
            if(userInputSpec.useVariables && window[targetVar]) {
              window.clearPerchanceErrors();
              let val = window[targetVar];
              // Support both Perchance Objects (Legacy) and Strings (New Scratchpad)
              inputEl.value = (val.evaluateItem) ? val.evaluateItem : val;
            } else {
              // Fallback: Use the default random list
              let randomList = userInputSpec.random;
              inputEl.value = selectLeaf(randomList).evaluateItem;
            }

            // 3. Trigger events
            inputEl.dispatchEvent(new Event("input"));
            if(inputEl.oninput) inputEl.oninput({});
          };
        }


        // update AI magic wand
        if(el.querySelector(".ai-suggest-btn")) {
          // THIS IS THE FULLY REVISED CLICK HANDLER
          el.querySelector(".ai-suggest-btn").onclick = async function() {
            // STEP 1: Get input from the textarea
            let inputEl = el.closest(".input-ctn").querySelector("input, textarea");

            // update UNDO
            forcePushUndoState(inputEl); // <-- ADD THIS LINE


            let inputText = inputEl.value.trim();
            if(!inputText) {
              window.aifgAlert("Please enter a few keywords in the Prompt first to enhance.\n\n💡 Tip: You can also request random elements like 'random clothes' or 'random places'. The AI prompt enhancer will turn them into Perchance-style syntax, such as {beach|city|forest|cafe...}.");

              return; // Stop if the input is empty
            }

            // Restore legacy scratchpad-variable support for the AI enhancer.
            // Example: PROMPT = a red fox, then [PROMPT] in the Prompt textarea.
            // Resolve only what is sent to the enhancer; keep the visible textarea unchanged
            // until the enhanced result starts streaming.
            let enhancerInputText = inputText;
            let enhancerUserInputSpec = window.___userSettings746291937.userInputs[inputEl.dataset.name];
            if(enhancerUserInputSpec?.useVariables) {
              parseAllVariables(); // avoid the normal 1s parse debounce when the wand is clicked
              try {
                window.clearPerchanceErrors();
                let evaluatedInputText = inputText.evaluateItem;
                if(evaluatedInputText !== undefined && evaluatedInputText !== null) {
                  enhancerInputText = String(evaluatedInputText).trim();
                }
              } catch(e) {
                console.warn("Prompt enhancer variable resolution failed; using raw prompt text.", e);
              }
            }

            window.___showPromptEnhancerCustomizationHint746291937?.();

            let suggestBtn = el.querySelector(".ai-suggest-btn");
            suggestBtn.innerHTML = `<span style="display:inline-block; animation:rotate 1.5s linear infinite;"><i class="fa-solid fa-spinner"></i></span>`;
            suggestBtn.disabled = true;
            let originalSuggestBtnDisplay = suggestBtn.style.display;

            let stopBtn = document.createElement("button");
            stopBtn.innerHTML = `<i class="fa-solid fa-stop fa-fade" title="Stop" style="--fa-animation-duration: 1.25s; font-size: 1rem;vertical-align:0.1em;"></i>`;
// --- COPY STYLES FROM OTHER BUTTONS ---
            stopBtn.style.width = "1.75rem";
            stopBtn.style.height = "1.75rem";
            stopBtn.style.padding = "0";
            stopBtn.style.position = "relative";
            stopBtn.style.display = "none";
            stopBtn.style.alignItems = "center";     // Centers icon vertically
            stopBtn.style.justifyContent = "center"; // Centers icon horizontally
            stopBtn.style.marginTop = "0.25rem";

            // let inputEl = el.closest(".input-ctn").querySelector("input, textarea"); // We already declared 'inputEl', so the original lines are modified
            let chunkCount = 0;
            let fullTextSoFar = window.___resolvePromptEnhancerPrefix746291937();

            // Release textarea focus before streaming so mobile browsers do not
            // keep trying to pull the changing prompt back into the viewport.
            inputEl.blur();
            inputEl.value = "Enhancing...";

            const formatEnhancedText = (text) => {
              text = (text || "").trim();
              return text ? text[0].toUpperCase() + text.slice(1) : "";
            };

            const smoothPromptWriter = ___smoothAiOutput746291937((text, meta) => {
              inputEl.value = text;
              inputEl.scrollTop = inputEl.scrollHeight;

              const cleanText = meta && typeof meta.rawValue === "string" ? meta.rawValue : text;
              window.input[inputEl.dataset.name] = cleanText;

              const userInputSpec = window.___userSettings746291937.userInputs[inputEl.dataset.name];
              if(userInputSpec) userInputSpec.value = cleanText;
            }, { cursor: true });

            let pendingObj = aiText({
              instruction: window.___resolvePromptEnhancerInstruction746291937(enhancerInputText),
              startWith: window.___resolvePromptEnhancerStartWith746291937(),
              stopSequences: ["\n"],
              hideStartWith: true,
              onChunk: (data) => {
                if(chunkCount === 0) {
                  inputEl.value = "";
                  stopBtn.style.display = "flex"; // <--- CHANGE THIS from "" to "flex"
                  suggestBtn.style.display = "none";
                }
                if(!data.isFromStartWith) {
                  fullTextSoFar += data.textChunk;
                  smoothPromptWriter.set(formatEnhancedText(fullTextSoFar));
                }
                chunkCount++;
              },
            });
            suggestBtn.after(stopBtn);

            stopBtn.onclick = function() {
              stopBtn.disabled = true;
              pendingObj.stop();
            };

            let onInputInterval = setInterval(() => {
              const cleanText = formatEnhancedText(fullTextSoFar);
              window.input[inputEl.dataset.name] = cleanText;

              const userInputSpec = window.___userSettings746291937.userInputs[inputEl.dataset.name];
              if(userInputSpec) userInputSpec.value = cleanText;
            }, 2000); // keeps generate usable mid-stream without saving the blinking cursor

            try {
              await pendingObj.onFinishPromise;
            } catch(e) {
              console.error(e);
            }

            clearInterval(onInputInterval);

            smoothPromptWriter.flush(formatEnhancedText(fullTextSoFar));

            inputEl.dispatchEvent(new Event("input"));

            stopBtn.remove();
            suggestBtn.style.display = originalSuggestBtnDisplay;
            suggestBtn.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles"style="font-size: 0.8rem;"></i>`;
            suggestBtn.disabled = false;
          };
        }
      });

      // === INSERTED: smarter undo button support with grouped intervals ===
      document.querySelectorAll('textarea.paragraph-input, input.text-input').forEach(el => {
        const name = el.dataset.name;
        if (!window.___undoStack) window.___undoStack = {};
        if (!window.___undoTimers) window.___undoTimers = {};
        if (!window.___lastUndoTime) window.___lastUndoTime = {};
        if (!window.___undoStack[name]) window.___undoStack[name] = [];

        el.addEventListener("input", function () {
          clearTimeout(window.___undoTimers[name]);
          window.___undoTimers[name] = setTimeout(() => {
            let now = Date.now();
            let val = el.value;
            let stack = window.___undoStack[name];
            let lastTime = window.___lastUndoTime[name] || 0;
            let timeGap = now - lastTime;

            let shouldPush = true;
            if (stack.length > 0 && timeGap < 6000) {
              let lastVal = stack[stack.length - 1];
              if (lastVal === val) shouldPush = false;
              else if (timeGap < 1200 && Math.abs(lastVal.length - val.length) <= 2) shouldPush = false;
            }

            if (shouldPush) {
              stack.push(val);
              if (stack.length > 50) stack.shift();
              window.___lastUndoTime[name] = now;
            }
          }, 400);
        });
      });

      userInputsCtn8462746262.querySelectorAll('.random-input-btn-ctn').forEach(el => {
        // Line Break button (inserts at cursor position)
        // already removed Line Break button

        // Undo button
        const undoBtn = el.querySelector(".undo-input-btn");
        if (undoBtn) {
          undoBtn.onclick = function () {
            const inputEl = el.closest(".input-ctn").querySelector("input, textarea");
            const name = el.dataset.inputName;
            if (window.___undoStack && window.___undoStack[name]?.length > 1) {
              window.___undoStack[name].pop();
              inputEl.value = window.___undoStack[name].at(-1);
              inputEl.dispatchEvent(new Event("input"));
            }
          };
        }
      });
      // === END INSERT ===

      // === NEW: INITIALIZE GUIDANCE ON LOAD ===
      let savedGuidance = localStorage.getItem('t2i_guidance_scale');
      if(savedGuidance !== null) {
        window.___updateGuidance(savedGuidance);
      }

      let savedGuidanceLock = localStorage.getItem('t2i_guidance_locked');
      window.___setGuidanceLock(window.innerWidth <= 700 && savedGuidanceLock === '1', false);
      // ========================================

      // focus on first non-hidden text input (only on non-mobile devices, otherwise onscreen keyboard pops up, which might be annoying):
      if(window.innerWidth > 700 && !window.location.hash.startsWith("#edit") && !window.alreadyFocussedTextAreaOnLoad) {
        let textInput = [...userInputsCtn8462746262.querySelectorAll('textarea, input')].filter(el => el.offsetHeight !== 0)[0];
        if(textInput) {
          let distanceFromTopOfPage = textInput.getBoundingClientRect().top;
          if(distanceFromTopOfPage < 300) { // don't focus if it's way down the page - we want to keep the page scrolled to the top on load
            textInput.focus();
          }
        }
        window.alreadyFocussedTextAreaOnLoad = true; // this is a hacky way to disable this when someone is editing a t2i-framework powered generator, since that's the only case where this plugin's code will be called multiple times (and the focus will annoyingly steal away focus from the perchance code editor)
      }

      // wait a 'tick' and then load share link data if it exists:
