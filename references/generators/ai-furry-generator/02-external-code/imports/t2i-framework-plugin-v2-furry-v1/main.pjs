        : "";
    };

    // --- Button HTML Construction ---
    let underEachImageParts = [];

    underEachImageParts.push(`
      <button class="personal-image-button"
        title="More image options: zoom, pin, save, reuse seed, AI chat, and Image Studio"
        aria-label="More image options"
        style="position:absolute; top:calc(0.25rem - 1px); right:calc(0.25rem - 1px); background:#cfcfcf; color:black; padding:4px; height:26px; width:26px; border-radius:999px; border:0; display:grid; place-items:center; cursor:pointer;"
        onmouseover="this.style.background='#ffffff'"
        onmouseout="this.style.background='#cfcfcf'"
        onclick="window.openImageMenu(this)">
        <i class="fa-solid fa-ellipsis-vertical"></i>
