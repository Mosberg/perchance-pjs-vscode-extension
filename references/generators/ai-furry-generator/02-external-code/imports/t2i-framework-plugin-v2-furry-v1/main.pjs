  };

  return Object.freeze({
    isBatchBusy: publicBridge.isBatchBusy,
    openBlob: publicBridge.openBlob,
    upscaleBatch: publicBridge.upscaleBatch,
    upscaleBigger: publicBridge.upscaleBigger,
