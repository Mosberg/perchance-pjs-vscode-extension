    if(settings.underImagesMessage) {
      outputAreaEl.insertAdjacentHTML('beforeend', `<div style="margin-top:0.5rem;flex:0 0 100%">${settings.underImagesMessage}</div>`);
    }

    window.__syncT2iBatchActions?.();

    // Click Counting
    let generateClickCount = Number(localStorage.generateClickCount || 0);
    generateClickCount++;
    if(isNaN(generateClickCount) || typeof generateClickCount !== "number") generateClickCount = 1;
    localStorage.generateClickCount = generateClickCount;

    if(window.showSocialFeaturesButtonAfterThisManyClicks !== undefined && generateClickCount >= window.showSocialFeaturesButtonAfterThisManyClicks) {
      let socialButton = document.querySelector("#showSocialsButtonCtn9000274628");
      if(socialButton) socialButton.style.display = "";
    }

    // --- LEFT BOTTOM HEART: GUIDE & RULES ---
    // The guide iframe is created only after the explicit Guide & Rules button is clicked.
    // Closing removes the iframe and popup completely, returning to the notice underneath.
    window.t2i_closePostGuideRules = function() {
      const popup = document.getElementById("t2iPostGuideRulesPopup");
      if(!popup) return;

      const frame = popup.querySelector("iframe");
      if(frame) {
        try { frame.src = "about:blank"; } catch(e) {}
        frame.remove();
      }
      popup.remove();
    };

    window.t2i_openPostGuideRules = function() {
      window.t2i_closePostGuideRules();

      const popup = document.createElement("div");
      popup.id = "t2iPostGuideRulesPopup";
      popup.style.cssText = "inset:0;position:fixed;background:rgba(0,0,0,.7);z-index:999999;display:flex;justify-content:center;align-items:center;backdrop-filter:blur(2px);";

      const card = document.createElement("div");
      card.style.cssText = "display:flex;flex-direction:column;width:95vw;max-width:900px;height:95vh;background:var(--box-color,#222);border:1px solid var(--border-color);border-radius:12px;box-shadow:0 10px 50px rgba(0,0,0,.5);overflow:hidden;";

      const head = document.createElement("div");
      head.style.cssText = "display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border-color);background:var(--box-color,#222);flex-shrink:0;";
      head.innerHTML = `
        <div style="font-weight:bold;font-size:1.1rem;color:var(--text-color,white);display:flex;align-items:center;gap:.5rem;">
          <span class="material-symbols-outlined" style="font-size:1.2em;">menu_book</span>
          Guide & Rules
        </div>
        <button type="button" aria-label="Close Guide & Rules"
          style="font-size:1.4rem;background:transparent;border:none;cursor:pointer;opacity:.7;color:var(--text-color,white);padding:0 5px;line-height:1;">✕</button>
      `;

      const slot = document.createElement("div");
      slot.style.cssText = "flex:1;position:relative;background:var(--embedctn-bg-color);overflow:hidden;";

      const frame = document.createElement("iframe");
      frame.allow = "clipboard-read *; clipboard-write *; fullscreen";
      frame.src = "https://null.perchance.org/ai-furry-generator-guide";
      frame.style.cssText = "width:100%;height:100%;border:none;display:block;";
      slot.appendChild(frame);

      head.querySelector("button").onclick = window.t2i_closePostGuideRules;
      popup.onclick = e => {
        if(e.target === popup) window.t2i_closePostGuideRules();
      };

      card.appendChild(head);
      card.appendChild(slot);
      popup.appendChild(card);
      document.body.appendChild(popup);
    };

    window.t2i_showPostRulesNotice = function(btn) {
      let existing = document.getElementById("t2iPostRulesNotice");
      if(existing) existing.remove();

      let dim = document.createElement("div");
      dim.id = "t2iPostRulesNotice";
      dim.style.cssText = "inset:0; position:fixed; background:rgba(0,0,0,.5); z-index:9998; display:flex; align-items:center; justify-content:center;";

      let box = document.createElement("div");
      box.style.cssText = "background:var(--box-color); color:var(--text-color); border:1px solid var(--border-color); padding:14px 16px; border-radius:8px; min-width:240px; max-width:min(92vw,360px); box-shadow:0 8px 30px rgba(0,0,0,.35); text-align:center;";

      box.innerHTML = `
        <div style="font-weight:600;margin-bottom:8px;">Please read the Guide & Rules before posting</div>
        <div style="font-size:.78rem;line-height:1.45;opacity:.7;margin:0 0 11px;text-align:left;">
          Rule violations may downgrade access to <b>Legacy Mode</b>. Severe or repeated violations may lead to local data deletion.
        </div>
        <div style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap;">
          <button id="t2iPostRulesGuideBtn"
            style="background:transparent;color:var(--text-color);border:1px solid var(--border-color);border-radius:6px;padding:8px 14px;cursor:pointer;font-weight:600;">
            Guide & Rules
          </button>
          <button id="t2iPostRulesReadBtn"
            style="background:var(--special-color,#0a66c9);color:white;border:0;border-radius:6px;padding:8px 14px;cursor:pointer;font-weight:600;">
            I will read it
          </button>
        </div>
      `;

      dim.onclick = e => {
        if(e.target === dim) dim.remove();
      };

      box.querySelector("#t2iPostRulesGuideBtn").onclick = () => {
        window.t2i_openPostGuideRules();
      };

      box.querySelector("#t2iPostRulesReadBtn").onclick = () => {
        localStorage.t2iPostRulesRead = "1";
        document.querySelectorAll(".t2i-post-rules-btn").forEach(el => el.remove());
        dim.remove();
      };

      dim.appendChild(box);
      document.body.appendChild(dim);
    };

    // --- UPDATED MENU FUNCTIONS ---
    window.openImageMenu = function(btn) {
      window._currentImageCtn = btn.closest('.t2i-image-ctn');
      const isPinned = window._currentImageCtn.classList.contains('t2i-pinned');

      window.closeImageMenu();

      let dim = document.createElement("div");
      dim.id = "dimLayer";
      dim.style.cssText = "inset:0; position: fixed; background:transparent; z-index:9998;";
      dim.onclick = window.closeImageMenu;

      let menu = document.createElement("div");
      menu.id = "imageMenu";
      menu.style.cssText = "top:0; left:0; position: fixed; visibility:hidden; background:var(--floatingpanel-button-color); padding:14px 16px; border-radius:8px; z-index:9999; min-width:220px; max-width:calc(100vw - 16px); max-height:calc(100vh - 24px); overflow-y:auto; box-sizing:border-box; text-align:left; font-family:sans-serif; box-shadow:0 10px 30px rgba(0,0,0,0.25);";

      // MENU HTML: Added "Use Seed" Button
      menu.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:6px;font-size:0.9rem;min-width:200px;">
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuBatchZoom()"><i class="fa-solid fa-magnifying-glass-plus fa-fw"></i><span style="flex:1;">zoom image</span></button>

          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionPin()">
          ${isPinned ? '<i class="fa-solid fa-thumbtack-slash fa-fw"></i><span style="flex:1;">unpin image</span>' : '<i class="fa-solid fa-thumbtack fa-fw"></i><span style="flex:1;">pin image</span>'}
          </button>


          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionSendSeed()">
            <i class="fa-solid fa-dice fa-fw"></i>
            <span style="flex:1;">apply seed</span>
          </button>

          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionSave(this)"><i class="fa-solid fa-notes-medical fa-fw"></i><span style="flex:1;">save to concept board</span></button>
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionDownload()"><i class="fa-solid fa-floppy-disk fa-fw"></i><span style="flex:1;">save to your device</span></button>
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionStudio()"><i class="fa-solid fa-pen-ruler fa-fw"></i><span style="flex:1;">image studio</span></button>
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionLink(this)"><i class="fa-solid fa-link fa-fw"></i><span style="flex:1;">copy image link</span></button>
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.menuActionPersonalmodal()"><i class="fa-solid fa-comments fa-fw"></i><span style="flex:1;">AI character chat</span></button>
          <button style="display:flex;justify-content:flex-start;align-items:center;gap:0.5em;padding:6px 10px;border:none;border-radius:6px;background:var(--floatingpanel-bg-color);color:var(--text-color);cursor:pointer;text-align:left;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'" onclick="window.closeImageMenu()"><i class="fa-solid fa-xmark fa-fw"></i><span style="flex:1;">close</span></button>
        </div>
      `;

      document.body.appendChild(dim);
      document.body.appendChild(menu);

      let positionFrame = 0;

      const positionMenu = () => {
        positionFrame = 0;

        if(!btn.isConnected || !menu.isConnected) {
          window.closeImageMenu();
          return;
        }

        const anchorRect = btn.getBoundingClientRect();
        const menuRect = menu.getBoundingClientRect();
        const viewportWidth = document.documentElement.clientWidth;
        const viewportHeight = document.documentElement.clientHeight;
        const edgeGap = 8;
        const buttonGap = 6;

        let left = anchorRect.right - menuRect.width;
        left = Math.min(
          Math.max(left, edgeGap),
          Math.max(edgeGap, viewportWidth - menuRect.width - edgeGap)
        );

        let top = anchorRect.bottom + buttonGap;
        if(top + menuRect.height > viewportHeight - edgeGap) {
          const topAbove = anchorRect.top - buttonGap - menuRect.height;
          top = topAbove >= edgeGap
            ? topAbove
            : Math.max(edgeGap, viewportHeight - menuRect.height - edgeGap);
        }

        menu.style.left = `${Math.round(left)}px`;
        menu.style.top = `${Math.round(top)}px`;
        menu.style.visibility = "visible";
      };

      const schedulePosition = () => {
        if(positionFrame) return;
        positionFrame = requestAnimationFrame(positionMenu);
      };

      window.addEventListener("scroll", schedulePosition, { passive:true, capture:true });
      window.addEventListener("resize", schedulePosition, { passive:true });

      window._imageMenuPositionCleanup = () => {
        window.removeEventListener("scroll", schedulePosition, true);
        window.removeEventListener("resize", schedulePosition);
        if(positionFrame) cancelAnimationFrame(positionFrame);
        positionFrame = 0;
      };

      positionMenu();
    };

    window.closeImageMenu = function() {
      if(window._imageMenuPositionCleanup) {
        window._imageMenuPositionCleanup();
        delete window._imageMenuPositionCleanup;
      }

      let dim = document.getElementById("dimLayer");
      let menu = document.getElementById("imageMenu");
      let lb  = document.getElementById("imageLightbox");
      if(menu) menu.remove();
      if(lb) lb.remove();
      if(dim) dim.remove();
      if('prevOverflow' in document.body.dataset) { document.body.style.overflow = document.body.dataset.prevOverflow; delete document.body.dataset.prevOverflow; }
    };

    window.menuActionPin = function() {
      if(window._currentImageCtn) window._currentImageCtn.classList.toggle('t2i-pinned');
      window.__syncT2iBatchActions?.();
      window.closeImageMenu();
    };

    window.menuActionUnpinAll = function() {
      document.querySelectorAll('#outputAreaEl > .t2i-image-ctn.t2i-pinned').forEach(el => {
        el.classList.remove('t2i-pinned');
      });
      window.__syncT2iBatchActions?.();
      window.closeImageMenu();
    };

    // ** NEW: Send Seed Function **
    window.menuActionSendSeed = function() {
      if(!window._currentImageCtn) return;

      // 1. Get Seed
      const iframe = window._currentImageCtn.querySelector("iframe");
      const seed = iframe?.textToImagePluginOutput?.inputs?.seed;

      if (!seed) {
        window.aifgAlert("Could not extract seed.");
        return window.closeImageMenu();
      }

      // 2. Find Prompt Input (Description or first textarea)
      // Checks data-name="description" OR "prompt" OR first textarea
      let inputEl = document.querySelector('textarea[data-name="description"]')
        || document.querySelector('textarea[data-name="prompt"]')
        || document.querySelector('textarea.paragraph-input');

      if(inputEl) {
        // 3. Append to end
        // Add space if there is text and it doesn't end with whitespace
        let text = inputEl.value;
        if(text.length > 0 && !/\s$/.test(text)) text += " ";

        inputEl.value = text + `(seed:::${seed})`;

        // 4. Trigger input event (updates undo stack / auto-save)
        inputEl.dispatchEvent(new Event("input"));

        // Optional visual feedback?
      } else {
        window.aifgAlert("Prompt input box not found.");
      }
      window.closeImageMenu();
    };

    // ============================================================================
    //  MODERN CHARACTER CREATION MODAL
    // ============================================================================
    window.menuActionPersonalmodal = function() {
      if (!window._currentImageCtn) return;

      const imageCtn = window._currentImageCtn;
      window.closeImageMenu();

      const iframe = imageCtn.querySelector("iframe");
      const out = iframe && iframe.textToImagePluginOutput;
      if (!out) return window.aifgAlert("Please wait for image.");

      const imgSrc = out.dataUrl;
      const imagePrompt = out.inputs.prompt;
      const imageSeed = out.inputs?.seed ?? "";
      const draftStoreKey = "t2i_character_profile_drafts_v1";
      const draftFingerprint = [
        imagePrompt,
        imageSeed,
        String(imgSrc).slice(0, 256),
        String(imgSrc).slice(-256)
      ].join("\n");
      const draftId = ___sha256HexSync746291937(draftFingerprint).slice(0, 32);
      const draftMaxAge = 30 * 24 * 60 * 60 * 1000;
      const draftMaxCount = 30;

      const readDraftStore = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(draftStoreKey) || "{}");
          return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
        } catch (error) {
          return {};
        }
      };

      const loadDraft = () => {
        const memoryDraft = imageCtn.__t2iCharacterProfileDraft;
        if (memoryDraft?.draftId === draftId && memoryDraft.data) return memoryDraft.data;

        const storedDraft = readDraftStore()[draftId];
        if (!storedDraft || typeof storedDraft !== "object") return null;
        if (Date.now() - Number(storedDraft.updatedAt || 0) > draftMaxAge) return null;

        imageCtn.__t2iCharacterProfileDraft = { draftId, data: storedDraft };
        return storedDraft;
      };

      // --- 1. DOM Structure ---
      const overlay = document.createElement("div");
      overlay.style.cssText = `inset:0;z-index:99999;position:fixed;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s ease;will-change:opacity;font-family:sans-serif;`;

      const modal = document.createElement("div");
      modal.style.cssText = `width:90%;max-width:900px;height:85vh;max-height:700px;background:var(--box-color,#1a1a1a);border:1px solid var(--border-color,#333);border-radius:12px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);display:flex;overflow:hidden;transform:scale(0.98);transition:transform 0.2s cubic-bezier(0.2,0.8,0.2,1);color:var(--text-color,#fff);`;

      // --- 2. CSS ---
      const style = document.createElement("style");
      style.innerHTML = `
        .opt-scroll::-webkit-scrollbar { width: 6px; }
        .opt-scroll::-webkit-scrollbar-thumb { background: rgba(125,125,125,0.3); border-radius: 99px; }
        .opt-scroll::-webkit-scrollbar-track { background: transparent; }

        .opt-btn:hover { opacity: 0.9; transform: translateY(-1px); }
        .opt-btn:active { transform: scale(0.98); }

        .opt-label { display:block; font-size:0.75rem; font-weight:700; margin-bottom:6px; opacity:0.8; text-transform:uppercase; letter-spacing:0.5px; }

        .opt-input { width:100%; padding:10px; border-radius:6px; border:1px solid var(--border-color,#444); background:rgba(0,0,0,0.2); color:inherit; font-size:0.9rem; font-family:inherit; outline:none; resize:none; transition:border-color 0.2s; box-sizing:border-box; }
        .opt-input:focus { border-color:rgba(255,255,255,0.5); background:rgba(0,0,0,0.3); }
      `;
      modal.appendChild(style);

      // --- 3. HTML Layout ---
      modal.innerHTML += `
        <div style="flex:1;background:#000;position:relative;min-width:300px;display:none;@media(min-width:750px){display:block;}">
          <img src="${imgSrc}" style="width:100%;height:100%;object-fit:cover;opacity:0.9;display:block;">
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 40%);"></div>
        </div>

        <div class="opt-scroll" style="flex:1.3;display:flex;flex-direction:column;padding:20px;overflow-y:auto;gap:8px;min-width:320px;">
          <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px solid var(--border-color,rgba(255,255,255,0.1));">
            <div style="display:flex;align-items:center;gap:10px;">
              <img src="${imgSrc}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
              <h2 style="margin:0;font-size:1.1rem;font-weight:700;">Profile Details</h2>
            </div>
            <button id="closeBtn" class="opt-btn" type="button" aria-label="Close and save draft" title="Close and save draft" style="background:none;border:none;font-size:1.5rem;cursor:pointer;color:inherit;line-height:1;padding:0 5px;">✕</button>
          </div>

          <div>
            <label class="opt-label" for="customInstruct">Instructions</label>
            <textarea id="customInstruct" class="opt-input" style="min-height:60px;" placeholder="Optional: specify name, personality, backstory... (e.g. 'Name her Sarah, she is a shy cyborg')"></textarea>
          </div>

          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:32px;">
            <div id="draftStatus" role="status" aria-live="polite" style="min-width:0;flex:1;font-size:0.72rem;line-height:1.3;opacity:0.62;"></div>
            <button id="magicBtn" class="opt-btn" type="button" style="font-size:0.8rem;padding:8px 16px;border-radius:4px;border:none;background:var(--special-color,#0a66c9);color:white;cursor:pointer;display:flex;align-items:center;gap:6px;transition:0.1s;flex:0 0 auto;">
              <span style="font-weight:600;">Generate</span> <i class="fa-solid fa-wand-magic-sparkles"></i>
            </button>
          </div>

          <div>
            <label class="opt-label" for="charName">Name</label>
            <input id="charName" type="text" class="opt-input" placeholder="Generated name (You can edit this later)">
          </div>

          <div style="flex:1;display:flex;flex-direction:column;">
            <label class="opt-label" for="charDesc">Description</label>
            <textarea id="charDesc" class="opt-input" style="flex:1;min-height:120px;line-height:1.5;" placeholder="Generated description (You can edit this later)"></textarea>
          </div>

          <button id="startBtn" class="opt-btn" type="button" style="width:100%;padding:12px;border-radius:6px;border:none;background:var(--special-color,#0a66c9);color:white;cursor:pointer;font-weight:600;font-size:1rem;display:flex;align-items:center;justify-content:center;gap:8px;">
            <i class="fa-solid fa-comments"></i> Start AI Chat
          </button>
        </div>
      `;

      // --- 4. Logic ---
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      overlay.getBoundingClientRect();
      overlay.style.opacity = "1";
      modal.style.transform = "scale(1)";

      const nameInput = modal.querySelector("#charName");
      const descInput = modal.querySelector("#charDesc");
      const instructInput = modal.querySelector("#customInstruct");
      const magicBtn = modal.querySelector("#magicBtn");
      const startBtn = modal.querySelector("#startBtn");
      const draftStatus = modal.querySelector("#draftStatus");

      let isClosed = false;
      let draftSaveTimer = 0;
      let currentDraftState = "draft";
      let generateObj = null;
      let smoothCharModalWriter = null;
      let generationRunId = 0;
      let charState = { v: "", p: "", r: "", active: 0 };
      let latestCharName = "";
      let latestKeepAtBottom = true;
      let lastStreamDraftSaveAt = 0;

      const setDraftStatus = (text, kind = "") => {
        draftStatus.textContent = text;
        draftStatus.style.color = kind === "error"
          ? "var(--alert-color,#ef5350)"
          : kind === "success"
            ? "light-dark(#137333,#81c995)"
            : "";
        draftStatus.style.opacity = text ? "0.78" : "0.62";
      };

      const saveDraft = (stateName = currentDraftState) => {
        currentDraftState = stateName;

        const draft = {
          version: 1,
          updatedAt: Date.now(),
          state: currentDraftState,
          instruction: instructInput.value,
          name: nameInput.value,
          description: descInput.value
        };

        imageCtn.__t2iCharacterProfileDraft = { draftId, data: draft };

        try {
          const now = Date.now();
          const store = readDraftStore();

          Object.keys(store).forEach(key => {
            const updatedAt = Number(store[key]?.updatedAt || 0);
            if (!updatedAt || now - updatedAt > draftMaxAge) delete store[key];
          });

          store[draftId] = draft;

          const retainedEntries = Object.entries(store)
            .sort((a, b) => Number(b[1]?.updatedAt || 0) - Number(a[1]?.updatedAt || 0))
            .slice(0, draftMaxCount);

          localStorage.setItem(draftStoreKey, JSON.stringify(Object.fromEntries(retainedEntries)));
        } catch (error) {
          console.warn("Could not persist character profile draft.", error);
        }

        return draft;
      };

      const scheduleDraftSave = () => {
        currentDraftState = "draft";
        clearTimeout(draftSaveTimer);
        draftSaveTimer = setTimeout(() => {
          draftSaveTimer = 0;
          saveDraft("draft");
        }, 250);
      };

      const saveStreamingDraft = () => {
        const now = Date.now();
        if (now - lastStreamDraftSaveAt < 1000) return;
        lastStreamDraftSaveAt = now;
        saveDraft("draft");
      };

      const restoredDraft = loadDraft();
      if (restoredDraft) {
        instructInput.value = String(restoredDraft.instruction || "");
        nameInput.value = String(restoredDraft.name || "");
        descInput.value = String(restoredDraft.description || "");
        currentDraftState = String(restoredDraft.state || "draft");
        setDraftStatus(
          currentDraftState === "stopped"
            ? "Draft restored. Partial result kept."
            : "Draft restored.",
          "success"
        );
      }

      [instructInput, nameInput, descInput].forEach(input => {
        input.addEventListener("input", scheduleDraftSave);
      });

      const buildCharDescription = () => {
        const parts = [];

        if (charState.v || charState.active === 0) {
          parts.push(`# {{char}} Visual Description:\n${charState.v}`);
        }

        if (charState.p || charState.active === 1) {
          parts.push(`# {{char}} Personality:\n${charState.p}`);
        }

        if (charState.r || charState.active === 2) {
          parts.push(`# {{char}} Roleplay Behavior Examples:\n${charState.r}`);
        }

        return parts.join("\n\n");
      };

      const setGeneratingUi = (isGenerating) => {
        magicBtn.classList.toggle("gen", isGenerating);
        magicBtn.style.background = isGenerating
          ? "var(--alert-color,#c62828)"
          : "var(--special-color,#0a66c9)";
        magicBtn.innerHTML = isGenerating
          ? '<i class="fa-solid fa-stop"></i> Stop'
          : '<span style="font-weight:600;">Generate</span> <i class="fa-solid fa-wand-magic-sparkles"></i>';
      };

      const flushGenerationOutput = () => {
