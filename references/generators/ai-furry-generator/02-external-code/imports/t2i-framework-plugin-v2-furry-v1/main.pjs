        style="position:relative; top:-58px; left:4px; background:white; padding:4px; height:24px; width:24px; border-radius:999px; border:0; display:grid; align-content:center; opacity:0; pointer-events:none;"
        aria-hidden="true"
        onclick="window.t2i_openCharacterDescriptionEditor(this.closest('.t2i-image-ctn'))">
        <i class="fa-solid fa-comment"></i>
      </button>
    `);

    underEachImageParts.push(window.t2i_getPromptBadges746291937());

    underEachImageParts.push(`[(()=>{
      let selectedStyleName = "";
      try {
        selectedStyleName = String(window.input?.artStyle?.getName || "").trim();
      } catch(e) {}

      if(!selectedStyleName.startsWith("Random")) return "";

      let n = String(typeof RnGN === "undefined" ? "" : RnGN).trim();
      if(!n) return "";

      n = n.split("&").join("&amp;").split("<").join("&lt;").split(">").join("&gt;").split('"').join("&quot;");

      return '<div class="t2i-random-style-label" onclick="event.stopPropagation();this.remove()" title="' + n + '" style="position:absolute;left:50%;top:0.42rem;transform:translateX(-50%);z-index:4;display:block;width:max-content;max-width:52%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;color:rgba(255,255,255,0.74);font:400 0.58rem/1.18 Inter,system-ui,-apple-system,sans-serif;letter-spacing:0.005em;text-align:center;user-select:none;-webkit-tap-highlight-color:transparent;filter:drop-shadow(0 1px 1px rgba(0,0,0,0.82)) drop-shadow(0 0 5px rgba(0,0,0,0.46));">'+n+'</div>';
    })()]`);

    underEachImageParts.push(`
      <button class="t2i-post-rules-btn"
        title="Please read the Guide & Rules before posting"
        style="position:absolute; left:0.25rem; bottom:0.25rem; background:#cfcfcf; color:black; width:24px; height:24px; padding:0; border-radius:999px; border:0; display:${localStorage.t2iPostRulesRead === "1" ? "none" : "grid"}; place-items:center; cursor:pointer;"
        onmouseover="this.style.background='#ffffff'"
        onmouseout="this.style.background='#cfcfcf'"
        onclick="window.t2i_showPostRulesNotice(this)">
        <i class="fa-solid fa-heart fa-lg"></i>
      </button>
    `);

    let underEachImageHtml = `<div>${underEachImageParts.join("")}</div>`;

    // Runtime color scheme is applied to each cloned imageOptions object by
    // ___getImageOptions746291937(), so canonical settings stay untouched.

    // --- SMART PRESERVATION LOGIC (PINNING) ---
    Array.from(outputAreaEl.children).forEach(child => {
      if (child.classList.contains('t2i-image-ctn')) {
        if (!child.classList.contains('t2i-pinned')) {
          child.remove();
        }
      } else {
        child.remove();
      }
    });

    // === NEW: INVISIBLE PROMPT MODIFICATION ===
    let promptName = window.input.description !== undefined ? "description" : (window.input.prompt !== undefined ? "prompt" : null);
    let originalPromptValue = promptName ? window.input[promptName] : null;

    if(promptName) {
      let guidanceVal = parseInt(localStorage.getItem('t2i_guidance_scale')) || 7;
      let valStr = originalPromptValue;

      // Handle cases where the variable is still a raw object
      if(originalPromptValue && typeof originalPromptValue === 'object' && originalPromptValue.evaluateItem) {
        valStr = originalPromptValue.evaluateItem;
      }

      // Inject syntax at the end ONLY if guidance is not 7
      if (guidanceVal !== 7) {
        let baseText = valStr || "";
        // Appends to the end, adding a space first if there's already text
        window.input[promptName] = baseText + (baseText ? " " : "") + `(guidanceScale:::${guidanceVal})`;
      } else {
        window.input[promptName] = valStr || "";
      }
    }
    // ==========================================

    let newBatchHtml = "";

    try {
      const batchParts = [];

      for (let i = 0; i < numImages; i++) {
        const imageOptions = window.___getImageOptions746291937();

        // Resolve this image's own {A|B|C} branch first.
        const evaluatedPrompt = String(
          imageOptions.prompt?.evaluateItem ?? imageOptions.prompt ?? ""
        );

        const usesPromptWidth = /\(width:::[^)]+\)/i.test(evaluatedPrompt);

        // Only branches lacking (width:::) receive the slider fallback.
        imageOptions.prompt = evaluatedPrompt;

        const pluginOutput =
