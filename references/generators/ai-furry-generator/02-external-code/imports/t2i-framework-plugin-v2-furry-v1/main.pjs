              </div>
              ${item.random ? `<div class="random-input-btn-ctn" data-input-name="${item.getName}" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem;"><button class="tab-scratchpad-btn" title="Tabbed Scratchpad" onclick="window.openTabbedScratchpad()" style="position: relative; width: 1.75rem; height: 1.75rem; padding: 0; display: flex; align-items: center; justify-content: center;"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" style="transform: scaleX(1.25) scaleY(1.0);"> <rect width="16" height="16" fill="none"/> <path fill="currentColor" stroke="currentColor" stroke-width="0.2" d="M5 1a.5.5 0 0 1 .5.5V2h2v-.5a.5.5 0 0 1 1 0V2h2v-.5a.5.5 0 0 1 1 0V2A1.5 1.5 0 0 1 13 3.5v2.536a2.55 2.55 0 0 0-1 .406V3.5a.5.5 0 0 0-.5-.5h-7a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h1.547v.002a1.6 1.6 0 0 0 .068.998H4.5A1.5 1.5 0 0 1 3 13.5v-10A1.5 1.5 0 0 1 4.5 2v-.5A.5.5 0 0 1 5 1m5 7c.107 0 .206.034.288.091L9.378 9H6a.5.5 0 0 1 0-1zm-3.004 3.435A.5.5 0 0 0 6.5 11H6a.5.5 0 0 0 0 1h.5a.5.5 0 0 0 .157-.025q.146-.284.339-.54M6 5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1zm6.338 2.455a1.56 1.56 0 0 1 2.207 2.207l-4.289 4.288a2.8 2.8 0 0 1-1.29.731l-1.211.303a.61.61 0 0 1-.74-.74l.304-1.21c.122-.489.374-.935.73-1.29z"/> </svg></button><button class="random-input-btn" title="Insert" style="position: relative; width: 1.75rem; height: 1.75rem; padding: 0; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-arrow-turn-down" style="transform: rotate(90deg); font-size: 0.8rem;"></i></button><button class="undo-input-btn" title="Undo" style="position: relative; width: 1.75rem; height: 1.75rem; padding: 0; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-clock-rotate-left" style="font-size: 0.8rem;"></i></button><button class="ai-suggest-btn" title="AI Prompt Enhancer" style="position: relative; width: 1.75rem; height: 1.75rem; padding: 0; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-wand-magic-sparkles" style="font-size: 0.8rem;"></i></button><button class="i2t-modal-btn" title="Image to Text" style="position: relative; width: 1.75rem; height: 1.75rem; padding: 0; display: flex; align-items: center; justify-content: center;" onclick="window.openI2tModal(this.closest('.input-ctn').querySelector('input, textarea'))"><span class="material-symbols-outlined" style="font-size: 1.12rem;">add_photo_alternate</span></button></div>` : ""}
            </div>
