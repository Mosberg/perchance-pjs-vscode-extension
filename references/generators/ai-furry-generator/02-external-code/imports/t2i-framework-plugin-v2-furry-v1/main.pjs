  window.___generateButtonClickEvent746291937 = async function(event) {

    if((!event || !event.__yeetChecked) && typeof window.YEET_beforeGenerate746291937 === "function") {
      return window.YEET_beforeGenerate746291937(event, () => {
        const nextEvent = event || {};
        nextEvent.__yeetChecked = true;
        return window.___generateButtonClickEvent746291937(nextEvent);
      });
    }

    clearPerchanceErrors(); // in case they has errors in their syntax in their last attempt, we don't want to keep showing the error bubble forever

    if(window.__isFocusedSharePrompt746291937?.()) {
      shareSettingsBtn758374.style.display = "";
      shareLinkCtn83927376.style.display = "none";
      window.__setFocusedSharePromptState746291937?.("idle");
    } else {
      shareSettingsBtn758374.style.display = "";
      shareLinkCtn83927376.style.display = "none";
      window.__restoreClassicSharePromptButton746291937?.();
    }

    generateButtonEl.textContent = "Generate";
    generateButtonEl.disabled = true;
    generateButtonEl.style.opacity = 0.7;
    setTimeout(() => {
      generateButtonEl.textContent = "Generate";
      generateButtonEl.disabled = false;
      generateButtonEl.style.opacity = 1;
    }, 3000);

    // Official v2 framework compatibility: allow importing generators to do
    // awaited pre-generation work without replacing furry-specific YEET logic.
    if(typeof settings.beforeGenerate === "function") {
      await settings.beforeGenerate();
    }

    let numImages = 6;
    if(!isNaN(Number(settings.numImages?.evaluateItem))) numImages = Number(settings.numImages?.evaluateItem);
    if(isNaN(numImages)) numImages = 6;

    // Snapshot the visible prompt/settings before guidance injection and before
    // each image resolves its own random branch.
    const promptHistorySnapshot = localStorage.getItem("pl_autoSavePromptHistory") === "true"
      ? window.t2i_capturePromptHistorySnapshot?.(numImages)
      : null;

    // LOGIC:
    // 1. Output Area scales based on batch size
    // 2. Uses min(800px, 100vw) so it doesn't break mobile screens
    // 3. Enforces flex-wrap so images drop to next line on narrow screens

    // --- Layout Logic ---
    if(numImages >= 16) {
      outputAreaEl.style.width = "100vw";
      outputAreaEl.style.maxWidth = "100%";
      outputAreaEl.style.minWidth = "0px";
    } else {
      outputAreaEl.style.width = "80vw";
      outputAreaEl.style.minWidth = "min(800px, 100vw)";
      outputAreaEl.style.maxWidth = "100%";
    }

    outputAreaEl.style.marginLeft = "auto";
    outputAreaEl.style.marginRight = "auto";
    outputAreaEl.style.display = "flex";
    outputAreaEl.style.flexWrap = "wrap";
    outputAreaEl.style.justifyContent = "center";

    if(!window.___userSettings746291937.imageButtons) window.___userSettings746291937.imageButtons = {};
    window.___userSettings746291937.imageButtons.personalImage = true;

    window.t2i_getPromptBadges746291937 = function() {
      const read = (v) => {
        if(v == null) return "";
        if(typeof v === "string") return v;
        if(typeof v === "number" || typeof v === "boolean") return String(v);
        try { return String(v.value ?? v.evaluateItem ?? ""); } catch(e) { return ""; }
      };

      const promptText = read(window.input?.description ?? window.input?.prompt);
      const tagText = (name) => read(window.input?.tags?.[name]);
      const has = (text, token, emoji) => text.includes(token) || text.includes(emoji);

      const iconStyle = `font-size:1.08em;line-height:1.18;vertical-align:-0.16em;font-weight:300;`;
      const nsfwIconStyle = `font-size:1.05em;line-height:1.18;vertical-align:-0.16em;font-weight:300;`;
      const itemStyle = `display:inline-flex;align-items:center;justify-content:flex-end;gap:0.24em;width:max-content;color:rgba(255,255,255,0.74);font-weight:400;line-height:1.22;`;

      const badges = [];
      if(has(promptText + tagText("SFW"), "U1F51E")) {
        badges.push(`<span style="${itemStyle}"><span class="material-symbols-outlined" style="${nsfwIconStyle}">explicit</span>NSFW</span>`);
      }
      if(has(promptText + tagText("Comments"), "U1F507")) {
        badges.push(`<span style="${itemStyle}"><span class="material-symbols-outlined" style="${iconStyle}">chat_bubble_off</span>Comment</span>`);
      }
      if(has(promptText + tagText("Private"), "U1F512")) {
