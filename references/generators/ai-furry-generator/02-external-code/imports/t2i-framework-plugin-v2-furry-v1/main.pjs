  // 1. Helper to update the Magic Object & State
  window.___updateChipState = function(container) {
    let hiddenInput = container.querySelector(".chip-hidden-input");
    let inputName = hiddenInput.dataset.name;
    let parts = [];
    let state = {};

    // Create the "Magic Object"
    let magicObj = {
      toString: function() { return this._joined; },
      _joined: ""
    };

    container.querySelectorAll(".t2iChip").forEach(chip => {
      let cName = chip.dataset.chipName;
      let isOn = chip.classList.contains("on");

      // Save State for checkbox logic
      state[cName] = isOn;

      // Determine Text Value (On vs Off)
      let txt = isOn ? chip.dataset.onVal : chip.dataset.offVal;

      // Assign to object key -> allows [input.tags.Furry]
      magicObj[cName] = txt;

      if (txt) parts.push(txt);
    });
    magicObj._joined = parts.join(", ");

    // Update Global Variable with the Object
    if (!window.input) window.input = {};
    window.input[inputName] = magicObj;

    // Update Hidden Input (visual/debug only)
    hiddenInput.value = magicObj._joined;

    // Save Click State (Persist checkboxes)
    localStorage.setItem("t2i_chip_state_" + inputName, JSON.stringify(state));
  };

  // 2. Click Handler
  window.___chipClickEvent = function(el) {
    el.classList.toggle("on");
    window.___updateChipState(el.closest(".input-ctn"));
  };
