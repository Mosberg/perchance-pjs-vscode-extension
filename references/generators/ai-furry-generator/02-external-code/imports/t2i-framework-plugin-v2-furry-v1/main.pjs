  window.___setGuidanceLock = function(locked, save = true) {
    const isMobile = window.innerWidth <= 700;

    if (save) {
      localStorage.setItem('t2i_guidance_locked', locked ? '1' : '0');
    }

    let lockBtn = document.getElementById('guidanceLockBtn');
    let slider = document.getElementById('guidanceSlider');
    let minusBtn = document.getElementById('guidanceMinusBtn');
    let plusBtn = document.getElementById('guidancePlusBtn');
    let ctn = document.getElementById('guidanceScaleCtn');

    if(!slider || !minusBtn || !plusBtn || !ctn) return;

    if (!isMobile) {
      slider.disabled = false;
      minusBtn.disabled = false;
      plusBtn.disabled = false;

      ctn.style.opacity = '0.7';
      slider.style.cursor = 'pointer';
      minusBtn.style.cursor = 'pointer';
      plusBtn.style.cursor = 'pointer';
      return;
    }

    if (locked) {
      if (lockBtn) {
        lockBtn.innerHTML = '<i class="fa-solid fa-lock"></i>';
        lockBtn.style.opacity = '1';
      }

      slider.disabled = true;
      minusBtn.disabled = true;
      plusBtn.disabled = true;

      ctn.style.opacity = '0.35';
      slider.style.cursor = 'not-allowed';
      minusBtn.style.cursor = 'not-allowed';
      plusBtn.style.cursor = 'not-allowed';
    } else {
      if (lockBtn) {
