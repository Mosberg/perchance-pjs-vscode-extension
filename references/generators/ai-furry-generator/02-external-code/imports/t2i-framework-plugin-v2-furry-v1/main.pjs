  // Hackily trigger the page load handler with an <img> onerror because it's an easy way to execute a script right after the HTML has been rendered.
  let dummyImageScriptTrigger = `<img style="display:fixed;opacity:0;pointer-events:none;top:-2000px;" src="" onerror="window.___pageLoadHandler746291937(); this.remove();">`;


  window.generateCommentsPluginElement85638294 = function() {
    let defaultChannelOptions = window.___userSettings746291937.defaultCommentOptions;
    // Geometry is owned by the host page. The tabbed plugin only fills whatever
    // size #commentsPluginCtn654732 is given, so layout can be changed with CSS.

    let channels = window.___userSettings746291937.commentChannels;
    const moreButtonIconHtml = '<i class="fa-solid fa-ellipsis" aria-hidden="true"></i>';
    const searchIconHtml = '<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>';
    return tabbedCommentsPlugin({channels, defaultChannelOptions, fillHeight:true, moreButtonIconHtml, searchIconHtml});
  }

  window.__getGalleryLoaderHost = function() {
    return document.getElementById('imageGalleryLoaderHost8569284') ||
      document.getElementById('imageGalleryCtn8569284');
  };

  window.__getGalleryLoaderHostForIframe = function(iframe) {
    const mainContent = document.getElementById('imageGalleryCtn8569284');
    if (mainContent?.contains(iframe)) {
      return window.__getGalleryLoaderHost();
    }
    return iframe?.parentElement || null;
  };

  window.__attachGalleryLoader = function(label = 'Loading Gallery…') {
    const host = window.__getGalleryLoaderHost();
    if (!host) return null;
    return window.aifgAttachFirstIframeLoader?.(host, label) || null;
  };

  window.__galleryCurrentZoom = parseFloat(localStorage.galleryZoomValue || "1.0");
  window.__galleryZoomSliderTimeout = null;

  window.__galleryUpdateZoomAll = function() {
    const zoomPercent = Math.round(window.__galleryCurrentZoom * 100);
    const zoomLvl = document.getElementById('galleryZoomLevelEl');
    const sliderLbl = document.getElementById('galleryZoomSliderLabel');
    const slider = document.getElementById('galleryZoomSlider');
    const content = document.getElementById('imageGalleryCtn8569284'); // The container holding the iframes

    if(zoomLvl) zoomLvl.textContent = zoomPercent + '%';
    if(sliderLbl) sliderLbl.textContent = zoomPercent + '%';
    if(slider) {
      slider.value = zoomPercent;
      let percentage = ((zoomPercent - 20) / 180) * 100;
      slider.style.background = `linear-gradient(to right, var(--text-color) ${percentage}%, var(--border-color) ${percentage}%)`;
    }

    if(content) {
      content.style.zoom = window.__galleryCurrentZoom;
      content.style.width = '100%';
      content.style.transform = 'none';
    }
  };

  window.__gallerySaveZoom = function() { localStorage.galleryZoomValue = window.__galleryCurrentZoom; };

  window.__galleryShowSlider = function() {
    const grp = document.getElementById('galleryZoomBtnGroup');
    const wrap = document.getElementById('galleryZoomSliderWrap');
    if(grp) grp.style.display = "none";
    if(wrap) wrap.style.display = "flex";
    clearTimeout(window.__galleryZoomSliderTimeout);
    window.__galleryZoomSliderTimeout = setTimeout(window.__galleryHideSlider, 2000);
  };

  window.__galleryHideSlider = function() {
    const wrap = document.getElementById('galleryZoomSliderWrap');
    const grp = document.getElementById('galleryZoomBtnGroup');
    if(wrap) wrap.style.display = "none";
    if(grp) grp.style.display = "flex";
  };

  window.__galleryZoomIn = function() {
    if (window.__galleryCurrentZoom < 2.0) {
      window.__galleryCurrentZoom = Math.min(2.0, window.__galleryCurrentZoom + 0.05);
      window.__galleryCurrentZoom = Math.round(window.__galleryCurrentZoom * 20) / 20;
      window.__galleryUpdateZoomAll();
      window.__gallerySaveZoom();
    }
  };

  window.__galleryZoomOut = function() {
    if (window.__galleryCurrentZoom > 0.2) {
      window.__galleryCurrentZoom = Math.max(0.2, window.__galleryCurrentZoom - 0.05);
      window.__galleryCurrentZoom = Math.round(window.__galleryCurrentZoom * 20) / 20;
      window.__galleryUpdateZoomAll();
      window.__gallerySaveZoom();
    }
  };

  window.__gallerySliderInput = function() {
    clearTimeout(window.__galleryZoomSliderTimeout);
    window.__galleryZoomSliderTimeout = setTimeout(window.__galleryHideSlider, 3000);
    const slider = document.getElementById('galleryZoomSlider');
    if(slider) {
      window.__galleryCurrentZoom = parseInt(slider.value) / 100;
      window.__galleryUpdateZoomAll();
    }
  };

  window.__toggleGalleryPanel = function() {
    const container = document.getElementById('galleryBodyContainer');
    const arrow = document.getElementById('galleryArrow');
    const line = document.getElementById('galleryBottomLine');
    if(!container) return;
    const isClosed = container.style.display === 'none';

    if (isClosed) {
      container.style.display = 'block';
      if(line) line.style.display = 'block';
      if(arrow) arrow.style.transform = 'rotate(0deg)';
      localStorage.setItem('galleryCollapsed', 'false');
      window.__socialPanelMemory.open('gallery', window.__mountGalleryPanel);
      setTimeout(window.__galleryUpdateZoomAll, 50);
    } else {
      container.style.display = 'none';
      if(line) line.style.display = 'none';
      if(arrow) arrow.style.transform = 'rotate(-90deg)';
      localStorage.setItem('galleryCollapsed', 'true');
      window.__socialPanelMemory.close('gallery', window.__unmountGalleryPanel);
    }
  };

  // --- GALLERY SELECTION LOGIC ---
  window.__defaultT2iGalleries = ["public", "pfp-event", "style-submit", "birthdayparty"];

  window.__readRawGalleryLayoutFromStorage = function() {
    const fallback = [...window.__defaultT2iGalleries];
    const raw = localStorage.getItem('t2i_gallery_folders');
    if (!raw) return fallback;

    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch (_) {
      return fallback;
    }

    if (!Array.isArray(parsed)) return fallback;

    const safeLayout = parsed.reduce((layout, entry) => {
      if (typeof entry === 'string' && entry.trim()) {
        layout.push(entry);
        return layout;
      }

      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) return layout;

      const folder = String(entry.folder || '').trim();
      if (!folder) return layout;

      layout.push({
        folder,
        isOpen: entry.isOpen !== false,
        items: Array.isArray(entry.items)
          ? entry.items.filter(item => typeof item === 'string' && item.trim())
          : []
      });
      return layout;
    }, []);

    return safeLayout.length ? safeLayout : ['public'];
  };

  window.__t2iGalleries = window.__readRawGalleryLayoutFromStorage();
  window.__t2iFolders = window.__t2iGalleries;

  window.__t2iCurrentGallery = localStorage.getItem('t2i_current_folder') || 'public';
  window.__t2iCurrentFolder = window.__t2iCurrentGallery;
  window.__kebabOpen = false;
  window.__activeKebabType = null;
  window.__activeKebabKey = null;
  window.__dragIndex = null;
  window.__reorderMode = false;
  window.__dragPosition = 'above';

  window.__initGalleryMenu = function() {
    const nameEl = document.getElementById('currentGalleryName');
    if(nameEl) nameEl.textContent = window.__t2iCurrentGallery;
  };

  window.__clampGalleryUi = function(value, min, max) {
    return Math.max(min, Math.min(max, value));
  };

  window.__positionFloatingGalleryUi = function(menu, anchorRect, alignRight) {
    if (!menu || !anchorRect) return;

    // Append to body so absolute positioning is cleanly relative to the document
    if (menu.parentElement !== document.body) {
      document.body.appendChild(menu);
    }

    const margin = 8;
    const gap = 4;

    // Change from 'fixed' to 'absolute' so it scrolls with the page
    menu.style.position = 'absolute';
    menu.style.visibility = 'hidden';
    menu.style.display = 'block';
    menu.style.overflowY = 'auto';

    const firstRect = menu.getBoundingClientRect();

    let left = alignRight
      ? anchorRect.right - firstRect.width
      : anchorRect.left;

    left = window.__clampGalleryUi(left, margin, window.innerWidth - firstRect.width - margin);

    const roomBelow = window.innerHeight - anchorRect.bottom - gap - margin;
    const roomAbove = anchorRect.top - gap - margin;

    let top;

    // Use up to 65% of the screen height instead of a hardcoded 280px limit
    const dynamicMax = Math.floor(window.innerHeight * 0.65);

    if (firstRect.height > roomBelow && roomAbove > roomBelow) {
      menu.style.maxHeight = Math.min(dynamicMax, Math.max(120, roomAbove)) + 'px';
      const rectAfterHeight = menu.getBoundingClientRect();
      top = anchorRect.top - gap - rectAfterHeight.height;
      top = Math.max(margin, top);
    } else {
      menu.style.maxHeight = Math.min(dynamicMax, Math.max(120, roomBelow)) + 'px';
      const rectAfterHeight = menu.getBoundingClientRect();
      top = anchorRect.bottom + gap;

      if (top + rectAfterHeight.height > window.innerHeight - margin) {
        top = Math.max(margin, window.innerHeight - rectAfterHeight.height - margin);
      }
    }

    // Add scroll offsets to attach the absolute menu correctly to the document layout
    menu.style.left = (left + window.scrollX) + 'px';
    menu.style.top = (top + window.scrollY) + 'px';
    menu.style.visibility = 'visible';
  };

  window.__toggleGalleryMenu = function() {
    const menu = document.getElementById('galleryDropdownMenu');
    const backdrop = document.getElementById('galleryMenuBackdrop');
    const btn = document.getElementById('galleryMenuBtn');

    if(menu.style.display === 'none') {
      window.__reorderMode = false;
      window.__renderGalleryMenu();

      if (btn) {
        const rect = btn.getBoundingClientRect();
        menu.style.minWidth = Math.max(180, rect.width) + 'px';
        window.__positionFloatingGalleryUi(menu, rect, window.innerWidth < 600);
      } else {
        menu.style.display = 'block';
        menu.style.visibility = 'visible';
      }

      if (backdrop) backdrop.style.display = 'block';

      // Scroll to the currently active gallery item WITHOUT scrolling the main page
      setTimeout(() => {
        const activeItem = menu.querySelector('.gallery-item.active');
        if (activeItem) {
          // Manually calculate the scroll position so the main window doesn't shift
          const centerPosition = activeItem.offsetTop - (menu.clientHeight / 2) + (activeItem.clientHeight / 2);
          menu.scrollTop = centerPosition;
        }
      }, 10);
    } else {
      window.__reorderMode = false;
      menu.style.display = 'none';
      menu.style.visibility = 'hidden';
      if (backdrop) backdrop.style.display = 'none';
      window.__closeKebab();
    }
  };

  window.__closeGalleryMenuClickOutside = function(e) {
    const menu = document.getElementById('galleryDropdownMenu');
    const backdrop = document.getElementById('galleryMenuBackdrop');
    const kebab = document.getElementById('activeKebabMenu');
    if (kebab && kebab.contains(e.target)) return;
    window.__reorderMode = false;
    if (menu) {
      menu.style.display = 'none';
      menu.style.visibility = 'hidden';
    }
    if (backdrop) backdrop.style.display = 'none';
    window.__closeKebab();
  };

  window.__renderGalleryMenu = function() {
    const menu = document.getElementById('galleryDropdownMenu');
    if (!menu) return;
    let html = `<div class="sticky-header" style="position:sticky; top:0; background:var(--floatingpanel-bg-color); z-index:2; border-bottom: 1px solid var(--border-color);"><div onclick="window.__addGallery()" class="gallery-item" style="border-bottom: none; font-weight: 600; justify-content: flex-start;"><i class="fa-solid fa-plus" style="margin-right:8px; opacity:0.6;"></i> Add New Gallery</div><div style="padding: 0 8px 8px 8px;"><input type="text" oninput="window.__filterGalleryMenu(this.value)" placeholder="Search..." style="width:100%; box-sizing:border-box; padding:4px 8px; border-radius:4px; border:1px solid var(--border-color); background:rgba(0,0,0,0.15); color:var(--text-color); font-size:12px; outline:none; margin:0;"></div></div>`;

    window.__t2iGalleries.forEach((f, i) => {
      if (typeof f === 'object') {
        const dragHtml = window.__reorderMode ? `<div class="drag-handle" ontouchstart="window.__touchStart(event, '${i}')" ontouchmove="window.__touchMove(event)" ontouchend="window.__touchEnd(event)" ondragstart="window.__dragStart(event, '${i}')" style="display:flex;"><i class="fa-solid fa-grip-vertical"></i></div>` : '';
        const kebabHtml = window.__reorderMode ? '' : `<button class="kebab-btn" onclick="window.__openFolderKebab(event, '${i}')"><i class="fa-solid fa-ellipsis-vertical"></i></button>`;
        const arrowIcon = f.isOpen ? 'fa-chevron-down' : 'fa-chevron-right';
        html += `<div class="gallery-folder" data-path="${i}" draggable="${window.__reorderMode}" onclick="window.__toggleFolder('${i}')" ondragstart="window.__dragStart(event, '${i}')" ondragover="window.__dragOver(event, this, '${i}', true)" ondragleave="window.__dragLeave(this)" ondrop="window.__drop(event, '${i}', true)" style="position:relative; background: rgba(0,0,0,0.15); border-bottom: 1px solid var(--border-color); box-sizing:border-box; cursor:pointer;"><div style="display:flex; align-items:center; padding: 8px 10px;"><div onclick="event.stopPropagation()" style="display:flex; align-items:center; justify-content:center;">${dragHtml}</div><div style="flex:1; display:flex; align-items:center;"><i class="fa-solid ${arrowIcon}" style="margin-right:8px; font-size:10px; width:12px; text-align:center; opacity:0.7;"></i><i class="fa-solid fa-folder" style="margin-right:8px; color: #f39c12;"></i><span style="font-weight:bold; font-size:13px; color:var(--text-color);">${f.folder}</span></div><div onclick="event.stopPropagation()" style="display:flex; align-items:center; justify-content:center;">${kebabHtml}</div></div></div>`;
        if (f.isOpen) {
          f.items.forEach((g, j) => { html += window.__renderGalleryItem(g, `${i}-${j}`, true); });
        }
      } else {
        html += window.__renderGalleryItem(f, `${i}`, false);
      }
    });
    menu.innerHTML = html;
  };

  window.__renderGalleryItem = function(name, path, isIndented) {
    const isActive = name === window.__t2iCurrentGallery ? 'active' : '';
    const safeName = name.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
    const dragHtml = window.__reorderMode ? `<div class="drag-handle" ontouchstart="event.stopPropagation(); window.__touchStart(event, '${path}')" ontouchmove="window.__touchMove(event)" ontouchend="window.__touchEnd(event)" ondragstart="event.stopPropagation(); window.__dragStart(event, '${path}')" onclick="event.stopPropagation()" style="display:flex;"><i class="fa-solid fa-grip-vertical"></i></div>` : '';
    const kebabHtml = window.__reorderMode ? '' : `<button class="kebab-btn" onclick="window.__openKebab(event, '${path}')"><i class="fa-solid fa-ellipsis-vertical"></i></button>`;
    const indentStyle = isIndented ? 'padding-left: 32px;' : 'padding-left: 10px;';
    return `<div class="gallery-item ${isActive}" data-path="${path}" draggable="${window.__reorderMode}" onclick="if (!event.target.closest('.kebab-btn, .drag-handle')) window.__selectGallery('${safeName}')" ondragstart="window.__dragStart(event, '${path}')" ondragover="window.__dragOver(event, this, '${path}', false)" ondragleave="window.__dragLeave(this)" ondrop="window.__drop(event, '${path}', false)" style="position:relative; box-sizing:border-box; ${indentStyle}">${dragHtml}<div class="gallery-name-txt">${name}</div>${kebabHtml}</div>`;
  };

  window.__filterGalleryMenu = function(query = '') {
    const originalQ = String(query).toLowerCase().trim();
    // Normalize the query: convert hyphens/underscores to spaces
    const q = originalQ.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();

    const menu = document.getElementById('galleryDropdownMenu');
    if (!menu) return;

    let lastFolder = null;
    let lastFolderMatches = false;

    for (const el of menu.children) {
      if (el.classList.contains('sticky-header')) continue;

      const rawText = (el.textContent || '').toLowerCase();
      // Normalize the menu text: convert hyphens/underscores to spaces
      const normalizedText = rawText.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();

      // Check if it matches either the exact input or the normalized input
      const textMatches = rawText.includes(originalQ) || normalizedText.includes(q);

      if (el.classList.contains('gallery-folder')) {
        // It's a folder. Update our trackers.
        lastFolder = el;
        lastFolderMatches = textMatches;
        el.style.display = textMatches ? 'block' : 'none';

      } else if (el.classList.contains('gallery-item')) {
        const isChild = el.dataset.path && el.dataset.path.includes('-');

        // Reset trackers if we hit a root item (meaning the previous folder block is over)
        if (!isChild) {
          lastFolder = null;
          lastFolderMatches = false;
        }

        // Show if the item matches OR if its parent folder matches
        const shouldShow = textMatches || (isChild && lastFolderMatches);
        el.style.display = shouldShow ? 'flex' : 'none';

        // If the item matched but the folder didn't, we must reveal the folder now
        if (textMatches && isChild && lastFolder && !lastFolderMatches) {
          lastFolder.style.display = 'block';
          lastFolderMatches = true; // Prevent redundant DOM updates for subsequent children
        }
      }
    }
  };

  window.__enableReorderMode = function(e) {
    if (e) e.stopPropagation();
    window.__reorderMode = true;
    window.__renderGalleryMenu();
    window.__closeKebab();
  };

  window.__dragStart = function(e, path) {
    window.__dragIndex = path;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', path);
  };

  window.__dragLeave = function(el) {
    el.classList.remove('drop-above', 'drop-below', 'drop-inside');
  };

  window.__dragOver = function(e, el, path, isFolder) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    el.classList.remove('drop-above', 'drop-below', 'drop-inside');
    let rect = el.getBoundingClientRect();
    let y = e.clientY - rect.top;
    let h = rect.height;
    let srcPath = String(window.__dragIndex);
    let srcIsFolder = srcPath.indexOf('-') === -1 && typeof window.__t2iGalleries[srcPath] === 'object';
    if (isFolder && !srcIsFolder && y > h * 0.25 && y < h * 0.75) {
      window.__dragPosition = 'inside';
      el.classList.add('drop-inside');
    } else if (y < h / 2) {
      window.__dragPosition = 'above';
      el.classList.add('drop-above');
    } else {
      window.__dragPosition = 'below';
      el.classList.add('drop-below');
    }
  };

  window.__drop = function(e, dropPath, isFolderDropTarget = false) {
    e.preventDefault();
    document.querySelectorAll('.drop-above, .drop-below, .drop-inside').forEach(el => el.classList.remove('drop-above', 'drop-below', 'drop-inside'));
    let srcPath = String(window.__dragIndex);
    if(!srcPath || srcPath === "null") return;
    let srcPts = srcPath.split('-');
    let dstPts = String(dropPath).split('-');
    let pos = window.__dragPosition;
    let srcIsFolder = srcPts.length === 1 && typeof window.__t2iGalleries[srcPts[0]] === 'object';
    if (srcIsFolder && (pos === 'inside' || dstPts.length > 1)) {
      window.__dragIndex = null;
      return window.aifgAlert("Cannot place a folder inside another folder.");
    }
    let item;
    let sRoot = parseInt(srcPts[0]);
    if (srcPts.length === 1) item = window.__t2iGalleries[sRoot];
    else item = window.__t2iGalleries[sRoot].items[parseInt(srcPts[1])];
    let targetArray;
    let targetIndex;
    if (pos === 'inside' && isFolderDropTarget) {
      targetArray = window.__t2iGalleries[parseInt(dstPts[0])].items;
      targetIndex = targetArray.length;
      window.__t2iGalleries[parseInt(dstPts[0])].isOpen = true;
    } else if (dstPts.length === 1) {
      targetArray = window.__t2iGalleries;
      targetIndex = parseInt(dstPts[0]);
      if (pos === 'below') targetIndex++;
    } else {
      targetArray = window.__t2iGalleries[parseInt(dstPts[0])].items;
      targetIndex = parseInt(dstPts[1]);
      if (pos === 'below') targetIndex++;
    }
    let sourceArray = srcPts.length === 1 ? window.__t2iGalleries : window.__t2iGalleries[sRoot].items;
    if (sourceArray === targetArray) {
      let sIdx = srcPts.length === 1 ? sRoot : parseInt(srcPts[1]);
      if (sIdx === targetIndex || (sIdx === targetIndex - 1 && pos === 'below')) {
        window.__dragIndex = null;
        return;
      }
      if (sIdx < targetIndex) targetIndex--;
    }
    if (srcPts.length === 1) window.__t2iGalleries.splice(sRoot, 1);
    else window.__t2iGalleries[sRoot].items.splice(parseInt(srcPts[1]), 1);
    targetArray.splice(targetIndex, 0, item);
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__reorderMode = false;
    window.__renderGalleryMenu();
    window.__dragIndex = null;
  };

  window.__touchStart = function(e, path) { window.__dragIndex = path; };

  window.__touchMove = function(e) {
    e.preventDefault();
    const touch = e.changedTouches[0];
    const target = document.elementFromPoint(touch.clientX, touch.clientY);
    const el = target ? target.closest('.gallery-folder, .gallery-item') : null;
    document.querySelectorAll('.drop-above, .drop-below, .drop-inside').forEach(n => n.classList.remove('drop-above', 'drop-below', 'drop-inside'));
    if (el) {
      let rect = el.getBoundingClientRect();
      let y = touch.clientY - rect.top;
      let h = rect.height;
      let isFolder = el.classList.contains('gallery-folder');
      let srcPath = String(window.__dragIndex);
      let srcIsFolder = srcPath.indexOf('-') === -1 && typeof window.__t2iGalleries[srcPath] === 'object';
      if (isFolder && !srcIsFolder && y > h * 0.25 && y < h * 0.75) {
        window.__dragPosition = 'inside';
        el.classList.add('drop-inside');
      } else if (y < h / 2) {
        window.__dragPosition = 'above';
        el.classList.add('drop-above');
      } else {
        window.__dragPosition = 'below';
        el.classList.add('drop-below');
      }
    }
  };

  window.__touchEnd = function(e) {
    if(window.__dragIndex === null || window.__dragIndex === "null") return;
    const touch = e.changedTouches[0];
    const target = document.elementFromPoint(touch.clientX, touch.clientY);
    const dropEl = target ? target.closest('.gallery-folder, .gallery-item') : null;
    document.querySelectorAll('.drop-above, .drop-below, .drop-inside').forEach(n => n.classList.remove('drop-above', 'drop-below', 'drop-inside'));
    if(dropEl && dropEl.dataset.path !== undefined) {
      window.__drop(e, dropEl.dataset.path, dropEl.classList.contains('gallery-folder'));
    }
    window.__dragIndex = null;
  };

  window.__openKebab = function(e, path) {
    e.stopPropagation();

    const kebabKey = String(path);
    const isSameKebab = window.__kebabOpen
      && window.__activeKebabType === 'gallery'
      && window.__activeKebabKey === kebabKey;

    if (isSameKebab) {
      window.__closeKebab();
      return;
    }

    window.__closeKebab();

    const rect = e.currentTarget.getBoundingClientRect();
    const kebab = document.createElement('div');
    kebab.id = 'activeKebabMenu';
    kebab.className = 'kebab-popup';
    kebab.style.position = 'fixed';
    kebab.style.top = '0';
    kebab.style.left = '0';
    kebab.style.visibility = 'hidden';
    kebab.style.maxHeight = 'calc(100dvh - 16px)';
    kebab.style.overflowY = 'auto';
    kebab.style.zIndex = '100000';

    let isRoot = String(path).indexOf('-') === -1;
    let folderBtnHtml = isRoot ? `<button class="kebab-action" onclick="window.__addFolder()"><i class="fa-solid fa-folder-plus"></i> Add Folder</button>` : ``;

    kebab.innerHTML = `<button class="kebab-action" onclick="window.__enableReorderMode(event)"><i class="fa-solid fa-arrows-up-down"></i> Reorder</button>${folderBtnHtml}<button class="kebab-action" onclick="window.__renameGallery('${path}')"><i class="fa-solid fa-pen"></i> Rename</button><button class="kebab-action" style="color:var(--alert-color);" onclick="window.__deleteGallery('${path}')"><i class="fa-solid fa-trash"></i> Delete</button>`;

    document.body.appendChild(kebab);
    window.__positionFloatingGalleryUi(kebab, rect, true);

    window.__kebabOpen = true;
    window.__activeKebabType = 'gallery';
    window.__activeKebabKey = kebabKey;

    setTimeout(() => document.addEventListener('click', window.__closeKebabClickOutside), 10);
  };

  window.__openFolderKebab = function(e, idx) {
    e.stopPropagation();

    const kebabKey = String(idx);
    const isSameKebab = window.__kebabOpen
      && window.__activeKebabType === 'folder'
      && window.__activeKebabKey === kebabKey;

    if (isSameKebab) {
      window.__closeKebab();
      return;
    }

    window.__closeKebab();

    const rect = e.currentTarget.getBoundingClientRect();
    const kebab = document.createElement('div');
    kebab.id = 'activeKebabMenu';
    kebab.className = 'kebab-popup';
    kebab.style.position = 'fixed';
    kebab.style.top = '0';
    kebab.style.left = '0';
    kebab.style.visibility = 'hidden';
    kebab.style.maxHeight = 'calc(100dvh - 16px)';
    kebab.style.overflowY = 'auto';
    kebab.style.zIndex = '100000';
    kebab.innerHTML = `<button class="kebab-action" onclick="window.__enableReorderMode(event)"><i class="fa-solid fa-arrows-up-down"></i> Reorder</button><button class="kebab-action" onclick="window.__addFolder()"><i class="fa-solid fa-folder-plus"></i> Add Folder</button><button class="kebab-action" onclick="window.__renameFolder('${idx}')"><i class="fa-solid fa-pen"></i> Rename</button><button class="kebab-action" style="color:var(--alert-color);" onclick="window.__deleteFolder('${idx}')"><i class="fa-solid fa-trash"></i> Delete</button>`;

    document.body.appendChild(kebab);
    window.__positionFloatingGalleryUi(kebab, rect, true);

    window.__kebabOpen = true;
    window.__activeKebabType = 'folder';
    window.__activeKebabKey = kebabKey;

    setTimeout(() => document.addEventListener('click', window.__closeKebabClickOutside), 10);
  };

  window.__closeKebabClickOutside = function(e) {
    const kebab = document.getElementById('activeKebabMenu');
    if (kebab && !kebab.contains(e.target)) {
      window.__closeKebab();
    }
  };

  window.__closeKebab = function() {
    const kebab = document.getElementById('activeKebabMenu');
    if (kebab) {
      kebab.style.display = 'none';
      kebab.style.visibility = 'hidden';
      kebab.remove();
    }

    document.removeEventListener('click', window.__closeKebabClickOutside);

    window.__kebabOpen = false;
    window.__activeKebabType = null;
    window.__activeKebabKey = null;
  };

  window.__selectGallery = function(name) {
    window.__t2iCurrentGallery = name;
    localStorage.setItem('t2i_current_folder', name);
    window.__t2iCurrentFolder = name;
    const nameEl = document.getElementById('currentGalleryName');
    if (nameEl) nameEl.textContent = name;
    const menu = document.getElementById('galleryDropdownMenu');
    if (menu) menu.style.display = 'none';
    const backdrop = document.getElementById('galleryMenuBackdrop');
    if (backdrop) backdrop.style.display = 'none';
    document.removeEventListener('click', window.__closeGalleryMenuClickOutside);
    const tIn = document.getElementById('galleryTagInputEl');
    const bIn = document.getElementById('galleryBadTagInputEl');
    window.__attachGalleryLoader?.('Loading Gallery…');
    if(typeof window.changeAll === 'function') {
      window.changeAll(tIn ? tIn.value : "", bIn ? bIn.value : "");
    }
  };

  window.__addGallery = async function() {
    let name = await window.aifgPrompt("Enter new gallery name:", "", { title:"New gallery", okText:"Add" });
    if(!name) return;
    name = name.trim().toLowerCase().replace(/[ _]+/g, '-').replace(/[^a-z0-9\-]/g, '');
    if(!name) return window.aifgAlert("Invalid name.");
    let isDup = false;
    window.__t2iGalleries.forEach(g => {
      if (typeof g === 'string' && g === name) isDup = true;
      if (typeof g === 'object' && g.items.includes(name)) isDup = true;
    });
    if (isDup) return window.aifgAlert("Duplicate name.");
    window.__t2iGalleries.push(name);
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__renderGalleryMenu();
    window.__selectGallery(name);
  };

  window.__addFolder = async function() {
    window.__closeKebab();
    let name = await window.aifgPrompt("Enter new folder name:", "", { title:"New folder", okText:"Add" });
    if(!name || !name.trim()) return;
    window.__t2iGalleries.push({ folder: name.trim(), isOpen: true, items: [] });
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__renderGalleryMenu();
  };

  window.__toggleFolder = function(idx) {
    if (window.__reorderMode) return;
    window.__t2iGalleries[idx].isOpen = !window.__t2iGalleries[idx].isOpen;
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__renderGalleryMenu();
  };

  window.__renameGallery = async function(path) {
    window.__closeKebab();
    let pts = String(path).split('-');
    let isRoot = pts.length === 1;
    let oldName = isRoot ? window.__t2iGalleries[pts[0]] : window.__t2iGalleries[pts[0]].items[pts[1]];
    let newName = await window.aifgPrompt("Choose a new gallery name:", oldName, { title:"Rename gallery", okText:"Rename" });
    if(!newName) return;
    newName = newName.trim().toLowerCase().replace(/[ _]+/g, '-').replace(/[^a-z0-9\-]/g, '');
    if(!newName) return window.aifgAlert("Invalid name.");
    let isDup = false;
    window.__t2iGalleries.forEach(g => {
      if (typeof g === 'string' && g === newName) isDup = true;
      if (typeof g === 'object' && g.items.includes(newName)) isDup = true;
    });
    if (isDup && newName !== oldName) return window.aifgAlert("Duplicate name.");
    if (isRoot) window.__t2iGalleries[pts[0]] = newName;
    else window.__t2iGalleries[pts[0]].items[pts[1]] = newName;
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    if(window.__t2iCurrentGallery === oldName) window.__selectGallery(newName);
    else window.__renderGalleryMenu();
  };

  window.__deleteGallery = async function(path) {
    window.__closeKebab();
    let pts = String(path).split('-');
    let isRoot = pts.length === 1;
    let name = isRoot ? window.__t2iGalleries[pts[0]] : window.__t2iGalleries[pts[0]].items[pts[1]];
    if(!await window.aifgConfirm(`Delete gallery '${name}'?\n\nImages are not deleted from the server; only this shortcut is removed.`, { title:"Delete gallery", okText:"Delete", danger:true })) return;
    if (isRoot) window.__t2iGalleries.splice(pts[0], 1);
    else window.__t2iGalleries[pts[0]].items.splice(pts[1], 1);
    if(window.__t2iGalleries.length === 0) window.__t2iGalleries = ['public'];
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    if(window.__t2iCurrentGallery === name) window.__selectGallery("public");
    else window.__renderGalleryMenu();
  };

  window.__renameFolder = async function(idx) {
    window.__closeKebab();
    let oldName = window.__t2iGalleries[idx].folder;
    let newName = await window.aifgPrompt("Choose a new folder name:", oldName, { title:"Rename folder", okText:"Rename" });
    if(!newName || !newName.trim()) return;
    window.__t2iGalleries[idx].folder = newName.trim();
    localStorage.setItem('t2i_gallery_folders', JSON.stringify(window.__t2iGalleries));
    window.__renderGalleryMenu();
