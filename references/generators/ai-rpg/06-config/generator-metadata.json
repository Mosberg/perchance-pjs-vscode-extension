 "perchanceMeta": {
  "title": "🗡️ AI RPG - Text Adventure - free, unlimited, no sign-up",
  "description": "Completely free & unlimited AI Text Adventure. Interactive AI story/game, kinda like AI Dungeon. DnD AI / Game Master, with no sign-up or login. Be whoever you want, do whatever you want. Fast generation and there are *no* daily usage restrictions - unlimited and 100% free text adventure AI. As you might expect from a AI RPG generator, you can create fantasy RPGs, horror games (including creepy/creepypasta and analogue horror stories), funny adventures, mystery, romance choose-your-own-adventures, AI isekai adventures, anime text adventures, and basically anything else.",
  "image": "https://user.uploads.dev/file/7779244672aaaf6c2c3c6b72d61c600a.jpeg",
  "pageTitle": "🗺️ AI RPG 🧙‍♂️"
 },
