          })
          overlay.onclick = () => overlay.remove()
          overlay.appendChild(zoomImg)
          document.body.appendChild(overlay)
        }
        canvas.onclick = openZoom

        // --- Request input ---
        const requestInput = document.createElement("textarea")
        requestInput.placeholder = "Describe the text you want on the image...\ne.g. a funny meme caption · a dramatic movie title · a neon 'OPEN 24 HOURS' sign · what a character is thinking or saying\n(leave empty and the AI will invent something that fits the scene)"
        Object.assign(requestInput.style, {
