    onClick(data) =>
      let oldModal = document.getElementById("galleryModal")
      if (oldModal) oldModal.remove()

      let modal = document.createElement("div")
      modal.id = "galleryModal"
      Object.assign(modal.style, {
        
        inset: "0",
        position: "fixed",
        background: "rgba(0,0,0,0.7)",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        zIndex: "10001"
      })

      let content = document.createElement("div")
      Object.assign(content.style, {
        background: "#1e1e1e",
        borderRadius: "12px",
        padding: "20px",
        color: "#fff",
        minWidth: "250px",
        textAlign: "center",
        boxShadow: "0 4px 20px rgba(0,0,0,0.4)"
      })
      function getCommentCount(channel, callback) {
      const relayOutput = root.commentsPlugin({
      channel: channel,
      onLoad: function(comments) {
      callback(comments.length);
      },
      onLoadMore: function(comments) {
      callback(comments.length);
      }
      });

  // Must mount into DOM (hidden) or onLoad never fires
      const holder = document.createElement('div');
      holder.style.cssText = "position:fixed; top:0; right:0; width:0; height:0; opacity:0; pointer-events:none; overflow:hidden;";
      holder.innerHTML = `<span>${relayOutput}</span>`;
      document.body.appendChild(holder);
      }

      function makeBtn(label, action, closeAfter = true) {
        let btn = document.createElement("button")
        btn.innerHTML = label
        Object.assign(btn.style, {
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          gap: "8px",
          width: "100%",
          margin: "8px 0",
          padding: "10px",
          border: "none",
          borderRadius: "8px",
          background: backbro,
          color: "white",
          fontSize: "15px",
          cursor: "pointer"
        })
        
        btn.onclick = () => {
          action()
          if (closeAfter) modal.remove()
        }
        return btn
      }
      
      const commentBtn = makeBtn('<i class="fa-solid fa-comment"></i> Comments', () => {
      const channel = "gcomment-" + data.imageId.slice(0, 25);
      
      const gen = window.generatorName; // the generator hosting the gallery-comment channels
      const filter = ""; // usually empty, or "/something" if your setup uses it

      const hashData = {
      allowCustomChannels: true,
      adminPasswordHash: "2ac281fc3cd3e46c71e0e07ddaa8f80263ac743b632f6dee6ff083466382a4f6",
      submitButtonText: "Send It!!",
      fullscreenButtonStyle: "display: none!important;",
      embedImagesInMessages: true,
      loadFonts: "Open+Sans:wght@400;700, Inter:wght@400;700, Roboto:wght@400;700",
      adminFlair: "Safemod",
      deleteButtonIcon: "❌",
      commentPlaceholderText: "Message.. :for gif",
      allowUsersToDeleteOwnComments: true,
      
      reverseCommentOrder: true,
      };
  
      const queryString = `adminPasswordHash=${encodeURIComponent(hashData.adminPasswordHash)}`;
      const commentsUrl = `https://comments-plugin.perchance.org/embed/${gen}+${channel}${filter}?${queryString}#` + encodeURIComponent(JSON.stringify(hashData)
      );

      const id = 'gallery-comment-modal';
      const overlay = document.createElement('div');
      overlay.id = id;
      overlay.style.cssText = "display:flex; inset:0; position:fixed; background:rgba(0,0,0,0.7); z-index:999999; justify-content:center; align-items:center;";
      overlay.onclick = (e) => { if (e.target === overlay) overlay.remove(); };

      overlay.innerHTML = `
      <div style="display:flex; flex-direction:column; width:95vw; max-width:600px; height:80vh; background:#222; border:1px solid #444; border-radius:12px; box-shadow:0 10px 50px rgba(0,0,0,0.5); overflow:hidden;">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; border-bottom:1px solid #444; background:#222; flex-shrink:0;">
        <div style="font-weight:bold; font-size:1.1rem; color:white; display:flex; align-items:center; gap:0.5rem;">
          <i class="fa-solid fa-comment"></i> Gallery Comments
        </div>
        <button onclick="document.getElementById('${id}').remove()" style="font-size:1.4rem; background:transparent; border:none; cursor:pointer; opacity:0.7; color:white; padding:0 5px; line-height:1;">✕</button>
      </div>

      <div class="gallery-comment-desktop-layout" style="flex:1; min-height:0; display:grid; grid-template-columns:minmax(180px,34%) 1fr; background:#111; overflow:hidden;">
        <div class="gallery-comment-image-preview" style="min-height:0; display:flex; align-items:center; justify-content:center; padding:10px; border-right:1px solid #444; background:#222;">
          <img src="${data.imageUrl}" style="max-width:100%; max-height:100%; object-fit:contain; border-radius:8px;">
        </div>
        <div class="gallery-comment-plugin-pane" style="min-width:0; min-height:0; height:100%; position:relative; background:#111; overflow:hidden;">
          <iframe
            src="${commentsUrl}"
            style="width:100%; height:100%; border:none;"
            allow="clipboard-write"
          ></iframe>
        </div>
      </div>
      </div>

      <style>
      @media (max-width:700px) {
        #${id} .gallery-comment-desktop-layout {
          display:grid !important;
          grid-template-columns:1fr !important;
          grid-template-rows:1fr !important;
          height:100% !important;
          min-height:0 !important;
        }
        #${id} .gallery-comment-image-preview { display:none !important; }
        #${id} .gallery-comment-plugin-pane {
          height:100% !important;
          min-height:0 !important;
          overflow:hidden !important;
        }
      }
      @media (min-width:701px) {
        #${id} > div { max-width:980px !important; }
      }
      </style>`;

      document.body.appendChild(overlay);
      }, false);

      content.appendChild(commentBtn);

      const channel = "gcomment-" + data.imageId.slice(0, 25);
      getCommentCount(channel, (count) => {
      commentBtn.innerHTML = `<i class="fa-solid fa-comment"></i> Comments (${count})`;
      })


      
      content.appendChild(makeBtn('<i class="fa-solid fa-expand"></i> Fullscreen', () => showImageFullscreen(data.imageUrl)))

      content.appendChild(makeBtn('<i class="fa-solid fa-download"></i> Download', async () => {
        try {
      if (!data.imageUrl) {
      alert("No image URL available to download.");
      return;
      }
      let response = await fetch(data.imageUrl);
      let arrayBuf = await response.arrayBuffer();
      let binary = "";
      let bytes = new Uint8Array(arrayBuf);
      for (let i = 0; i < bytes.length; i++) {
      binary += String.fromCharCode(bytes[i]);
      }
      let base64 = btoa(binary);

      let exifObj = {
        "0th": {
        [piexif.ImageIFD.ImageDescription]: (data.prompt || "") 
      },
      "Exif": {
        [piexif.ExifIFD.UserComment]: 
          `seed: ${data.seed || ""}\n` +
          `cfg: ${data.guidanceScale || ""}\n` +
          `prompt: ${data.prompt || ""}\n`
      }
      };

    
      let exifBytes = piexif.dump(exifObj);
      let newJpgBase64 = piexif.insert(exifBytes, "data:image/jpeg;base64," + base64);
      function base64ToBlob(base64String) {
        const parts = base64String.split(',');
        const raw = atob(parts[1]);
      const buffer = new ArrayBuffer(raw.length);
      const bytes = new Uint8Array(buffer);
        for (let i = 0; i < raw.length; i++) {
        bytes[i] = raw.charCodeAt(i);
        }
        return new Blob([bytes], { type: "image/jpeg" });
        }

      let finalBlob = base64ToBlob(newJpgBase64);

    
      const filename = `realmweaver+exif_seed${data.seed || ""}.jpg`;
      const url = URL.createObjectURL(finalBlob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      } catch (err) {
      console.error("EXIF download failed:", err);
      alert("Failed to download image with EXIF.");
      }
      }));
      content.appendChild(makeBtn('<i class="fa-solid fa-eraser"></i> Remove Background', async () => {
        try {
      alert("Background removal takes around 15 seconds.\nThe finished image will pop up as a downloadable PNG. \nBe patient and dont spam this button ✌️.");

      if (!data.imageUrl) {
      alert("No image URL available.");
      return;
      }

      async function removeBackground(imageUrl) {
        if (!removeBackground.transformers) {
        const transformers = await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.3.3");
        transformers.env.allowLocalModels = false;
        transformers.env.backends.onnx.wasm.proxy = true;
        removeBackground.transformers = transformers;
        }

      const { AutoModel, AutoProcessor, RawImage } = removeBackground.transformers;

      if (!removeBackground.model) {
        removeBackground.model = await AutoModel.from_pretrained("briaai/RMBG-1.4", {
        config: { model_type: "custom" }
        });
      }

      if (!removeBackground.processor) {
      removeBackground.processor = await AutoProcessor.from_pretrained("briaai/RMBG-1.4");
      }

      const image = await RawImage.fromURL(imageUrl);
      const { pixel_values } = await removeBackground.processor(image);
      const { output } = await removeBackground.model({ input: pixel_values });

      const mask = await RawImage
        .fromTensor(output[0].mul(255).to("uint8"))
        .resize(image.width, image.height);

      const canvas = document.createElement("canvas");
      canvas.width = image.width;
      canvas.height = image.height;
      const ctx = canvas.getContext("2d");

      ctx.drawImage(image.toCanvas(), 0, 0);
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < mask.data.length; i++) {
      imgData.data[i * 4 + 3] = mask.data[i];
      }

      ctx.putImageData(imgData, 0, 0);
      return canvas.toDataURL("image/png");
      }

      let pngDataUrl = await removeBackground(data.imageUrl);

      const filename = `realmweaver_nobg_seed${data.seed || ""}.png`;
      const a = document.createElement("a");
      a.href = pngDataUrl;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      } catch (err) {
      console.error("Background removal failed:", err);
      alert("Failed to remove background.");
      }
      }));
      async function extractResolution(data) {
      if (data.resolution && data.resolution !== "" && data.resolution !== "undefined") {
      return data.resolution;
      }
      if (data.dataUrl || data.imageUrl) {
      return await getAspect(data.dataUrl || data.imageUrl);
      }
      return null;
      }
      function getAspect(url) {
      return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => {
      const { width, height } = img;
      if (width > height) resolve("768x512");
      else if (height > width) resolve("512x768");
      else resolve("768x768");
      };
      img.onerror = () => resolve("512x512");
      img.src = url;
      });
      }

      content.appendChild(makeBtn('<i class="fa-solid fa-copy"></i> Copy Prompt', async () => {
      if (!data.prompt) { alert("No prompt available."); return; }
      const resolution = await extractResolution(data);
      let parts = [data.prompt];
      if (resolution) parts.push(`(resolution:::${resolution})`);
      if (data.guidanceScale) parts.push(`(guidanceScale:::${data.guidanceScale})`);
      await navigator.clipboard.writeText(parts.join(" "));
      alert("Prompt copied!");
      }, false));

      content.appendChild(makeBtn('<i class="fa-solid fa-pen"></i> Edit & Regenerate', async () => {
      if (!data.prompt) { alert("No prompt available."); return; }
      const resolution = await extractResolution(data);
      const resPart = resolution ? `(resolution:::${resolution})` : `(resolution:::{768x768|512x768|768x512})`;
      if (window.openGalleryEditRegen) window.openGalleryEditRegen(data);
      }));
      content.appendChild(makeBtn('<i class="fa-solid fa-share"></i> Share Image', async () => {
        if (!data.imageUrl) return alert("No image to share.")
        try {
        let shareText = (data.prompt ? data.prompt + "\n\n" : "") + "Generated using: https://perchance.org/realmweaver"

        if (navigator.share) {
        await navigator.share({
          title: "Shared Image",
          text: shareText,
          url: data.imageUrl
        })
        } else {
        await navigator.clipboard.writeText(data.imageUrl + "\n\n" + shareText)
          alert("Image URL and generator link copied to clipboard!")
          }
          } catch (err) {
          console.error("Share failed:", err)
          alert("Could not share image.")
        }
        }))
      content.appendChild(makeBtn('<i class="fa-solid fa-font"></i> AI Text on Image', async () => {
        if (!data.imageUrl) {
          alert("No image available.")
          return
        }

        // --- Modal ---
        const modal = document.createElement("div")
        Object.assign(modal.style, {
