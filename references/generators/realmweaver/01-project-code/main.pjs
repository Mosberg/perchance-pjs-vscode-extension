          background: "#1a1a1a", padding: "20px", borderRadius: "12px",
          textAlign: "center", maxWidth: "95vw", maxHeight: "95vh", overflowY: "auto",
          border: "1px solid #333", boxShadow: "0 10px 30px rgba(0,0,0,0.5)",
          width: "min(760px, 94vw)", boxSizing: "border-box"
        })
        modal.appendChild(box)
        document.body.appendChild(modal)

        // --- Header ---
        const head = document.createElement("div")
        Object.assign(head.style, {
          display: "flex", justifyContent: "space-between", alignItems: "center",
          marginBottom: "10px"
        })
        const title = document.createElement("h3")
