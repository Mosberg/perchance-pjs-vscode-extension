world
  n = {5-10} // the overall min and max number of children
  continent
	ocean
	archipelago^0.2 // normal odds notation for general likelihood

continent
  n = {3-5}
  desert_region
	mountain_range {1-3} // min of 1, max of 3 - for *this specific item*
	forested_region
	
desert_region // use under-scores for names
  n = {3-5}
	name = {rocky ^0.2|sandy |}desert region // optionally specify alternative names
	village
	sand

mountain_range
	description = A {snowy|dry|massive} range of mountains, stretching up to {1000-9000} metres at its tallest.
	mountain
	alpine_forest
	
alpine_forest
	description = There are trees, and it's quite {cold|snowy}. About -{3-30} degrees Celsius. <br><img src="https://i.imgur.com/0Xy40ze.png" style="width:200px;">

