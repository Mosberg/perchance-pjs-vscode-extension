{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Perchance PJS",
  "scopeName": "source.perchance.pjs",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#meta-tags"
    },
    {
      "include": "#list-definition"
    },
    {
      "include": "#property-block"
    },
    {
      "include": "#special-constructs"
    },
    {
      "include": "#html-mode"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#references"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.perchance.pjs",
          "match": "//.*$"
        },
        {
          "name": "comment.block.perchance.pjs",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "meta-tags": {
      "patterns": [
        {
          "name": "meta.tag.perchance.pjs",
          "match": "(meta:(?:import|position|id|name|description))\\b",
          "captures": {
            "1": {
              "name": "entity.name.tag.meta.perchance.pjs"
            }
          }
        },
        {
          "name": "variable.language.meta-item.perchance.pjs",
          "match": "\\$meta\\b"
        }
      ]
    },
    "list-definition": {
      "patterns": [
        {
          "name": "meta.list.perchance.pjs",
          "begin": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.list.perchance.pjs"
            },
            "2": {
              "name": "keyword.operator.assignment.perchance.pjs"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#list-items"
            }
          ]
        }
      ]
    },
    "list-items": {
      "patterns": [
        {
          "name": "constant.numeric.odds.perchance.pjs",
          "match": "\\{\\s*\\d+(?:-\\d+)?\\s*\\}"
        },
        {
          "name": "string.quoted.double.perchance.pjs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.perchance.pjs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.perchance.pjs",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.perchance.pjs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "variable.other.reference.perchance.pjs",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.control.choice.perchance.pjs",
          "match": "\\|"
        }
      ]
    },
    "property-block": {
      "patterns": [
        {
          "name": "meta.property-block.perchance.pjs",
          "begin": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.property.perchance.pjs"
            },
            "2": {
              "name": "keyword.operator.assignment.perchance.pjs"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#list-items"
            },
            {
              "name": "storage.modifier.async.perchance.pjs",
              "match": "\\basync\\b"
            }
          ]
        }
      ]
    },
    "special-constructs": {
      "patterns": [
        {
          "name": "constant.language.empty-list.perchance.pjs",
          "match": "\\{\\|\\}"
        },
        {
          "name": "constant.language.placeholder.perchance.pjs",
          "match": "<{3}[^>]+>{3}"
        }
      ]
    },
    "html-mode": {
      "patterns": [
        {
          "name": "meta.embedded.block.html.perchance.pjs",
          "begin": "(?i)^\\s*(html)\\s*(:)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.html-mode.perchance.pjs"
            },
            "2": {
              "name": "keyword.operator.assignment.perchance.pjs"
            }
          },
          "end": "$",
          "contentName": "text.html.basic",
          "patterns": [
            {
              "include": "text.html.basic"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.perchance.pjs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.perchance.pjs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.perchance.pjs",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.perchance.pjs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.perchance.pjs",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "variable.other.reference.perchance.pjs",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
